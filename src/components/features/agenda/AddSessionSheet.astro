---
---

<div 
  id="add-session-sheet" 
  class="fixed inset-x-0 bottom-0 z-[100] bg-surface-main rounded-t-[2rem] p-6 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex-1 overflow-y-auto no-scrollbar">
    <h3 class="text-2xl font-extrabold tracking-tight text-black mb-6">New Session</h3>

    <form id="add-session-form" class="space-y-6">
      <!-- Patient Picker -->
      <div class="space-y-2">
        <label for="patient-select" class="text-sm font-bold text-text-muted">Patient</label>
        <div class="relative bg-black/5 rounded-2xl overflow-hidden focus-within:ring-2 focus-within:ring-brand-primary transition-all">
          <select 
            id="patient-select" 
            name="patientId" 
            class="w-full bg-transparent border-none py-4 px-4 font-bold text-black focus:outline-none appearance-none cursor-pointer"
            required
          >
            <option value="" disabled selected>Select a patient...</option>
            <option value="patient_1">Maria Popescu</option>
            <option value="patient_2">Andrei Ionescu</option>
            <option value="patient_3">Elena Stan</option>
            <!-- In reality, this would be populated from Convex -->
          </select>
          <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-black/40">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Date / Time Picker -->
      <div class="space-y-2">
        <label for="datetime-select" class="text-sm font-bold text-text-muted">Date & Time</label>
        <div class="bg-black/5 rounded-2xl overflow-hidden focus-within:ring-2 focus-within:ring-brand-primary transition-all">
          <input 
            type="datetime-local" 
            id="datetime-select" 
            name="startTime" 
            class="w-full bg-transparent border-none py-4 px-4 font-bold text-black focus:outline-none"
            required
          />
        </div>
      </div>

      <!-- Location Picker -->
      <div class="space-y-2">
        <label class="text-sm font-bold text-text-muted mb-2 block">Location</label>
        <div class="flex gap-3">
          <label class="flex-1 relative cursor-pointer">
            <input type="radio" name="location" value="Ghimbav" class="peer sr-only" checked />
            <div class="py-3 text-center rounded-2xl font-bold bg-black/5 text-text-muted peer-checked:bg-brand-secondary peer-checked:text-white transition-all">
              Ghimbav
            </div>
          </label>
          <label class="flex-1 relative cursor-pointer">
            <input type="radio" name="location" value="Belaqua" class="peer sr-only" />
            <div class="py-3 text-center rounded-2xl font-bold bg-black/5 text-text-muted peer-checked:bg-brand-primary peer-checked:text-black transition-all">
              Belaqua
            </div>
          </label>
        </div>
      </div>
    </form>
  </div>

  <div class="pt-6 mt-auto">
    <button type="submit" form="add-session-form" class="w-full py-4 rounded-2xl bg-black text-white font-bold text-lg active:scale-95 transition-transform shadow-lg">
      Book Session
    </button>
  </div>
</div>

<script>
  class AddSessionSheetManager {
    sheet: HTMLElement | null;
    form: HTMLFormElement | null;
    timeInput: HTMLInputElement | null;
    overlay: HTMLElement | null;
    startY: number;
    currentY: number;

    constructor() {
      this.sheet = document.getElementById('add-session-sheet');
      this.form = document.getElementById('add-session-form') as HTMLFormElement;
      this.timeInput = document.getElementById('datetime-select') as HTMLInputElement;
      this.startY = 0;
      this.currentY = 0;

      this.createOverlay();
      this.bindEvents();
    }

    createOverlay() {
      this.overlay = document.createElement('div');
      this.overlay.className = 'fixed inset-0 bg-black/40 z-[90] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm';
      document.body.appendChild(this.overlay);

      this.overlay.addEventListener('click', () => this.close());
    }

    bindEvents() {
      if (!this.sheet) return;

      // Swipe down to close
      const handle = this.sheet.querySelector('.cursor-grab');
      handle?.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      handle?.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      handle?.addEventListener('touchend', () => this.handleTouchEnd());

      // Listen for custom event to open sheet
      window.addEventListener('openAddSession', (e: any) => {
        const timeStr = e.detail?.time;
        if (timeStr && this.timeInput) {
          // Format expected by datetime-local: YYYY-MM-DDThh:mm
          // This is a stub, assuming we just want today with the clicked time
          const now = new Date();
          const yyyy = now.getFullYear();
          const mm = String(now.getMonth() + 1).padStart(2, '0');
          const dd = String(now.getDate()).padStart(2, '0');
          this.timeInput.value = `${yyyy}-${mm}-${dd}T${timeStr}`;
        } else if (this.timeInput) {
          this.timeInput.value = '';
        }
        this.open();
      });

      this.form?.addEventListener('submit', (e) => {
        e.preventDefault();
        // Here we would call the Convex mutation
        console.log("Create appointment stub triggered.");
        this.close();
      });
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.classList.remove('translate-y-full');
      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    close() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.style.transform = '';
      this.sheet.classList.add('translate-y-full');
      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      
      // Reset form
      setTimeout(() => this.form?.reset(), 500);
    }

    handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      if (this.sheet) this.sheet.style.transition = 'none';
    }

    handleTouchMove(e: TouchEvent) {
      this.currentY = e.touches[0].clientY;
      const deltaY = this.currentY - this.startY;
      if (deltaY > 0 && this.sheet) {
        e.preventDefault();
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.sheet) return;
      const deltaY = this.currentY - this.startY;
      this.sheet.style.transition = 'transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1)';
      
      if (deltaY > 150) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    new AddSessionSheetManager();
  });
</script>
