---
const todayStr = new Date().toISOString().split('T')[0];

// Generating upcoming work dates (Monday to Friday only)
const upcomingDates: Array<{ value: string; displayDay: string; displayDate: number }> = [];
let dayCounter = 0;
while (upcomingDates.length < 14 && dayCounter < 30) {
  const d = new Date();
  d.setDate(d.getDate() + dayCounter);
  const dayOfWeek = d.getDay();
  // Include only working days: Monday (1) through Friday (5)
  if (dayOfWeek !== 0 && dayOfWeek !== 6) {
    upcomingDates.push({
      value: d.toISOString().split('T')[0],
      displayDay: upcomingDates.length === 0 && dayCounter === 0 ? 'Azi' : d.toLocaleDateString('ro-RO', { weekday: 'short' }),
      displayDate: d.getDate()
    });
  }
  dayCounter++;
}
---

<div 
  id="add-session-sheet" 
  class="fixed inset-x-0 bottom-0 z-[100] bg-surface-card rounded-t-[2rem] p-4 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex-1 overflow-y-auto no-scrollbar">
    <h3 id="sheet-title" class="text-2xl font-extrabold tracking-tight text-black mb-6">Programare nouă</h3>

    <form id="add-session-form" class="space-y-6">
      <input type="hidden" name="sessionId" id="sessionId" value="" />
      
      <!-- Custom Patient Picker -->
      <div class="space-y-2">
        <!-- Search Patient Input (Always visible) -->
        <div class="relative">
          <input 
            type="text" 
            id="search-patient-input" 
            placeholder="Căutare pacient..." 
            class="w-full px-6 py-4 rounded-full border-2 border-brand-secondary bg-transparent text-lg font-bold text-black focus:outline-none focus:border-brand-secondary transition-all"
          />
          <div class="absolute inset-y-0 right-6 flex items-center pointer-events-none">
            <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <div id="patient-list" class="hidden flex-col gap-3 pb-2 overflow-y-auto max-h-[40vh] no-scrollbar mt-4 px-2">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Date/Time Selectors (Butoane Principale) -->
      <div id="date-time-selectors" class="space-y-3 pt-2">
        <input type="hidden" name="selectedDate" id="selectedDate" value={todayStr} />
        <input type="hidden" name="selectedTime" id="selectedTime" value="08:00" />

        <!-- Button 1: Alege Data -->
        <button 
          type="button" 
          id="btn-trigger-date-sheet"
          class="w-full px-6 py-4 rounded-full border-2 border-brand-secondary bg-transparent text-lg font-bold text-black flex items-center justify-between transition-all active:scale-[0.98] cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="text-lg font-bold text-black" id="display-date-label">Alege data</span>
          </div>
          <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Button 2: Alege Ora -->
        <button 
          type="button" 
          id="btn-trigger-time-sheet"
          class="w-full px-6 py-4 rounded-full border-2 border-brand-secondary bg-transparent text-lg font-bold text-black flex items-center justify-between transition-all active:scale-[0.98] cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-lg font-bold text-black" id="display-time-label">Alege ora</span>
          </div>
          <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>



      <div class="pt-4 pb-2">
        <button type="submit" id="submit-btn" class="w-full py-4 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-xl shadow-md shadow-amber-500/15 active:scale-95 transition-all cursor-pointer">
          Salvează
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Custom Time Picker Sheet (Stil Bottom Sheet identic cu Calendar) -->
<div 
  id="add-session-time-modal" 
  class="fixed inset-x-0 bottom-0 z-[120] bg-surface-card rounded-t-[2.5rem] p-5 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden space-y-4"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-2 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <!-- Modal Header -->
  <div class="flex items-center justify-between pb-2 border-b border-border-subtle/40 px-1">
    <h3 class="text-xl font-black text-text-main font-sans tracking-tight">Alege ora</h3>
    <button type="button" id="btn-close-session-time" class="w-8 h-8 rounded-full bg-surface-base hover:bg-brand-secondary hover:text-white text-text-muted font-bold flex items-center justify-center transition-colors">&times;</button>
  </div>

  <!-- 24H Time Preview Display -->
  <div class="flex items-center justify-center gap-3 py-3.5 bg-surface-base/80 rounded-2xl border border-border-subtle/60 shadow-inner text-text-main font-black text-4xl font-sans tracking-tight">
    <span id="session-hour-display">08</span>
    <span class="text-text-muted/60">:</span>
    <span id="session-minute-display">00</span>
  </div>

  <!-- Quick Hours Grid -->
  <div>
    <div class="grid grid-cols-4 gap-2 max-h-36 overflow-y-auto pr-1" id="session-hours-grid"></div>
  </div>

  <!-- Minutes Selector -->
  <div class="space-y-1.5 pt-1">
    <div class="text-xs font-extrabold text-text-muted font-sans uppercase tracking-wider">Minute</div>
    <div class="grid grid-cols-4 gap-2" id="session-minutes-grid"></div>
  </div>

  <!-- Confirm Button -->
  <div class="pt-2 mt-auto">
    <button type="button" id="btn-confirm-session-time" class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all text-center cursor-pointer">
      Salvează
    </button>
  </div>
</div>
<div id="add-session-time-overlay" class="fixed inset-0 bg-black/40 z-[115] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"></div>

<!-- Custom Date Picker Sheet -->
<div 
  id="custom-date-picker-sheet" 
  class="fixed inset-x-0 bottom-0 z-[110] bg-surface-card rounded-t-[2rem] p-4 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-4 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex items-center justify-between mb-6 px-1">
    <button type="button" id="date-picker-prev" class="w-10 h-10 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center active:scale-95 transition-transform">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <h3 id="date-picker-month-year" class="text-lg font-extrabold tracking-tight">August 2026</h3>
    <button type="button" id="date-picker-next" class="w-10 h-10 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center active:scale-95 transition-transform">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>

  <!-- Weekday labels -->
  <div class="grid grid-cols-7 mb-2">
    {['L','M','M','J','V','S','D'].map(d => (
      <div class="text-center text-xs font-bold text-text-muted uppercase tracking-wider py-2">{d}</div>
    ))}
  </div>

  <!-- Days grid -->
  <div id="date-picker-grid" class="grid grid-cols-7 gap-1 flex-1 overflow-y-auto no-scrollbar">
    <!-- Populated by JS -->
  </div>

  <div class="pt-4 mt-auto">
    <button type="button" id="date-picker-close" class="w-full py-4 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all text-center cursor-pointer">
      Salvează
    </button>
  </div>
</div>
<div id="custom-date-picker-overlay" class="fixed inset-0 bg-black/40 z-[105] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"></div>

<script>
  import { getSettings } from '../../../utils/settings';

  import { getPatients } from '../../../lib/services/patientService';
  import { createAppointment, updateAppointment } from '../../../lib/services/appointmentService';

  class AddSessionSheetManager {
    sheet: HTMLElement | null;
    form: HTMLFormElement | null;
    timeInput: HTMLInputElement | null;
    dateInput: HTMLInputElement | null;
    overlay: HTMLElement | null = null;
    datePickerSheet: HTMLElement | null;
    datePickerOverlay: HTMLElement | null;
    currentPickerDate: Date;
    startY: number;
    currentY: number;
    startX: number = 0;
    dragEngaged: boolean = false;
    scrollAtTop: boolean = true;
    settings: any;
    currentHour: number = 8;
    currentMin: number = 0;
    selectedCustomHour: string = '08';
    selectedCustomMinute: string = '00';
    selectedPatientId: string | null = null;

    constructor() {
      this.sheet = document.getElementById('add-session-sheet');
      this.form = document.getElementById('add-session-form') as HTMLFormElement;
      this.timeInput = document.getElementById('selectedTime') as HTMLInputElement;
      this.dateInput = document.getElementById('selectedDate') as HTMLInputElement;
      this.datePickerSheet = document.getElementById('custom-date-picker-sheet');
      this.datePickerOverlay = document.getElementById('custom-date-picker-overlay');
      this.currentPickerDate = new Date();
      this.selectedCustomHour = '08';
      this.selectedCustomMinute = '00';
      this.startY = 0;
      this.currentY = 0;
      this.settings = getSettings();

      this.createOverlay();
      this.populateDynamicContent();
      this.bindEvents();
      this.bindDateTimeSelectors();
      this.bindDatePicker();
      this.bindCustomTimeModal();
    }
    populateDynamicContent() {
      // Populate time slots
      const timeContainer = document.getElementById('time-slots-container');
      if (timeContainer) {
        timeContainer.innerHTML = '';
        const workStartStr = this.settings?.work_start || this.settings?.schedule?.workStart || '08:00';
        const workEndStr   = this.settings?.work_end   || this.settings?.schedule?.workEnd   || '20:00';

        const startHour = parseInt(workStartStr.split(':')[0], 10) || 8;
        const endHour   = parseInt(workEndStr.split(':')[0], 10)   || 20;
        
        let i = 0;
        for (let h = startHour; h <= endHour; h++) {
          ['00', '30'].forEach(m => {
            if (h === endHour && m !== '00') return;
            const timeStr = `${h.toString().padStart(2, '0')}:${m}`;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.dataset.timeBtn = timeStr;
            btn.className = `shrink-0 flex flex-col items-center justify-center px-2 py-1 transition-all duration-300 ${i === 0 ? 'text-brand-secondary' : 'text-black opacity-70 hover:opacity-100'}`;
            btn.innerHTML = `<span class="text-xl font-extrabold">${timeStr}</span>`;
            timeContainer.appendChild(btn);
            i++;
          });
        }
      }
      this.populatePatients();
    }

    async populatePatients() {
      const patientList = document.getElementById('patient-list');
      if (patientList) {
        patientList.innerHTML = '';
        
        let rawPatients: any[] = [];
        try {
          rawPatients = await getPatients();
        } catch (e) {
          console.error(e);
        }
        
        // Asigură că fiecare pacient apare o SINGURĂ dată (deduplicare după ID)
        const patients = Array.from(new Map(rawPatients.map(p => [p.id, p])).values());

        if (patients.length === 0) {
          patientList.innerHTML = '<div class="p-4 text-center text-sm font-bold text-text-muted bg-black/5 rounded-2xl">Nu s-au găsit pacienți. Te rugăm să adaugi un pacient mai întâi.</div>';
          return;
        }

        patients.forEach((patient: any) => {
          const catName = patient.name;
          const patientId = patient.id;
          const isGhimbav = (patient.locatie || '').toLowerCase() === 'ghimbav';
          
          // Roz pt Ghimbav, Galben pt Belaqva
          const colorClass = isGhimbav 
              ? 'bg-brand-secondary text-white' 
              : 'bg-brand-primary text-black';
          
          const label = document.createElement('label');
          label.className = 'relative cursor-pointer w-full';
          
          label.innerHTML = `
            <input type="radio" name="patientId" value="${patientId}" data-patient-name="${catName}" data-color-class="${colorClass}" class="peer sr-only" />
            <div class="px-6 py-4 rounded-[1.5rem] font-bold text-lg transition-opacity flex items-center justify-between ${colorClass}">
              <span>${catName}</span>
              <div class="w-6 h-6 rounded-full border-2 border-current opacity-0 peer-checked:opacity-100 flex items-center justify-center transition-opacity">
                <div class="w-3 h-3 rounded-full bg-current"></div>
              </div>
            </div>
          `;
          patientList.appendChild(label);
        });

        // Re-bind change listeners for new radios
        const patientRadios = this.form?.querySelectorAll('input[name="patientId"]');
        const settingsContainer = document.getElementById('settings-container');

        patientRadios?.forEach(radio => {
          radio.addEventListener('change', (e: any) => {
            if (e.target.checked) {
              this.selectedPatientId = e.target.value;
              const searchInput = document.getElementById('search-patient-input') as HTMLInputElement;
              if (searchInput) {
                searchInput.value = e.target.getAttribute('data-patient-name') || '';
              }
              const selectedPatientNameSpan = document.getElementById('selected-patient-name');
              if (selectedPatientNameSpan) {
                selectedPatientNameSpan.textContent = e.target.getAttribute('data-patient-name') || 'Pacient';
              }
              
              patientList?.classList.add('hidden');
              patientList?.classList.remove('flex');
              
              settingsContainer?.classList.remove('hidden');
              settingsContainer?.classList.add('flex');
            }
          });
        });
      }
    }

    createOverlay() {
      // Remove any existing overlay to prevent ghost backdrops after SPA navigation
      document.querySelectorAll('.session-sheet-overlay').forEach(o => o.remove());

      this.overlay = document.createElement('div');
      this.overlay.className = 'session-sheet-overlay fixed inset-0 bg-black/40 z-[90] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm';
      document.body.appendChild(this.overlay);

      this.overlay.addEventListener('click', () => this.close());
    }

    updateCustomTimeDisplay(totalMinutes: number) {
      const clamped = Math.max(360, Math.min(1320, totalMinutes));
      const h = Math.floor(clamped / 60);
      const m = clamped % 60;

      this.currentHour = h;
      this.currentMin = m;

      const hourStr = h.toString().padStart(2, '0');
      const minStr = m.toString().padStart(2, '0');
      const fullTimeStr = `${hourStr}:${minStr}`;

      const sliderTimeDisplay = document.getElementById('slider-time-display');
      const badgePreview = document.getElementById('custom-time-badge-preview');
      const displayTime = document.getElementById('display-selected-time');
      const rangeSlider = document.getElementById('time-range-slider') as HTMLInputElement;

      if (sliderTimeDisplay) sliderTimeDisplay.textContent = fullTimeStr;
      if (badgePreview) badgePreview.textContent = fullTimeStr;
      if (displayTime) displayTime.textContent = fullTimeStr;
      if (rangeSlider) rangeSlider.value = clamped.toString();
      if (this.timeInput) this.timeInput.value = fullTimeStr;

      // Update minute chips highlighting
      const minChips = document.querySelectorAll<HTMLButtonElement>('[data-min-chip]');
      minChips.forEach(chip => {
        if (chip.dataset.minChip === minStr) {
          chip.classList.add('bg-black', 'text-white', 'border-black');
          chip.classList.remove('bg-white', 'text-black', 'border-black/5');
        } else {
          chip.classList.remove('bg-black', 'text-white', 'border-black');
          chip.classList.add('bg-white', 'text-black', 'border-black/5');
        }
      });
    }
    
    bindDateTimeSelectors() {
      const dateBtns = document.querySelectorAll<HTMLButtonElement>('[data-date-btn]');
      const timeBtns = document.querySelectorAll<HTMLButtonElement>('[data-time-btn]');
      const nativeDatePicker = document.getElementById('native-date-picker') as HTMLInputElement;
      const otherDateBtn = document.getElementById('other-date-btn');
      
      const nativeTimePicker = document.getElementById('native-time-picker') as HTMLInputElement;
      const timeScrollLeftBtn = document.getElementById('time-scroll-left');
      const timeSlotsContainer = document.getElementById('time-slots-container');

      dateBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          dateBtns.forEach(b => {
            b.classList.remove('text-brand-secondary');
            b.classList.add('text-black', 'opacity-70');
          });
          
          if (otherDateBtn) {
             otherDateBtn.classList.remove('text-brand-secondary');
             otherDateBtn.classList.add('text-black');
          }
          
          btn.classList.add('text-brand-secondary');
          btn.classList.remove('text-black', 'opacity-70');
          
          if (this.dateInput) this.dateInput.value = btn.dataset.dateBtn || '';
          
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
      });
      
      if (nativeDatePicker && otherDateBtn) {
         // Nu mai e nevoie de schimbat selectedVal pt nativeDatePicker (date picker e custom sheet momentan pt alte zile, 
         // dar dacă se folosește native-date-picker, păstrăm logica)
         nativeDatePicker.addEventListener('change', (e: any) => {
             const selectedVal = e.target.value;
             if (!selectedVal) return;
             
             dateBtns.forEach(b => {
                b.classList.remove('text-brand-secondary');
                b.classList.add('text-black', 'opacity-70');
             });
             
             otherDateBtn.classList.add('text-brand-secondary');
             otherDateBtn.classList.remove('text-black');
             
             if (this.dateInput) this.dateInput.value = selectedVal;
             
             otherDateBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
         });
      }

      otherDateBtn?.addEventListener('click', () => {
        this.openDatePicker();
      });

      // ---- TIME SELECTORS LOGIC ----
      
      timeScrollLeftBtn?.addEventListener('click', () => {
        if (timeSlotsContainer) {
          timeSlotsContainer.scrollBy({ left: -100, behavior: 'smooth' });
        }
      });

      timeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          this.selectTime(btn.dataset.timeBtn || '08:00');
        });
      });
    }
    
    selectDate(dateStr: string) {
      if (!dateStr || !this.dateInput) return;
      this.dateInput.value = dateStr;

      const dateLabel = document.getElementById('display-date-label');
      if (dateLabel) {
        const parsed = new Date(dateStr + 'T00:00:00');
        if (!isNaN(parsed.getTime())) {
          const weekday = parsed.toLocaleDateString('ro-RO', { weekday: 'long' });
          const monthName = parsed.toLocaleDateString('ro-RO', { month: 'long' });
          const capitalizedMonth = monthName.charAt(0).toUpperCase() + monthName.slice(1);
          const formatted = `${weekday.charAt(0).toUpperCase() + weekday.slice(1)}, ${parsed.getDate()} ${capitalizedMonth}`;
          dateLabel.textContent = formatted;
        } else {
          dateLabel.textContent = dateStr;
        }
      }
    }

    selectTime(timeStr: string) {
      if (!timeStr || !this.timeInput) return;
      this.timeInput.value = timeStr;

      const timeLabel = document.getElementById('display-time-label');
      if (timeLabel) {
        timeLabel.textContent = timeStr;
      }
    }

    bindDatePicker() {
      const prevBtn = document.getElementById('date-picker-prev');
      const nextBtn = document.getElementById('date-picker-next');
      const closeBtn = document.getElementById('date-picker-close');
      const triggerBtn = document.getElementById('btn-trigger-date-sheet');

      triggerBtn?.addEventListener('click', () => this.openDatePicker());

      prevBtn?.addEventListener('click', () => {
        this.currentPickerDate.setMonth(this.currentPickerDate.getMonth() - 1);
        this.renderDatePicker();
      });

      nextBtn?.addEventListener('click', () => {
        this.currentPickerDate.setMonth(this.currentPickerDate.getMonth() + 1);
        this.renderDatePicker();
      });

      closeBtn?.addEventListener('click', () => this.closeDatePicker());
      this.datePickerOverlay?.addEventListener('click', () => this.closeDatePicker());

      // Swipe-down to close
      let startY = 0;
      this.datePickerSheet?.addEventListener('touchstart', (e: any) => {
        startY = e.touches[0].clientY;
      }, { passive: true });
      this.datePickerSheet?.addEventListener('touchmove', (e: any) => {
        const deltaY = e.touches[0].clientY - startY;
        if (deltaY > 0 && this.datePickerSheet) {
          this.datePickerSheet.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });
      this.datePickerSheet?.addEventListener('touchend', (e: any) => {
        const deltaY = (e.changedTouches[0].clientY || 0) - startY;
        if (this.datePickerSheet) {
          this.datePickerSheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
          if (deltaY > 150) {
            this.closeDatePicker();
          } else {
            this.datePickerSheet.style.transform = 'translateY(0)';
          }
        }
      });
    }

    openDatePicker() {
      const selectedValue = this.dateInput?.value;
      if (selectedValue) {
        const parsed = new Date(selectedValue + 'T00:00:00');
        if (!isNaN(parsed.getTime())) {
          this.currentPickerDate = parsed;
        }
      }
      this.renderDatePicker();
      if (this.datePickerSheet && this.datePickerOverlay) {
        this.datePickerSheet.classList.remove('translate-y-full');
        this.datePickerOverlay.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    closeDatePicker() {
      if (this.datePickerSheet && this.datePickerOverlay) {
        this.datePickerSheet.style.transform = '';
        this.datePickerSheet.classList.add('translate-y-full');
        this.datePickerOverlay.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    renderDatePicker() {
      const grid = document.getElementById('date-picker-grid');
      const monthYear = document.getElementById('date-picker-month-year');
      if (!grid || !monthYear) return;

      const year = this.currentPickerDate.getFullYear();
      const month = this.currentPickerDate.getMonth();
      const monthName = this.currentPickerDate.toLocaleDateString('ro-RO', { month: 'long' });
      monthYear.textContent = `${monthName} ${year}`;

      const firstDayOfMonth = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const startOffset = firstDayOfMonth === 0 ? 6 : firstDayOfMonth - 1; // Monday-first

      const selectedValue = this.dateInput?.value;
      const todayStr = new Date().toISOString().split('T')[0];

      grid.innerHTML = '';

      // Empty cells for offset
      for (let i = 0; i < startOffset; i++) {
        const empty = document.createElement('div');
        grid.appendChild(empty);
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const dateObj = new Date(year, month, d);
        const dayOfWeek = dateObj.getDay();
        const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;

        const dateStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}`;
        const isSelected = dateStr === selectedValue;
        const isToday = dateStr === todayStr;

        const btn = document.createElement('button');
        btn.type = 'button';
        
        if (isWeekend) {
          btn.disabled = true;
          btn.className = 'aspect-square rounded-2xl text-sm font-extrabold bg-black/5 text-black/30 pointer-events-none cursor-not-allowed';
          btn.style.backgroundImage = 'repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(0,0,0,0.06) 4px, rgba(0,0,0,0.06) 8px)';
        } else {
          btn.className = `aspect-square rounded-2xl text-sm font-extrabold transition-all active:scale-95 ${
            isSelected
              ? 'bg-black text-white shadow-lg'
              : isToday
                ? 'bg-brand-primary text-black'
                : 'bg-black/5 text-black hover:bg-black/10'
          }`;
          btn.addEventListener('click', () => {
            this.selectDate(dateStr);
            this.closeDatePicker();
          });
        }
        
        btn.textContent = d.toString();
        grid.appendChild(btn);
      }
    }

    openCustomTimeModal() {
      const modal = document.getElementById('add-session-time-modal');
      const overlay = document.getElementById('add-session-time-overlay');
      if (!modal) return;

      const currentVal = this.timeInput?.value || '08:00';
      const parts = currentVal.split(':');
      this.selectedCustomHour = parts[0] || '08';
      this.selectedCustomMinute = parts[1] || '00';
      
      const hd = document.getElementById('session-hour-display');
      const md = document.getElementById('session-minute-display');
      if (hd) hd.textContent = this.selectedCustomHour;
      if (md) md.textContent = this.selectedCustomMinute;

      this.renderTimeGrids();
      
      modal.classList.remove('translate-y-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
    }

    renderTimeGrids() {
      const hoursGrid = document.getElementById('session-hours-grid');
      const minutesGrid = document.getElementById('session-minutes-grid');
      const hoursList = ['07','08','09','10','11','12','13','14','15','16','17','18'];
      const minutesList = ['00','15','30','45'];

      if (hoursGrid) {
        hoursGrid.innerHTML = '';
        hoursList.forEach(h => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSel = h === this.selectedCustomHour;
          btn.className = `py-2 rounded-xl font-extrabold text-sm transition-all ${
            isSel ? 'bg-brand-secondary text-white shadow-sm scale-105' : 'bg-surface-base hover:bg-brand-primary/30 text-text-main'
          }`;
          btn.textContent = h;
          btn.addEventListener('click', () => {
            this.selectedCustomHour = h;
            const hd = document.getElementById('session-hour-display');
            if (hd) hd.textContent = h;
            this.renderTimeGrids();
          });
          hoursGrid.appendChild(btn);
        });
      }
      
      if (minutesGrid) {
        minutesGrid.innerHTML = '';
        minutesList.forEach(m => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSel = m === this.selectedCustomMinute;
          btn.className = `py-2 rounded-xl font-extrabold text-sm transition-all ${
            isSel ? 'bg-brand-secondary text-white shadow-sm scale-105' : 'bg-surface-base hover:bg-brand-primary/30 text-text-main'
          }`;
          btn.textContent = m;
          btn.addEventListener('click', () => {
            this.selectedCustomMinute = m;
            const md = document.getElementById('session-minute-display');
            if (md) md.textContent = m;
            this.renderTimeGrids();
          });
          minutesGrid.appendChild(btn);
        });
      }
    }

    // --- Custom Time Modal Logic ---
    bindCustomTimeModal() {
      const btnOpen = document.getElementById('btn-open-session-time');
      const btnTimeSheet = document.getElementById('btn-trigger-time-sheet');
      const btnClose = document.getElementById('btn-close-session-time');
      const btnConfirm = document.getElementById('btn-confirm-session-time');
      const modal = document.getElementById('add-session-time-modal');

      const closeModal = () => {
        if (!modal) return;
        const overlay = document.getElementById('add-session-time-overlay');
        modal.style.transform = '';
        modal.classList.add('translate-y-full');
        overlay?.classList.add('opacity-0', 'pointer-events-none');
      };

      if (btnOpen) {
        btnOpen.addEventListener('click', () => this.openCustomTimeModal());
      }
      if (btnTimeSheet) {
        btnTimeSheet.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.openCustomTimeModal();
        });
      }
      if (btnClose) {
        btnClose.addEventListener('click', closeModal);
      }
      const timeOverlay = document.getElementById('add-session-time-overlay');
      if (timeOverlay) {
        timeOverlay.addEventListener('click', closeModal);
      }

      // Swipe down to close for time sheet
      let timeStartY = 0;
      modal?.addEventListener('touchstart', (e: any) => {
        timeStartY = e.touches[0].clientY;
      }, { passive: true });
      modal?.addEventListener('touchmove', (e: any) => {
        const deltaY = e.touches[0].clientY - timeStartY;
        if (deltaY > 0 && modal) {
          modal.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });
      modal?.addEventListener('touchend', (e: any) => {
        const deltaY = (e.changedTouches[0].clientY || 0) - timeStartY;
        if (modal) {
          modal.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
          if (deltaY > 150) {
            closeModal();
          } else {
            modal.style.transform = 'translateY(0)';
          }
        }
      });

      btnConfirm?.addEventListener('click', () => {
        const timeStr = `${this.selectedCustomHour}:${this.selectedCustomMinute}`;
        this.selectTime(timeStr);
        closeModal();
      });
    }

    async handleSubmit(e?: Event) {
      if (e) e.preventDefault();
      
      const formData = this.form ? new FormData(this.form) : null;
      const sessionIdInput = document.getElementById('sessionId') as HTMLInputElement | null;
      const sessionId = sessionIdInput?.value || (formData?.get('sessionId') as string) || '';
      
      const patientRadio = this.form?.querySelector('input[name="patientId"]:checked') as HTMLInputElement | null;
      const patientId = this.selectedPatientId || patientRadio?.value || (formData?.get('patientId') as string) || '';
      
      const timeVal = (document.getElementById('selectedTime') as HTMLInputElement)?.value;
      const dateVal = (document.getElementById('selectedDate') as HTMLInputElement)?.value;

      const selectedTime = timeVal || (formData?.get('selectedTime') as string) || '08:00';
      const selectedDate = dateVal || (formData?.get('selectedDate') as string) || new Date().toISOString().split('T')[0];

      if (!patientId) {
        (window as any).showToast('Te rugăm să selectezi un pacient din listă.', 'warning', 'Pacient neselectat');
        return;
      }

      // Check Lunch Break overlap from settings
      const lunchStart = this.settings?.lunch_start || this.settings?.pause_start || '13:00';
      const lunchEnd = this.settings?.lunch_end || this.settings?.pause_end || '14:00';
      if (selectedTime >= lunchStart && selectedTime < lunchEnd) {
        (window as any).showToast(`Ora ${selectedTime} se suprapune cu pauza de masă (${lunchStart} - ${lunchEnd}).`, 'warning', 'Pauză de masă');
        return;
      }

      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Se salvează…';
      }

      try {
        if (sessionId) {
          await updateAppointment(sessionId, {
            pacient_id: patientId,
            data: selectedDate,
            ora: selectedTime,
          });
          (window as any).showToast('Programarea a fost modificată cu succes.', 'success');
        } else {
          await createAppointment({
            pacient_id: patientId,
            data: selectedDate,
            ora: selectedTime,
          });
          (window as any).showToast('Programarea a fost salvată cu succes.', 'success');
        }

        window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        this.close();
      } catch (err: any) {
        (window as any).showToast('Eroare la salvarea programării: ' + (err.message || err), 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = sessionId ? 'Salvează Modificările' : 'Salvează programarea';
        }
      }
    }
    bindEvents() {
      if (!this.sheet) return;

      // Swipe-down to dismiss from anywhere on the sheet — only engages on a
      // clearly vertical downward swipe while the form is scrolled to the top
      this.sheet.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      this.sheet.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      this.sheet.addEventListener('touchend', () => this.handleTouchEnd());

      // Listen for custom event to open sheet
      if (!(window as any)._addSessionWindowListenerBound) {
        window.addEventListener('openAddSession', async (e: any) => {
          await this.populatePatients(); // Ensure patient list is up to date

          const detail = e.detail || {};
          const isEdit = !!detail.isEdit;
          const session = detail.session;
          const showDateTime = !!detail.showDateTime || isEdit;
          const timeStr = detail.time || session?.selectedTime || '08:00';
          const dateStr = detail.date || session?.selectedDate;
          const patientName = detail.patientName || session?.patientName;

          const titleEl = document.getElementById('sheet-title');
          const submitBtnEl = document.getElementById('submit-btn');
          const sessionIdInput = document.getElementById('sessionId') as HTMLInputElement;
          const dateTimeContainer = document.getElementById('date-time-selectors');

          if (sessionIdInput) {
            sessionIdInput.value = isEdit && session ? session.id : '';
          }

          if (isEdit) {
            if (titleEl) titleEl.textContent = 'Editează programarea';
            if (submitBtnEl) submitBtnEl.textContent = 'Salvează Modificările';
          } else {
            if (titleEl) titleEl.textContent = 'Programare nouă';
            if (submitBtnEl) submitBtnEl.textContent = 'Salvează';
          }

        // Keep Date & Time selectors visible so user can always see and change selected hour
        dateTimeContainer?.classList.remove('hidden');

        if (isEdit) {
          if (timeStr) this.selectTime(timeStr);
          if (dateStr) this.selectDate(dateStr);
        } else {
          // Reset labels to default on new appointment
          const dateLabel = document.getElementById('display-date-label');
          const timeLabel = document.getElementById('display-time-label');
          if (dateLabel) dateLabel.textContent = 'Alege data';
          if (timeLabel) timeLabel.textContent = 'Alege ora';
          if (this.dateInput && dateStr) this.dateInput.value = dateStr;
          if (this.timeInput && timeStr) this.timeInput.value = timeStr;
        }

        // Reset patient selector state
        const pList = document.getElementById('patient-list');
        const searchInput = document.getElementById('search-patient-input') as HTMLInputElement;
        const settingsContainer = document.getElementById('settings-container');

        const patientRadios = this.form?.querySelectorAll('input[name="patientId"]') as NodeListOf<HTMLInputElement>;
        patientRadios?.forEach(r => r.checked = false);
        this.selectedPatientId = null;

        if (patientName) {
          const matchingRadio = Array.from(patientRadios || []).find(r =>
            r.getAttribute('data-patient-name') === patientName || r.value === patientName
          );
          if (matchingRadio) {
            matchingRadio.checked = true;
            this.selectedPatientId = matchingRadio.value;
            matchingRadio.dispatchEvent(new Event('change'));
          }
        } else {
          if (searchInput) searchInput.value = '';
          if (pList) {
            pList.classList.add('hidden');
            pList.classList.remove('flex');
          }
          if (settingsContainer) {
            settingsContainer.classList.add('hidden');
            settingsContainer.classList.remove('flex');
          }
        }

        if (isEdit && session) {
          const recurringCb = this.form?.querySelector('input[name="recurring"]') as HTMLInputElement;
          const reminderCb = this.form?.querySelector('input[name="reminder"]') as HTMLInputElement;
          if (recurringCb) recurringCb.checked = !!session.recurring;
          if (reminderCb) reminderCb.checked = !!session.reminder;
        }

        this.open();
      });
      (window as any)._addSessionWindowListenerBound = true;
      }

      // Bind submit handlers
      const submitBtnEl = document.getElementById('submit-btn');
      if (this.form) {
        this.form.onsubmit = (e) => this.handleSubmit(e);
      }
      if (submitBtnEl) {
        submitBtnEl.onclick = (e) => {
          e.preventDefault();
          this.handleSubmit(e);
        };
      }

      // Handle showing patient list and search input
      const patientList = document.getElementById('patient-list');
      const searchPatientInput = document.getElementById('search-patient-input') as HTMLInputElement | null;

      searchPatientInput?.addEventListener('focus', () => {
        patientList?.classList.remove('hidden');
        patientList?.classList.add('flex');
      });

      searchPatientInput?.addEventListener('input', (e: any) => {
        const query = e.target.value.toLowerCase().trim();
        patientList?.classList.remove('hidden');
        patientList?.classList.add('flex');
        
        const labels = patientList?.querySelectorAll('label');
        labels?.forEach((label) => {
          const radio = label.querySelector('input[type="radio"]') as HTMLInputElement | null;
          const patientName = (radio?.getAttribute('data-patient-name') || '').toLowerCase();
          if (!query || patientName.includes(query)) {
            label.classList.remove('hidden');
          } else {
            label.classList.add('hidden');
          }
        });
      });
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.classList.remove('translate-y-full');
      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    close() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.style.transform = '';
      this.sheet.classList.add('translate-y-full');
      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      
      // Reset form
      setTimeout(() => this.form?.reset(), 500);
    }

    handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;
      // Only allow sheet drag when the scrollable form is at the top,
      // otherwise the gesture should scroll the form instead
      const scrollArea = this.sheet?.querySelector('.overflow-y-auto');
      this.scrollAtTop = !scrollArea || scrollArea.scrollTop <= 0;
    }

    handleTouchMove(e: TouchEvent) {
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        if (this.scrollAtTop && deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.sheet) this.sheet.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.sheet) {
        if (e.cancelable) {
          e.preventDefault();
        }
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.sheet || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      this.sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
      
      if (deltaY > 150) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }
  }

  let globalAddSessionSheetManager: AddSessionSheetManager | null = null;
  
  // Initialize
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('add-session-sheet')) return;
    
    if (!globalAddSessionSheetManager) {
      globalAddSessionSheetManager = new AddSessionSheetManager();
    } else {
      // Re-bind DOM elements if they changed
      globalAddSessionSheetManager.sheet = document.getElementById('add-session-sheet');
      globalAddSessionSheetManager.form = document.getElementById('add-session-form') as HTMLFormElement;
      globalAddSessionSheetManager.timeInput = document.getElementById('selectedTime') as HTMLInputElement;
      globalAddSessionSheetManager.dateInput = document.getElementById('selectedDate') as HTMLInputElement;
      globalAddSessionSheetManager.datePickerSheet = document.getElementById('custom-date-picker-sheet');
      globalAddSessionSheetManager.datePickerOverlay = document.getElementById('custom-date-picker-overlay');
      globalAddSessionSheetManager.createOverlay();
      globalAddSessionSheetManager.populateDynamicContent();
      globalAddSessionSheetManager.bindEvents();
      globalAddSessionSheetManager.bindDateTimeSelectors();
      globalAddSessionSheetManager.bindDatePicker();
      globalAddSessionSheetManager.bindCustomTimeModal();
    }
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

