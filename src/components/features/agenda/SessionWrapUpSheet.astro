---
// SessionWrapUpSheet.astro — Pop-up inteligent la confirmarea unei ședințe
---

<div id="session-wrapup-sheet" data-sheet-root class="fixed inset-0 z-[120] pointer-events-none">
  <div id="session-wrapup-backdrop" class="absolute inset-0 bg-black/50 pointer-events-auto transition-opacity duration-300 opacity-0"></div>
  
  <div id="session-wrapup-content" class="absolute bottom-0 left-0 right-0 bg-surface-card rounded-t-[2.5rem] p-6 pb-safe pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] max-h-[90vh] overflow-y-auto border-t border-transparent">
    <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 cursor-grab active:cursor-grabbing" id="wrapup-drag-handle"></div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-text-main">Finalizează ședința</h2>
        <p class="text-text-muted font-bold text-sm mt-0.5" id="wrapup-subtitle">Confirmă detaliile și programează săptămâna viitoare</p>
      </div>
    </div>
    <!-- Patient & Session Summary Card (Lean & Essential) -->
    <div class="mb-5 bg-neutral-100/90 p-4 rounded-2xl border border-transparent relative">
      <!-- Content -->
      <div id="wrapup-summary-content" class="flex items-center justify-between">
        <div>
          <div class="font-black text-neutral-900 text-base sm:text-lg" id="wrapup-patient-name">Se încarcă…</div>
          <div class="text-neutral-900 font-extrabold text-sm sm:text-base mt-1" id="wrapup-session-details">
            Ședința de azi • 08:00
          </div>
        </div>
        <div class="text-right">
          <div class="text-[11px] font-black uppercase tracking-wider text-neutral-800">Ședințe</div>
          <div class="text-base font-black text-rose-600 leading-tight" id="wrapup-session-count">-- / --</div>
        </div>
      </div>
    </div>

    <!-- Subscription Alert (if total sessions reached or near end) -->
    <div id="wrapup-subscription-alert" class="hidden mb-5 p-3.5 rounded-2xl bg-amber-50 border border-transparent text-amber-900 text-xs sm:text-sm font-bold flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Abonament completat!</span>
      </div>
      <button type="button" id="btn-renew-package" class="px-3 py-1.5 rounded-xl bg-amber-400 text-black font-black text-xs shadow-sm hover:brightness-105 active:scale-95 transition-all">
        + Reînnoiește
      </button>
    </div>

    <!-- Section 1: Next Week Recurrence Selection (Lean) -->
    <div class="space-y-3 mb-6">
      <label class="block text-sm sm:text-base font-black text-neutral-900">
        Programezi și săptămâna viitoare?
      </label>
      
      <div class="grid grid-cols-1 gap-2.5" id="recurrence-options-container">
        <!-- Option A: Same day & time next week (DEFAULT) -->
        <button 
          type="button" 
          data-recurrence-option="same" 
          class="w-full p-4 rounded-2xl border-2 border-rose-500 bg-rose-500/10 text-neutral-900 font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full border-2 border-rose-500 bg-rose-500 flex items-center justify-center text-white shrink-0">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="text-left">
              <div class="font-black text-sm sm:text-base text-neutral-900" id="wrapup-same-slot-label">Da, marți viitoare la 08:00</div>
              <div class="text-xs font-bold text-neutral-500 mt-0.5" id="wrapup-same-slot-date">+7 zile mai târziu</div>
            </div>
          </div>
        </button>

        <!-- Option B: Pick custom day/time for next week -->
        <button 
          type="button" 
          data-recurrence-option="custom" 
          class="w-full p-4 rounded-2xl border border-transparent bg-neutral-50 hover:bg-neutral-100 text-neutral-900 font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full border-2 border-neutral-300 flex items-center justify-center shrink-0">
              <div class="w-2 h-2 rounded-full bg-transparent"></div>
            </div>
            <div class="text-left">
              <div class="font-black text-sm sm:text-base text-neutral-900">Altă zi / altă oră</div>
            </div>
          </div>
        </button>

        <!-- Option C: Do not schedule for next week -->
        <button 
          type="button" 
          data-recurrence-option="none" 
          class="w-full p-4 rounded-2xl border border-transparent bg-neutral-50 hover:bg-neutral-100 text-neutral-900 font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full border-2 border-neutral-300 flex items-center justify-center shrink-0">
              <div class="w-2 h-2 rounded-full bg-transparent"></div>
            </div>
            <div class="text-left">
              <div class="font-black text-sm sm:text-base text-neutral-900">Nu, doar confirmă</div>
            </div>
          </div>
        </button>
      </div>
    </div>

    <!-- Custom Date/Time Selectors (Hidden by default, shown if Custom option selected) -->
    <div id="wrapup-custom-datetime-box" class="hidden mb-6 p-4 rounded-2xl bg-surface-base border border-transparent space-y-3">
      <div class="text-xs font-black uppercase text-text-muted">Alege data și ora pentru săptămâna viitoare</div>
      <div class="grid grid-cols-2 gap-3">
        <button type="button" id="wrapup-trigger-date" class="text-left px-3 py-2.5 rounded-xl border border-transparent bg-white font-bold text-sm text-text-main focus:outline-none focus:border-transparent active:scale-[0.98] transition-transform">
          <span class="block text-[10px] font-bold text-text-muted uppercase tracking-wider mb-0.5">Data</span>
          <span id="wrapup-display-date">--</span>
        </button>
        <button type="button" id="wrapup-trigger-time" class="text-left px-3 py-2.5 rounded-xl border border-transparent bg-white font-bold text-sm text-text-main focus:outline-none focus:border-transparent active:scale-[0.98] transition-transform">
          <span class="block text-[10px] font-bold text-text-muted uppercase tracking-wider mb-0.5">Ora</span>
          <span id="wrapup-display-time">08:00</span>
        </button>
      </div>
      <input type="hidden" id="wrapup-custom-time" value="08:00" />
      <input type="hidden" id="wrapup-custom-date" />
    </div>
    

    <!-- Submit Action Button (Without Check Icon) -->
    <div class="pt-4">
      <button 
        type="button" 
        id="btn-confirm-wrapup" 
        class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-lg shadow-md shadow-amber-500/15 active:scale-[0.98] transition-all flex items-center justify-center cursor-pointer"
      >
        <span>Confirmă ședința</span>
      </button>
    </div>
  </div>

  <!-- Custom Date Picker Sheet -->
  <div 
    id="wrapup-date-picker-sheet" 
    data-sheet-root
    class="fixed inset-x-0 bottom-0 z-[130] bg-surface-card rounded-t-[2rem] p-4 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden pointer-events-auto"
  >
    <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-4 shrink-0 cursor-grab active:cursor-grabbing"></div>
    <div class="flex items-center justify-between mb-6 px-1">
      <button type="button" id="wrapup-date-prev" class="w-10 h-10 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center active:scale-95 transition-transform">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <h3 id="wrapup-date-month-year" class="text-lg font-extrabold tracking-tight">August 2026</h3>
      <button type="button" id="wrapup-date-next" class="w-10 h-10 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center active:scale-95 transition-transform">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
    <div class="grid grid-cols-7 mb-2">
      {['L','M','M','J','V','S','D'].map(d => (
        <div class="text-center text-xs font-bold text-text-muted uppercase tracking-wider py-2">{d}</div>
      ))}
    </div>
    <div id="wrapup-date-grid" class="grid grid-cols-7 gap-1 flex-1 overflow-y-auto"></div>
    <div class="pt-4 mt-auto">
      <button type="button" id="wrapup-date-close" class="w-full py-4 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all text-center cursor-pointer">
        Salvează
      </button>
    </div>
  </div>
  <div id="wrapup-date-picker-overlay" class="fixed inset-0 bg-black/40 z-[125] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"></div>

  <!-- Custom Time Picker Sheet -->
  <div 
    id="wrapup-time-picker-sheet" 
    data-sheet-root
    class="fixed inset-x-0 bottom-0 z-[130] bg-surface-card rounded-t-[2.5rem] p-5 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden space-y-4 pointer-events-auto"
  >
    <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-2 shrink-0 cursor-grab active:cursor-grabbing"></div>
    <div class="flex items-center justify-between pb-2 border-b border-transparent px-1">
      <h3 class="text-xl font-black text-text-main font-sans tracking-tight">Alege ora</h3>
    </div>
    <div class="flex items-center justify-center gap-3 py-3.5 bg-surface-base/80 rounded-2xl border border-transparent shadow-inner text-text-main font-black text-4xl font-sans tracking-tight">
      <span id="wrapup-time-hour">08</span>
      <span class="text-text-muted/60">:</span>
      <span id="wrapup-time-minute">00</span>
    </div>
    <div>
      <div class="grid grid-cols-4 gap-2 py-2" id="wrapup-time-hours-grid"></div>
    </div>
    <div class="space-y-1.5 pt-1">
      <div class="text-xs font-extrabold text-text-muted font-sans uppercase tracking-wider">Minute</div>
      <div class="grid grid-cols-4 gap-2" id="wrapup-time-minutes-grid"></div>
    </div>
    <div class="pt-2 mt-auto">
      <button type="button" id="wrapup-time-confirm" class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all text-center cursor-pointer">
        Salvează
      </button>
    </div>
  </div>
  <div id="wrapup-time-picker-overlay" class="fixed inset-0 bg-black/40 z-[125] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"></div>
</div>

<script>
  import { completeSession, createAppointment } from '../../../lib/services/appointmentService';
  import { getPatient, resetPatientSubscription } from '../../../lib/services/patientService';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';
  import { toLocalISOString } from '../../../utils/date';

  class WrapUpSheetManager {
    private sheet: HTMLElement | null;
    private backdrop: HTMLElement | null;
    private content: HTMLElement | null;

    private currentAppointment: any = null;
    private selectedRecurrence: 'same' | 'custom' | 'none' = 'same';

    private nextWeekDateStr: string = '';
    private nextWeekDayName: string = '';
    private pickerMonth: Date = new Date();
    private selectedCustomDateStr: string = '';
    private selectedCustomHour: string = '08';
    private selectedCustomMinute: string = '00';
    private selectedCustomTimeStr: string = '08:00';

    private customDate: string = '';
    private customTime: string = '08:00';
    private pickerDate: Date = new Date();
    private selectedHour: string = '08';
    private selectedMinute: string = '00';

    constructor() {
      this.reconnect();
      this.bindEvents();
    }

    reconnect() {
      this.sheet = document.getElementById('session-wrapup-sheet');
      this.backdrop = document.getElementById('session-wrapup-backdrop');
      this.content = document.getElementById('session-wrapup-content');
      this.bindSheetSwipe();
      this.bindPickerSwipe('wrapup-date-picker-sheet', () => this.closeDatePicker());
      this.bindPickerSwipe('wrapup-time-picker-sheet', () => this.closeTimePicker());
    }

    private bindEvents() {
      window.addEventListener('openWrapUp', ((e: CustomEvent) => {
        if (e.detail?.appointment) {
          this.currentAppointment = e.detail.appointment;
          this.initView();
          this.open();
        }
      }) as EventListener);

      // Use document delegation so clicks keep working after Astro view transitions
      // and even if the persisted sheet element is replaced.
      document.addEventListener('click', (e) => this.handleDocumentClick(e));

      // Swipe-down to close main wrap-up sheet
      this.bindSheetSwipe();

      // Swipe-down to close pickers
      this.bindPickerSwipe('wrapup-date-picker-sheet', () => this.closeDatePicker());
      this.bindPickerSwipe('wrapup-time-picker-sheet', () => this.closeTimePicker());
    }

    private handleDocumentClick(e: MouseEvent) {
      const target = e.target as HTMLElement;
      if (!target) return;

      if (target.closest('#btn-confirm-wrapup')) {
        e.stopPropagation();
        this.handleConfirm();
        return;
      }

      if (target.closest('#wrapup-close-btn')) {
        e.stopPropagation();
        this.close();
        return;
      }

      const recurBtn = target.closest('[data-recurrence-option]') as HTMLElement | null;
      if (recurBtn) {
        const opt = recurBtn.getAttribute('data-recurrence-option') as 'same' | 'custom' | 'none';
        this.setRecurrenceOption(opt);
        return;
      }

      if (target.closest('#btn-renew-package')) {
        e.stopPropagation();
        this.handleRenewPackage();
        return;
      }

      if (target.closest('#wrapup-trigger-date')) {
        this.openDatePicker();
        return;
      }

      if (target.closest('#wrapup-trigger-time')) {
        this.openTimePicker();
        return;
      }

      if (target.closest('#wrapup-date-prev')) {
        this.pickerDate.setMonth(this.pickerDate.getMonth() - 1);
        this.renderDatePicker();
        return;
      }

      if (target.closest('#wrapup-date-next')) {
        this.pickerDate.setMonth(this.pickerDate.getMonth() + 1);
        this.renderDatePicker();
        return;
      }

      if (target.closest('#wrapup-date-close') || target.closest('#wrapup-date-picker-overlay')) {
        this.closeDatePicker();
        return;
      }

      if (target.closest('#wrapup-time-confirm') || target.closest('#wrapup-time-picker-overlay')) {
        this.closeTimePicker();
        return;
      }

      if (target.closest('#session-wrapup-backdrop')) {
        this.close();
        return;
      }
    }

    private async handleRenewPackage() {
      if (!this.currentAppointment?.pacient_id && !this.currentAppointment?.pacienti?.id) return;
      const patientId = this.currentAppointment.pacient_id || this.currentAppointment.pacienti?.id;
      const patientName = this.currentAppointment.pacienti ? `${this.currentAppointment.pacienti.prenume || ''} ${this.currentAppointment.pacienti.nume || ''}`.trim() : this.currentAppointment.patientName;
      const total = this.currentAppointment.pacienti?.sedinte_total || 10;
      
      // Open RenewalSheet on top of the current confirm card
      window.dispatchEvent(new CustomEvent('openRenewalSheet', {
        detail: {
          patientId,
          currentTotal: total,
          patientName
        }
      }));
    }

    private async initView() {
      if (!this.currentAppointment) return;

      const appt = this.currentAppointment;
      const patientName = appt.pacienti ? `${appt.pacienti.prenume || ''} ${appt.pacienti.nume || ''}`.trim() : (appt.patientName || 'Pacient');
      const timeStr = appt.ora || appt.selectedTime || '08:00';
      const dateStr = appt.data || appt.selectedDate || toLocalISOString(new Date());

      const cleanTime = (timeStr || '08:00').substring(0, 5);

      // Calculate next week date (+7 days) safely with toLocalISOString
      const currentDateObj = new Date(dateStr + 'T00:00:00');
      const nextWeekObj = new Date(currentDateObj);
      nextWeekObj.setDate(nextWeekObj.getDate() + 7);

      this.nextWeekDateStr = toLocalISOString(nextWeekObj);
      const dayName = nextWeekObj.toLocaleDateString('ro-RO', { weekday: 'long' });
      this.nextWeekDayName = dayName.charAt(0).toUpperCase() + dayName.slice(1);

      const nextWeekMonthFull = nextWeekObj.toLocaleDateString('ro-RO', { month: 'long' });
      const formattedNextDate = `${this.nextWeekDayName}, ${nextWeekObj.getDate()} ${nextWeekMonthFull}, ora ${cleanTime}`;

      // Populate UI
      const nameEl = document.getElementById('wrapup-patient-name');
      const detailsEl = document.getElementById('wrapup-session-details');
      const countEl = document.getElementById('wrapup-session-count');
      const sameSlotLabel = document.getElementById('wrapup-same-slot-label');
      const sameSlotDate = document.getElementById('wrapup-same-slot-date');

      const sessionDateObj = new Date(dateStr + 'T00:00:00');
      const sessionDayFull = sessionDateObj.toLocaleDateString('ro-RO', { weekday: 'long' });
      const sessionDayCapitalized = sessionDayFull.charAt(0).toUpperCase() + sessionDayFull.slice(1);
      const sessionMonthFull = sessionDateObj.toLocaleDateString('ro-RO', { month: 'long' });
      const sessionDateFormatted = `${sessionDayCapitalized}, ${sessionDateObj.getDate()} ${sessionMonthFull}, ora ${cleanTime}`;

      if (nameEl) nameEl.textContent = patientName;
      if (detailsEl) detailsEl.textContent = sessionDateFormatted;
      
      const folosite = (appt.pacienti?.sedinte_folosite ?? 0) + 1; // including today
      const total = appt.pacienti?.sedinte_total || 10;
      if (countEl) countEl.textContent = `${folosite} / ${total}`;

      if (sameSlotLabel) sameSlotLabel.textContent = 'Da, peste o săptămână';
      if (sameSlotDate) sameSlotDate.textContent = formattedNextDate;

      // Set custom date/time defaults to next week
      this.customDate = this.nextWeekDateStr;
      this.customTime = timeStr;
      [this.selectedHour, this.selectedMinute] = timeStr.split(':');
      this.pickerDate = new Date(this.nextWeekDateStr + 'T00:00:00');
      this.updateCustomDateTimeDisplay();

      // Show subscription warning if needed
      const alertEl = document.getElementById('wrapup-subscription-alert');
      if (alertEl) {
        if (folosite >= total) {
          alertEl.classList.remove('hidden');
        } else {
          alertEl.classList.add('hidden');
        }
      }

      // Default option is ALWAYS "Da, peste o săptămână"
      this.setRecurrenceOption('same');

      // Reset submit button state so it works on every open
      const btnConfirm = document.getElementById('btn-confirm-wrapup') as HTMLButtonElement | null;
      if (btnConfirm) {
        btnConfirm.disabled = false;
        btnConfirm.textContent = 'Confirmă ședința';
      }

    }

    private setRecurrenceOption(option: 'same' | 'custom' | 'none') {
      this.selectedRecurrence = option;

      const container = document.getElementById('recurrence-options-container');
      const customBox = document.getElementById('wrapup-custom-datetime-box');
      if (!container) return;

      const buttons = container.querySelectorAll<HTMLButtonElement>('[data-recurrence-option]');
      buttons.forEach(btn => {
        const opt = btn.getAttribute('data-recurrence-option');
        const isSel = opt === option;
        const iconContainer = btn.querySelector('.rounded-full');

        if (isSel) {
          btn.className = 'w-full p-4 rounded-2xl border-2 border-brand-secondary bg-brand-secondary/10 text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]';
          if (iconContainer) {
            iconContainer.className = 'w-5 h-5 rounded-full border-2 border-brand-secondary bg-brand-secondary flex items-center justify-center text-white shrink-0';
            iconContainer.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>';
          }
        } else {
          btn.className = 'w-full p-4 rounded-2xl border border-transparent bg-surface-base/50 hover:bg-surface-base text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]';
          if (iconContainer) {
            iconContainer.className = 'w-5 h-5 rounded-full border-2 border-text-muted/40 flex items-center justify-center shrink-0';
            iconContainer.innerHTML = '<div class="w-2 h-2 rounded-full bg-transparent"></div>';
          }
        }
      });

      if (customBox) {
        if (option === 'custom') {
          customBox.classList.remove('hidden');
        } else {
          customBox.classList.add('hidden');
        }
      }
    }

    private async handleConfirm() {
      if (!this.currentAppointment) return;

      const btnConfirm = document.getElementById('btn-confirm-wrapup') as HTMLButtonElement | null;
      if (btnConfirm) {
        btnConfirm.disabled = true;
        btnConfirm.textContent = 'Se procesează…';
      }

      const appt = this.currentAppointment;
      const patientId = appt.pacient_id || appt.pacienti?.id;

      try {
        // 1. Confirm current session
        let sessionCompleted = false;
        try {
          await completeSession(appt.id);
          sessionCompleted = true;
          (window as any).showToast('Ședința a fost marcată ca efectuată!', 'success');
        } catch (err: any) {
          throw new Error('Eroare la finalizare: ' + (err?.message || err));
        }

        // Event must be dispatched if session completed, even if next steps fail
        if (sessionCompleted) {
          window.dispatchEvent(new CustomEvent('sessionsUpdated'));
          window.dispatchEvent(new CustomEvent('patientsUpdated'));
        }

        // Fetch fresh patient info to get updated session count after completeSession
        let freshPatient: any = null;
        try {
          if (patientId) {
            freshPatient = await getPatient(patientId);
          }
        } catch (e) {
          console.warn('Could not fetch fresh patient:', e);
        }

        const folosite = freshPatient ? freshPatient.sedinte_folosite : ((appt.pacienti?.sedinte_folosite ?? 0) + 1);
        const total = freshPatient ? freshPatient.sedinte_total : (appt.pacienti?.sedinte_total || 10);
        const isSubscriptionDone = folosite >= total;

        // 2. Check if subscription is complete and user wants to schedule next week
        if (isSubscriptionDone && this.selectedRecurrence !== 'none') {
          const targetDate = this.selectedRecurrence === 'same' ? this.nextWeekDateStr : (this.customDate || this.nextWeekDateStr);
          const targetTime = this.selectedRecurrence === 'same' ? (appt.ora || appt.selectedTime || '08:00') : (this.customTime || '08:00');
          const locatie = (appt.location || appt.pacienti?.locatie || 'Belaqva') as 'Belaqva' | 'Ghimbav';
          const patientName = freshPatient ? freshPatient.name : (appt.pacienti ? `${appt.pacienti.prenume || ''} ${appt.pacienti.nume || ''}`.trim() : (appt.patientName || 'Pacient'));

          // Close wrapup sheet cleanly so it doesn't linger behind RenewalSheet
          this.close();

          // Open RenewalSheet on top
          window.dispatchEvent(new CustomEvent('openRenewalSheet', {
            detail: {
              patientId,
              currentTotal: total,
              patientName,
              pendingAppointment: {
                data: targetDate,
                ora: targetTime,
                locatie: locatie
              }
            }
          }));
          (window as any).showToast('Abonament completat! Reînnoiește pachetul pentru a confirma programarea viitoare.', 'warning');

          return;
        }

        // 3. Schedule next week session if subscription still active
        if (this.selectedRecurrence === 'same') {
          const timeStr = appt.ora || appt.selectedTime || '08:00';
          const locatie = appt.location || appt.pacienti?.locatie || 'Belaqva';
          await createAppointment({
            pacient_id: patientId,
            data: this.nextWeekDateStr,
            ora: timeStr,
            locatie: locatie as 'Belaqva' | 'Ghimbav',
          });
          (window as any).showToast(`S-a programat automat ${this.nextWeekDayName} viitoare la ${timeStr}!`, 'success');
        } else if (this.selectedRecurrence === 'custom') {
          const targetDate = this.customDate || this.nextWeekDateStr;
          const targetTime = this.customTime || '08:00';
          const locatie = appt.location || appt.pacienti?.locatie || 'Belaqva';
          await createAppointment({
            pacient_id: patientId,
            data: targetDate,
            ora: targetTime,
            locatie: locatie as 'Belaqva' | 'Ghimbav',
          });
          (window as any).showToast(`Noua programare a fost creată pe ${targetDate} la ${targetTime}!`, 'success');
        }

        this.close();
      } catch (err: any) {
        (window as any).showToast('Eroare: ' + (err?.message || err), 'error');
      } finally {
        if (btnConfirm) {
          btnConfirm.disabled = false;
          btnConfirm.textContent = 'Confirmă ședința';
        }
      }
    }

    // --- Custom Date Picker ---
    private openDatePicker() {
      const sheet = document.getElementById('wrapup-date-picker-sheet');
      const overlay = document.getElementById('wrapup-date-picker-overlay');
      if (!sheet || !overlay) return;

      const parsed = new Date(this.customDate + 'T00:00:00');
      if (!isNaN(parsed.getTime())) {
        this.pickerDate = parsed;
      }
      this.renderDatePicker();
      sheet.dataset.open = 'true';
      sheet.classList.add('translate-y-full');
      void sheet.offsetWidth;
      sheet.classList.remove('translate-y-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    private closeDatePicker() {
      const sheet = document.getElementById('wrapup-date-picker-sheet');
      const overlay = document.getElementById('wrapup-date-picker-overlay');
      if (!sheet || !overlay) return;
      sheet.style.transform = '';
      sheet.classList.add('translate-y-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        sheet.dataset.open = 'false';
      }, 500);
    }

    private renderDatePicker() {
      const grid = document.getElementById('wrapup-date-grid');
      const monthYear = document.getElementById('wrapup-date-month-year');
      if (!grid || !monthYear) return;

      const year = this.pickerDate.getFullYear();
      const month = this.pickerDate.getMonth();
      const monthName = this.pickerDate.toLocaleDateString('ro-RO', { month: 'long' });
      monthYear.textContent = `${monthName} ${year}`;

      const firstDayOfMonth = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const startOffset = firstDayOfMonth === 0 ? 6 : firstDayOfMonth - 1;
      const todayStr = new Date().toISOString().split('T')[0];

      grid.innerHTML = '';

      for (let i = 0; i < startOffset; i++) {
        grid.appendChild(document.createElement('div'));
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const dateObj = new Date(year, month, d);
        const dayOfWeek = dateObj.getDay();
        const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
        const dateStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}`;
        const isSelected = dateStr === this.customDate;
        const isToday = dateStr === todayStr;

        const btn = document.createElement('button');
        btn.type = 'button';

        if (isWeekend) {
          btn.disabled = true;
          btn.className = 'aspect-square rounded-2xl text-sm font-extrabold bg-black/5 text-black/30 pointer-events-none cursor-not-allowed';
          btn.style.backgroundImage = 'repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(0,0,0,0.06) 4px, rgba(0,0,0,0.06) 8px)';
        } else {
          btn.className = `aspect-square rounded-2xl text-sm font-extrabold transition-all active:scale-95 ${
            isSelected
              ? 'bg-black text-white shadow-lg'
              : isToday
                ? 'bg-brand-primary text-black'
                : 'bg-black/5 text-black hover:bg-black/10'
          }`;
          btn.addEventListener('click', () => {
            this.customDate = dateStr;
            this.updateCustomDateTimeDisplay();
            this.renderDatePicker();
          });
        }

        btn.textContent = d.toString();
        grid.appendChild(btn);
      }
    }

    // --- Custom Time Picker ---
    private openTimePicker() {
      const sheet = document.getElementById('wrapup-time-picker-sheet');
      const overlay = document.getElementById('wrapup-time-picker-overlay');
      if (!sheet || !overlay) return;

      const parts = this.customTime.split(':');
      this.selectedHour = parts[0] || '08';
      this.selectedMinute = parts[1] || '00';

      const hourEl = document.getElementById('wrapup-time-hour');
      const minuteEl = document.getElementById('wrapup-time-minute');
      if (hourEl) hourEl.textContent = this.selectedHour;
      if (minuteEl) minuteEl.textContent = this.selectedMinute;

      this.renderTimeGrids();
      sheet.dataset.open = 'true';
      sheet.classList.add('translate-y-full');
      void sheet.offsetWidth;
      sheet.classList.remove('translate-y-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    private closeTimePicker() {
      const sheet = document.getElementById('wrapup-time-picker-sheet');
      const overlay = document.getElementById('wrapup-time-picker-overlay');
      if (!sheet || !overlay) return;
      this.customTime = `${this.selectedHour}:${this.selectedMinute}`;
      this.updateCustomDateTimeDisplay();
      sheet.style.transform = '';
      sheet.classList.add('translate-y-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        sheet.dataset.open = 'false';
      }, 500);
    }

    private bindPickerSwipe(sheetId: string, onClose: () => void) {
      const sheet = document.getElementById(sheetId);
      if (!sheet) return;

      let startY = 0;
      sheet.addEventListener('touchstart', (e: any) => {
        startY = e.touches[0].clientY;
      }, { passive: true });
      sheet.addEventListener('touchmove', (e: any) => {
        const deltaY = e.touches[0].clientY - startY;
        if (deltaY > 0) {
          sheet.style.transition = 'none';
          sheet.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });
      sheet.addEventListener('touchend', (e: any) => {
        const deltaY = (e.changedTouches[0].clientY || 0) - startY;
        sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 150) {
          onClose();
        } else {
          sheet.style.transform = 'translateY(0)';
        }
      });
    }

    private bindSheetSwipe() {
      const sheet = this.content;
      const handle = document.getElementById('wrapup-drag-handle');
      if (!sheet) return;

      let startY = 0;
      let startX = 0;
      let isDragging = false;

      const onStart = (clientX: number, clientY: number) => {
        if (document.activeElement && ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) {
          return;
        }
        startY = clientY;
        startX = clientX;
        isDragging = false;
      };
      
      const onMove = (clientX: number, clientY: number, e: TouchEvent) => {
        const isAtTop = sheet.scrollTop <= 0;
        if (!isAtTop && !isDragging) return;

        const deltaY = clientY - startY;
        const deltaX = clientX - startX;

        if (!isDragging) {
          if (deltaY > 8 && deltaY > Math.abs(deltaX) * 1.2) {
            isDragging = true;
            sheet.style.transition = 'none';
          } else {
            return;
          }
        }

        if (deltaY > 0) {
          if (e.cancelable) e.preventDefault();
          sheet.style.transform = `translateY(${deltaY}px)`;
        }
      };

      const onEnd = (clientY: number) => {
        if (!isDragging) return;
        isDragging = false;
        const deltaY = clientY - startY;
        sheet.style.transition = 'transform 350ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 80) {
          this.close();
        } else {
          sheet.style.transform = 'translateY(0)';
        }
      };

      if (handle) {
        handle.addEventListener('touchstart', (e: any) => {
          startY = e.touches[0].clientY;
          startX = e.touches[0].clientX;
          isDragging = true;
          sheet.style.transition = 'none';
        }, { passive: true });

        handle.addEventListener('touchmove', (e: any) => {
          if (!isDragging) return;
          const deltaY = e.touches[0].clientY - startY;
          if (deltaY > 0) {
            if (e.cancelable) e.preventDefault();
            sheet.style.transform = `translateY(${deltaY}px)`;
          }
        }, { passive: false });

        handle.addEventListener('touchend', (e: any) => {
          if (!isDragging) return;
          isDragging = false;
          const deltaY = e.changedTouches[0].clientY - startY;
          sheet.style.transition = 'transform 350ms cubic-bezier(0.32, 0.72, 0, 1)';
          if (deltaY > 80) {
            this.close();
          } else {
            sheet.style.transform = 'translateY(0)';
          }
        }, { passive: false });
      }

      sheet.addEventListener('touchstart', (e: any) => onStart(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
      sheet.addEventListener('touchmove', (e: any) => onMove(e.touches[0].clientX, e.touches[0].clientY, e), { passive: false });
      sheet.addEventListener('touchend', (e: any) => onEnd(e.changedTouches[0].clientY), { passive: true });
    }

    private renderTimeGrids() {
      const hoursGrid = document.getElementById('wrapup-time-hours-grid');
      const minutesGrid = document.getElementById('wrapup-time-minutes-grid');
      const hoursList = ['07','08','09','10','11','12','13','14','15','16','17','18'];
      const minutesList = ['00','15','30','45'];

      if (hoursGrid) {
        hoursGrid.innerHTML = '';
        hoursList.forEach(h => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSel = h === this.selectedHour;
          btn.className = `py-2 rounded-xl font-extrabold text-sm transition-all ${
            isSel ? 'bg-brand-secondary text-white shadow-sm scale-105' : 'bg-surface-base hover:bg-brand-primary/30 text-text-main'
          }`;
          btn.textContent = h;
          btn.addEventListener('click', () => {
            this.selectedHour = h;
            const hd = document.getElementById('wrapup-time-hour');
            if (hd) hd.textContent = h;
            this.renderTimeGrids();
          });
          hoursGrid.appendChild(btn);
        });
      }

      if (minutesGrid) {
        minutesGrid.innerHTML = '';
        minutesList.forEach(m => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSel = m === this.selectedMinute;
          btn.className = `py-2 rounded-xl font-extrabold text-sm transition-all ${
            isSel ? 'bg-brand-secondary text-white shadow-sm scale-105' : 'bg-surface-base hover:bg-brand-primary/30 text-text-main'
          }`;
          btn.textContent = m;
          btn.addEventListener('click', () => {
            this.selectedMinute = m;
            const md = document.getElementById('wrapup-time-minute');
            if (md) md.textContent = m;
            this.renderTimeGrids();
          });
          minutesGrid.appendChild(btn);
        });
      }
    }

    private updateCustomDateTimeDisplay() {
      const dateDisplay = document.getElementById('wrapup-display-date');
      const timeDisplay = document.getElementById('wrapup-display-time');
      if (dateDisplay) {
        const parsed = new Date(this.customDate + 'T00:00:00');
        if (!isNaN(parsed.getTime())) {
          const fmt = parsed.toLocaleDateString('ro-RO', { day: 'numeric', month: 'short', weekday: 'short' });
          dateDisplay.textContent = fmt;
        } else {
          dateDisplay.textContent = '--';
        }
      }
      if (timeDisplay) timeDisplay.textContent = this.customTime;
    }

    private open() {
      this.reconnect();
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.content.style.maxHeight = `${window.innerHeight * 0.9}px`;
      this.sheet.dataset.open = 'true';
      this.content.style.transform = '';
      void this.sheet.offsetWidth;
      this.backdrop.classList.remove('opacity-0');
      this.content.classList.remove('translate-y-full');
      lockBodyScroll();
    }

    private close() {
      this.reconnect();
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.closeDatePicker();
      this.closeTimePicker();
      this.backdrop.classList.add('opacity-0');
      this.content.style.transform = '';
      this.content.classList.add('translate-y-full');
      unlockBodyScroll();
      setTimeout(() => {
        this.reconnect();
        if (this.sheet) {
          this.sheet.dataset.open = 'false';
        }
        this.currentAppointment = null;
      }, 500);
    }
  }

  (window as any).__wrapUpManager = (window as any).__wrapUpManager || null;

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('session-wrapup-sheet')) return;

    const mgr = (window as any).__wrapUpManager as WrapUpSheetManager | null;
    if (!mgr) {
      (window as any).__wrapUpManager = new WrapUpSheetManager();
    } else {
      mgr.reconnect();
    }
  });
</script>

