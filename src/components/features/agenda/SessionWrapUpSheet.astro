---
---

<div 
  id="session-wrapup-sheet" 
  class="fixed inset-x-0 bottom-0 z-[100] bg-surface-card rounded-t-[2rem] p-6 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex-1 overflow-y-auto no-scrollbar">
    <h3 class="text-2xl font-extrabold tracking-tight text-black mb-1">Confirmă sesiunea</h3>
    <p id="wrapup-queue-position" class="text-xs font-bold text-text-muted uppercase tracking-widest mb-4"></p>

    <p id="wrapup-patient-name" class="text-xl font-extrabold text-black">Patient Name</p>
    <p id="wrapup-session-date" class="text-text-muted font-semibold mb-6">Data și ora sesiunii</p>

    <!-- Rebook Toggle -->
    <div class="bg-black/5 rounded-3xl p-5 flex flex-col gap-4 mb-6">
      <div class="flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h4 class="font-bold text-black text-lg leading-tight">Programează și săptămâna viitoare</h4>
          <p id="wrapup-next-date" class="text-sm text-text-muted font-medium mt-1">Aceeași zi și oră</p>
        </div>
        
        <!-- Massive iOS-style toggle -->
        <label class="relative inline-flex items-center cursor-pointer shrink-0">
          <input type="checkbox" id="rebook-toggle" name="rebook" class="sr-only peer" checked>
          <div class="w-16 h-9 bg-black/20 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-brand-primary"></div>
        </label>
      </div>
    </div>

    <!-- Attendance Actions -->
    <div class="flex gap-3">
      <button type="button" id="wrapup-btn-absent" class="flex-1 py-4 rounded-2xl bg-rose-600 text-white font-extrabold text-lg active:scale-95 transition-transform shadow-lg disabled:opacity-50">
        Nu a venit
      </button>
      <button type="button" id="wrapup-btn-came" class="flex-1 py-4 rounded-2xl bg-emerald-600 text-white font-extrabold text-lg active:scale-95 transition-transform shadow-lg disabled:opacity-50">
        Da, a venit
      </button>
    </div>
  </div>
</div>

<script>
  import { getPendingWrapUps, completeSession, markAbsent, rebookNextWeek } from '../../../lib/services/appointmentService';
  import type { PendingWrapUp } from '../../../lib/services/appointmentService';

  class SessionWrapUpManager {
    sheet: HTMLElement | null;
    overlay: HTMLElement | null = null;
    patientLabel: HTMLElement | null;
    dateLabel: HTMLElement | null;
    nextDateLabel: HTMLElement | null;
    queuePosLabel: HTMLElement | null;
    rebookToggle: HTMLInputElement | null;
    btnCame: HTMLButtonElement | null;
    btnAbsent: HTMLButtonElement | null;
    queue: PendingWrapUp[] = [];
    current: PendingWrapUp | null = null;
    isOpen: boolean = false;
    isProcessing: boolean = false;
    startY: number;
    currentY: number;
    startX: number = 0;
    dragEngaged: boolean = false;
    scrollAtTop: boolean = true;

    constructor() {
      this.sheet = document.getElementById('session-wrapup-sheet');
      this.patientLabel = document.getElementById('wrapup-patient-name');
      this.dateLabel = document.getElementById('wrapup-session-date');
      this.nextDateLabel = document.getElementById('wrapup-next-date');
      this.queuePosLabel = document.getElementById('wrapup-queue-position');
      this.rebookToggle = document.getElementById('rebook-toggle') as HTMLInputElement;
      this.btnCame = document.getElementById('wrapup-btn-came') as HTMLButtonElement;
      this.btnAbsent = document.getElementById('wrapup-btn-absent') as HTMLButtonElement;
      this.startY = 0;
      this.currentY = 0;

      this.createOverlay();
      this.bindEvents();
    }

    createOverlay() {
      this.overlay = document.createElement('div');
      this.overlay.className = 'fixed inset-0 bg-black/40 z-[90] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm';
      document.body.appendChild(this.overlay);

      this.overlay.addEventListener('click', () => this.close());
    }

    bindEvents() {
      if (!this.sheet) return;

      // Swipe-down to dismiss from anywhere on the sheet — only engages on a
      // clearly vertical downward swipe while the form is scrolled to the top
      this.sheet.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      this.sheet.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      this.sheet.addEventListener('touchend', () => this.handleTouchEnd());

      this.btnCame?.addEventListener('click', () => this.answer(true));
      this.btnAbsent?.addEventListener('click', () => this.answer(false));

      // Open event — pentru o sesiune specifică sau re-verificare forțată
      window.addEventListener('openWrapUp', (e: any) => {
        const appt = e.detail?.appointment;
        if (appt) {
          this.queue = [appt];
          this.showCurrent();
        } else if (e.detail?.forceCheck) {
          this.checkQueue();
        }
      });
    }

    formatDate(dateStr: string): string {
      const d = new Date(dateStr + 'T00:00:00');
      if (isNaN(d.getTime())) return dateStr;
      const day = d.toLocaleDateString('ro-RO', { weekday: 'long' });
      const month = d.toLocaleDateString('ro-RO', { month: 'long' });
      const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
      return `${cap(day)}, ${d.getDate()} ${month}`;
    }

    nextWeekDateStr(dateStr: string): string {
      const d = new Date(dateStr + 'T00:00:00');
      d.setDate(d.getDate() + 7);
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    async checkQueue() {
      if (this.isOpen || this.isProcessing) return;
      try {
        this.queue = await getPendingWrapUps();
      } catch (e) {
        console.error('Eroare citire wrap-up queue:', e);
        return;
      }
      if (this.queue.length === 0) return;
      this.showCurrent();
    }

    showCurrent() {
      const item = this.queue[0];
      if (!item) {
        this.finishQueue();
        return;
      }
      this.current = item;

      if (this.patientLabel) {
        this.patientLabel.textContent = item.pacienti
          ? `${item.pacienti.prenume} ${item.pacienti.nume}`
          : 'Pacient';
      }
      if (this.dateLabel) {
        this.dateLabel.textContent = `${this.formatDate(item.data)} · ${(item.ora || '').slice(0, 5)}`;
      }
      if (this.nextDateLabel) {
        this.nextDateLabel.textContent = `${this.formatDate(this.nextWeekDateStr(item.data))} · ${(item.ora || '').slice(0, 5)}`;
      }
      if (this.queuePosLabel) {
        this.queuePosLabel.textContent = this.queue.length > 1
          ? `Mai ai ${this.queue.length} sesiuni de confirmat`
          : 'Ultima sesiune de confirmat';
      }
      if (this.rebookToggle) this.rebookToggle.checked = true;

      this.open();
    }

    async answer(came: boolean) {
      if (!this.current || this.isProcessing) return;
      this.isProcessing = true;
      if (this.btnCame) this.btnCame.disabled = true;
      if (this.btnAbsent) this.btnAbsent.disabled = true;

      const item = this.current;
      const patientName = item.pacienti ? `${item.pacienti.prenume} ${item.pacienti.nume}` : 'Pacientul';

      try {
        if (came) {
          await completeSession(item.id);
        } else {
          await markAbsent(item.id, 'Absent — confirmat din wrap-up');
        }

        if (this.rebookToggle?.checked) {
          try {
            await rebookNextWeek(item.id);
          } catch (rebookErr: any) {
            (window as any).showToast(
              `${patientName}: sesiunea a fost salvată, dar reprogramarea a eșuat (${rebookErr?.message || rebookErr}).`,
              'warning',
              'Reprogramare eșuată'
            );
          }
        }
      } catch (err: any) {
        (window as any).showToast('Eroare la salvarea confirmării: ' + (err?.message || err), 'error');
      }

      this.queue.shift();
      this.current = null;
      this.isProcessing = false;
      if (this.btnCame) this.btnCame.disabled = false;
      if (this.btnAbsent) this.btnAbsent.disabled = false;

      if (this.queue.length > 0) {
        this.showCurrent();
      } else {
        this.finishQueue();
      }
    }

    finishQueue() {
      this.close();
      window.dispatchEvent(new CustomEvent('sessionsUpdated'));
      window.dispatchEvent(new CustomEvent('patientsUpdated'));
      (window as any).showToast('Toate sesiunile au fost confirmate.', 'success');
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      this.isOpen = true;
      this.sheet.classList.remove('translate-y-full');
      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    close() {
      if (!this.sheet || !this.overlay) return;
      this.isOpen = false;
      this.sheet.style.transform = '';
      this.sheet.classList.add('translate-y-full');
      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      // Sesiunile rămase în coadă se reîntreabă la următorul reload complet al aplicației
      this.queue = [];
      this.current = null;
    }

    handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;
      // Only allow sheet drag when the scrollable form is at the top,
      // otherwise the gesture should scroll the form instead
      const scrollArea = this.sheet?.querySelector('.overflow-y-auto');
      this.scrollAtTop = !scrollArea || scrollArea.scrollTop <= 0;
    }

    handleTouchMove(e: TouchEvent) {
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        if (this.scrollAtTop && deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.sheet) this.sheet.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.sheet) {
        if (e.cancelable) e.preventDefault();
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.sheet || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      this.sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
      
      if (deltaY > 150) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }
  }

  let wrapUpManager: SessionWrapUpManager | null = null;
  let wrapUpCheckedThisLoad = false;

  function initWrapUp() {
    if (!wrapUpManager) {
      wrapUpManager = new SessionWrapUpManager();
    }
    // Rulează coada o singură dată per încărcare completă a aplicației
    if (!wrapUpCheckedThisLoad) {
      wrapUpCheckedThisLoad = true;
      // Mic delay ca auth-ul Supabase să fie restaurat din storage
      setTimeout(() => wrapUpManager?.checkQueue(), 1500);
    }
  }

  document.addEventListener('DOMContentLoaded', initWrapUp);
  document.addEventListener('astro:page-load', initWrapUp);

  // Permite re-verificarea manuală (ex: după ce trece o sesiune în timpul utilizării)
  window.addEventListener('checkWrapUps', () => wrapUpManager?.checkQueue());
</script>
