---
---

<div 
  id="session-wrapup-sheet" 
  class="fixed inset-x-0 bottom-0 z-[100] bg-surface-card rounded-t-[2rem] p-6 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex-1 overflow-y-auto no-scrollbar">
    <h3 class="text-2xl font-extrabold tracking-tight text-black mb-2">Session Complete</h3>
    <p id="wrapup-patient-name" class="text-text-muted font-semibold mb-6">Patient Name</p>

    <form id="wrapup-session-form" class="space-y-8">
      
      <!-- Session Notes -->
      <div class="space-y-2">
        <label for="session-notes" class="text-sm font-bold text-text-muted">Session Notes</label>
        <div class="bg-black/5 rounded-2xl overflow-hidden focus-within:ring-2 focus-within:ring-brand-primary transition-all p-4">
          <textarea 
            id="session-notes" 
            name="notes" 
            rows="3"
            placeholder="Patient showed improved mobility..."
            class="w-full bg-transparent border-none font-medium text-black focus:outline-none resize-none"
          ></textarea>
        </div>
      </div>

      <!-- Rebook Toggle -->
      <div class="bg-black/5 rounded-3xl p-5 flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <div>
            <h4 class="font-bold text-black text-lg">Rebook for next week?</h4>
            <p id="wrapup-next-date" class="text-sm text-text-muted font-medium mt-1">Next Thursday, 14:00</p>
          </div>
          
          <!-- Massive iOS-style toggle -->
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="rebook-toggle" name="rebook" class="sr-only peer" checked>
            <div class="w-16 h-9 bg-black/20 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-brand-primary"></div>
          </label>
        </div>
      </div>
    </form>
  </div>

  <div class="pt-6 mt-auto">
    <button type="submit" form="wrapup-session-form" class="w-full py-4 rounded-2xl bg-black text-white font-bold text-lg active:scale-95 transition-transform shadow-lg">
      Save & Close
    </button>
  </div>
</div>

<script>
  class SessionWrapUpManager {
    sheet: HTMLElement | null;
    form: HTMLFormElement | null;
    overlay: HTMLElement | null = null;
    patientLabel: HTMLElement | null;
    dateLabel: HTMLElement | null;
    startY: number;
    currentY: number;

    constructor() {
      this.sheet = document.getElementById('session-wrapup-sheet');
      this.form = document.getElementById('wrapup-session-form') as HTMLFormElement;
      this.patientLabel = document.getElementById('wrapup-patient-name');
      this.dateLabel = document.getElementById('wrapup-next-date');
      this.startY = 0;
      this.currentY = 0;

      this.createOverlay();
      this.bindEvents();
    }

    createOverlay() {
      this.overlay = document.createElement('div');
      this.overlay.className = 'fixed inset-0 bg-black/40 z-[90] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm';
      document.body.appendChild(this.overlay);

      this.overlay.addEventListener('click', () => this.close());
    }

    bindEvents() {
      if (!this.sheet) return;

      const handle = this.sheet.querySelector('.cursor-grab');
      handle?.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      handle?.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      handle?.addEventListener('touchend', () => this.handleTouchEnd());

      // Open event
      window.addEventListener('openWrapUp', (e: any) => {
        if (this.patientLabel && e.detail?.patientName) {
          this.patientLabel.textContent = e.detail.patientName;
        }
        if (this.dateLabel && e.detail?.nextDateStr) {
          this.dateLabel.textContent = e.detail.nextDateStr;
        }
        this.open();
      });

      this.form?.addEventListener('submit', (e) => {
        e.preventDefault();
        console.log("WrapUp mutation stub triggered.");
        this.close();
      });
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.classList.remove('translate-y-full');
      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    close() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.style.transform = '';
      this.sheet.classList.add('translate-y-full');
      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      
      setTimeout(() => this.form?.reset(), 500);
    }

    handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      if (this.sheet) this.sheet.style.transition = 'none';
    }

    handleTouchMove(e: TouchEvent) {
      this.currentY = e.touches[0].clientY;
      const deltaY = this.currentY - this.startY;
      if (deltaY > 0 && this.sheet) {
        e.preventDefault();
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.sheet) return;
      const deltaY = this.currentY - this.startY;
      this.sheet.style.transition = 'transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1)';
      
      if (deltaY > 150) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new SessionWrapUpManager();
  });
</script>
