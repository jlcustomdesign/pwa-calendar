---
// SessionWrapUpSheet.astro — Pop-up inteligent la confirmarea unei ședințe
---

<div id="session-wrapup-sheet" class="fixed inset-0 z-[120] pointer-events-none hidden">
  <div id="session-wrapup-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm pointer-events-auto transition-opacity duration-500 opacity-0"></div>
  
  <div id="session-wrapup-content" class="absolute bottom-0 left-0 right-0 bg-surface-card rounded-t-[2.5rem] p-6 pb-safe pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] max-h-[90vh] overflow-y-auto no-scrollbar border-t border-border-subtle/50">
    <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 cursor-grab active:cursor-grabbing" id="wrapup-drag-handle"></div>

    <!-- Header -->
    <div class="flex items-center mb-4">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-text-main">Finalizează ședința</h2>
        <p class="text-text-muted font-bold text-sm mt-0.5" id="wrapup-subtitle">Confirmă detaliile și programează săptămâna viitoare</p>
      </div>
    </div>

    <!-- Patient & Session Summary Card -->
    <div class="mb-5 bg-surface-base/80 p-4 rounded-2xl border border-border-subtle/70 flex items-center justify-between">
      <div>
        <div class="font-extrabold text-text-main text-lg" id="wrapup-patient-name">Se încarcă…</div>
        <div class="text-text-muted font-bold text-xs mt-0.5" id="wrapup-session-details">
          Ședința de azi • 08:00
        </div>
      </div>
      <div class="text-right">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-text-muted">Ședințe efectuate</div>
        <div class="text-base font-black text-brand-secondary leading-tight" id="wrapup-session-count">-- / --</div>
      </div>
    </div>

    <!-- Subscription Alert (if total sessions reached or near end) -->
    <div id="wrapup-subscription-alert" class="hidden mb-5 p-4 rounded-2xl bg-amber-50 border border-amber-200/80 text-amber-900 text-sm font-bold flex items-center justify-between">
      <div class="flex items-center gap-3">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Abonament aproape finalizat!</span>
      </div>
      <button type="button" id="btn-renew-package" class="px-3 py-1.5 rounded-xl bg-amber-500 text-black font-extrabold text-xs shadow-sm hover:brightness-105 active:scale-95 transition-all">
        + Reînnoiește pachet
      </button>
    </div>

    <!-- Section 1: Next Week Recurrence Selection -->
    <div class="space-y-3 mb-6">
      <label class="block text-base font-extrabold text-text-main">
        📅 Dorești programare și pe săptămâna viitoare?
      </label>
      
      <div class="grid grid-cols-1 gap-2.5" id="recurrence-options-container">
        <!-- Option A: Same day & time next week (DEFAULT) -->
        <button 
          type="button" 
          data-recurrence-option="same" 
          class="w-full p-4 rounded-2xl border-2 border-brand-secondary bg-brand-secondary/10 text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full border-2 border-brand-secondary bg-brand-secondary flex items-center justify-center text-white shrink-0">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="text-left">
              <div class="font-extrabold text-sm sm:text-base text-text-main" id="wrapup-same-slot-label">Da, lunea viitoare la 08:00</div>
              <div class="text-xs font-semibold text-text-muted mt-0.5" id="wrapup-same-slot-date">+7 zile mai târziu</div>
            </div>
          </div>
        </button>

        <!-- Option B: Pick custom day/time for next week -->
        <button 
          type="button" 
          data-recurrence-option="custom" 
          class="w-full p-4 rounded-2xl border border-border-subtle bg-surface-base/50 hover:bg-surface-base text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full border-2 border-text-muted/40 flex items-center justify-center shrink-0">
              <div class="w-2 h-2 rounded-full bg-transparent"></div>
            </div>
            <div class="text-left">
              <div class="font-extrabold text-sm sm:text-base text-text-main">Altă zi / altă oră săptămâna viitoare</div>
              <div class="text-xs font-semibold text-text-muted mt-0.5">Alege manual din calendar</div>
            </div>
          </div>
        </button>

        <!-- Option C: Do not schedule for next week -->
        <button 
          type="button" 
          data-recurrence-option="none" 
          class="w-full p-4 rounded-2xl border border-border-subtle bg-surface-base/50 hover:bg-surface-base text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full border-2 border-text-muted/40 flex items-center justify-center shrink-0">
              <div class="w-2 h-2 rounded-full bg-transparent"></div>
            </div>
            <div class="text-left">
              <div class="font-extrabold text-sm sm:text-base text-text-main">Nu, doar confirmă ședința curentă</div>
              <div class="text-xs font-semibold text-text-muted mt-0.5">Nu creează nicio altă programare</div>
            </div>
          </div>
        </button>
      </div>
    </div>

    <!-- Custom Date/Time Selectors (Hidden by default, shown if Custom option selected) -->
    <div id="wrapup-custom-datetime-box" class="hidden mb-6 p-4 rounded-2xl bg-surface-base border border-border-subtle space-y-3">
      <div class="text-xs font-black uppercase text-text-muted">Alege data și ora pentru săptămâna viitoare</div>
      <div class="grid grid-cols-2 gap-3">
        <button type="button" id="wrapup-trigger-date" class="text-left px-3 py-2.5 rounded-xl border border-border-subtle bg-white font-bold text-sm text-text-main focus:outline-none focus:border-brand-secondary active:scale-[0.98] transition-transform">
          <span class="block text-[10px] font-bold text-text-muted uppercase tracking-wider mb-0.5">Data</span>
          <span id="wrapup-display-date">--</span>
        </button>
        <button type="button" id="wrapup-trigger-time" class="text-left px-3 py-2.5 rounded-xl border border-border-subtle bg-white font-bold text-sm text-text-main focus:outline-none focus:border-brand-secondary active:scale-[0.98] transition-transform">
          <span class="block text-[10px] font-bold text-text-muted uppercase tracking-wider mb-0.5">Ora</span>
          <span id="wrapup-display-time">08:00</span>
        </button>
      </div>
    </div>

    <!-- Submit Action Button -->
    <div class="pt-2">
      <button 
        type="button" 
        id="btn-confirm-wrapup" 
        class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-lg shadow-md shadow-amber-500/15 active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Confirmă ședința</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Custom Date Picker Sheet -->
  <div 
    id="wrapup-date-picker-sheet" 
    class="fixed inset-x-0 bottom-0 z-[130] bg-surface-card rounded-t-[2rem] p-4 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden pointer-events-auto"
  >
    <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-4 shrink-0 cursor-grab active:cursor-grabbing"></div>
    <div class="flex items-center justify-between mb-6 px-1">
      <button type="button" id="wrapup-date-prev" class="w-10 h-10 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center active:scale-95 transition-transform">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <h3 id="wrapup-date-month-year" class="text-lg font-extrabold tracking-tight">August 2026</h3>
      <button type="button" id="wrapup-date-next" class="w-10 h-10 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center active:scale-95 transition-transform">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
    <div class="grid grid-cols-7 mb-2">
      {['L','M','M','J','V','S','D'].map(d => (
        <div class="text-center text-xs font-bold text-text-muted uppercase tracking-wider py-2">{d}</div>
      ))}
    </div>
    <div id="wrapup-date-grid" class="grid grid-cols-7 gap-1 flex-1 overflow-y-auto no-scrollbar"></div>
    <div class="pt-4 mt-auto">
      <button type="button" id="wrapup-date-close" class="w-full py-4 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all text-center cursor-pointer">
        Salvează
      </button>
    </div>
  </div>
  <div id="wrapup-date-picker-overlay" class="fixed inset-0 bg-black/40 z-[125] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"></div>

  <!-- Custom Time Picker Sheet -->
  <div 
    id="wrapup-time-picker-sheet" 
    class="fixed inset-x-0 bottom-0 z-[130] bg-surface-card rounded-t-[2.5rem] p-5 shadow-2xl transition-transform duration-500 translate-y-full will-change-transform flex flex-col max-h-[85vh] overflow-hidden space-y-4 pointer-events-auto"
  >
    <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-2 shrink-0 cursor-grab active:cursor-grabbing"></div>
    <div class="flex items-center justify-between pb-2 border-b border-border-subtle/40 px-1">
      <h3 class="text-xl font-black text-text-main font-sans tracking-tight">Alege ora</h3>
    </div>
    <div class="flex items-center justify-center gap-3 py-3.5 bg-surface-base/80 rounded-2xl border border-border-subtle/60 shadow-inner text-text-main font-black text-4xl font-sans tracking-tight">
      <span id="wrapup-time-hour">08</span>
      <span class="text-text-muted/60">:</span>
      <span id="wrapup-time-minute">00</span>
    </div>
    <div>
      <div class="grid grid-cols-4 gap-2 max-h-36 overflow-y-auto pr-1 py-2" id="wrapup-time-hours-grid"></div>
    </div>
    <div class="space-y-1.5 pt-1">
      <div class="text-xs font-extrabold text-text-muted font-sans uppercase tracking-wider">Minute</div>
      <div class="grid grid-cols-4 gap-2" id="wrapup-time-minutes-grid"></div>
    </div>
    <div class="pt-2 mt-auto">
      <button type="button" id="wrapup-time-confirm" class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all text-center cursor-pointer">
        Salvează
      </button>
    </div>
  </div>
  <div id="wrapup-time-picker-overlay" class="fixed inset-0 bg-black/40 z-[125] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"></div>
</div>

<script>
  import { completeSession, createAppointment } from '../../../lib/services/appointmentService';
  import { getPatient, updatePatient } from '../../../lib/services/patientService';

  class WrapUpSheetManager {
    private sheet: HTMLElement | null;
    private backdrop: HTMLElement | null;
    private content: HTMLElement | null;

    private currentAppointment: any = null;
    private selectedRecurrence: 'same' | 'custom' | 'none' = 'same';

    private nextWeekDateStr: string = '';
    private nextWeekDayName: string = '';

    private customDate: string = '';
    private customTime: string = '08:00';
    private pickerDate: Date = new Date();
    private selectedHour: string = '08';
    private selectedMinute: string = '00';

    constructor() {
      this.sheet = document.getElementById('session-wrapup-sheet');
      this.backdrop = document.getElementById('session-wrapup-backdrop');
      this.content = document.getElementById('session-wrapup-content');

      this.bindEvents();
    }

    private bindEvents() {
      window.addEventListener('openWrapUp', ((e: CustomEvent) => {
        if (e.detail?.appointment) {
          this.currentAppointment = e.detail.appointment;
          this.initView();
          this.open();
        }
      }) as EventListener);

      this.backdrop?.addEventListener('click', () => this.close());

      // Swipe-down to close main wrap-up sheet
      this.bindSheetSwipe();

      // Handle Recurrence option selection
      const optionsContainer = document.getElementById('recurrence-options-container');
      optionsContainer?.querySelectorAll<HTMLButtonElement>('[data-recurrence-option]').forEach(btn => {
        btn.addEventListener('click', () => {
          const opt = btn.getAttribute('data-recurrence-option') as 'same' | 'custom' | 'none';
          this.setRecurrenceOption(opt);
        });
      });

      // Renew package button
      document.getElementById('btn-renew-package')?.addEventListener('click', async () => {
        if (!this.currentAppointment?.pacient_id && !this.currentAppointment?.pacienti?.id) return;
        const patientId = this.currentAppointment.pacient_id || this.currentAppointment.pacienti?.id;
        try {
          const patient = await getPatient(patientId);
          const newTotal = (patient.sedinte_total || 10) + 10;
          await updatePatient(patientId, { sedinte_total: newTotal });
          (window as any).showToast(`Pachetul pacientului a fost extins la ${newTotal} ședințe!`, 'success');
          
          const alertEl = document.getElementById('wrapup-subscription-alert');
          if (alertEl) alertEl.classList.add('hidden');
          
          const countEl = document.getElementById('wrapup-session-count');
          if (countEl) countEl.textContent = `${patient.sedinte_folosite || 0} / ${newTotal}`;
        } catch (err: any) {
          (window as any).showToast('Eroare la extinderea pachetului: ' + (err?.message || err), 'error');
        }
      });

      // Submit Confirm Wrap-Up
      document.getElementById('btn-confirm-wrapup')?.addEventListener('click', () => {
        this.handleConfirm();
      });

      // Custom date/time triggers
      document.getElementById('wrapup-trigger-date')?.addEventListener('click', () => this.openDatePicker());
      document.getElementById('wrapup-trigger-time')?.addEventListener('click', () => this.openTimePicker());

      // Date picker controls
      document.getElementById('wrapup-date-prev')?.addEventListener('click', () => {
        this.pickerDate.setMonth(this.pickerDate.getMonth() - 1);
        this.renderDatePicker();
      });
      document.getElementById('wrapup-date-next')?.addEventListener('click', () => {
        this.pickerDate.setMonth(this.pickerDate.getMonth() + 1);
        this.renderDatePicker();
      });
      document.getElementById('wrapup-date-close')?.addEventListener('click', () => this.closeDatePicker());
      document.getElementById('wrapup-date-picker-overlay')?.addEventListener('click', () => this.closeDatePicker());

      // Time picker controls
      document.getElementById('wrapup-time-confirm')?.addEventListener('click', () => this.closeTimePicker());
      document.getElementById('wrapup-time-picker-overlay')?.addEventListener('click', () => this.closeTimePicker());

      // Swipe-down to close pickers
      this.bindPickerSwipe('wrapup-date-picker-sheet', () => this.closeDatePicker());
      this.bindPickerSwipe('wrapup-time-picker-sheet', () => this.closeTimePicker());
    }

    private async initView() {
      if (!this.currentAppointment) return;

      const appt = this.currentAppointment;
      const patientName = appt.pacienti ? `${appt.pacienti.prenume || ''} ${appt.pacienti.nume || ''}`.trim() : (appt.patientName || 'Pacient');
      const timeStr = appt.ora || appt.selectedTime || '08:00';
      const dateStr = appt.data || appt.selectedDate || new Date().toISOString().split('T')[0];

      // Calculate next week date (+7 days)
      const currentDateObj = new Date(dateStr + 'T00:00:00');
      const nextWeekObj = new Date(currentDateObj);
      nextWeekObj.setDate(nextWeekObj.getDate() + 7);

      this.nextWeekDateStr = nextWeekObj.toISOString().split('T')[0];
      const dayName = nextWeekObj.toLocaleDateString('ro-RO', { weekday: 'long' });
      this.nextWeekDayName = dayName.charAt(0).toUpperCase() + dayName.slice(1);

      const formattedNextDate = `${this.nextWeekDayName}, ${nextWeekObj.getDate()} ${nextWeekObj.toLocaleDateString('ro-RO', { month: 'short' })}`;

      // Populate UI
      const nameEl = document.getElementById('wrapup-patient-name');
      const detailsEl = document.getElementById('wrapup-session-details');
      const countEl = document.getElementById('wrapup-session-count');
      const sameSlotLabel = document.getElementById('wrapup-same-slot-label');
      const sameSlotDate = document.getElementById('wrapup-same-slot-date');

      if (nameEl) nameEl.textContent = patientName;
      if (detailsEl) detailsEl.textContent = `Ședință ${dateStr} • ora ${timeStr}`;
      
      const folosite = (appt.pacienti?.sedinte_folosite ?? 0) + 1; // including today
      const total = appt.pacienti?.sedinte_total || 10;
      if (countEl) countEl.textContent = `${folosite} / ${total}`;

      if (sameSlotLabel) sameSlotLabel.textContent = `Da, ${this.nextWeekDayName.toLowerCase()} viitoare la ${timeStr}`;
      if (sameSlotDate) sameSlotDate.textContent = `Data: ${formattedNextDate}`;

      // Set custom date/time defaults to next week
      this.customDate = this.nextWeekDateStr;
      this.customTime = timeStr;
      [this.selectedHour, this.selectedMinute] = timeStr.split(':');
      this.pickerDate = new Date(this.nextWeekDateStr + 'T00:00:00');
      this.updateCustomDateTimeDisplay();

      // Show subscription warning if needed
      const alertEl = document.getElementById('wrapup-subscription-alert');
      if (alertEl) {
        if (folosite >= total) {
          alertEl.classList.remove('hidden');
        } else {
          alertEl.classList.add('hidden');
        }
      }

      // Default option reset to "same"
      this.setRecurrenceOption('same');
    }

    private setRecurrenceOption(option: 'same' | 'custom' | 'none') {
      this.selectedRecurrence = option;
      const container = document.getElementById('recurrence-options-container');
      const customBox = document.getElementById('wrapup-custom-datetime-box');

      if (!container) return;

      container.querySelectorAll<HTMLButtonElement>('[data-recurrence-option]').forEach(btn => {
        const opt = btn.getAttribute('data-recurrence-option');
        const isSel = opt === option;
        const iconContainer = btn.querySelector('.rounded-full');

        if (isSel) {
          btn.className = 'w-full p-4 rounded-2xl border-2 border-brand-secondary bg-brand-secondary/10 text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]';
          if (iconContainer) {
            iconContainer.className = 'w-5 h-5 rounded-full border-2 border-brand-secondary bg-brand-secondary flex items-center justify-center text-white shrink-0';
            iconContainer.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>';
          }
        } else {
          btn.className = 'w-full p-4 rounded-2xl border border-border-subtle bg-surface-base/50 hover:bg-surface-base text-text-main font-bold text-base flex items-center justify-between transition-all cursor-pointer active:scale-[0.98]';
          if (iconContainer) {
            iconContainer.className = 'w-5 h-5 rounded-full border-2 border-text-muted/40 flex items-center justify-center shrink-0';
            iconContainer.innerHTML = '<div class="w-2 h-2 rounded-full bg-transparent"></div>';
          }
        }
      });

      if (customBox) {
        if (option === 'custom') {
          customBox.classList.remove('hidden');
        } else {
          customBox.classList.add('hidden');
        }
      }
    }

    private async handleConfirm() {
      if (!this.currentAppointment) return;

      const btnConfirm = document.getElementById('btn-confirm-wrapup') as HTMLButtonElement | null;
      if (btnConfirm) {
        btnConfirm.disabled = true;
        btnConfirm.textContent = 'Se procesează…';
      }

      const appt = this.currentAppointment;
      const patientId = appt.pacient_id || appt.pacienti?.id;

      try {
        // 1. Confirm current session
        await completeSession(appt.id);

        // 2. Schedule next week session if selected
        if (this.selectedRecurrence === 'same') {
          const timeStr = appt.ora || appt.selectedTime || '08:00';
          await createAppointment({
            pacient_id: patientId,
            data: this.nextWeekDateStr,
            ora: timeStr,
          });
          (window as any).showToast(`Ședința a fost marcată ca efectuată și s-a programat automat ${this.nextWeekDayName} viitoare la ${timeStr}!`, 'success');
        } else if (this.selectedRecurrence === 'custom') {
          const targetDate = this.customDate || this.nextWeekDateStr;
          const targetTime = this.customTime || '08:00';

          await createAppointment({
            pacient_id: patientId,
            data: targetDate,
            ora: targetTime,
          });
          (window as any).showToast(`Ședința a fost marcată ca efectuată și noua programare a fost creată pe ${targetDate} la ${targetTime}!`, 'success');
        } else {
          (window as any).showToast('Ședința a fost marcată ca efectuată cu succes!', 'success');
        }

        window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        this.close();
      } catch (err: any) {
        (window as any).showToast('Eroare la procesare: ' + (err?.message || err), 'error');
      } finally {
        if (btnConfirm) {
          btnConfirm.disabled = false;
          btnConfirm.textContent = 'Confirmă ședința';
        }
      }
    }

    // --- Custom Date Picker ---
    private openDatePicker() {
      const sheet = document.getElementById('wrapup-date-picker-sheet');
      const overlay = document.getElementById('wrapup-date-picker-overlay');
      if (!sheet || !overlay) return;

      const parsed = new Date(this.customDate + 'T00:00:00');
      if (!isNaN(parsed.getTime())) {
        this.pickerDate = parsed;
      }
      this.renderDatePicker();
      sheet.classList.remove('translate-y-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    private closeDatePicker() {
      const sheet = document.getElementById('wrapup-date-picker-sheet');
      const overlay = document.getElementById('wrapup-date-picker-overlay');
      if (!sheet || !overlay) return;
      sheet.style.transform = '';
      sheet.classList.add('translate-y-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
    }

    private renderDatePicker() {
      const grid = document.getElementById('wrapup-date-grid');
      const monthYear = document.getElementById('wrapup-date-month-year');
      if (!grid || !monthYear) return;

      const year = this.pickerDate.getFullYear();
      const month = this.pickerDate.getMonth();
      const monthName = this.pickerDate.toLocaleDateString('ro-RO', { month: 'long' });
      monthYear.textContent = `${monthName} ${year}`;

      const firstDayOfMonth = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const startOffset = firstDayOfMonth === 0 ? 6 : firstDayOfMonth - 1;
      const todayStr = new Date().toISOString().split('T')[0];

      grid.innerHTML = '';

      for (let i = 0; i < startOffset; i++) {
        grid.appendChild(document.createElement('div'));
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const dateObj = new Date(year, month, d);
        const dayOfWeek = dateObj.getDay();
        const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
        const dateStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}`;
        const isSelected = dateStr === this.customDate;
        const isToday = dateStr === todayStr;

        const btn = document.createElement('button');
        btn.type = 'button';

        if (isWeekend) {
          btn.disabled = true;
          btn.className = 'aspect-square rounded-2xl text-sm font-extrabold bg-black/5 text-black/30 pointer-events-none cursor-not-allowed';
          btn.style.backgroundImage = 'repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(0,0,0,0.06) 4px, rgba(0,0,0,0.06) 8px)';
        } else {
          btn.className = `aspect-square rounded-2xl text-sm font-extrabold transition-all active:scale-95 ${
            isSelected
              ? 'bg-black text-white shadow-lg'
              : isToday
                ? 'bg-brand-primary text-black'
                : 'bg-black/5 text-black hover:bg-black/10'
          }`;
          btn.addEventListener('click', () => {
            this.customDate = dateStr;
            this.updateCustomDateTimeDisplay();
            this.renderDatePicker();
          });
        }

        btn.textContent = d.toString();
        grid.appendChild(btn);
      }
    }

    // --- Custom Time Picker ---
    private openTimePicker() {
      const sheet = document.getElementById('wrapup-time-picker-sheet');
      const overlay = document.getElementById('wrapup-time-picker-overlay');
      if (!sheet || !overlay) return;

      const parts = this.customTime.split(':');
      this.selectedHour = parts[0] || '08';
      this.selectedMinute = parts[1] || '00';

      const hourEl = document.getElementById('wrapup-time-hour');
      const minuteEl = document.getElementById('wrapup-time-minute');
      if (hourEl) hourEl.textContent = this.selectedHour;
      if (minuteEl) minuteEl.textContent = this.selectedMinute;

      this.renderTimeGrids();
      sheet.classList.remove('translate-y-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    private closeTimePicker() {
      const sheet = document.getElementById('wrapup-time-picker-sheet');
      const overlay = document.getElementById('wrapup-time-picker-overlay');
      if (!sheet || !overlay) return;
      this.customTime = `${this.selectedHour}:${this.selectedMinute}`;
      this.updateCustomDateTimeDisplay();
      sheet.style.transform = '';
      sheet.classList.add('translate-y-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
    }

    private bindPickerSwipe(sheetId: string, onClose: () => void) {
      const sheet = document.getElementById(sheetId);
      if (!sheet) return;

      let startY = 0;
      sheet.addEventListener('touchstart', (e: any) => {
        startY = e.touches[0].clientY;
      }, { passive: true });
      sheet.addEventListener('touchmove', (e: any) => {
        const deltaY = e.touches[0].clientY - startY;
        if (deltaY > 0) {
          sheet.style.transition = 'none';
          sheet.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });
      sheet.addEventListener('touchend', (e: any) => {
        const deltaY = (e.changedTouches[0].clientY || 0) - startY;
        sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 150) {
          onClose();
        } else {
          sheet.style.transform = 'translateY(0)';
        }
      });
    }

    private bindSheetSwipe() {
      const sheet = this.content;
      const handle = document.getElementById('wrapup-drag-handle');
      if (!sheet) return;

      let startY = 0;
      let isDragging = false;

      const onStart = (clientY: number) => {
        startY = clientY;
        isDragging = true;
      };
      const onMove = (clientY: number) => {
        if (!isDragging) return;
        const deltaY = clientY - startY;
        if (deltaY > 0) {
          sheet.style.transition = 'none';
          sheet.style.transform = `translateY(${deltaY}px)`;
        }
      };
      const onEnd = (clientY: number) => {
        if (!isDragging) return;
        isDragging = false;
        const deltaY = clientY - startY;
        sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 120) {
          this.close();
        } else {
          sheet.style.transform = 'translateY(0)';
        }
      };

      handle?.addEventListener('touchstart', (e: any) => onStart(e.touches[0].clientY), { passive: true });
      handle?.addEventListener('touchmove', (e: any) => onMove(e.touches[0].clientY), { passive: true });
      handle?.addEventListener('touchend', (e: any) => onEnd(e.changedTouches[0].clientY), { passive: true });

      sheet.addEventListener('touchstart', (e: any) => onStart(e.touches[0].clientY), { passive: true });
      sheet.addEventListener('touchmove', (e: any) => onMove(e.touches[0].clientY), { passive: true });
      sheet.addEventListener('touchend', (e: any) => onEnd(e.changedTouches[0].clientY), { passive: true });
    }

    private renderTimeGrids() {
      const hoursGrid = document.getElementById('wrapup-time-hours-grid');
      const minutesGrid = document.getElementById('wrapup-time-minutes-grid');
      const hoursList = ['07','08','09','10','11','12','13','14','15','16','17','18'];
      const minutesList = ['00','15','30','45'];

      if (hoursGrid) {
        hoursGrid.innerHTML = '';
        hoursList.forEach(h => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSel = h === this.selectedHour;
          btn.className = `py-2 rounded-xl font-extrabold text-sm transition-all ${
            isSel ? 'bg-brand-secondary text-white shadow-sm scale-105' : 'bg-surface-base hover:bg-brand-primary/30 text-text-main'
          }`;
          btn.textContent = h;
          btn.addEventListener('click', () => {
            this.selectedHour = h;
            const hd = document.getElementById('wrapup-time-hour');
            if (hd) hd.textContent = h;
            this.renderTimeGrids();
          });
          hoursGrid.appendChild(btn);
        });
      }

      if (minutesGrid) {
        minutesGrid.innerHTML = '';
        minutesList.forEach(m => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSel = m === this.selectedMinute;
          btn.className = `py-2 rounded-xl font-extrabold text-sm transition-all ${
            isSel ? 'bg-brand-secondary text-white shadow-sm scale-105' : 'bg-surface-base hover:bg-brand-primary/30 text-text-main'
          }`;
          btn.textContent = m;
          btn.addEventListener('click', () => {
            this.selectedMinute = m;
            const md = document.getElementById('wrapup-time-minute');
            if (md) md.textContent = m;
            this.renderTimeGrids();
          });
          minutesGrid.appendChild(btn);
        });
      }
    }

    private updateCustomDateTimeDisplay() {
      const dateDisplay = document.getElementById('wrapup-display-date');
      const timeDisplay = document.getElementById('wrapup-display-time');
      if (dateDisplay) {
        const parsed = new Date(this.customDate + 'T00:00:00');
        if (!isNaN(parsed.getTime())) {
          const fmt = parsed.toLocaleDateString('ro-RO', { day: 'numeric', month: 'short', weekday: 'short' });
          dateDisplay.textContent = fmt;
        } else {
          dateDisplay.textContent = '--';
        }
      }
      if (timeDisplay) timeDisplay.textContent = this.customTime;
    }

    private open() {
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.sheet.classList.remove('hidden');
      this.content.style.transform = '';
      void this.sheet.offsetWidth;
      this.backdrop.classList.remove('opacity-0');
      this.content.classList.remove('translate-y-full');
    }

    private close() {
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.closeDatePicker();
      this.closeTimePicker();
      this.backdrop.classList.add('opacity-0');
      this.content.style.transform = '';
      this.content.classList.add('translate-y-full');
      setTimeout(() => {
        if (this.sheet) this.sheet.classList.add('hidden');
        this.currentAppointment = null;
      }, 500);
    }
  }

  let globalWrapUpManager: WrapUpSheetManager | null = null;

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('session-wrapup-sheet')) return;

    if (!globalWrapUpManager) {
      globalWrapUpManager = new WrapUpSheetManager();
    }
  });
</script>

