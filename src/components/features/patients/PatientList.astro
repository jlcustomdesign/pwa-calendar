---
// Dynamic Patient List Component
---

<div class="mb-6 space-y-4">
  <!-- Search Bar and Add Button -->
  <div class="flex gap-3" id="patient-search-row">
    <div class="relative flex-1 min-w-0">
      <input type="text" id="patient-search" placeholder="Căutare pacient..." class="w-full bg-white rounded-full py-3.5 pl-12 pr-4 text-black focus:outline-none border border-transparent shadow-sm text-base font-extrabold h-[56px]" />
      <svg class="w-5 h-5 absolute left-4 top-[18px] text-black/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <button 
      id="add-patient-btn"
      class="h-[56px] shrink-0 rounded-full bg-brand-primary hover:brightness-105 text-black flex items-center justify-center shadow-md shadow-amber-500/15 active:scale-95 transition-all cursor-pointer"
    >
      <svg class="w-6 h-6 shrink-0 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      <span class="add-label font-extrabold text-base text-black">Adaugă</span>
    </button>
  </div>

  <style>
    /* Pill <-> circle morph for the Adaugă button while searching */
    #add-patient-btn {
      width: auto;
      padding: 0 20px;
      transition: width 0.6s cubic-bezier(0.32, 0.72, 0, 1),
                  padding 0.6s cubic-bezier(0.32, 0.72, 0, 1),
                  transform 0.15s ease;
    }
    #add-patient-btn .add-label {
      display: inline-block;
      max-width: 90px;
      opacity: 1;
      margin-left: 8px;
      overflow: hidden;
      white-space: nowrap;
      transition: max-width 0.55s cubic-bezier(0.32, 0.72, 0, 1),
                  opacity 0.3s ease,
                  margin-left 0.55s cubic-bezier(0.32, 0.72, 0, 1);
    }
    #patient-search-row.search-active #add-patient-btn {
      width: 52px !important; /* !important overrides the inline measured width so it can transition */
      padding: 0;
    }
    #patient-search-row.search-active #add-patient-btn .add-label {
      max-width: 0;
      opacity: 0;
      margin-left: 0;
    }
  </style>
  <!-- Unified Filter + Sort Dropdown -->
  <div class="relative inline-block" id="patient-filter-sort-wrapper">
    <button
      type="button"
      id="patient-filter-sort-trigger"
      class="flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-black/10 shadow-sm text-sm font-extrabold text-black active:scale-95 transition-all"
    >
      <svg class="w-4 h-4 text-black/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      <span id="filter-sort-label">Toți · Nume</span>
      <svg class="w-4 h-4 text-black/60 transition-transform duration-200" id="filter-sort-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>

    <!-- Dropdown Panel -->
    <div id="patient-filter-sort-panel" class="absolute left-0 top-full mt-2 w-80 sm:w-96 bg-surface-card rounded-2xl p-5 shadow-xl border border-black/5 opacity-0 invisible scale-95 origin-top-left transition-all duration-200 z-50">
      <!-- Filters -->
      <div class="mb-5">
        <h4 class="text-xs font-black uppercase tracking-wider text-text-muted mb-3">Filtre</h4>
        <div id="filter-options" class="grid grid-cols-2 gap-2">
          <button type="button" data-filter="all" class="filter-option-btn px-3 py-3 rounded-xl bg-brand-primary text-black font-extrabold text-sm text-center transition-all active:scale-95">Toți</button>
          <button type="button" data-filter="belaqva" class="filter-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Belaqva</button>
          <button type="button" data-filter="ghimbav" class="filter-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Ghimbav</button>
          <button type="button" data-filter="unpaid" class="filter-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Neachitați</button>
          <button type="button" data-filter="paid" class="filter-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Achitați</button>
          <button type="button" data-filter="expired" class="filter-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Expirați</button>
        </div>
      </div>

      <!-- Sort -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-text-muted mb-3">Sortare</h4>
        <div id="sort-options" class="grid grid-cols-2 gap-2">
          <button type="button" data-sort="name" class="sort-option-btn px-3 py-3 rounded-xl bg-brand-primary text-black font-extrabold text-sm text-center transition-all active:scale-95">Nume</button>
          <button type="button" data-sort="expired" class="sort-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Expirat</button>
          <button type="button" data-sort="progress" class="sort-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Progres</button>
          <button type="button" data-sort="payment" class="sort-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">Plată</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="patient-list-container" class="space-y-4 pb-32 overflow-x-hidden">
  <!-- Populated by JS -->
</div>

<!-- Skeleton loader: shown only while fetching from DB -->
<div id="patient-list-skeleton" class="hidden space-y-4 pb-32 overflow-x-hidden">
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
</div>

<!-- Empty State Template -->
<template id="patient-empty-state">
  <div class="p-8 text-center bg-surface-card rounded-2xl border border-transparent">
    <div class="w-16 h-16 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
    </div>
    <h3 class="font-bold text-lg text-black mb-1">Niciun pacient momentan</h3>
    <p class="text-sm text-text-muted">Adaugă primul pacient pentru a începe.</p>
  </div>
</template>

<script>
  import { getPatients, deletePatient as deletePatientDB, isRenewalDismissed } from '../../../lib/services/patientService';
  import { getSettings } from '../../../lib/services/settingsService';
  import { escapeHtml } from '../../../utils/html';

  class PatientListManager {
    container: HTMLElement | null;
    currentSearchQuery: string = '';
    activeFilters: string[] = ['all'];
    currentSort: string = 'name';
    availableCategories: string[] = ['Belaqva', 'Ghimbav', 'Neachitați', 'Achitați', 'Expirați'];

    readonly categoryToFilterKey: Record<string, string> = {
      'Belaqva': 'belaqva',
      'Ghimbav': 'ghimbav',
      'Neachitați': 'unpaid',
      'Achitați': 'paid',
      'Expirați': 'expired',
    };

    constructor() {
      this.container = document.getElementById('patient-list-container');
      this.clearOldLocalStorage();
      this.bindEvents();
      this.init();
    }

    async init() {
      await this.loadActiveCategories();
      this.renderFilterButtons();
      await this.render();
    }

    clearOldLocalStorage() {
      // Curățare definitivă mock-uri vechi din localStorage
      localStorage.removeItem('kineto_patients');
      localStorage.removeItem('mock_patients_initialized_v4');
    }

    bindEvents() {
      // Prevent duplicate global listeners
      if (!(window as any)._patientEventsBound) {
        window.addEventListener('patientsUpdated', async (e: any) => {
          const c = document.getElementById('patient-list-container');
          if (!c) return;
          this.container = c;
          // Dacă evenimentul vine de la o ștergere făcută de acest list, nu re-renderăm întreaga listă.
          // Cardul a fost deja eliminat optimist din DOM; re-fetch-ul ar crea doar un flash și un call DB.
          if (e.detail?.source === 'patientListDelete') {
            return;
          }
          // După o plată, așteptăm puțin ca replica de citire Supabase să fie la zi.
          if (e.detail?.source === 'paymentSheet') {
            await new Promise(r => setTimeout(r, 300));
          }
          await this.render();
        });

        window.addEventListener('settingsUpdated', async () => {
          await this.loadActiveCategories();
          this.renderFilterButtons();
          await this.render();
        });
        (window as any)._patientEventsBound = true;
      }
      
      this.bindLocalEvents();
    }

    bindLocalEvents() {
      const searchInput = document.getElementById('patient-search') as HTMLInputElement;
      if (searchInput && searchInput.dataset.patientLocalBound !== 'true') {
        searchInput.dataset.patientLocalBound = 'true';
        searchInput.addEventListener('input', (e) => {
          this.currentSearchQuery = (e.target as HTMLInputElement).value.toLowerCase();
          this.render();
        });

        // Morph the Adaugă pill into a circle while the search is active
        const searchRow = document.getElementById('patient-search-row');
        const addBtn = document.getElementById('add-patient-btn') as HTMLElement | null;
        let addBtnResetTimer: number | undefined;
        searchInput.addEventListener('focus', () => {
          if (!searchRow || !addBtn) return;
          clearTimeout(addBtnResetTimer);
          addBtn.style.width = `${addBtn.offsetWidth}px`;
          void addBtn.offsetWidth;
          searchRow.classList.add('search-active');
        });
        searchInput.addEventListener('blur', () => {
          if (!searchRow || !addBtn) return;
          if (!searchInput.value.trim()) {
            searchRow.classList.remove('search-active');
            addBtnResetTimer = window.setTimeout(() => {
              addBtn.style.width = '';
            }, 650);
          }
        });

        addBtn.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('openAddPatient'));
        });
      }

      // Unified filter + sort panel
      this.bindFilterSortPanel();
    }

    bindFilterSortPanel() {
      const wrapper = document.getElementById('patient-filter-sort-wrapper');
      const trigger = document.getElementById('patient-filter-sort-trigger');
      const panel = document.getElementById('patient-filter-sort-panel');
      const chevron = document.getElementById('filter-sort-chevron');
      if (!trigger || !panel || !wrapper) return;

      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';

      const openPanel = () => {
        panel.classList.remove('opacity-0', 'invisible', 'scale-95');
        panel.classList.add('opacity-100', 'visible', 'scale-100');
        if (chevron) chevron.style.transform = 'rotate(180deg)';
        this.updateFilterSortPanelUI();
      };

      const closePanel = () => {
        panel.classList.add('opacity-0', 'invisible', 'scale-95');
        panel.classList.remove('opacity-100', 'visible', 'scale-100');
        if (chevron) chevron.style.transform = '';
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = panel.classList.contains('visible');
        if (isOpen) closePanel();
        else openPanel();
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target as Node)) {
          closePanel();
        }
      });

      // Filter options (multi-select toggle)
      const filterContainer = document.getElementById('filter-options');
      filterContainer?.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = (e.target as HTMLElement).closest('.filter-option-btn') as HTMLElement;
        if (!target) return;
        this.toggleFilter(target.getAttribute('data-filter') || 'all');
        this.updateFilterSortPanelUI();
        this.render();
        closePanel();
      });

      // Sort options
      const sortContainer = document.getElementById('sort-options');
      sortContainer?.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = (e.target as HTMLElement).closest('.sort-option-btn') as HTMLElement;
        if (!target) return;
        this.currentSort = target.getAttribute('data-sort') || 'name';
        this.updateFilterSortPanelUI();
        this.render();
        closePanel();
      });
    }

    toggleFilter(filter: string) {
      if (filter === 'all') {
        this.activeFilters = ['all'];
        return;
      }

      let next = new Set(this.activeFilters);
      next.delete('all');

      if (next.has(filter)) {
        next.delete(filter);
      } else {
        next.add(filter);
      }

      this.activeFilters = next.size > 0 ? Array.from(next) : ['all'];
    }

    async loadActiveCategories() {
      try {
        const settings = await getSettings();
        if (Array.isArray(settings.active_categories) && settings.active_categories.length > 0) {
          this.availableCategories = settings.active_categories;
        }
      } catch (e) {
        console.warn('Eroare încărcare categorii active:', e);
      }

      // Dacă un filtru activ a devenit inactiv în settings, îl resetăm
      const validKeys = new Set(['all', ...this.availableCategories.map((c) => this.categoryToFilterKey[c] || c)]);
      this.activeFilters = this.activeFilters.filter((f) => validKeys.has(f));
      if (this.activeFilters.length === 0) this.activeFilters = ['all'];
    }

    renderFilterButtons() {
      const filterContainer = document.getElementById('filter-options');
      if (!filterContainer) return;

      filterContainer.innerHTML = `
        <button type="button" data-filter="all" class="filter-option-btn px-3 py-3 rounded-xl bg-brand-primary text-black font-extrabold text-sm text-center transition-all active:scale-95">Toți</button>
        ${this.availableCategories.map((cat) => {
          const key = this.categoryToFilterKey[cat] || cat;
          return `<button type="button" data-filter="${key}" class="filter-option-btn px-3 py-3 rounded-xl bg-white text-black border border-black/10 font-extrabold text-sm text-center transition-all active:scale-95">${cat}</button>`;
        }).join('')}
      `;
    }

    updateFilterSortPanelUI() {
      const filterContainer = document.getElementById('filter-options');
      filterContainer?.querySelectorAll('.filter-option-btn').forEach((btn) => {
        const isActive = this.activeFilters.includes((btn as HTMLElement).getAttribute('data-filter') || '');
        if (isActive) {
          btn.classList.remove('bg-white', 'border', 'border-black/10');
          btn.classList.add('bg-brand-primary', 'text-black');
        } else {
          btn.classList.remove('bg-brand-primary', 'text-black');
          btn.classList.add('bg-white', 'text-black', 'border', 'border-black/10');
        }
      });

      const sortContainer = document.getElementById('sort-options');
      sortContainer?.querySelectorAll('.sort-option-btn').forEach((btn) => {
        const isActive = (btn as HTMLElement).getAttribute('data-sort') === this.currentSort;
        if (isActive) {
          btn.classList.remove('bg-white', 'border', 'border-black/10');
          btn.classList.add('bg-brand-primary', 'text-black');
        } else {
          btn.classList.remove('bg-brand-primary', 'text-black');
          btn.classList.add('bg-white', 'text-black', 'border', 'border-black/10');
        }
      });

      this.updateFilterSortLabel();
    }

    updateFilterSortLabel() {
      const label = document.getElementById('filter-sort-label');
      if (!label) return;
      const filterLabels: Record<string, string> = {
        all: 'Toți',
        belaqva: 'Belaqva',
        ghimbav: 'Ghimbav',
        unpaid: 'Neachitați',
        paid: 'Achitați',
        expired: 'Expirați'
      };
      const sortLabels: Record<string, string> = {
        name: 'Nume',
        expired: 'Expirat',
        progress: 'Progres',
        payment: 'Plată'
      };
      let filterLabel = 'Toți';
      if (!this.activeFilters.includes('all') && this.activeFilters.length > 0) {
        if (this.activeFilters.length === 1) {
          filterLabel = filterLabels[this.activeFilters[0]] || this.activeFilters[0];
        } else {
          filterLabel = `${this.activeFilters.length} filtre`;
        }
      }
      label.textContent = `${filterLabel} · ${sortLabels[this.currentSort] || 'Nume'}`;
    }

    async deletePatient(id: string) {
      try {
        const cardWrapper = this.container?.querySelector(`[data-patient-id="${id}"]`) as HTMLElement | null;
        if (cardWrapper) {
          cardWrapper.style.transition = 'all 300ms cubic-bezier(0.4, 0, 0.2, 1)';
          cardWrapper.style.opacity = '0';
          cardWrapper.style.maxHeight = '0px';
          cardWrapper.style.transform = 'scale(0.95)';
          cardWrapper.style.marginBottom = '0px';
          cardWrapper.style.overflow = 'hidden';
          setTimeout(() => cardWrapper.remove(), 300);
        }

        await deletePatientDB(id);
        (window as any).showToast('Pacientul a fost șters cu succes.', 'success');
        window.dispatchEvent(new CustomEvent('patientsUpdated', {
          detail: { source: 'patientListDelete', deletedId: id }
        }));
      } catch (err: any) {
        (window as any).showToast('Eroare la ștergerea pacientului: ' + err.message, 'error');
        this.render();
      }
    }

    editPatient(patient: any) {
      if (!patient) return;
      window.dispatchEvent(new CustomEvent('openAddPatient', {
        detail: {
          isEdit: true,
          patient: patient
        }
      }));
    }

    bookSession(patientName: string) {
      window.dispatchEvent(new CustomEvent('openAddSession', {
        detail: {
          patientName: patientName,
          showDateTime: true
        }
      }));
    }

    async render() {
      if (!this.container) return;

      const skeleton = document.getElementById('patient-list-skeleton');
      if (skeleton && this.container.children.length === 0) {
        this.container.classList.add('hidden');
        skeleton.classList.remove('hidden');
      }

      let patients: any[] = [];
      try {
        const filtersActive = !this.activeFilters.includes('all') && this.activeFilters.length > 0;

        const activeLocations = filtersActive
          ? this.activeFilters.filter((f: string) => f === 'belaqva' || f === 'ghimbav')
          : [];
        const activePayments = filtersActive
          ? this.activeFilters.filter((f: string) => f === 'unpaid' || f === 'paid')
          : [];
        const expiredActive = filtersActive && this.activeFilters.includes('expired');

        patients = await getPatients({
          search: this.currentSearchQuery || undefined
        });

        if (filtersActive) {
          patients = patients.filter((p: any) => {
            const loc = (p.locatie || '').toLowerCase();
            const locMatch =
              activeLocations.length === 0 ||
              activeLocations.some((f: string) => {
                if (f === 'belaqva') return loc === 'belaqva' || loc === 'belaqua';
                if (f === 'ghimbav') return loc === 'ghimbav';
                return false;
              });

            let paymentMatch = true;
            if (activePayments.length > 0) {
              const suma = Number(p.suma_incasata || 0);
              const cost = Number(p.cost || 0);
              const isPaid = p.achitat || (cost > 0 && suma >= cost);
              paymentMatch = activePayments.some((f: string) => {
                if (f === 'paid') return isPaid;
                if (f === 'unpaid') return !isPaid;
                return false;
              });
            }

            const expiredMatch =
              !expiredActive ||
              ((p.sedinte_total || 0) > 0 && (p.sedinte_folosite || 0) >= (p.sedinte_total || 0));

            return locMatch && paymentMatch && expiredMatch;
          });
        }

        // Sortare
        patients = patients.slice().sort((a: any, b: any) => {
          const nameA = (a.name || '').toLowerCase();
          const nameB = (b.name || '').toLowerCase();

          if (this.currentSort === 'name') {
            return nameA.localeCompare(nameB, 'ro');
          }

          if (this.currentSort === 'expired') {
            const totalA = a.sedinte_total || 0;
            const usedA = a.sedinte_folosite || 0;
            const expiredA = totalA > 0 && usedA >= totalA ? 1 : 0;
            const totalB = b.sedinte_total || 0;
            const usedB = b.sedinte_folosite || 0;
            const expiredB = totalB > 0 && usedB >= totalB ? 1 : 0;
            if (expiredA !== expiredB) return expiredB - expiredA;
            return nameA.localeCompare(nameB, 'ro');
          }

          if (this.currentSort === 'progress') {
            const totalA = a.sedinte_total || 1;
            const totalB = b.sedinte_total || 1;
            const progA = Math.min(100, ((a.sedinte_folosite || 0) / totalA) * 100);
            const progB = Math.min(100, ((b.sedinte_folosite || 0) / totalB) * 100);
            if (progB !== progA) return progB - progA;
            return nameA.localeCompare(nameB, 'ro');
          }

          if (this.currentSort === 'payment') {
            const getPaymentRank = (p: any) => {
              const suma = Number(p.suma_incasata || 0);
              const cost = Number(p.cost || 0);
              if (p.achitat || (cost > 0 && suma >= cost)) return 2;
              if (suma > 0) return 1;
              return 0;
            };
            const rankA = getPaymentRank(a);
            const rankB = getPaymentRank(b);
            if (rankA !== rankB) return rankA - rankB;
            return nameA.localeCompare(nameB, 'ro');
          }

          return nameA.localeCompare(nameB, 'ro');
        });
      } catch (e) {
        console.error('Eroare citire pacienti:', e);
      }

      if (skeleton) skeleton.classList.add('hidden');
      this.container.classList.remove('hidden');

      if (patients.length === 0) {
        const template = document.getElementById('patient-empty-state') as HTMLTemplateElement;
        this.container.innerHTML = '';
        if (template) this.container.appendChild(template.content.cloneNode(true));
        return;
      }

      this.container.innerHTML = '';

      patients.forEach((patient: any) => {
        const locatie = patient.locatie || '';
        let isGhimbav = locatie.toLowerCase() === 'ghimbav';
        let isBelaqva = locatie.toLowerCase() === 'belaqva' || locatie.toLowerCase() === 'belaqua';

        const sumaIncasata = Number(patient.suma_incasata || 0);
        const costTotal = Number(patient.cost || 0);
        let paymentStatus = 'Neachitat';

        if (patient.achitat || (costTotal > 0 && sumaIncasata >= costTotal)) {
          paymentStatus = 'Achitat integral';
        } else if (sumaIncasata > 0) {
          paymentStatus = 'Achitat parțial';
        }

        let cardClasses = "bg-brand-primary text-black"; // default to Belaqva colors
        if (isGhimbav) {
          cardClasses = "bg-brand-secondary text-white";
        }

        const attendanceCount = patient.sedinte_folosite || 0;
        // ✅ FIX: fallback la 1 în loc de 10 pentru a nu arăta date gresite la Şdință unică
        const totalSessions = patient.sedinte_total || 1;
        let progressPercentage = Math.min(100, Math.round((attendanceCount / totalSessions) * 100));

        const isFullyPaid = paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat' || patient.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal);
        const restDePlata = isFullyPaid ? 0 : Math.max(0, costTotal - sumaIncasata);

        const cardWrapper = document.createElement('div');
        cardWrapper.className = 'block relative rounded-[2.5rem] shadow-sm overflow-hidden mb-4 mx-0 sm:mx-4';
        cardWrapper.setAttribute('data-patient-id', patient.id);

        // Action Background (History / Share Schedule / Edit / Delete)
        const actionsBg = document.createElement('div');
        actionsBg.className = 'absolute inset-0 bg-neutral-100 flex items-center justify-end px-4 z-0';
        actionsBg.innerHTML = `
          <div class="flex items-center gap-2.5">
            <button type="button" class="history-btn w-12 h-12 rounded-full bg-sky-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform border border-transparent" title="Istoric Plăți">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </button>
            <button type="button" class="edit-btn w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent" title="Editează pacientul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
            </button>
            <button type="button" class="delete-btn w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" title="Șterge pacientul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        `;

        // The foreground card
        const card = document.createElement('div');
        card.className = `swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}`;
        card.style.touchAction = 'pan-y'; // allow vertical scroll
        
        const planName = patient.plan === 'Subscription' || patient.plan === 'Abonament' ? 'Abonament' : (patient.plan === 'One Time' ? 'Ședință' : (patient.plan || 'Fără plan'));

        // Escape user-controlled values before inserting into HTML
        const safeName = escapeHtml(patient.name);
        const safePlanName = escapeHtml(planName);
        const safeLocatie = escapeHtml(locatie || 'Belaqva');
        const safeTelefon = escapeHtml(patient.telefon || '+1234567890');
        const safeDriveLink = escapeHtml(patient.drive_link || '#');
        const hasDriveLink = Boolean(patient.drive_link);

        const subscriptionDone = totalSessions > 0 && attendanceCount >= totalSessions;
        const displayCount = subscriptionDone ? totalSessions : attendanceCount;
        progressPercentage = subscriptionDone ? 100 : (totalSessions > 0 ? Math.min(100, Math.round((attendanceCount / totalSessions) * 100)) : 0);
        const progressBarFill = isGhimbav ? 'bg-brand-primary' : 'bg-brand-secondary';
        const progressBarTrack = isGhimbav ? 'bg-black/20' : 'bg-black/15';

        let paymentBadgeHtml = `<span class='text-sm font-black text-rose-900'>Neachitat</span>`;
        let paymentBadgeBgClass = 'bg-rose-50 hover:bg-rose-100 border-rose-200/60';

        if (paymentStatus === 'Achitat parțial' || (sumaIncasata > 0 && restDePlata > 0)) {
          paymentBadgeHtml = `<span class='text-sm font-black text-amber-900'>${sumaIncasata}/${costTotal || sumaIncasata} RON</span>`;
          paymentBadgeBgClass = 'bg-amber-50 hover:bg-amber-100 border-amber-200/60';
        } else if (isFullyPaid) {
          paymentBadgeHtml = `<span class='text-sm font-black text-emerald-900'>Achitat</span>`;
          paymentBadgeBgClass = 'bg-emerald-50 hover:bg-emerald-100 border-emerald-200/60';
        }

        const renewalDismissed = isRenewalDismissed(patient.id);
        const subscriptionWarningHtml = subscriptionDone && !renewalDismissed
          ? `<div class='pt-2 pb-2 space-y-2'><button type='button' class='renew-subscription-btn w-full h-12 rounded-2xl bg-black hover:bg-neutral-800 text-white text-base font-black tracking-wide shadow-md active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer border border-transparent opacity-100' data-patient-id='${patient.id}' data-total-sessions='${totalSessions}'><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg><span>Reînnoiește pachetul</span></button></div>`
          : '';

        const notificationBellHtml = subscriptionDone && !renewalDismissed
          ? `<button type='button' class='renew-subscription-btn shrink-0 px-3 py-1.5 rounded-full bg-black text-white text-xs font-black uppercase tracking-wider shadow-md active:scale-95 transition-all' data-patient-id='${patient.id}' data-total-sessions='${totalSessions}' title='Abonament terminat - Reînnoiește'>Reînnoiește</button>`
          : '';

        card.innerHTML = `
          <div class='card-summary relative z-20 flex flex-col justify-between p-6 space-y-4 cursor-pointer' ontouchstart="" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
            <!-- Top Row: Patient Name, Notification Bell & Book Session Button -->
            <div class='flex items-center gap-3 w-full justify-between'>
              <div class='flex-1 min-w-0'>
                <h4 class='text-xl sm:text-2xl font-black tracking-tight truncate'>${safeName}</h4>
              </div>
              <div class='flex items-center gap-2 shrink-0'>
                ${notificationBellHtml}
              </div>
            </div>
            
            <!-- Middle Row: Progress Bar -->
            <div class='flex items-center gap-4 relative z-10 pt-1'>
              <div class='h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative'>
                <div class='h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out' style='width: ${progressPercentage}%;'></div>
              </div>
              <div class='text-xs sm:text-sm font-black tracking-wide opacity-90 shrink-0'>${displayCount}/${totalSessions}</div>
            </div>
          </div>

          <!-- Expandable Details -->
          <div class='card-details grid' style='grid-template-rows: 0fr; transition: grid-template-rows 300ms ease;'>
            <div class='overflow-hidden min-h-0'>
              <div class='px-6 pb-6 space-y-3'>
                <!-- Plan & Location White Pill -->
                <div class='flex items-center justify-between px-5 py-3 rounded-2xl bg-white text-black text-sm font-extrabold shadow-sm border border-transparent'>
                  <span class='flex items-center gap-2 shrink-0 text-black'>
                    <svg class='w-4 h-4 text-black opacity-75 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'/>
                    </svg>
                    <span class='text-black font-black'>${safePlanName}</span>
                  </span>
                  <span class='flex items-center gap-2 shrink-0 text-black'>
                    <svg class='w-4 h-4 text-black opacity-75 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z'/>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 11a3 3 0 11-6 0 3 3 0 016 0z'/>
                    </svg>
                    <span class='text-black font-black'>${safeLocatie}</span>
                  </span>
                </div>

                <!-- Payment Badge + Phone + Folder Buttons -->
                <div class='flex items-center justify-between gap-3 pt-0.5'>
                  <button 
                    type='button'
                    class='open-payment-btn flex-1 h-12 flex flex-col items-center justify-center px-4 rounded-2xl ${paymentBadgeBgClass} border font-extrabold shadow-sm cursor-pointer transition-all active:scale-95'
                    data-patient-id='${patient.id}'
                  >
                    ${paymentBadgeHtml}
                  </button>

                  <div class='flex items-center gap-2 shrink-0'>
                    <a href='${patient.telefon ? `tel:${safeTelefon}` : '#'}' class='call-patient-btn w-12 h-12 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer' title='Sună pacientul' data-phone='${safeTelefon}' onclick='event.stopPropagation(); if (!${JSON.stringify(patient.telefon || '')}) { event.preventDefault(); if (window.showToast) { window.showToast("Pacientul nu are un număr de telefon salvat.", "info"); } else { alert("Pacientul nu are un număr de telefon salvat."); } }'>
                      <svg class='w-5 h-5 text-black opacity-85' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' />
                      </svg>
                    </a>

                    <a href='${safeDriveLink}' target='${hasDriveLink ? '_blank' : '_self'}' rel='noopener noreferrer' class='open-drive-btn w-12 h-12 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer' title='Deschide Dosar/Drive' data-drive-link='${safeDriveLink}'>
                      <svg class='w-5 h-5 text-black opacity-85' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z' />
                      </svg>
                    </a>
                  </div>
                </div>

                <!-- Buton Trimite Programul -->
                <button 
                  type='button'
                  class='w-full h-12 rounded-2xl bg-white hover:bg-neutral-50 text-black text-sm font-extrabold shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer border border-transparent share-schedule-btn'
                  data-patient-id='${patient.id}'
                  data-patient-name='${safeName}'
                  data-patient-phone='${escapeHtml(patient.telefon || '')}'
                  data-patient-location='${escapeHtml(patient.locatie || '')}'
                >
                  <svg class="w-5 h-5 text-black opacity-80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>Trimite programul</span>
                </button>

                <!-- Subscription Renewal Alert (if completed) -->
                ${subscriptionWarningHtml}
              </div>
            </div>
          </div>
        `;

        // Action buttons event bindings
        const editBtn = actionsBg.querySelector('.edit-btn');
        editBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.editPatient(patient);
        });

        const historyBtn = actionsBg.querySelector('.history-btn');
        historyBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: patient.id } }));
        });

        const deleteBtn = actionsBg.querySelector('.delete-btn');
        deleteBtn?.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const confirmed = await (window as any).showConfirm('Ștergere Pacient', `Sigur dorești să ștergi pacientul ${patient.name}?`);
          if (confirmed) {
            this.deletePatient(patient.id);
          }
        });

        // Securitate: evenimentele de mai jos sunt legate imperativ, nu prin onclick inline.
        card.querySelectorAll('.open-payment-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: patient.id } }));
          });
        });

        card.querySelectorAll('.share-schedule-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const el = btn as HTMLElement;
            window.dispatchEvent(new CustomEvent('openShareScheduleSheet', {
              detail: {
                patientId: el.dataset.patientId || patient.id,
                patientName: el.dataset.patientName || patient.name,
                patientPhone: el.dataset.patientPhone || patient.telefon || '',
                patientLocation: el.dataset.patientLocation || patient.locatie || ''
              }
            }));
          });
        });

        card.querySelectorAll('.renew-subscription-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const el = btn as HTMLElement;
            const sessions = parseInt(el.dataset.totalSessions || `${totalSessions}`, 10);
            (window as any).renewSubscription?.(patient.id, sessions, patient.name);
          });
        });

        const callLink = card.querySelector('.call-patient-btn');
        callLink?.addEventListener('click', (e) => {
          e.stopPropagation();
        });

        const driveLink = card.querySelector('.open-drive-btn') as HTMLAnchorElement | null;
        if (driveLink) {
          const rawLink = patient.drive_link || '';
          const isValid = /^https?:\/\//i.test(rawLink);
          if (!isValid) {
            driveLink.href = '#';
            driveLink.removeAttribute('target');
          }
          driveLink.addEventListener('click', (e) => {
            e.stopPropagation();
            if (!isValid) {
              e.preventDefault();
              (window as any).showToast?.('Pacientul nu are un link de dosar/Drive valid.', 'info');
            }
          });
        }

        cardWrapper.appendChild(actionsBg);
        cardWrapper.appendChild(card);
        if (this.container) {
          this.container.appendChild(cardWrapper);
        }
      });

      this.updateFilterSortLabel();
    }
  }

  let globalPatientListManager: PatientListManager | null = null;
  function bootPatientList() {
    if (!document.getElementById('patient-list-container')) return;
    
    if (!globalPatientListManager) {
      globalPatientListManager = new PatientListManager();
    } else {
      globalPatientListManager.container = document.getElementById('patient-list-container');
      globalPatientListManager.bindLocalEvents();
      globalPatientListManager.render();
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootPatientList();
  } else {
    document.addEventListener('DOMContentLoaded', bootPatientList);
  }
  document.addEventListener('astro:page-load', bootPatientList);

</script>
