---
// Dynamic Patient List Component
---

<div class="mb-6 space-y-4">
  <!-- Search Bar and Add Button -->
  <div class="flex gap-3" id="patient-search-row">
    <div class="relative flex-1 min-w-0">
      <input type="text" id="patient-search" placeholder="Căutare pacient..." class="w-full bg-white rounded-full py-3.5 pl-12 pr-4 text-black focus:outline-none border border-transparent shadow-sm text-base font-extrabold h-[56px]" />
      <svg class="w-5 h-5 absolute left-4 top-[18px] text-black/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <button 
      id="add-patient-btn"
      onclick="window.dispatchEvent(new CustomEvent('openAddPatient'))"
      class="h-[56px] shrink-0 rounded-full bg-brand-primary hover:brightness-105 text-black flex items-center justify-center shadow-md shadow-amber-500/15 active:scale-95 transition-all cursor-pointer"
    >
      <svg class="w-6 h-6 shrink-0 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      <span class="add-label font-extrabold text-base text-black">Adaugă</span>
    </button>
  </div>

  <style>
    /* Pill <-> circle morph for the Adaugă button while searching */
    #add-patient-btn {
      width: auto;
      padding: 0 20px;
      transition: width 0.6s cubic-bezier(0.32, 0.72, 0, 1),
                  padding 0.6s cubic-bezier(0.32, 0.72, 0, 1),
                  transform 0.15s ease;
    }
    #add-patient-btn .add-label {
      display: inline-block;
      max-width: 90px;
      opacity: 1;
      margin-left: 8px;
      overflow: hidden;
      white-space: nowrap;
      transition: max-width 0.55s cubic-bezier(0.32, 0.72, 0, 1),
                  opacity 0.3s ease,
                  margin-left 0.55s cubic-bezier(0.32, 0.72, 0, 1);
    }
    #patient-search-row.search-active #add-patient-btn {
      width: 52px !important; /* !important overrides the inline measured width so it can transition */
      padding: 0;
    }
    #patient-search-row.search-active #add-patient-btn .add-label {
      max-width: 0;
      opacity: 0;
      margin-left: 0;
    }
  </style>
  <!-- Filters (Horizontal Swipeable - dynamically synced with Settings -> Categorii) -->
  <div 
    id="patient-filters-bar"
    class="flex gap-2 overflow-x-auto pb-2 scrollbar-none no-scrollbar select-none touch-pan-x cursor-grab active:cursor-grabbing" 
    style="-webkit-overflow-scrolling: touch; touch-action: pan-x; overscroll-behavior-x: contain;"
  >
    <button class="filter-btn active px-5 py-2.5 rounded-full bg-brand-primary text-black font-extrabold text-sm whitespace-nowrap active:scale-95 transition-all shadow-sm shrink-0" data-filter="all">Toți</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all shrink-0" data-filter="belaqva">Belaqva</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all shrink-0" data-filter="ghimbav">Ghimbav</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all shrink-0" data-filter="unpaid">Neachitați</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all shrink-0" data-filter="paid">Achitați</button>
  </div>
</div>

<div id="patient-list-container" class="space-y-4 pb-32 overflow-x-hidden">
  <!-- Populated by JS -->
</div>

<!-- Skeleton loader: shown only while fetching from DB -->
<div id="patient-list-skeleton" class="hidden space-y-4 pb-32 overflow-x-hidden">
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
</div>

<!-- Empty State Template -->
<template id="patient-empty-state">
  <div class="p-8 text-center bg-surface-card rounded-2xl border border-transparent">
    <div class="w-16 h-16 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
    </div>
    <h3 class="font-bold text-lg text-black mb-1">Niciun pacient momentan</h3>
    <p class="text-sm text-text-muted">Adaugă primul pacient pentru a începe.</p>
  </div>
</template>

<script>
  import { getPatients, deletePatient as deletePatientDB, isRenewalDismissed } from '../../../lib/services/patientService';
  import { getSettings } from '../../../lib/services/settingsService';
  import { escapeHtml, escapeJsString } from '../../../utils/html';

  class PatientListManager {
    container: HTMLElement | null;
    currentSearchQuery: string = '';
    currentFilter: string = 'all';

    constructor() {
      this.container = document.getElementById('patient-list-container');
      this.clearOldLocalStorage();
      this.bindEvents();
      this.loadCategoryFilters();
      this.render();
    }

    clearOldLocalStorage() {
      // Curățare definitivă mock-uri vechi din localStorage
      localStorage.removeItem('kineto_patients');
      localStorage.removeItem('mock_patients_initialized_v4');
    }

    bindEvents() {
      // Prevent duplicate global listeners
      if (!(window as any)._patientEventsBound) {
        window.addEventListener('patientsUpdated', async (e: any) => {
          const c = document.getElementById('patient-list-container');
          if (!c) return;
          this.container = c;
          // Dacă evenimentul vine de la o ștergere făcută de acest list, nu re-renderăm întreaga listă.
          // Cardul a fost deja eliminat optimist din DOM; re-fetch-ul ar crea doar un flash și un call DB.
          if (e.detail?.source === 'patientListDelete') {
            return;
          }
          // După o plată, așteptăm puțin ca replica de citire Supabase să fie la zi.
          if (e.detail?.source === 'paymentSheet') {
            await new Promise(r => setTimeout(r, 300));
          }
          await this.render();
        });

        window.addEventListener('settingsUpdated', async () => {
          await this.loadCategoryFilters();
          await this.render();
        });
        (window as any)._patientEventsBound = true;
      }
      
      this.bindLocalEvents();
    }

    bindLocalEvents() {
      const searchInput = document.getElementById('patient-search') as HTMLInputElement;
      if (searchInput && searchInput.dataset.patientLocalBound !== 'true') {
        searchInput.dataset.patientLocalBound = 'true';
        searchInput.addEventListener('input', (e) => {
          this.currentSearchQuery = (e.target as HTMLInputElement).value.toLowerCase();
          this.render();
        });

        // Morph the Adaugă pill into a circle while the search is active
        const searchRow = document.getElementById('patient-search-row');
        const addBtn = document.getElementById('add-patient-btn') as HTMLElement | null;
        let addBtnResetTimer: number | undefined;
        searchInput.addEventListener('focus', () => {
          if (!searchRow || !addBtn) return;
          clearTimeout(addBtnResetTimer);
          addBtn.style.width = `${addBtn.offsetWidth}px`;
          void addBtn.offsetWidth;
          searchRow.classList.add('search-active');
        });
        searchInput.addEventListener('blur', () => {
          if (!searchRow || !addBtn) return;
          if (!searchInput.value.trim()) {
            searchRow.classList.remove('search-active');
            addBtnResetTimer = window.setTimeout(() => {
              addBtn.style.width = '';
            }, 650);
          }
        });
      }

      // Desktop drag-to-scroll for filters
      const filtersBar = document.getElementById('patient-filters-bar');
      if (filtersBar && filtersBar.dataset.dragBound !== 'true') {
        filtersBar.dataset.dragBound = 'true';
        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;

        filtersBar.addEventListener('mousedown', (e) => {
          isDown = true;
          startX = e.pageX - filtersBar.offsetLeft;
          scrollLeft = filtersBar.scrollLeft;
        });
        filtersBar.addEventListener('mouseleave', () => { isDown = false; });
        filtersBar.addEventListener('mouseup', () => { isDown = false; });
        filtersBar.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - filtersBar.offsetLeft;
          const walk = (x - startX) * 1.5;
          filtersBar.scrollLeft = scrollLeft - walk;
        });
      }
    }

    async loadCategoryFilters() {
      const filtersBar = document.getElementById('patient-filters-bar');
      if (!filtersBar) return;

      let rawCategories = ['Belaqva', 'Ghimbav', 'Neachitați', 'Achitați'];
      try {
        const settings = await getSettings();
        if (settings?.categories && settings.categories.length > 0) {
          rawCategories = settings.categories;
        }
      } catch (e) {
        console.warn('Eroare încărcare categorii setări:', e);
      }

      // Filter out any "Toți" from the custom categories list and deduplicate
      const cleanCategories: string[] = [];
      const seen = new Set<string>();

      rawCategories.forEach(c => {
        const trimmed = c.trim();
        const norm = trimmed.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        if (!trimmed || norm === 'toti' || norm === 'all' || seen.has(norm)) return;
        seen.add(norm);
        cleanCategories.push(trimmed);
      });

      // Clear bar completely
      filtersBar.innerHTML = '';

      // 1. Fixed unique master button: "Toți"
      const allBtn = document.createElement('button');
      const isAllActive = this.currentFilter === 'all';
      allBtn.className = `filter-btn ${isAllActive ? 'active bg-brand-primary text-black' : 'bg-white text-black border border-black/10'} px-5 py-2.5 rounded-full font-extrabold text-sm whitespace-nowrap active:scale-95 transition-all shadow-sm shrink-0 cursor-pointer`;
      allBtn.setAttribute('data-filter', 'all');
      allBtn.textContent = 'Toți';
      filtersBar.appendChild(allBtn);

      // Individual category buttons
      cleanCategories.forEach(cleanName => {
        const norm = cleanName.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

        let filterVal = norm;
        if (norm.includes('belaqva') || norm.includes('belaqua')) filterVal = 'belaqva';
        else if (norm.includes('ghimbav')) filterVal = 'ghimbav';
        else if (norm.includes('neachitat') || norm.includes('unpaid')) filterVal = 'unpaid';
        else if (norm.includes('achitat') || norm.includes('paid')) filterVal = 'paid';
        else filterVal = `custom:${cleanName}`;

        const isActive = this.currentFilter === filterVal;
        const btn = document.createElement('button');
        btn.className = `filter-btn ${isActive ? 'active bg-brand-primary text-black' : 'bg-white text-black border border-black/10'} px-5 py-2.5 rounded-full font-extrabold text-sm whitespace-nowrap active:scale-95 transition-all shadow-sm shrink-0 cursor-pointer`;
        btn.setAttribute('data-filter', filterVal);
        btn.textContent = cleanName;
        filtersBar.appendChild(btn);
      });

      // Bind delegated click handler ONCE on the filtersBar if not already bound
      if (filtersBar.dataset.clickBound !== 'true') {
        filtersBar.dataset.clickBound = 'true';
        filtersBar.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest('.filter-btn') as HTMLElement;
          if (!target) return;

          filtersBar.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('active', 'bg-brand-primary');
            b.classList.add('bg-white', 'border', 'border-black/10', 'shadow-sm');
          });
          target.classList.remove('bg-white', 'border', 'border-black/10');
          target.classList.add('active', 'bg-brand-primary');
          
          this.currentFilter = target.getAttribute('data-filter') || 'all';
          this.render();
        });
      }
    }

    async deletePatient(id: string) {
      try {
        const cardWrapper = this.container?.querySelector(`[data-patient-id="${id}"]`) as HTMLElement | null;
        if (cardWrapper) {
          cardWrapper.style.transition = 'all 300ms cubic-bezier(0.4, 0, 0.2, 1)';
          cardWrapper.style.opacity = '0';
          cardWrapper.style.maxHeight = '0px';
          cardWrapper.style.transform = 'scale(0.95)';
          cardWrapper.style.marginBottom = '0px';
          cardWrapper.style.overflow = 'hidden';
          setTimeout(() => cardWrapper.remove(), 300);
        }

        await deletePatientDB(id);
        (window as any).showToast('Pacientul a fost șters cu succes.', 'success');
        window.dispatchEvent(new CustomEvent('patientsUpdated', {
          detail: { source: 'patientListDelete', deletedId: id }
        }));
      } catch (err: any) {
        (window as any).showToast('Eroare la ștergerea pacientului: ' + err.message, 'error');
        this.render();
      }
    }

    editPatient(patient: any) {
      if (!patient) return;
      window.dispatchEvent(new CustomEvent('openAddPatient', {
        detail: {
          isEdit: true,
          patient: patient
        }
      }));
    }

    bookSession(patientName: string) {
      window.dispatchEvent(new CustomEvent('openAddSession', {
        detail: {
          patientName: patientName,
          showDateTime: true
        }
      }));
    }

    async render() {
      if (!this.container) return;

      const skeleton = document.getElementById('patient-list-skeleton');
      if (skeleton && this.container.children.length === 0) {
        this.container.classList.add('hidden');
        skeleton.classList.remove('hidden');
      }

      let patients: any[] = [];
      try {
        let locationFilter: 'Belaqva' | 'Ghimbav' | undefined = undefined;
        let achitatFilter: boolean | undefined = undefined;

        if (this.currentFilter === 'ghimbav') locationFilter = 'Ghimbav';
        else if (this.currentFilter === 'belaqva') locationFilter = 'Belaqva';
        else if (this.currentFilter === 'unpaid') achitatFilter = false;
        else if (this.currentFilter === 'paid') achitatFilter = true;

        patients = await getPatients({
          locatie: locationFilter,
          achitat: achitatFilter,
          search: this.currentSearchQuery || undefined
        });

        // Filtru pentru categorii custom dacă utilizatorul a definit alte etichete
        if (this.currentFilter.startsWith('custom:')) {
          const customTerm = this.currentFilter.replace('custom:', '').toLowerCase().trim();
          patients = patients.filter((p: any) => {
            const plan = (p.plan || '').toLowerCase();
            const loc = (p.locatie || '').toLowerCase();
            const name = (p.name || '').toLowerCase();
            const notes = (p.observatii || '').toLowerCase();
            return plan.includes(customTerm) || loc.includes(customTerm) || name.includes(customTerm) || notes.includes(customTerm);
          });
        }
      } catch (e) {
        console.error('Eroare citire pacienti:', e);
      }

      if (skeleton) skeleton.classList.add('hidden');
      this.container.classList.remove('hidden');

      if (patients.length === 0) {
        const template = document.getElementById('patient-empty-state') as HTMLTemplateElement;
        this.container.innerHTML = '';
        if (template) this.container.appendChild(template.content.cloneNode(true));
        return;
      }

      this.container.innerHTML = '';

      patients.forEach((patient: any) => {
        const locatie = patient.locatie || '';
        let isGhimbav = locatie.toLowerCase() === 'ghimbav';
        let isBelaqva = locatie.toLowerCase() === 'belaqva' || locatie.toLowerCase() === 'belaqua';

        const sumaIncasata = Number(patient.suma_incasata || 0);
        const costTotal = Number(patient.cost || 0);
        let paymentStatus = 'Neachitat';

        if (patient.achitat || (costTotal > 0 && sumaIncasata >= costTotal)) {
          paymentStatus = 'Achitat integral';
        } else if (sumaIncasata > 0) {
          paymentStatus = 'Achitat parțial';
        }

        let cardClasses = "bg-brand-primary text-black"; // default to Belaqva colors
        if (isGhimbav) {
          cardClasses = "bg-brand-secondary text-white";
        }

        const attendanceCount = patient.sedinte_folosite || 0;
        const totalSessions = patient.sedinte_total || 10;
        let progressPercentage = Math.min(100, Math.round((attendanceCount / totalSessions) * 100));

        const isFullyPaid = paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat' || patient.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal);
        const restDePlata = isFullyPaid ? 0 : Math.max(0, costTotal - sumaIncasata);

        const cardWrapper = document.createElement('div');
        cardWrapper.className = 'block relative rounded-[2.5rem] shadow-sm overflow-hidden mb-4 mx-0 sm:mx-4';
        cardWrapper.setAttribute('data-patient-id', patient.id);

        // Action Background (History / Share Schedule / Edit / Delete)
        const actionsBg = document.createElement('div');
        actionsBg.className = 'absolute inset-0 bg-neutral-100 flex items-center justify-end px-4 z-0';
        actionsBg.innerHTML = `
          <div class="flex items-center gap-2.5">
            <button type="button" class="history-btn w-12 h-12 rounded-full bg-sky-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform border border-transparent" title="Istoric Plăți">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </button>
            <button type="button" class="share-schedule-swipe-btn w-12 h-12 rounded-full bg-amber-400 shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent" title="Trimite programul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </button>
            <button type="button" class="edit-btn w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent" title="Editează pacientul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
            </button>
            <button type="button" class="delete-btn w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" title="Șterge pacientul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        `;

        // The foreground card
        const card = document.createElement('div');
        card.className = `swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}`;
        card.style.touchAction = 'pan-y'; // allow vertical scroll
        
        const planName = patient.plan === 'Subscription' || patient.plan === 'Abonament' ? 'Abonament' : (patient.plan === 'One Time' ? 'Ședință' : (patient.plan || 'Fără plan'));

        // Escape user-controlled values before inserting into HTML
        const safeName = escapeHtml(patient.name);
        const safeNameJs = escapeJsString(patient.name || '');
        const safePlanName = escapeHtml(planName);
        const safeLocatie = escapeHtml(locatie || 'Belaqva');
        const safeTelefon = escapeHtml(patient.telefon || '+1234567890');
        const safeDriveLink = escapeHtml(patient.drive_link || '#');
        const hasDriveLink = Boolean(patient.drive_link);

        const subscriptionDone = totalSessions > 0 && attendanceCount >= totalSessions;
        const displayCount = subscriptionDone ? totalSessions : attendanceCount;
        progressPercentage = subscriptionDone ? 100 : (totalSessions > 0 ? Math.min(100, Math.round((attendanceCount / totalSessions) * 100)) : 0);
        const progressBarFill = isGhimbav ? 'bg-brand-primary' : 'bg-brand-secondary';
        const progressBarTrack = isGhimbav ? 'bg-black/20' : 'bg-black/15';

        let paymentBadgeHtml = `<span class='text-sm font-black text-rose-900'>Neachitat</span>`;
        let paymentBadgeBgClass = 'bg-rose-50 hover:bg-rose-100 border-rose-200/60';

        if (paymentStatus === 'Achitat parțial' || (sumaIncasata > 0 && restDePlata > 0)) {
          paymentBadgeHtml = `<span class='text-sm font-black text-amber-900'>${sumaIncasata}/${costTotal || sumaIncasata} RON</span>`;
          paymentBadgeBgClass = 'bg-amber-50 hover:bg-amber-100 border-amber-200/60';
        } else if (isFullyPaid) {
          paymentBadgeHtml = `<span class='text-sm font-black text-emerald-900'>Achitat</span>`;
          paymentBadgeBgClass = 'bg-emerald-50 hover:bg-emerald-100 border-emerald-200/60';
        }

        const renewalDismissed = isRenewalDismissed(patient.id);
        const subscriptionWarningHtml = subscriptionDone && !renewalDismissed
          ? `<div class='pt-2 pb-2 space-y-2'><button type='button' class='w-full h-12 rounded-2xl bg-black hover:bg-neutral-800 text-white text-base font-black tracking-wide shadow-md active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer border border-transparent opacity-100' onclick='event.stopPropagation(); window.renewSubscription("${patient.id}", ${totalSessions}, "${safeNameJs}")'><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg><span>Reînnoiește pachetul</span></button></div>`
          : '';

        const notificationBellHtml = subscriptionDone && !renewalDismissed
          ? `<button type='button' onclick='event.stopPropagation(); window.renewSubscription("${patient.id}", ${totalSessions}, "${safeNameJs}")' class='shrink-0 px-3 py-1.5 rounded-full bg-black text-white text-xs font-black uppercase tracking-wider shadow-md active:scale-95 transition-all' title='Abonament terminat - Reînnoiește'>Reînnoiește</button>`
          : '';

        card.innerHTML = `
          <div class='card-summary relative z-20 flex flex-col justify-between p-6 space-y-4 cursor-pointer' ontouchstart="" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
            <!-- Top Row: Patient Name, Notification Bell & Book Session Button -->
            <div class='flex items-center gap-3 w-full justify-between'>
              <div class='flex-1 min-w-0'>
                <h4 class='text-xl sm:text-2xl font-black tracking-tight truncate'>${safeName}</h4>
              </div>
              <div class='flex items-center gap-2 shrink-0'>
                ${notificationBellHtml}
              </div>
            </div>
            
            <!-- Middle Row: Progress Bar -->
            <div class='flex items-center gap-4 relative z-10 pt-1'>
              <div class='h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative'>
                <div class='h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out' style='width: ${progressPercentage}%;'></div>
              </div>
              <div class='text-xs sm:text-sm font-black tracking-wide opacity-90 shrink-0'>${displayCount}/${totalSessions}</div>
            </div>
          </div>

          <!-- Expandable Details -->
          <div class='card-details grid' style='grid-template-rows: 0fr; transition: grid-template-rows 300ms ease;'>
            <div class='overflow-hidden min-h-0'>
              <div class='px-6 pb-6 space-y-3'>
                <!-- Plan & Location White Pill -->
                <div class='flex items-center justify-between px-5 py-3 rounded-2xl bg-white text-black text-sm font-extrabold shadow-sm border border-transparent'>
                  <span class='flex items-center gap-2 shrink-0 text-black'>
                    <svg class='w-4 h-4 text-black opacity-75 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'/>
                    </svg>
                    <span class='text-black font-black'>${safePlanName}</span>
                  </span>
                  <span class='flex items-center gap-2 shrink-0 text-black'>
                    <svg class='w-4 h-4 text-black opacity-75 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z'/>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 11a3 3 0 11-6 0 3 3 0 016 0z'/>
                    </svg>
                    <span class='text-black font-black'>${safeLocatie}</span>
                  </span>
                </div>

                <!-- Payment Badge + Phone + Folder Buttons -->
                <div class='flex items-center justify-between gap-3 pt-0.5'>
                  <button 
                    type='button'
                    class='flex-1 h-12 flex flex-col items-center justify-center px-4 rounded-2xl ${paymentBadgeBgClass} border font-extrabold shadow-sm cursor-pointer transition-all active:scale-95' 
                    onclick='event.stopPropagation(); window.dispatchEvent(new CustomEvent("openPaymentSheet", { detail: { patientId: "${patient.id}" } }))'
                  >
                    ${paymentBadgeHtml}
                  </button>

                  <div class='flex items-center gap-2 shrink-0'>
                    <a href='tel:${safeTelefon}' class='w-12 h-12 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer' title='Sună pacientul' onclick='event.stopPropagation()'>
                      <svg class='w-5 h-5 text-black opacity-85' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' />
                      </svg>
                    </a>

                    <a href='${safeDriveLink}' target='${hasDriveLink ? '_blank' : '_self'}' rel='noopener noreferrer' class='w-12 h-12 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer' title='Deschide Dosar/Drive' onclick='event.stopPropagation(); if (!${JSON.stringify(patient.drive_link || '')}) { event.preventDefault(); if (window.showToast) { window.showToast("Pacientul nu are un link de dosar/Drive salvat.", "info"); } else { alert("Pacientul nu are un link de dosar/Drive salvat."); } }'>
                      <svg class='w-5 h-5 text-black opacity-85' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z' />
                      </svg>
                    </a>
                  </div>
                </div>

                <!-- Buton Trimite Programul -->
                <button 
                  type='button'
                  class='w-full h-12 rounded-2xl bg-white hover:bg-neutral-50 text-black text-sm font-extrabold shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer border border-transparent share-schedule-btn'
                  onclick='event.stopPropagation(); window.dispatchEvent(new CustomEvent("openShareScheduleSheet", { detail: { patientId: "${patient.id}", patientName: "${safeNameJs}", patientPhone: "${escapeJsString(patient.telefon || '')}", patientLocation: "${escapeJsString(patient.locatie || '')}" } }))'
                >
                  <svg class="w-5 h-5 text-black opacity-80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>Trimite programul</span>
                </button>

                <!-- Subscription Renewal Alert (if completed) -->
                ${subscriptionWarningHtml}
              </div>
            </div>
          </div>
        `;

        // Action buttons event bindings
        const editBtn = actionsBg.querySelector('.edit-btn');
        editBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.editPatient(patient);
        });

        const historyBtn = actionsBg.querySelector('.history-btn');
        historyBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: patient.id } }));
        });

        const shareSwipeBtn = actionsBg.querySelector('.share-schedule-swipe-btn');
        shareSwipeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          window.dispatchEvent(new CustomEvent('openShareScheduleSheet', {
            detail: {
              patientId: patient.id,
              patientName: patient.name,
              patientPhone: patient.telefon || '',
              patientLocation: patient.locatie || ''
            }
          }));
        });

        const deleteBtn = actionsBg.querySelector('.delete-btn');
        deleteBtn?.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const confirmed = await (window as any).showConfirm('Ștergere Pacient', `Sigur dorești să ștergi pacientul ${patient.name}?`);
          if (confirmed) {
            this.deletePatient(patient.id);
          }
        });

        cardWrapper.appendChild(actionsBg);
        cardWrapper.appendChild(card);
        if (this.container) {
          this.container.appendChild(cardWrapper);
        }
      });
    }
  }

  let globalPatientListManager: PatientListManager | null = null;
  function bootPatientList() {
    if (!document.getElementById('patient-list-container')) return;
    
    if (!globalPatientListManager) {
      globalPatientListManager = new PatientListManager();
    } else {
      globalPatientListManager.container = document.getElementById('patient-list-container');
      globalPatientListManager.bindLocalEvents();
      globalPatientListManager.render();
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootPatientList();
  } else {
    document.addEventListener('DOMContentLoaded', bootPatientList);
  }
  document.addEventListener('astro:page-load', bootPatientList);

</script>
