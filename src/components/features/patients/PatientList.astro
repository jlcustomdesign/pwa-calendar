---
// Dynamic Patient List Component
---

<div class="mb-6 space-y-4">
  <!-- Search Bar and Add Button -->
  <div class="flex gap-3" id="patient-search-row">
    <div class="relative flex-1 min-w-0">
      <input type="text" id="patient-search" placeholder="Căutare pacient..." class="w-full bg-white rounded-full py-3.5 pl-12 pr-4 text-black focus:outline-none border border-black/10 shadow-sm text-base font-extrabold h-[56px]" />
      <svg class="w-5 h-5 absolute left-4 top-[18px] text-black/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <button 
      id="add-patient-btn"
      onclick="window.dispatchEvent(new CustomEvent('openAddPatient'))"
      class="h-[56px] shrink-0 rounded-full bg-brand-primary hover:brightness-105 text-black flex items-center justify-center shadow-md shadow-amber-500/15 active:scale-95 transition-all cursor-pointer"
    >
      <svg class="w-6 h-6 shrink-0 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      <span class="add-label font-extrabold text-base text-black">Adaugă</span>
    </button>
  </div>

  <style>
    /* Pill <-> circle morph for the Adaugă button while searching */
    #add-patient-btn {
      width: auto;
      padding: 0 20px;
      transition: width 0.6s cubic-bezier(0.32, 0.72, 0, 1),
                  padding 0.6s cubic-bezier(0.32, 0.72, 0, 1),
                  transform 0.15s ease;
    }
    #add-patient-btn .add-label {
      display: inline-block;
      max-width: 90px;
      opacity: 1;
      margin-left: 8px;
      overflow: hidden;
      white-space: nowrap;
      transition: max-width 0.55s cubic-bezier(0.32, 0.72, 0, 1),
                  opacity 0.3s ease,
                  margin-left 0.55s cubic-bezier(0.32, 0.72, 0, 1);
    }
    #patient-search-row.search-active #add-patient-btn {
      width: 52px !important; /* !important overrides the inline measured width so it can transition */
      padding: 0;
    }
    #patient-search-row.search-active #add-patient-btn .add-label {
      max-width: 0;
      opacity: 0;
      margin-left: 0;
    }
  </style>
  <!-- Filters -->
  <div class="flex gap-2 overflow-x-auto pb-2 hide-scrollbar" style="-ms-overflow-style: none; scrollbar-width: none;">
    <button class="filter-btn active px-5 py-2.5 rounded-full bg-brand-primary text-black font-extrabold text-sm whitespace-nowrap active:scale-95 transition-all shadow-sm" data-filter="all">Toți</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all" data-filter="ghimbav">Ghimbav</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all" data-filter="belaqva">Belaqva</button>
    <button class="filter-btn px-5 py-2.5 rounded-full bg-white text-black font-extrabold text-sm whitespace-nowrap border border-black/10 shadow-sm active:scale-95 transition-all" data-filter="unpaid">Neachitați</button>
  </div>
</div>

<div id="patient-list-container" class="space-y-4 pb-32 overflow-x-hidden">
  <!-- Populated by JS -->
</div>

<!-- Empty State Template -->
<template id="patient-empty-state">
  <div class="p-8 text-center bg-surface-card rounded-2xl border border-dashed border-black/10">
    <div class="w-16 h-16 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
    </div>
    <h3 class="font-bold text-lg text-black mb-1">Niciun pacient momentan</h3>
    <p class="text-sm text-text-muted">Adaugă primul pacient pentru a începe.</p>
  </div>
</template>

<script>
  import { getPatients, deletePatient as deletePatientDB, resetPatientSubscription } from '../../../lib/services/patientService';

  (window as any).renewSubscription = (window as any).renewSubscription || (async (patientId: string, totalSessions: number) => {
    try {
      await resetPatientSubscription(patientId, totalSessions);
      (window as any).showToast?.('Abonamentul a fost reînnoit! Ședințele au fost reluate de la 0.', 'success');
      window.dispatchEvent(new CustomEvent('patientsUpdated'));
      window.dispatchEvent(new CustomEvent('sessionsUpdated'));
    } catch (err: any) {
      (window as any).showToast?.('Eroare la reînnoire: ' + (err?.message || err), 'error');
    }
  });

  class PatientListManager {
    container: HTMLElement | null;
    currentSearchQuery: string = '';
    currentFilter: string = 'all';

    constructor() {
      this.container = document.getElementById('patient-list-container');
      this.clearOldLocalStorage();
      this.bindEvents();
      this.render();
    }

    clearOldLocalStorage() {
      // Curățare definitivă mock-uri vechi din localStorage
      localStorage.removeItem('kineto_patients');
      localStorage.removeItem('mock_patients_initialized_v4');
    }

    bindEvents() {
      // Prevent duplicate global listeners
      if (!(window as any)._patientEventsBound) {
        window.addEventListener('patientsUpdated', async () => {
          const c = document.getElementById('patient-list-container');
          if (c) {
            this.container = c;
            await this.render();
          }
        });
        
        // Global click listener for expanding/collapsing details
        document.addEventListener('click', (e: any) => {
          const toggleBtn = e.target.closest('[data-toggle-details]');
          if (toggleBtn) {
            const patientId = toggleBtn.getAttribute('data-toggle-details');
            const detailsContent = document.getElementById(`details-${patientId}`);
            const chevron = toggleBtn.querySelector('svg');
            
            if (detailsContent) {
              const isHidden = detailsContent.classList.contains('hidden');
              if (isHidden) {
                detailsContent.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
              } else {
                detailsContent.classList.add('hidden');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
              }
            }
          }
        });
        (window as any)._patientEventsBound = true;
      }
      
      this.bindLocalEvents();
    }

    bindLocalEvents() {
      const searchInput = document.getElementById('patient-search') as HTMLInputElement;
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          this.currentSearchQuery = (e.target as HTMLInputElement).value.toLowerCase();
          this.render();
        });

        // Morph the Adaugă pill into a circle while the search is active
        const searchRow = document.getElementById('patient-search-row');
        const addBtn = document.getElementById('add-patient-btn') as HTMLElement | null;
        let addBtnResetTimer: number | undefined;
        searchInput.addEventListener('focus', () => {
          if (!searchRow || !addBtn) return;
          clearTimeout(addBtnResetTimer);
          // Pin the current width first — CSS can't transition from width:auto,
          // so measure it, force a reflow, then let the class animate to 52px
          addBtn.style.width = `${addBtn.offsetWidth}px`;
          void addBtn.offsetWidth;
          searchRow.classList.add('search-active');
        });
        searchInput.addEventListener('blur', () => {
          if (!searchRow || !addBtn) return;
          if (!searchInput.value.trim()) {
            searchRow.classList.remove('search-active');
            // Restore natural pill width once the morph-back transition finished
            addBtnResetTimer = window.setTimeout(() => {
              addBtn.style.width = '';
            }, 650);
          }
        });
      }

      const filterBtns = document.querySelectorAll('.filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-brand-primary');
            b.classList.add('bg-white', 'border', 'border-black/10', 'shadow-sm');
          });
          const target = e.currentTarget as HTMLElement;
          target.classList.remove('bg-white', 'border', 'border-black/10');
          target.classList.add('bg-brand-primary');
          
          this.currentFilter = target.getAttribute('data-filter') || 'all';
          this.render();
        });
      });
    }

    async deletePatient(id: string) {
      try {
        await deletePatientDB(id);
        (window as any).showToast('Pacientul a fost șters cu succes.', 'success');
        this.render();
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
      } catch (err: any) {
        (window as any).showToast('Eroare la ștergerea pacientului: ' + err.message, 'error');
      }
    }

    editPatient(patient: any) {
      if (!patient) return;
      window.dispatchEvent(new CustomEvent('openAddPatient', {
        detail: {
          isEdit: true,
          patient: patient
        }
      }));
    }

    bookSession(patientName: string) {
      window.dispatchEvent(new CustomEvent('openAddSession', {
        detail: {
          patientName: patientName,
          showDateTime: true
        }
      }));
    }

    async render() {
      if (!this.container) return;

      let patients: any[] = [];
      try {
        patients = await getPatients({
          locatie: this.currentFilter === 'ghimbav' ? 'Ghimbav' : (this.currentFilter === 'belaqva' ? 'Belaqva' : undefined),
          achitat: this.currentFilter === 'unpaid' ? false : undefined,
          search: this.currentSearchQuery || undefined
        });
      } catch (e) {
        console.error('Eroare citire pacienti:', e);
      }

      if (patients.length === 0) {
        const template = document.getElementById('patient-empty-state') as HTMLTemplateElement;
        this.container.innerHTML = '';
        if (template) this.container.appendChild(template.content.cloneNode(true));
        return;
      }

      this.container.innerHTML = '';

      patients.forEach((patient: any) => {
        const locatie = patient.locatie || '';
        let isGhimbav = locatie.toLowerCase() === 'ghimbav';
        let isBelaqva = locatie.toLowerCase() === 'belaqva' || locatie.toLowerCase() === 'belaqua';

        const sumaIncasata = Number(patient.suma_incasata || 0);
        const costTotal = Number(patient.cost || 0);
        let paymentStatus = 'Neachitat';

        if (patient.status_plata) {
          paymentStatus = patient.status_plata;
        } else if (patient.achitat || (costTotal > 0 && sumaIncasata >= costTotal)) {
          paymentStatus = 'Achitat integral';
        } else if (sumaIncasata > 0) {
          paymentStatus = 'Achitat parțial';
        }

        let cardClasses = "bg-brand-primary text-black"; // default to Belaqva colors
        if (isGhimbav) {
          cardClasses = "bg-brand-secondary text-white";
        }

        const attendanceCount = patient.sedinte_folosite || 0;
        const totalSessions = patient.sedinte_total || 10;
        let progressPercentage = Math.min(100, Math.round((attendanceCount / totalSessions) * 100));

        const isFullyPaid = paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat' || patient.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal);
        const restDePlata = isFullyPaid ? 0 : Math.max(0, costTotal - sumaIncasata);

        const cardWrapper = document.createElement('div');
        cardWrapper.className = 'block relative rounded-[2.5rem] shadow-sm overflow-hidden mb-4';

        // Action Background (Edit / Delete) - Using SessionCard style
        const actionsBg = document.createElement('div');
        actionsBg.className = 'absolute inset-0 bg-neutral-100 flex items-center justify-end px-6 z-0';
        actionsBg.innerHTML = `
          <div class="flex items-center gap-3">
            <button class="edit-btn w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-black/5" title="Editează pacientul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            </button>
            <button class="delete-btn w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" title="Șterge pacientul">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        `;

        // The foreground card
        const card = document.createElement('div');
        card.className = `swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}`;
        card.style.touchAction = 'pan-y'; // allow vertical scroll
        
        const planName = patient.plan === 'Subscription' || patient.plan === 'Abonament' ? 'Ab.' : (patient.plan || 'Fără plan');

        const subscriptionDone = totalSessions > 0 && attendanceCount > 0 && attendanceCount >= totalSessions;
        const displayCount = subscriptionDone ? totalSessions : attendanceCount;
        progressPercentage = subscriptionDone ? 100 : (totalSessions > 0 ? Math.min(100, Math.round((attendanceCount / totalSessions) * 100)) : 0);
        const progressBarFill = isGhimbav ? 'bg-brand-primary' : 'bg-brand-secondary';
        const progressBarTrack = isGhimbav ? 'bg-black/20' : 'bg-black/15';

        let paymentBadgeClass = 'bg-white hover:bg-neutral-50 text-black border border-black/5 font-extrabold shadow-sm';
        let displayPaymentLabel = 'Status plată';

        if (paymentStatus === 'Achitat parțial' || (sumaIncasata > 0 && restDePlata > 0)) {
          displayPaymentLabel = `<span class="leading-tight text-center"><span class="block">Parțial</span><span class="block text-[10px] opacity-80 font-bold">${sumaIncasata}/${costTotal} RON</span></span>`;
          paymentBadgeClass = 'bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200 font-extrabold shadow-sm';
        } else if (paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat' || (costTotal > 0 && sumaIncasata >= costTotal)) {
          displayPaymentLabel = 'Achitat';
          paymentBadgeClass = 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 font-extrabold shadow-sm';
        } else if (paymentStatus === 'Neachitat') {
          displayPaymentLabel = 'Neachitat';
        } else {
          displayPaymentLabel = paymentStatus || 'Status plată';
        }

        const subscriptionWarningHtml = subscriptionDone
          ? `<div class='px-6 pb-3'><button type='button' class='w-full py-2.5 px-4 rounded-2xl bg-brand-secondary text-black text-xs sm:text-sm font-black uppercase tracking-wider text-center shadow-md border border-black/5 hover:opacity-90 active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5' onclick='event.stopPropagation(); window.renewSubscription("${patient.id}", ${totalSessions})'><span>REÎNNOIEȘTE PACHETUL (${displayCount}/${totalSessions})</span></button></div>`
          : '';

        card.innerHTML = `
          <!-- Summary Section (Always visible) -->
          <div class='card-summary relative z-20 flex flex-col justify-between cursor-pointer transition-transform active:scale-[0.98] min-h-[80px] p-6'>
            <div class='flex items-center gap-3 w-full relative z-10 justify-between'>
              <div class='flex-1 min-w-0'>
                <h4 class='text-xl font-bold tracking-tight leading-none truncate'>${patient.name}</h4>
              </div>
              <button 
                type='button' 
                class='book-btn shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-black/10 hover:bg-black/20 active:scale-95 transition-transform'
                title='Programează'
                onclick='event.stopPropagation()'
              >
                <svg class='w-5 h-5 opacity-90' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' /></svg>
              </button>
            </div>
            
            <!-- Progress (Restored to Summary) -->
            <div class='flex items-center gap-4 mt-5 relative z-10'>
              <div class='h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative'>
                <div class='h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out' style='width: ${progressPercentage}%;'></div>
              </div>
              <div class='text-xs font-bold tracking-wide opacity-90 shrink-0'>${displayCount}/${totalSessions}</div>
            </div>
          </div>

          <!-- Details Section (Hidden by default, expands on click) -->
          <div class='card-details grid transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]' style='grid-template-rows: 0fr;'>
            <div class='overflow-hidden relative z-20'>
              ${subscriptionWarningHtml}

              <div class='px-6 pt-2 pb-2 space-y-3'>
                <!-- Row 1: Plan + Location -->
                <div class='flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white text-black text-sm sm:text-base font-extrabold shadow-sm border border-black/5'>
                  <span class='flex items-center gap-1.5 shrink-0 text-black'>
                    <svg class='w-4 h-4 text-black opacity-75 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'/>
                    </svg>
                    <span class='text-black font-black'>${planName}</span>
                  </span>
                  <span class='flex items-center gap-1.5 shrink-0 text-black'>
                    <svg class='w-4 h-4 text-black opacity-75 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z'/>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 11a3 3 0 11-6 0 3 3 0 016 0z'/>
                    </svg>
                    <span class='text-black font-black'>${locatie || 'Belaqva'}</span>
                  </span>
                </div>

                <!-- Row 2: Payment badge + Call/Drive icon buttons -->
                <div class='flex items-center justify-between pt-0.5 gap-3'>
                  <button 
                    type='button'
                    class='h-11 flex-1 min-w-0 flex items-center justify-center px-3 rounded-2xl ${paymentBadgeClass} hover:opacity-90 active:scale-95 transition-all text-sm sm:text-base font-black cursor-pointer shadow-sm' 
                    onclick='event.stopPropagation(); window.dispatchEvent(new CustomEvent("openPaymentSheet", { detail: { patientId: "${patient.id}" } }))'
                  >
                    <span class="truncate">${displayPaymentLabel}</span>
                  </button>

                  <div class='flex items-center gap-2 shrink-0'>
                    <a href='tel:${patient.telefon || '+1234567890'}' class='w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-black/5 shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer' title='Sună pacientul' onclick='event.stopPropagation()'>
                      <svg class='w-5 h-5 text-black opacity-85' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' />
                      </svg>
                    </a>

                    <a href='${patient.drive_link || '#'}' target='${patient.drive_link ? '_blank' : '_self'}' rel='noopener noreferrer' class='w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-black/5 shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer' title='Deschide Dosar/Drive' onclick='event.stopPropagation(); if (!${JSON.stringify(patient.drive_link || '')}) { event.preventDefault(); if (window.showToast) { window.showToast("Pacientul nu are un link de dosar/Drive salvat.", "info"); } else { alert("Pacientul nu are un link de dosar/Drive salvat."); } }'>
                      <svg class='w-5 h-5 text-black opacity-85' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z' />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;

        // Event bindings
        const bookBtn = card.querySelector('.book-btn');
        bookBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.bookSession(patient.name);
        });

        const editBtn = actionsBg.querySelector('.edit-btn');
        editBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.editPatient(patient);
        });

        const deleteBtn = actionsBg.querySelector('.delete-btn');
        deleteBtn?.addEventListener('click', async (e) => {
          e.stopPropagation();
          const confirmed = await (window as any).showConfirm('Ștergere Pacient', `Sigur dorești să ștergi pacientul ${patient.name}?`);
          if (confirmed) {
            this.deletePatient(patient.id);
          }
        });

        // Toggle Details
        const summary = card.querySelector('.card-summary');
        const details = card.querySelector('.card-details') as HTMLElement;
        let isExpanded = false;
        
        summary?.addEventListener('click', (e) => {
          if (cardWrapper.dataset.wasSwiping === 'true') {
            cardWrapper.dataset.wasSwiping = 'false';
            return;
          }
          isExpanded = !isExpanded;
          if (details) {
            details.style.gridTemplateRows = isExpanded ? '1fr' : '0fr';
          }
        });

        // Swipe logic
        let startX = 0;
        let currentX = 0;
        let isSwiping = false;
        let isOpen = false;
        const MAX_SWIPE = -140;
        const SWIPE_THRESHOLD = -60;

        card.addEventListener('touchstart', (e: any) => {
          startX = e.touches[0].clientX;
          currentX = startX;
          isSwiping = true;
          cardWrapper.dataset.wasSwiping = 'false';
          card.style.transition = 'none';
        }, { passive: true });

        card.addEventListener('touchmove', (e: any) => {
          if (!isSwiping) return;
          currentX = e.touches[0].clientX;
          const diffX = currentX - startX;
          
          if (Math.abs(diffX) > 10) {
            cardWrapper.dataset.wasSwiping = 'true';
          }

          let targetX = isOpen ? MAX_SWIPE + diffX : diffX;
          if (targetX > 0) targetX = 0;
          if (targetX < MAX_SWIPE - 20) targetX = MAX_SWIPE - 20;
          
          card.style.transform = `translateX(${targetX}px)`;
        }, { passive: true });

        const onEnd = () => {
          if (!isSwiping) return;
          isSwiping = false;
          
          const diffX = currentX - startX;
          card.style.transition = 'transform 300ms cubic-bezier(0.32, 0.72, 0, 1)';

          if (Math.abs(diffX) < 10) {
            // Was just a tap
            card.style.transform = isOpen ? `translateX(${MAX_SWIPE}px)` : 'translateX(0px)';
            return;
          }

          if (!isOpen && diffX < SWIPE_THRESHOLD) {
            isOpen = true;
            card.style.transform = `translateX(${MAX_SWIPE}px)`;
          } else if (isOpen && diffX > -SWIPE_THRESHOLD) {
            isOpen = false;
            card.style.transform = 'translateX(0px)';
          } else {
            card.style.transform = isOpen ? `translateX(${MAX_SWIPE}px)` : 'translateX(0px)';
          }
        };

        card.addEventListener('touchend', onEnd);
        card.addEventListener('touchcancel', onEnd);

        cardWrapper.appendChild(actionsBg);
        cardWrapper.appendChild(card);
        if (this.container) {
          this.container.appendChild(cardWrapper);
        }
      });
    }
  }

  let globalPatientListManager: PatientListManager | null = null;
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('patient-list-container')) return;
    
    if (!globalPatientListManager) {
      globalPatientListManager = new PatientListManager();
    } else {
      globalPatientListManager.container = document.getElementById('patient-list-container');
      globalPatientListManager.bindLocalEvents();
      globalPatientListManager.render();
    }
  });
</script>
