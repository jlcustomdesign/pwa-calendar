---
// Patient Onboarding Bottom Sheet
---

<div 
  id="add-patient-sheet" 
  class="fixed inset-x-0 bottom-0 z-[100] bg-surface-card rounded-t-[2.5rem] p-5 pb-0 shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] translate-y-full will-change-transform flex flex-col max-h-[90vh] overflow-hidden"
>
  <!-- Swipe handle -->
  <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex-1 overflow-y-auto no-scrollbar px-2 pt-2 pb-28">
    <h3 id="patient-sheet-title" class="text-2xl font-extrabold tracking-tight text-black mb-8">Pacient nou</h3>

    <form id="add-patient-form" class="space-y-7">
      <input type="hidden" name="patientId" id="editPatientId" value="" />
      
      <!-- General Details -->
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Nume complet</label>
          <input 
            type="text" 
            name="name" 
            id="patientName" 
            required
            placeholder="ex: Alexandru Popa" 
            class="w-full px-6 py-4 rounded-full bg-black/5 border border-transparent text-lg font-extrabold text-black focus:outline-none focus:bg-white focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
          />
        </div>

        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Număr de telefon</label>
          <input 
            type="tel" 
            name="phone" 
            id="patientPhone" 
            placeholder="ex: 0740 123 456" 
            class="w-full px-6 py-4 rounded-full bg-black/5 border border-transparent text-lg font-extrabold text-black focus:outline-none focus:bg-white focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
          />
        </div>
      </div>

      <!-- Plan & Location -->
      <div class="grid grid-cols-2 gap-4">
        <!-- Plan (Chips) -->
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Plan</label>
          <input type="hidden" name="plan" id="patientPlan" value="Abonament" />
          <div class="flex flex-col gap-2">
            <button type="button" data-plan="Abonament" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Abonament</button>
            <button type="button" data-plan="Ședință unică" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Ședință unică</button>
          </div>
        </div>

        <!-- Location (Chips) -->
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Locație</label>
          <input type="hidden" name="location" id="patientLocation" value="Belaqva" />
          <div class="flex flex-col gap-2">
            <button type="button" data-location="Belaqva" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Belaqva</button>
            <button type="button" data-location="Ghimbav" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Ghimbav</button>
          </div>
        </div>
      </div>

      <!-- Cost & Frequency -->
      <div class="grid gap-4">
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Cost (RON)</label>
          <input 
            type="number" 
            name="cost" 
            id="patientCost" 
            placeholder="ex: 150" 
            class="w-full px-6 py-4 rounded-full bg-black/5 border border-transparent text-lg font-extrabold text-black focus:outline-none focus:bg-white focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
          />
        </div>
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Frecvență</label>
          <div class="flex flex-col gap-3">
            <div class="flex flex-wrap gap-2">
              <button type="button" data-frequency="1 / săptămână" class="px-3 py-2 rounded-xl text-xs font-bold transition-all bg-black/5 text-black hover:bg-black/10">1 / săptămână</button>
              <button type="button" data-frequency="2 / săptămână" class="px-3 py-2 rounded-xl text-xs font-bold transition-all bg-black/5 text-black hover:bg-black/10">2 / săptămână</button>
              <button type="button" data-frequency="3 / săptămână" class="px-3 py-2 rounded-xl text-xs font-bold transition-all bg-black/5 text-black hover:bg-black/10">3 / săptămână</button>
            </div>
            <input 
              type="text" 
              name="frequency" 
              id="patientFrequency" 
              placeholder="Sau introdu personalizat (ex: 5 / săptămână)" 
              value="1 / săptămână"
              class="w-full px-4 py-2.5 rounded-xl bg-black/5 border border-transparent focus:bg-white focus:border-brand-primary transition-all font-bold text-black text-sm"
            />
          </div>
        </div>
      </div>

      <!-- Total Sessions -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Număr total ședințe</label>
        <input 
          type="number" 
          name="totalSessions" 
          id="patientTotalSessions" 
          placeholder="e.g. 10" 
          class="w-full px-4 py-3 rounded-2xl bg-black/5 border border-transparent focus:bg-white focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all font-bold text-black"
        />
      </div>

      <!-- Status Plată -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Status plată</label>
        <input type="hidden" name="paymentStatus" id="patientPaymentStatus" value="Neachitat" />
        <div class="flex flex-wrap gap-2">
          <button type="button" data-payment="Neachitat" class="px-4 py-2 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Neachitat</button>
          <button type="button" data-payment="Achitat" class="px-4 py-2 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Achitat</button>
        </div>
      </div>

      <!-- Drive Link -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Link dosar / Drive (opțional)</label>
        <div class="relative">
          <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
          <input 
            type="url" 
            name="driveLink" 
            id="patientDriveLink" 
            placeholder="https://drive.google.com/..." 
            class="w-full pl-11 pr-4 py-3 rounded-2xl bg-black/5 border border-transparent focus:bg-white focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all font-bold text-black text-sm"
          />
        </div>
      </div>
    </form>
  </div>

  <div class="absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-surface-card via-surface-card to-transparent pt-12">
    <button type="button" id="save-patient-btn" class="w-full py-4 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all cursor-pointer">
      Salvează
    </button>
  </div>
</div>

<script>
  import { addPatient, updatePatient } from '../../../lib/services/patientService';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  class AddPatientSheetManager {
    sheet: HTMLElement | null;
    form: HTMLFormElement | null;
    overlay: HTMLElement | null = null;
    startY: number = 0;
    currentY: number = 0;
    startX: number = 0;
    dragEngaged: boolean = false;
    scrollAtTop: boolean = true;

    constructor() {
      this.sheet = document.getElementById('add-patient-sheet');
      this.form = document.getElementById('add-patient-form') as HTMLFormElement;
      
      this.createOverlay();
      this.bindEvents();
    }

    createOverlay() {
      // Remove any existing overlay to prevent duplicates on SPA navigation
      const existingOverlays = document.querySelectorAll('.patient-sheet-overlay');
      existingOverlays.forEach(o => o.remove());

      this.overlay = document.createElement('div');
      this.overlay.className = 'fixed inset-0 bg-black/40 z-[90] opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm patient-sheet-overlay';
      document.body.appendChild(this.overlay);
      this.overlay.addEventListener('click', () => this.close());
    }

    bindEvents() {
      if (!this.sheet) return;

      // Swipe-down to dismiss from anywhere on the sheet — only engages on a
      // clearly vertical downward swipe while the form is scrolled to the top
      this.sheet.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      this.sheet.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      this.sheet.addEventListener('touchend', () => this.handleTouchEnd());

      // We will move the window listener outside of bindEvents to avoid duplicates.
      // It is now handled in the init function.
      
      // Bind Plan Chips
      const planChips = document.querySelectorAll<HTMLButtonElement>('[data-plan]');
      planChips.forEach(chip => {
        chip.addEventListener('click', (e) => {
          e.preventDefault();
          const planVal = chip.dataset.plan || 'Abonament';
          if (this.form) {
            (this.form.querySelector('[name="plan"]') as HTMLInputElement).value = planVal;
          }
          this.updatePlanChips(planVal);
        });
      });

      // Bind Location Chips
      const locationChips = document.querySelectorAll<HTMLButtonElement>('[data-location]');
      locationChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const locVal = chip.dataset.location || 'Belaqva';
          if (this.form) {
            (this.form.querySelector('[name="location"]') as HTMLInputElement).value = locVal;
          }
          this.updateLocationChips(locVal);
        });
      });

      // Bind Frequency Chips
      const freqChips = document.querySelectorAll<HTMLButtonElement>('[data-frequency]');
      freqChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const freqVal = chip.dataset.frequency || '1 / săptămână';
          if (this.form) {
            (this.form.querySelector('[name="frequency"]') as HTMLInputElement).value = freqVal;
          }
          this.updateFrequencyChips(freqVal);
        });
      });

      const freqInput = this.form?.querySelector('[name="frequency"]') as HTMLInputElement;
      if (freqInput) {
        freqInput.addEventListener('input', (e) => {
          this.updateFrequencyChips((e.target as HTMLInputElement).value);
        });
      }

      // Bind Payment Chips
      const paymentChips = document.querySelectorAll<HTMLButtonElement>('[data-payment]');
      paymentChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const paymentVal = chip.dataset.payment || 'Unpaid';
          if (this.form) {
            (this.form.querySelector('[name="paymentStatus"]') as HTMLInputElement).value = paymentVal;
          }
          this.updatePaymentChips(paymentVal);
        });
      });

      const saveBtn = document.getElementById('save-patient-btn');
      saveBtn?.addEventListener('click', () => this.savePatient(false));
    }

    updatePlanChips(selectedPlan: string) {
      const clean = (s: string) => (s || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
      const normSelected = clean(selectedPlan);

      const planChips = document.querySelectorAll<HTMLButtonElement>('[data-plan]');
      planChips.forEach(chip => {
        const chipPlan = clean(chip.dataset.plan || '');
        let isMatch = false;

        if (normSelected.includes('abonament') || normSelected.includes('subscrip')) {
          isMatch = chipPlan.includes('abonament');
        } else if (normSelected.includes('sedinta') || normSelected.includes('unica') || normSelected.includes('one') || normSelected.includes('single')) {
          isMatch = chipPlan.includes('sedinta') || chipPlan.includes('unica');
        } else {
          isMatch = chipPlan === normSelected;
        }

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    updateLocationChips(selectedLoc: string) {
      const clean = (s: string) => (s || '').toLowerCase().trim();
      const normSelected = clean(selectedLoc);

      const locationChips = document.querySelectorAll<HTMLButtonElement>('[data-location]');
      locationChips.forEach(chip => {
        const chipLoc = clean(chip.dataset.location || '');
        const isMatch = chipLoc === normSelected;

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    updateFrequencyChips(selectedFreq: string) {
      const clean = (s: string) => (s || '').toLowerCase().trim();
      const normSelected = clean(selectedFreq);

      const freqChips = document.querySelectorAll<HTMLButtonElement>('[data-frequency]');
      freqChips.forEach(chip => {
        const chipFreq = clean(chip.dataset.frequency || '');
        const isMatch = chipFreq === normSelected ||
          (chipFreq.length > 0 && normSelected.length > 0 && chipFreq.charAt(0) === normSelected.charAt(0) && chipFreq.charAt(0) >= '1' && chipFreq.charAt(0) <= '9');

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    updatePaymentChips(selectedPayment: string) {
      const clean = (s: string) => (s || '').toLowerCase().trim();
      const normSelected = clean(selectedPayment);

      const paymentChips = document.querySelectorAll<HTMLButtonElement>('[data-payment]');
      paymentChips.forEach(chip => {
        const chipPayment = clean(chip.dataset.payment || '');
        let isMatch = false;

        if (normSelected === 'neachitat' || normSelected === 'unpaid') {
          isMatch = chipPayment === 'neachitat';
        } else if (normSelected === 'achitat' || normSelected === 'paid') {
          isMatch = chipPayment === 'achitat';
        } else {
          isMatch = chipPayment === normSelected;
        }

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    async savePatient(bookSession: boolean) {
      if (!this.form) return;
      if (!this.form.checkValidity()) {
        this.form.reportValidity();
        return;
      }

      const saveBtn = document.getElementById('save-patient-btn') as HTMLButtonElement | null;
      if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Se salvează…'; }

      const formData = new FormData(this.form);
      const patientId = formData.get('patientId') as string;
      const patientName = formData.get('name') as string;

      const payload = {
        name: patientName,
        telefon: (formData.get('phone') as string) || '',
        plan: (formData.get('plan') as any) || 'Abonament',
        locatie: (formData.get('location') as any) || 'Belaqva',
        cost: formData.get('cost') ? Number(formData.get('cost')) : 0,
        sedinte_total: formData.get('totalSessions') ? Number(formData.get('totalSessions')) : 10,
        frecventa: (formData.get('frequency') as string) || '1 / săptămână',
        achitat: formData.get('paymentStatus') === 'Achitat' || formData.get('paymentStatus') === 'Paid fully' || formData.get('paymentStatus') === 'Paid',
        drive_link: (formData.get('driveLink') as string) || '',
      };

      try {
        if (patientId) {
          await updatePatient(patientId, payload);
        } else {
          await addPatient(payload);
        }

        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        this.close();

        if (bookSession) {
          setTimeout(() => {
            window.dispatchEvent(new CustomEvent('openAddSession', {
              detail: {
                patientName: patientName,
                showDateTime: true
              }
            }));
          }, 300);
        }
      } catch (err: any) {
        const msg = err.message || err.toString();
        if (msg.includes('Există deja')) {
          (window as any).showToast(msg, 'warning', 'Pacient existent');
        } else {
          (window as any).showToast('Eroare la salvarea pacientului: ' + msg, 'error');
        }
      } finally {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Salvează'; }
      }
    }

    handleOpenEvent(e: any) {
        const detail = e.detail || {};
        const isEdit = !!detail.isEdit;
        const patient = detail.patient;

        const titleEl = document.getElementById('patient-sheet-title');
        const idInput = document.getElementById('editPatientId') as HTMLInputElement;

        if (idInput) {
          idInput.value = isEdit && patient ? patient.id : '';
        }

        if (titleEl) {
          titleEl.textContent = isEdit ? 'Editează pacient' : 'Pacient nou';
        }

        if (isEdit && patient && this.form) {
          const editPaymentStatus = patient.achitat ? 'Achitat' : 'Neachitat';
          (this.form.querySelector('[name="name"]') as HTMLInputElement).value = patient.name || '';
          (this.form.querySelector('[name="phone"]') as HTMLInputElement).value = patient.telefon || '';
          (this.form.querySelector('[name="plan"]') as HTMLInputElement).value = patient.plan || 'Abonament';
          (this.form.querySelector('[name="location"]') as HTMLInputElement).value = patient.locatie || 'Belaqva';
          (this.form.querySelector('[name="cost"]') as HTMLInputElement).value = patient.cost != null ? String(patient.cost) : '';
          (this.form.querySelector('[name="totalSessions"]') as HTMLInputElement).value = patient.sedinte_total != null ? String(patient.sedinte_total) : '';
          (this.form.querySelector('[name="frequency"]') as HTMLInputElement).value = patient.frecventa || '1 / săptămână';
          (this.form.querySelector('[name="paymentStatus"]') as HTMLInputElement).value = editPaymentStatus;
          (this.form.querySelector('[name="driveLink"]') as HTMLInputElement).value = patient.drive_link || '';
          this.updatePlanChips(patient.plan || 'Abonament');
          this.updateLocationChips(patient.locatie || 'Belaqva');
          this.updateFrequencyChips(patient.frecventa || '1 / săptămână');
          this.updatePaymentChips(editPaymentStatus);
        } else if (this.form) {
          this.form.reset();
          this.updatePlanChips('Abonament');
          this.updateLocationChips('Belaqva');
          this.updateFrequencyChips('1 / săptămână');
          this.updatePaymentChips('Neachitat');
        }

        this.open();
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.classList.remove('translate-y-full');
      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      lockBodyScroll();
    }

    close() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.style.transform = '';
      this.sheet.classList.add('translate-y-full');
      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      unlockBodyScroll();
      setTimeout(() => this.form?.reset(), 500);
    }

    handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;
      // Only allow sheet drag when the scrollable form is at the top,
      // otherwise the gesture should scroll the form instead
      const scrollArea = this.sheet?.querySelector('.overflow-y-auto');
      this.scrollAtTop = !scrollArea || scrollArea.scrollTop <= 0;
    }

    handleTouchMove(e: TouchEvent) {
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        if (this.scrollAtTop && deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.sheet) this.sheet.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.sheet) {
        if (e.cancelable) e.preventDefault();
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.sheet || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      this.sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
      
      if (deltaY > 150) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }
  }

  function initPatientSheet() {
    // Only bind the window event listener once globally
    if (!(window as any)._patientSheetListenerBound) {
      window.addEventListener('openAddPatient', (e: any) => {
        if ((window as any).currentPatientSheetManager) {
          (window as any).currentPatientSheetManager.handleOpenEvent(e);
        }
      });
      (window as any)._patientSheetListenerBound = true;
    }
    
    // Always instantiate a new manager on page load so it binds to the new DOM elements
    (window as any).currentPatientSheetManager = new AddPatientSheetManager();
  }

  document.addEventListener('astro:page-load', initPatientSheet);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
