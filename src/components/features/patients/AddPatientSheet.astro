---
// Patient Onboarding Bottom Sheet
---

<div 
  id="add-patient-sheet" 
  data-sheet-root
  class="fixed inset-x-0 bottom-0 z-[100] bg-surface-card rounded-t-[2.5rem] p-5 pb-0 shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] translate-y-full will-change-transform flex flex-col max-h-[90vh] overflow-hidden"
>
  <!-- Swipe handle -->
  <div id="add-patient-drag-handle" class="w-12 h-1.5 bg-neutral-300 rounded-full mx-auto mb-4 shrink-0 cursor-grab active:cursor-grabbing"></div>

  <div class="flex-1 overflow-y-auto px-2 pt-1 pb-28">
    <h3 id="patient-sheet-title" class="text-2xl font-extrabold tracking-tight text-black mb-6">Pacient nou</h3>

    <form id="add-patient-form" class="space-y-7">
      <input type="hidden" name="patientId" id="editPatientId" value="" />
      
      <!-- General Details -->
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Nume complet</label>
          <input 
            type="text" 
            name="name" 
            id="patientName" 
            required
            placeholder="ex: Alexandru Popa" 
            class="w-full px-6 py-4 rounded-full bg-black/5 border border-transparent text-lg font-extrabold text-black focus:outline-none focus:bg-white focus:border-transparent focus:ring-2 focus:ring-brand-primary/20 transition-all"
          />
        </div>

        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Număr de telefon</label>
          <input 
            type="tel" 
            name="phone" 
            id="patientPhone" 
            placeholder="ex: 0740 123 456" 
            class="w-full px-6 py-4 rounded-full bg-black/5 border border-transparent text-lg font-extrabold text-black focus:outline-none focus:bg-white focus:border-transparent focus:ring-2 focus:ring-brand-primary/20 transition-all"
          />
        </div>
      </div>

      <!-- Plan & Location -->
      <div class="grid grid-cols-2 gap-4">
        <!-- Plan (Chips) -->
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Tip Plan</label>
          <input type="hidden" name="plan" id="patientPlan" value="Abonament" />
          <div class="flex flex-col gap-2">
            <button type="button" data-plan="Abonament" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Abonament</button>
            <button type="button" data-plan="Ședință unică" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Ședință unică</button>
          </div>
        </div>

        <!-- Location (Chips) -->
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Locație</label>
          <input type="hidden" name="location" id="patientLocation" value="Belaqva" />
          <div class="flex flex-col gap-2">
            <button type="button" data-location="Belaqva" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Belaqva</button>
            <button type="button" data-location="Ghimbav" class="px-4 py-3 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Ghimbav</button>
          </div>
        </div>
      </div>

      <!-- Preset Pachet & Preț Auto-apply -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Pachete & Prețuri Predeterminate</label>
        <div id="patient-pricing-presets" class="flex flex-wrap gap-2 mb-2">
          <!-- Dynamically populated from pricing_packages -->
        </div>
      </div>

      <!-- Price per session & Sessions -->
      <div class="grid grid-cols-2 gap-4">
        <!-- Price per session -->
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Preț / Ședință (RON)</label>
          <div class="flex items-center gap-2">
            <button type="button" data-stepper="pricePerSession" data-dir="-1" class="w-10 h-12 rounded-xl bg-black/5 text-black font-extrabold active:scale-95 transition-transform">−</button>
            <input 
              type="number" 
              name="pricePerSession" 
              id="patientPricePerSession" 
              placeholder="ex: 130" 
              class="flex-1 min-w-0 px-3 py-3.5 rounded-2xl bg-black/5 border border-transparent text-base font-extrabold text-black focus:outline-none focus:bg-white focus:border-transparent focus:ring-2 focus:ring-brand-primary/20 transition-all text-center"
            />
            <button type="button" data-stepper="pricePerSession" data-dir="1" class="w-10 h-12 rounded-xl bg-black/5 text-black font-extrabold active:scale-95 transition-transform">+</button>
          </div>
        </div>

        <!-- Total Sessions -->
        <div>
          <label class="block text-sm font-extrabold text-black mb-2">Număr Ședințe</label>
          <div class="flex items-center gap-2">
            <button type="button" data-stepper="totalSessions" data-dir="-1" class="w-10 h-12 rounded-xl bg-black/5 text-black font-extrabold active:scale-95 transition-transform">−</button>
            <input 
              type="number" 
              name="totalSessions" 
              id="patientTotalSessions" 
              placeholder="ex: 10" 
              class="flex-1 min-w-0 px-3 py-3.5 rounded-2xl bg-black/5 border border-transparent focus:bg-white focus:border-transparent focus:ring-2 focus:ring-brand-primary/20 transition-all font-extrabold text-black text-base text-center"
            />
            <button type="button" data-stepper="totalSessions" data-dir="1" class="w-10 h-12 rounded-xl bg-black/5 text-black font-extrabold active:scale-95 transition-transform">+</button>
          </div>
        </div>
      </div>

      <!-- Cost Total (read-only, auto-calculated) -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Cost Total (RON)</label>
        <input 
          type="number" 
          name="cost" 
          id="patientCost" 
          readonly
          placeholder="0" 
          class="w-full px-5 py-3.5 rounded-2xl bg-black/5 border border-transparent text-base font-extrabold text-black opacity-70 cursor-default"
        />
      </div>

      <!-- Status Plată -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Status plată</label>
        <input type="hidden" name="paymentStatus" id="patientPaymentStatus" value="Neachitat" />
        <div class="flex flex-wrap gap-2">
          <button type="button" data-payment="Neachitat" class="px-4 py-2 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Neachitat</button>
          <button type="button" data-payment="Plată parțială" class="px-4 py-2 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Plată parțială</button>
          <button type="button" data-payment="Achitat" class="px-4 py-2 rounded-xl text-sm font-extrabold transition-all bg-black/5 text-black hover:bg-black/10">Achitat</button>
        </div>

        <!-- Partial payment amount (shown only when partial is selected) -->
        <div id="partial-payment-box" class="hidden mt-3">
          <label class="block text-xs font-extrabold text-black/70 mb-1.5">Sumă achitată acum (RON)</label>
          <input 
            type="number" 
            name="partialAmount" 
            id="patientPartialAmount" 
            min="1"
            placeholder="ex: 50" 
            class="w-full px-6 py-3 rounded-full bg-black/5 border border-transparent text-base font-extrabold text-black focus:outline-none focus:bg-white focus:border-transparent focus:ring-2 focus:ring-brand-primary/20 transition-all"
          />
        </div>
      </div>

      <!-- Drive Link -->
      <div>
        <label class="block text-sm font-extrabold text-black mb-2">Link dosar / Drive (opțional)</label>
        <div class="relative">
          <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
          <input 
            type="url" 
            name="driveLink" 
            id="patientDriveLink" 
            placeholder="https://drive.google.com/..." 
            class="w-full pl-11 pr-4 py-3 rounded-2xl bg-black/5 border border-transparent focus:bg-white focus:border-transparent focus:ring-2 focus:ring-brand-primary/20 transition-all font-bold text-black text-sm"
          />
        </div>
      </div>
    </form>
  </div>

  <div class="absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-surface-card via-surface-card to-transparent pt-12">
    <button type="button" id="save-patient-btn" class="w-full py-4 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-base shadow-md shadow-amber-500/15 active:scale-95 transition-all cursor-pointer">
      Salvează
    </button>
  </div>
</div>

<script>
  import { addPatient, updatePatient, addPayment } from '../../../lib/services/patientService';
  import { getPricingPackages } from '../../../lib/services/pricingService';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  class AddPatientSheetManager {
    sheet: HTMLElement | null;
    form: HTMLFormElement | null;
    overlay: HTMLElement | null = null;
    startY: number = 0;
    currentY: number = 0;
    startX: number = 0;
    dragEngaged: boolean = false;
    scrollAtTop: boolean = true;
    pricingPackages: any[] = [];
    currentPlanFilter: string = 'Abonament';

    constructor() {
      this.sheet = document.getElementById('add-patient-sheet');
      this.form = document.getElementById('add-patient-form') as HTMLFormElement;
      
      this.createOverlay();
      this.bindEvents();
      this.loadPricingPackages();
    }

    async loadPricingPackages() {
      try {
        this.pricingPackages = await getPricingPackages();
        this.renderPricingPresets();
      } catch (err) {
        console.error("Eroare la incarcarea pachetelor", err);
      }
    }

    renderPricingPresets() {
      const container = document.getElementById('patient-pricing-presets');
      if (!container) return;
      container.innerHTML = '';
      
      const clean = (s: string) => (s || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
      const normSelected = clean(this.currentPlanFilter);
      const isSubscription = normSelected.includes('abonament') || normSelected.includes('subscrip');

      const filtered = this.pricingPackages.filter(p => {
        if (isSubscription) {
          return p.tip === 'Subscription';
        } else {
          return p.tip === 'One Time';
        }
      });

      filtered.forEach((pkg, index) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.preset = pkg.id;
        // Treat the stored price as the per-session price; calculate total for subscriptions
        const defaultSessions = pkg.tip === 'Subscription' ? 10 : 1;
        btn.dataset.pricePerSession = pkg.pret.toString();
        btn.dataset.sessions = defaultSessions.toString();
        btn.dataset.plan = this.currentPlanFilter;
        btn.className = 'preset-chip px-4 py-2.5 rounded-xl text-xs font-black transition-all bg-black/5 text-black hover:bg-black/10';
        btn.textContent = `${pkg.nume} (${pkg.pret} RON/sed)`;
        container.appendChild(btn);
      });

      // Buton personalizat la final
      const customBtn = document.createElement('button');
      customBtn.type = 'button';
      customBtn.dataset.preset = 'custom';
      customBtn.className = 'preset-chip px-4 py-2.5 rounded-xl text-xs font-black transition-all bg-black/5 text-black hover:bg-black/10';
      customBtn.textContent = 'Personalizat';
      container.appendChild(customBtn);
    }

    createOverlay() {
      // Remove any existing overlay to prevent duplicates on SPA navigation
      const existingOverlays = document.querySelectorAll('.patient-sheet-overlay');
      existingOverlays.forEach(o => o.remove());

      this.overlay = document.createElement('div');
      this.overlay.className = 'fixed inset-0 bg-black/50 z-[90] opacity-0 pointer-events-none transition-opacity duration-300 patient-sheet-overlay';
      document.body.appendChild(this.overlay);
      this.overlay.addEventListener('click', () => this.close());
    }

    bindEvents() {
      if (!this.sheet) return;
      if (this.sheet.dataset.addPatientEventsBound === 'true') return;
      this.sheet.dataset.addPatientEventsBound = 'true';

      // Swipe-down to dismiss from anywhere on the sheet — only engages on a
      // clearly vertical downward swipe while the form is scrolled to the top
      this.sheet.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      this.sheet.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      this.sheet.addEventListener('touchend', () => this.handleTouchEnd());

      // Dedicated drag handle close
      const dragHandle = document.getElementById('add-patient-drag-handle');
      if (dragHandle) {
        let startY = 0;
        let currentY = 0;
        let dragging = false;
        dragHandle.addEventListener('touchstart', (e: any) => {
          e.stopPropagation();
          startY = e.touches[0].clientY;
          currentY = startY;
          dragging = true;
          if (this.sheet) this.sheet.style.transition = 'none';
        }, { passive: false });
        dragHandle.addEventListener('touchmove', (e: any) => {
          e.stopPropagation();
          if (!dragging) return;
          currentY = e.touches[0].clientY;
          const deltaY = currentY - startY;
          if (deltaY > 0 && this.sheet) {
            if (e.cancelable) e.preventDefault();
            this.sheet.style.transform = `translateY(${deltaY}px)`;
          }
        }, { passive: false });
        const onEnd = () => {
          if (!dragging) return;
          dragging = false;
          const deltaY = currentY - startY;
          if (this.sheet) {
            this.sheet.style.transition = 'transform 400ms cubic-bezier(0.32, 0.72, 0, 1)';
            if (deltaY > 80) {
              this.close();
            } else {
              this.sheet.style.transform = 'translateY(0)';
            }
          }
        };
        dragHandle.addEventListener('touchend', onEnd);
        dragHandle.addEventListener('touchcancel', onEnd);
      }

      // We will move the window listener outside of bindEvents to avoid duplicates.
      // It is now handled in the init function.
      
      // Bind Preset Chips
      const presetContainer = document.getElementById('patient-pricing-presets');
      if (presetContainer) {
        presetContainer.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.preset-chip') as HTMLButtonElement | null;
          if (btn) {
            e.preventDefault();
            this.handlePresetClick(btn);
          }
        });
      }

      // Bind Plan Chips
      const planChips = document.querySelectorAll<HTMLButtonElement>('[data-plan]');
      planChips.forEach(chip => {
        chip.addEventListener('click', (e) => {
          e.preventDefault();
          const planVal = chip.dataset.plan || 'Abonament';
          if (this.form) {
            (this.form.querySelector('[name="plan"]') as HTMLInputElement).value = planVal;
          }
          this.currentPlanFilter = planVal;
          this.updatePlanChips(planVal);
          this.applyPlanDefaults(planVal);
          this.renderPricingPresets();
        });
      });

      // Bind Location Chips
      const locationChips = document.querySelectorAll<HTMLButtonElement>('[data-location]');
      locationChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const locVal = chip.dataset.location || 'Belaqva';
          if (this.form) {
            (this.form.querySelector('[name="location"]') as HTMLInputElement).value = locVal;
          }
          this.updateLocationChips(locVal);
        });
      });

      // Bind Payment Chips
      const paymentChips = document.querySelectorAll<HTMLButtonElement>('[data-payment]');
      paymentChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const paymentVal = chip.dataset.payment || 'Unpaid';
          if (this.form) {
            (this.form.querySelector('[name="paymentStatus"]') as HTMLInputElement).value = paymentVal;
          }
          this.updatePaymentChips(paymentVal);
          this.togglePartialAmountBox(paymentVal);
        });
      });

      // Bind session/price steppers and auto-calculate total
      const stepperBtns = this.form?.querySelectorAll<HTMLButtonElement>('[data-stepper]');
      stepperBtns?.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const target = btn.dataset.stepper;
          const dir = parseInt(btn.dataset.dir || '0', 10);
          const input = document.getElementById(target === 'pricePerSession' ? 'patientPricePerSession' : 'patientTotalSessions') as HTMLInputElement | null;
          if (!input) return;
          const current = parseInt(input.value || '0', 10) || 0;
          const next = Math.max(0, current + dir);
          input.value = next.toString();
          this.calculateTotalCost();
        });
      });

      const priceInput = document.getElementById('patientPricePerSession') as HTMLInputElement | null;
      const sessionsInput2 = document.getElementById('patientTotalSessions') as HTMLInputElement | null;
      priceInput?.addEventListener('input', () => this.calculateTotalCost());
      sessionsInput2?.addEventListener('input', () => this.calculateTotalCost());

      const saveBtn = document.getElementById('save-patient-btn');
      saveBtn?.addEventListener('click', () => this.savePatient(false));
    }

    private calculateTotalCost() {
      const priceInput = document.getElementById('patientPricePerSession') as HTMLInputElement | null;
      const sessionsInput = document.getElementById('patientTotalSessions') as HTMLInputElement | null;
      const costInput = document.getElementById('patientCost') as HTMLInputElement | null;
      if (!priceInput || !sessionsInput || !costInput) return;

      const price = parseFloat(priceInput.value || '0') || 0;
      const sessions = parseInt(sessionsInput.value || '0', 10) || 0;
      costInput.value = (price * sessions).toString();
    }

    private handlePresetClick(btn: HTMLButtonElement) {
      const presetId = btn.dataset.preset;
      const pricePerSession = btn.dataset.pricePerSession;
      const sessions = btn.dataset.sessions;
      const plan = btn.dataset.plan;

      const costInput = document.getElementById('patientCost') as HTMLInputElement | null;
      const pricePerSessionInput = document.getElementById('patientPricePerSession') as HTMLInputElement | null;
      const sessionsInput = document.getElementById('patientTotalSessions') as HTMLInputElement | null;
      const planInput = document.getElementById('patientPlan') as HTMLInputElement | null;

      const chips = document.querySelectorAll('.preset-chip');
      chips.forEach(c => {
        c.className = 'preset-chip px-4 py-2.5 rounded-xl text-xs font-black transition-all bg-black/5 text-black hover:bg-black/10';
      });

      btn.className = 'preset-chip px-4 py-2.5 rounded-xl text-xs font-black transition-all bg-amber-400 text-black shadow-sm border border-black/10';

      if (presetId === 'custom') {
        if (pricePerSessionInput) { pricePerSessionInput.value = ''; pricePerSessionInput.focus(); }
        if (sessionsInput) { sessionsInput.value = ''; }
        if (costInput) { costInput.value = ''; }
        return;
      }

      if (plan && planInput) {
        planInput.value = plan;
        this.updatePlanChips(plan);
        this.applyPlanDefaults(plan);
      }

      if (pricePerSession && pricePerSessionInput) {
        pricePerSessionInput.value = pricePerSession;
      }

      if (sessions && sessionsInput) {
        sessionsInput.value = sessions;
      }

      this.calculateTotalCost();
    }

    private togglePartialAmountBox(paymentVal: string) {
      const box = document.getElementById('partial-payment-box');
      const input = document.getElementById('patientPartialAmount') as HTMLInputElement | null;
      const isPartial = (paymentVal || '').toLowerCase().includes('parțial') || (paymentVal || '').toLowerCase().includes('partial');
      if (box) {
        if (isPartial) {
          box.classList.remove('hidden');
          setTimeout(() => input?.focus(), 100);
        } else {
          box.classList.add('hidden');
          if (input) input.value = '';
        }
      }
    }

    updatePlanChips(selectedPlan: string) {
      const clean = (s: string) => (s || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
      const normSelected = clean(selectedPlan);

      const planChips = document.querySelectorAll<HTMLButtonElement>('[data-plan]');
      planChips.forEach(chip => {
        const chipPlan = clean(chip.dataset.plan || '');
        let isMatch = false;

        if (normSelected.includes('abonament') || normSelected.includes('subscrip')) {
          isMatch = chipPlan.includes('abonament');
        } else if (normSelected.includes('sedinta') || normSelected.includes('unica') || normSelected.includes('one') || normSelected.includes('single')) {
          isMatch = chipPlan.includes('sedinta') || chipPlan.includes('unica');
        } else {
          isMatch = chipPlan === normSelected;
        }

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    updateLocationChips(selectedLoc: string) {
      const clean = (s: string) => (s || '').toLowerCase().trim();
      const normSelected = clean(selectedLoc);

      const locationChips = document.querySelectorAll<HTMLButtonElement>('[data-location]');
      locationChips.forEach(chip => {
        const chipLoc = clean(chip.dataset.location || '');
        const isMatch = chipLoc === normSelected;

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    private isOneTimePlan(plan: string) {
      const clean = (s: string) => (s || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
      const p = clean(plan);
      return p.includes('sedinta') || p.includes('unica') || p.includes('one') || p.includes('single');
    }

    applyPlanDefaults(plan: string) {
      const totalInput = this.form?.querySelector('[name="totalSessions"]') as HTMLInputElement | null;
      if (!totalInput) return;

      if (this.isOneTimePlan(plan)) {
        totalInput.value = '1';
        totalInput.readOnly = true;
        totalInput.classList.add('opacity-50', 'cursor-not-allowed');
      } else {
        totalInput.readOnly = false;
        totalInput.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    }

    updatePaymentChips(selectedPayment: string) {
      const clean = (s: string) => (s || '').toLowerCase().trim();
      const normSelected = clean(selectedPayment);

      const paymentChips = document.querySelectorAll<HTMLButtonElement>('[data-payment]');
      paymentChips.forEach(chip => {
        const chipPayment = clean(chip.dataset.payment || '');
        let isMatch = false;

        if (normSelected === 'neachitat' || normSelected === 'unpaid') {
          isMatch = chipPayment === 'neachitat';
        } else if (normSelected === 'achitat' || normSelected === 'paid') {
          isMatch = chipPayment === 'achitat';
        } else if (normSelected.includes('par') || normSelected.includes('partial')) {
          isMatch = chipPayment.includes('par') || chipPayment.includes('partial');
        } else {
          isMatch = chipPayment === normSelected;
        }

        if (isMatch) {
          chip.style.backgroundColor = '#ffc107';
          chip.style.color = '#000000';
          chip.classList.remove('bg-black/5');
          chip.classList.add('shadow-sm', 'font-extrabold');
        } else {
          chip.style.backgroundColor = '';
          chip.style.color = '';
          chip.classList.add('bg-black/5', 'text-black');
          chip.classList.remove('shadow-sm');
        }
      });
    }

    async savePatient(bookSession: boolean) {
      if (!this.form) return;
      if (!this.form.checkValidity()) {
        this.form.reportValidity();
        return;
      }

      const saveBtn = document.getElementById('save-patient-btn') as HTMLButtonElement | null;
      if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Se salvează…'; }

      const formData = new FormData(this.form);
      const patientId = formData.get('patientId') as string;
      const patientName = formData.get('name') as string;
      const paymentStatus = formData.get('paymentStatus') as string;
      const partialAmountRaw = formData.get('partialAmount') as string;
      const partialAmount = partialAmountRaw ? Number(partialAmountRaw) : 0;
      const isPartial = (paymentStatus || '').toLowerCase().includes('par') || (paymentStatus || '').toLowerCase().includes('partial');

      if (isPartial && partialAmount <= 0) {
        (window as any).showToast('Introdu suma plătită parțial pentru a continua.', 'warning');
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Salvează'; }
        return;
      }

      const payload = {
        name: patientName,
        telefon: (formData.get('phone') as string) || '',
        plan: (formData.get('plan') as any) || 'Abonament',
        locatie: (formData.get('location') as any) || 'Belaqva',
        cost: formData.get('cost') ? Number(formData.get('cost')) : 0,
        sedinte_total: formData.get('totalSessions') ? Number(formData.get('totalSessions')) : 10,
        achitat: paymentStatus === 'Achitat' || paymentStatus === 'Paid fully' || paymentStatus === 'Paid',
        drive_link: (formData.get('driveLink') as string) || '',
      };

      try {
        let savedPatientId = patientId || '';
        if (patientId) {
          await updatePatient(patientId, payload);
        } else {
          savedPatientId = await addPatient(payload);
        }

        // Înregistrăm plata parțială imediat după salvarea pacientului
        if (isPartial && savedPatientId && partialAmount > 0) {
          await addPayment(savedPatientId, partialAmount, false);
        }

        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        this.close();

        if (bookSession) {
          setTimeout(() => {
            window.dispatchEvent(new CustomEvent('openAddSession', {
              detail: {
                patientName: patientName,
                showDateTime: true
              }
            }));
          }, 300);
        }
      } catch (err: any) {
        const msg = err.message || err.toString();
        if (msg.includes('Există deja')) {
          (window as any).showToast(msg, 'warning', 'Pacient existent');
        } else {
          (window as any).showToast('Eroare la salvarea pacientului: ' + msg, 'error');
        }
      } finally {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Salvează'; }
      }
    }

    handleOpenEvent(e: any) {
        const detail = e.detail || {};
        const isEdit = !!detail.isEdit;
        const patient = detail.patient;

        const titleEl = document.getElementById('patient-sheet-title');
        const idInput = document.getElementById('editPatientId') as HTMLInputElement;

        if (idInput) {
          idInput.value = isEdit && patient ? patient.id : '';
        }

        if (titleEl) {
          titleEl.textContent = isEdit ? 'Editează pacient' : 'Pacient nou';
        }

        if (isEdit && patient && this.form) {
          let editPaymentStatus = 'Neachitat';
          if (patient.achitat) {
            editPaymentStatus = 'Achitat';
          } else if ((patient.suma_incasata || 0) > 0) {
            editPaymentStatus = 'Plată parțială';
          }
          const cost = patient.cost != null ? Number(patient.cost) : 0;
          const sessions = patient.sedinte_total != null ? Number(patient.sedinte_total) : 0;
          const pricePerSession = sessions > 0 ? Math.round(cost / sessions) : 0;

          (this.form.querySelector('[name="name"]') as HTMLInputElement).value = patient.name || '';
          (this.form.querySelector('[name="phone"]') as HTMLInputElement).value = patient.telefon || '';
          (this.form.querySelector('[name="plan"]') as HTMLInputElement).value = patient.plan || 'Abonament';
          (this.form.querySelector('[name="location"]') as HTMLInputElement).value = patient.locatie || 'Belaqva';
          (this.form.querySelector('[name="pricePerSession"]') as HTMLInputElement).value = pricePerSession > 0 ? String(pricePerSession) : '';
          (this.form.querySelector('[name="totalSessions"]') as HTMLInputElement).value = sessions > 0 ? String(sessions) : '';
          (this.form.querySelector('[name="cost"]') as HTMLInputElement).value = cost > 0 ? String(cost) : '';
          (this.form.querySelector('[name="paymentStatus"]') as HTMLInputElement).value = editPaymentStatus;
          (this.form.querySelector('[name="driveLink"]') as HTMLInputElement).value = patient.drive_link || '';
          this.currentPlanFilter = patient.plan || 'Abonament';
          this.updatePlanChips(patient.plan || 'Abonament');
          this.updateLocationChips(patient.locatie || 'Belaqva');
          this.updatePaymentChips(editPaymentStatus);
          this.applyPlanDefaults(patient.plan || 'Abonament');
          this.togglePartialAmountBox(editPaymentStatus);
          this.renderPricingPresets();
        } else if (this.form) {
          this.form.reset();
          const defaultPresetBtn = document.querySelector('.preset-chip[data-preset="p1"]') as HTMLButtonElement | null;
          if (defaultPresetBtn) {
            this.handlePresetClick(defaultPresetBtn);
          } else {
            (this.form.querySelector('[name="pricePerSession"]') as HTMLInputElement).value = '150';
            (this.form.querySelector('[name="totalSessions"]') as HTMLInputElement).value = '10';
            (this.form.querySelector('[name="cost"]') as HTMLInputElement).value = '1500';
            this.currentPlanFilter = 'Abonament';
            this.updatePlanChips('Abonament');
            this.applyPlanDefaults('Abonament');
            this.renderPricingPresets();
          }
          this.updateLocationChips('Belaqva');
          this.updatePaymentChips('Neachitat');
          this.togglePartialAmountBox('Neachitat');
        }

        const partialAmountInput = document.getElementById('patientPartialAmount') as HTMLInputElement | null;
        if (partialAmountInput) partialAmountInput.value = '';

        this.open();
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      // Ensure the sheet is in the layout before animating (prevents flash on load)
      // Lock max-height in pixels to prevent jumping when iOS keyboard resizes the viewport
      this.sheet.style.maxHeight = `${window.innerHeight * 0.9}px`;
      this.sheet.dataset.open = 'true';
      // Prevent the on-screen keyboard from opening automatically when the sheet slides up
      if (document.activeElement && 'blur' in document.activeElement) {
        (document.activeElement as HTMLElement).blur();
      }
      void this.sheet.offsetWidth;
      this.sheet.classList.remove('translate-y-full');
      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      lockBodyScroll();
    }

    close() {
      if (!this.sheet || !this.overlay) return;
      this.sheet.style.transform = '';
      this.sheet.classList.add('translate-y-full');
      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      unlockBodyScroll();
      setTimeout(() => {
        if (this.sheet) this.sheet.dataset.open = 'false';
        this.form?.reset();
      }, 500);
    }

    handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;
      
      // If an input is focused OR the user is tapping on an input, prevent sheet dragging to avoid jumps
      const target = e.target as HTMLElement;
      const isInputTarget = target && ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'LABEL'].includes(target.tagName);
      if (isInputTarget || (document.activeElement && ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName))) {
        this.scrollAtTop = false;
        return;
      }

      // Only allow sheet drag when the scrollable form is at the top,
      // otherwise the gesture should scroll the form instead
      const scrollArea = this.sheet?.querySelector('.overflow-y-auto');
      this.scrollAtTop = !scrollArea || scrollArea.scrollTop <= 0;
    }

    handleTouchMove(e: TouchEvent) {
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        if (this.scrollAtTop && deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.sheet) this.sheet.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.sheet) {
        if (e.cancelable) e.preventDefault();
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.sheet || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      this.sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
      
      if (deltaY > 150) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }
  }

  function initPatientSheet() {
    // Only bind the window event listener once globally
    if (!(window as any)._patientSheetListenerBound) {
      window.addEventListener('openAddPatient', (e: any) => {
        if ((window as any).currentPatientSheetManager) {
          (window as any).currentPatientSheetManager.handleOpenEvent(e);
        }
      });
      (window as any)._patientSheetListenerBound = true;
    }

    // Recreate the manager on every page navigation so its overlay is always
    // attached to the current document body (Astro's transition:persist moves
    // the sheet but not the dynamically-created overlay).
    if (document.getElementById('add-patient-sheet')) {
      (window as any).currentPatientSheetManager = new AddPatientSheetManager();
    }
  }

  document.addEventListener('astro:page-load', initPatientSheet);
  document.addEventListener('DOMContentLoaded', initPatientSheet);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initPatientSheet();
  }
</script>
