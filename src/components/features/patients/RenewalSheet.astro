---
// RenewalSheet.astro — Bottom sheet custom pentru reînnoirea abonamentelor de ședințe
---

<div id="renewal-sheet" data-sheet-root class="fixed inset-0 z-[130] pointer-events-none">
  <div id="renewal-backdrop" class="absolute inset-0 bg-black/25 pointer-events-auto transition-opacity duration-300 opacity-0"></div>
  
  <div id="renewal-content" class="absolute bottom-0 left-0 right-0 bg-surface-card rounded-t-[2.5rem] p-6 pb-8 sm:pb-6 pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] max-h-[90vh] overflow-y-auto border-t border-transparent">
    <!-- Drag handle -->
    <div class="w-12 h-1.5 bg-neutral-300 rounded-full mx-auto mb-6 cursor-grab active:cursor-grabbing" id="renewal-drag-handle"></div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-text-main">Reînnoire abonament</h2>
        <p class="text-text-muted font-bold text-sm mt-0.5" id="renewal-patient-name">Selectează noul pachet de ședințe</p>
      </div>
    </div>

    <!-- Restanță anterioară (dacă există) -->
    <div id="renewal-debt-card" class="hidden mb-4 bg-rose-50 border border-rose-200 p-4 rounded-2xl">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center font-black shrink-0 shadow-sm mt-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs sm:text-sm font-black text-rose-900 leading-snug">Restanță anterioară: <span id="renewal-debt-amount" class="text-rose-600 font-extrabold underline">0 RON</span></p>
          <p class="text-[11px] font-bold text-rose-700 mt-1">Pacientul mai are de achitat suma de mai sus din abonamentul anterior pe lângă costul noului pachet.</p>
        </div>
      </div>
    </div>

    <!-- Info simplu și discret -->
    <div class="flex items-center gap-2.5 p-3.5 bg-amber-500/10 border border-amber-500/20 rounded-2xl mb-4">
      <svg class="w-4 h-4 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span class="text-xs font-black text-neutral-800 leading-snug">Contorul de ședințe va fi reluat de la 0 (istoricul rămâne salvat).</span>
    </div>

    <!-- CARD: PREȚ & ȘEDINȚE (Clean Design) -->
    <div class="rounded-3xl bg-black/[0.03] p-4 space-y-4 border border-black/5 mb-4">
      <div class="grid grid-cols-2 gap-3">
        <!-- Preț / Ședință -->
        <div>
          <label class="block text-xs font-black text-black mb-1.5 uppercase tracking-wider text-center">Preț / Ședință</label>
          <div class="flex items-center rounded-2xl bg-white border border-pink-200/80 p-1 shadow-sm focus-within:border-pink-400 focus-within:ring-2 focus-within:ring-pink-100 transition-all">
            <button 
              type="button" 
              data-stepper="price" 
              data-dir="-1" 
              class="w-8 h-9 rounded-xl bg-pink-100 hover:bg-pink-200 active:scale-95 text-pink-700 font-black text-lg flex items-center justify-center transition-all shrink-0 cursor-pointer"
            >
              −
            </button>
            <input
              type="number"
              id="renewal-price-input"
              value="150"
              min="0"
              max="2000"
              step="10"
              inputmode="numeric"
              placeholder="150"
              class="w-full min-w-0 px-1 py-1.5 bg-transparent border-0 text-center font-extrabold text-black text-base focus:outline-none"
            />
            <button 
              type="button" 
              data-stepper="price" 
              data-dir="1" 
              class="w-8 h-9 rounded-xl bg-pink-100 hover:bg-pink-200 active:scale-95 text-pink-700 font-black text-lg flex items-center justify-center transition-all shrink-0 cursor-pointer"
            >
              +
            </button>
          </div>
        </div>

        <!-- Nr. Ședințe -->
        <div>
          <label class="block text-xs font-black text-black mb-1.5 uppercase tracking-wider text-center">Nr. Ședințe</label>
          <div class="flex items-center rounded-2xl bg-white border border-pink-200/80 p-1 shadow-sm focus-within:border-pink-400 focus-within:ring-2 focus-within:ring-pink-100 transition-all">
            <button 
              type="button" 
              data-stepper="sessions" 
              data-dir="-1" 
              class="w-8 h-9 rounded-xl bg-pink-100 hover:bg-pink-200 active:scale-95 text-pink-700 font-black text-lg flex items-center justify-center transition-all shrink-0 cursor-pointer"
            >
              −
            </button>
            <input
              type="number"
              id="renewal-sessions-input"
              value="10"
              min="1"
              max="100"
              step="1"
              inputmode="numeric"
              placeholder="10"
              class="w-full min-w-0 px-1 py-1.5 bg-transparent border-0 text-center font-extrabold text-black text-base focus:outline-none"
            />
            <button 
              type="button" 
              data-stepper="sessions" 
              data-dir="1" 
              class="w-8 h-9 rounded-xl bg-pink-100 hover:bg-pink-200 active:scale-95 text-pink-700 font-black text-lg flex items-center justify-center transition-all shrink-0 cursor-pointer"
            >
              +
            </button>
          </div>
        </div>
      </div>

      <!-- Cost Total Calculat Automat -->
      <div class="flex items-center justify-between p-3.5 px-4 rounded-2xl bg-white border border-black/5 shadow-2xs">
        <span class="text-xs font-black uppercase tracking-wider text-text-muted">Total calculat:</span>
        <div class="flex items-baseline gap-1">
          <span id="renewal-calculated-cost" class="text-xl sm:text-2xl font-black text-text-main">1500</span>
          <span class="text-xs font-black text-text-muted">RON</span>
        </div>
      </div>
    </div>

    <!-- CARD: STATUS PLATĂ (3 Opțiuni: Neachitat, Parțial, Achitat) -->
    <div class="rounded-3xl bg-black/[0.03] p-4 space-y-3 border border-black/5 mb-5">
      <label class="block text-xs font-black text-black uppercase tracking-wider">Status plată</label>
      <div class="grid grid-cols-3 gap-1.5 p-1 bg-black/5 rounded-2xl" id="renewal-payment-mode-container">
        <button 
          type="button" 
          data-payment="Neachitat" 
          class="renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-rose-100 text-rose-700 shadow-sm"
        >
          Neachitat
        </button>
        <button 
          type="button" 
          data-payment="Parțial" 
          class="renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-center truncate text-text-muted hover:text-black"
        >
          Parțial
        </button>
        <button 
          type="button" 
          data-payment="Achitat" 
          class="renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-center truncate text-text-muted hover:text-black"
        >
          Achitat
        </button>
      </div>

      <!-- Sumă plată parțială -->
      <div id="renewal-partial-box" class="hidden mt-2.5">
        <label for="renewal-partial-amount" class="block text-xs font-black text-black mb-1.5 uppercase tracking-wider">Sumă achitată acum (RON)</label>
        <input
          type="number"
          id="renewal-partial-amount"
          min="1"
          placeholder="ex: 500"
          class="w-full px-5 py-3 rounded-2xl bg-white border border-black/10 text-base font-extrabold text-black focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all shadow-sm"
        />
      </div>
    </div>

    <!-- Buton Confirmă -->
    <div class="pt-1 mb-2">
      <button 
        type="button" 
        id="btn-confirm-renewal" 
        class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-lg shadow-md shadow-amber-500/15 active:scale-[0.98] transition-all flex items-center justify-center cursor-pointer"
      >
        <span>Confirmă reînnoirea</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { resetPatientSubscription, getPatient, getPatientPayments } from '../../../lib/services/patientService';
  import { createAppointment } from '../../../lib/services/appointmentService';
  import { getSettings } from '../../../lib/services/settingsService';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  class RenewalSheetManager {
    private sheet: HTMLElement | null = null;
    private backdrop: HTMLElement | null = null;
    private content: HTMLElement | null = null;
    private sessionsInput: HTMLInputElement | null = null;
    private priceInput: HTMLInputElement | null = null;
    private partialAmountInput: HTMLInputElement | null = null;
    private partialBox: HTMLElement | null = null;
    private calculatedDisplay: HTMLElement | null = null;
    private selectedPaymentStatus: 'Neachitat' | 'Parțial' | 'Achitat' = 'Neachitat';
    private currentPatientId: string | null = null;
    private pendingAppointment: any = null;
    private isOpen: boolean = false;

    constructor() {
      this.reconnect();
      this.bindEvents();
    }

    reconnect() {
      this.sheet = document.getElementById('renewal-sheet');
      this.backdrop = document.getElementById('renewal-backdrop');
      this.content = document.getElementById('renewal-content');
      this.sessionsInput = document.getElementById('renewal-sessions-input') as HTMLInputElement;
      this.priceInput = document.getElementById('renewal-price-input') as HTMLInputElement;
      this.partialAmountInput = document.getElementById('renewal-partial-amount') as HTMLInputElement;
      this.partialBox = document.getElementById('renewal-partial-box');
      this.calculatedDisplay = document.getElementById('renewal-calculated-cost');

      if (this.sheet?.dataset.open === 'true') this.isOpen = true;
      this.bindDragHandle();
      this.bindContentSwipe();
    }

    handleOpenEvent(e: CustomEvent) {
      if (e.detail?.patientId) {
        this.currentPatientId = e.detail.patientId;
        const count = e.detail.currentTotal || 10;
        this.pendingAppointment = e.detail.pendingAppointment || null;
        this.loadPatientInfo(e.detail.patientName, count);
        this.open();
      }
    }

    private bindEvents() {
      if ((window as any)._renewalDocClickBound) return;
      (window as any)._renewalDocClickBound = true;

      document.addEventListener('click', (e) => {
        const mgr = (window as any).currentRenewalSheetManager || this;
        mgr.handleDocumentClick(e);
      });

      // Steppers & input calculation listeners
      document.addEventListener('input', (e) => {
        const target = e.target as HTMLElement;
        if (target && (target.id === 'renewal-sessions-input' || target.id === 'renewal-price-input')) {
          const mgr = (window as any).currentRenewalSheetManager || this;
          mgr.calculateTotalCost();
        }
      });

      this.bindDragHandle();
      this.bindContentSwipe();
    }

    private handleDocumentClick(e: MouseEvent) {
      const target = e.target as HTMLElement;
      if (!target) return;

      if (target.closest('#renewal-backdrop')) {
        this.close();
        return;
      }

      // Stepper button clicks
      const stepperBtn = target.closest('[data-stepper]') as HTMLElement | null;
      if (stepperBtn && target.closest('#renewal-sheet')) {
        const type = stepperBtn.dataset.stepper;
        const dir = parseInt(stepperBtn.dataset.dir || '1', 10);
        this.stepValue(type, dir);
        return;
      }

      // Payment mode buttons (Neachitat, Parțial, Achitat)
      const payBtn = target.closest('[data-payment]') as HTMLElement | null;
      if (payBtn && target.closest('#renewal-sheet')) {
        const status = payBtn.dataset.payment as 'Neachitat' | 'Parțial' | 'Achitat';
        this.setPaymentStatus(status);
        return;
      }

      // Confirm button
      if (target.closest('#btn-confirm-renewal')) {
        this.handleConfirm();
        return;
      }
    }

    private stepValue(type: string | undefined, dir: number) {
      if (type === 'sessions') {
        const input = document.getElementById('renewal-sessions-input') as HTMLInputElement | null;
        if (!input) return;
        const cur = parseInt(input.value || '10', 10);
        const next = Math.max(1, Math.min(100, cur + dir));
        input.value = String(next);
        this.calculateTotalCost();
      } else if (type === 'price') {
        const input = document.getElementById('renewal-price-input') as HTMLInputElement | null;
        if (!input) return;
        const cur = parseInt(input.value || '150', 10);
        const step = 10;
        const next = Math.max(0, cur + dir * step);
        input.value = String(next);
        this.calculateTotalCost();
      }
    }

    calculateTotalCost() {
      const sInput = document.getElementById('renewal-sessions-input') as HTMLInputElement | null;
      const pInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
      const display = document.getElementById('renewal-calculated-cost');

      const sessions = Math.max(1, parseInt(sInput?.value || '0', 10) || 10);
      const price = Math.max(0, parseInt(pInput?.value || '0', 10) || 0);
      const total = sessions * price;

      if (display) {
        display.textContent = String(total);
      }
      return total;
    }

    private setPaymentStatus(status: 'Neachitat' | 'Parțial' | 'Achitat') {
      this.selectedPaymentStatus = status;
      const buttons = document.querySelectorAll<HTMLElement>('#renewal-payment-mode-container [data-payment]');
      buttons.forEach(btn => {
        const bStatus = btn.dataset.payment;
        if (bStatus === status) {
          if (status === 'Neachitat') {
            btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-rose-100 text-rose-700 shadow-sm';
          } else if (status === 'Parțial') {
            btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-amber-100 text-amber-900 shadow-sm';
          } else {
            btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-emerald-100 text-emerald-800 shadow-sm';
          }
        } else {
          btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-center truncate bg-transparent text-text-muted hover:text-black';
        }
      });

      const pBox = document.getElementById('renewal-partial-box');
      if (pBox) {
        if (status === 'Parțial') {
          pBox.classList.remove('hidden');
        } else {
          pBox.classList.add('hidden');
        }
      }
    }

    private async loadPatientInfo(providedName?: string, defaultSessions: number = 10) {
      const nameEl = document.getElementById('renewal-patient-name');
      const debtCard = document.getElementById('renewal-debt-card');
      const debtAmountEl = document.getElementById('renewal-debt-amount');
      const sInput = document.getElementById('renewal-sessions-input') as HTMLInputElement | null;
      const pInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
      const partInput = document.getElementById('renewal-partial-amount') as HTMLInputElement | null;

      if (partInput) partInput.value = '';

      let defaultPrice = 150;
      try {
        const st = await getSettings();
        if (st?.default_price) defaultPrice = st.default_price;
      } catch (_) {}

      if (sInput) sInput.value = String(defaultSessions || 10);
      if (pInput) pInput.value = String(defaultPrice);

      if (!this.currentPatientId) {
        this.calculateTotalCost();
        return;
      }

      try {
        const patient = await getPatient(this.currentPatientId);
        if (nameEl) nameEl.textContent = `Pacient: ${patient.name}`;

        if (patient.sedinte_total && sInput) {
          sInput.value = String(patient.sedinte_total);
        }
        if (patient.cost && patient.sedinte_total && patient.sedinte_total > 0 && pInput) {
          const derivedPrice = Math.round(Number(patient.cost) / Number(patient.sedinte_total));
          if (derivedPrice > 0) pInput.value = String(derivedPrice);
        }

        const totalPaid = await getPatientPayments(this.currentPatientId);
        const costTotal = Number(patient.cost || 0);
        const restDePlata = Math.max(0, costTotal - totalPaid);

        if (!patient.achitat && restDePlata > 0) {
          if (debtAmountEl) debtAmountEl.textContent = `${restDePlata} RON`;
          if (debtCard) debtCard.classList.remove('hidden');
        } else {
          if (debtCard) debtCard.classList.add('hidden');
        }
      } catch (e) {
        if (providedName && nameEl) nameEl.textContent = `Pacient: ${providedName}`;
      }

      this.calculateTotalCost();
    }

    private bindDragHandle() {
      const dragHandle = document.getElementById('renewal-drag-handle');
      if (!dragHandle || !this.content) return;
      if (dragHandle.dataset.renewalBound === 'true') return;
      dragHandle.dataset.renewalBound = 'true';
      let startY = 0;
      let currentY = 0;
      let dragging = false;
      const content = this.content;

      dragHandle.addEventListener('touchstart', (e: TouchEvent) => {
        startY = e.touches[0].clientY;
        currentY = startY;
        dragging = true;
        content.style.transition = 'none';
      }, { passive: true });

      dragHandle.addEventListener('touchmove', (e: TouchEvent) => {
        if (!dragging) return;
        currentY = e.touches[0].clientY;
        const deltaY = currentY - startY;
        if (deltaY > 0) {
          if (e.cancelable) e.preventDefault();
          content.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: false });

      const onEnd = () => {
        if (!dragging) return;
        dragging = false;
        const deltaY = currentY - startY;
        content.style.transition = 'transform 400ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 80) {
          this.close();
        } else {
          content.style.transform = 'translateY(0)';
        }
      };

      dragHandle.addEventListener('touchend', onEnd);
      dragHandle.addEventListener('touchcancel', onEnd);
    }

    private bindContentSwipe() {
      if (!this.content) return;
      if (this.content.dataset.renewalSwipeBound === 'true') return;
      this.content.dataset.renewalSwipeBound = 'true';
      let startY = 0;
      let currentY = 0;
      let startX = 0;
      let dragEngaged = false;
      const content = this.content;

      content.addEventListener('touchstart', (e: TouchEvent) => {
        if (document.activeElement && ['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
          return;
        }
        startY = e.touches[0].clientY;
        currentY = startY;
        startX = e.touches[0].clientX;
        dragEngaged = false;
      }, { passive: true });

      content.addEventListener('touchmove', (e: TouchEvent) => {
        const isAtTop = content.scrollTop <= 0;
        if (!isAtTop && !dragEngaged) return;

        const y = e.touches[0].clientY;
        const deltaY = y - startY;
        const deltaX = e.touches[0].clientX - startX;

        if (!dragEngaged) {
          if (deltaY > 10 && Math.abs(deltaY) > Math.abs(deltaX)) {
            dragEngaged = true;
            content.style.transition = 'none';
          } else {
            return;
          }
        }

        if (deltaY > 0) {
          if (e.cancelable) e.preventDefault();
          content.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: false });

      const onSwipeEnd = () => {
        if (!dragEngaged) return;
        dragEngaged = false;
        const deltaY = currentY - startY;
        content.style.transition = 'transform 400ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 100) {
          this.close();
        } else {
          content.style.transform = 'translateY(0)';
        }
      };

      content.addEventListener('touchend', onSwipeEnd);
      content.addEventListener('touchcancel', onSwipeEnd);
    }

    private async handleConfirm() {
      if (!this.currentPatientId) {
        (window as any).showToast?.('Eroare: Pacientul nu este selectat.', 'error');
        return;
      }

      const sInput = document.getElementById('renewal-sessions-input') as HTMLInputElement | null;
      const pInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
      const partInput = document.getElementById('renewal-partial-amount') as HTMLInputElement | null;

      const count = Math.max(1, parseInt(sInput?.value || '10', 10));
      const pricePerSession = Math.max(0, parseInt(pInput?.value || '150', 10));
      const totalCost = count * pricePerSession;
      const paidAmount = this.selectedPaymentStatus === 'Parțial' ? Math.max(0, parseInt(partInput?.value || '0', 10)) : 0;

      const btn = document.getElementById('btn-confirm-renewal') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="animate-pulse">Se procesează...</span>';
      }

      try {
        await resetPatientSubscription(
          this.currentPatientId,
          count,
          totalCost,
          {
            status: this.selectedPaymentStatus,
            paidAmount: paidAmount
          }
        );

        if (this.pendingAppointment) {
          try {
            await createAppointment({
              pacient_id: this.currentPatientId,
              data: this.pendingAppointment.data,
              ora: this.pendingAppointment.ora,
              locatie: this.pendingAppointment.locatie,
            });
            (window as any).showToast?.(`Abonament reînnoit și ședința programată pe ${this.pendingAppointment.data} la ${this.pendingAppointment.ora}!`, 'success');
          } catch (appErr: any) {
            (window as any).showToast?.('Abonament reînnoit, dar nu s-a putut salva programarea: ' + (appErr?.message || appErr), 'warning');
          }
          this.pendingAppointment = null;
        } else {
          (window as any).showToast?.(`Abonamentul a fost reînnoit (${count} ședințe - ${totalCost} RON).`, 'success');
        }

        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        this.close();
      } catch (err: any) {
        (window as any).showToast?.('Eroare la reînnoire: ' + (err?.message || err), 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<span>Confirmă reînnoirea</span>';
        }
      }
    }

    open() {
      this.reconnect();
      if (!this.sheet || !this.backdrop || !this.content) return;
      this.isOpen = true;
      this.calculateTotalCost();
      this.setPaymentStatus('Neachitat');
      this.sheet.dataset.open = 'true';
      void this.sheet.offsetWidth;

      this.backdrop.classList.remove('opacity-0');
      this.content.classList.remove('translate-y-full');
      lockBodyScroll();
    }

    close() {
      if (!this.sheet || !this.backdrop || !this.content || !this.isOpen) return;
      this.isOpen = false;
      unlockBodyScroll();

      this.content.style.transition = '';
      this.content.style.transform = '';
      this.backdrop.classList.add('opacity-0');
      this.content.classList.add('translate-y-full');

      setTimeout(() => {
        if (!this.isOpen && this.sheet) {
          this.sheet.dataset.open = 'false';
          this.currentPatientId = null;
        }
      }, 500);
    }
  }

  function initRenewalSheet() {
    if (!document.getElementById('renewal-sheet')) return;

    if (!(window as any)._renewalSheetWindowListenerBound) {
      window.addEventListener('openRenewalSheet', (e: Event) => {
        (window as any).currentRenewalSheetManager?.handleOpenEvent(e as CustomEvent);
      });
      (window as any)._renewalSheetWindowListenerBound = true;
    }

    (window as any).currentRenewalSheetManager = new RenewalSheetManager();
  }

  document.addEventListener('astro:page-load', initRenewalSheet);
  document.addEventListener('DOMContentLoaded', initRenewalSheet);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initRenewalSheet();
  }
</script>
