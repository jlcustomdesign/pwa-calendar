---
// RenewalSheet.astro — Bottom sheet custom pentru reînnoirea abonamentelor de ședințe
---

<div 
  id="renewal-sheet" 
  data-sheet-root 
  class="fixed inset-x-0 bottom-0 z-[130] bg-white rounded-t-[2.5rem] pt-5 pb-0 shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] translate-y-full will-change-transform flex flex-col max-h-[92vh] overflow-hidden"
>
  <!-- Drag handle (large touch area) -->
  <div class="flex items-center justify-center py-3 shrink-0 cursor-grab active:cursor-grabbing" id="renewal-drag-handle">
    <div class="w-12 h-1.5 bg-black/10 rounded-full"></div>
  </div>

  <div class="flex-1 overflow-y-auto px-6 pt-1 pb-36 space-y-5">
    <!-- Header -->
    <div class="flex items-center justify-between mb-2">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Reînnoire abonament</h2>
        <p class="text-black font-black mt-1 text-lg sm:text-xl" id="renewal-patient-name">Selectează noul pachet de ședințe</p>
      </div>
    </div>

    <!-- Restanță anterioară (dacă există) -->
    <div id="renewal-debt-card" class="hidden bg-rose-50 border border-rose-200 p-4 rounded-2xl">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center font-black shrink-0 shadow-sm mt-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs sm:text-sm font-black text-rose-900 leading-snug">Restanță anterioară: <span id="renewal-debt-amount" class="text-rose-600 font-extrabold underline">0 RON</span></p>
          <p class="text-[11px] font-bold text-rose-700 mt-1">Pacientul mai are de achitat suma de mai sus din abonamentul anterior pe lângă costul noului pachet.</p>
        </div>
      </div>
    </div>

    <!-- Info simplu și discret -->
    <div class="flex items-center gap-2.5 p-3.5 bg-amber-500/10 border border-amber-500/20 rounded-2xl">
      <svg class="w-4 h-4 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span class="text-xs font-black text-neutral-800 leading-snug">Contorul de ședințe va fi reluat de la 0 (istoricul rămâne salvat).</span>
    </div>

    <!-- CARD: PREȚ & ȘEDINȚE (Clean Design) -->
    <div class="rounded-3xl bg-black/[0.03] p-4 space-y-4 border border-black/5">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-black text-black mb-1.5 uppercase tracking-wider text-center">Preț abonament</label>
          <div class="flex items-center bg-white rounded-2xl overflow-hidden shadow-sm p-1 gap-1 transition-all border border-pink-200/80">
            <button type="button" tabindex="-1" class="px-3 py-2 text-black font-black bg-brand-primary hover:brightness-105 transition-all active:scale-95 text-base rounded-xl cursor-pointer shrink-0" onclick="const pDec = document.getElementById('renewal-price-input'); if(pDec){ pDec.value = Math.max(0, Number(pDec.value || 0) - 50); pDec.dispatchEvent(new Event('input', { bubbles: true })); }">-</button>
            <input
              type="number"
              id="renewal-price-input"
              value="1500"
              min="0"
              inputmode="numeric"
              placeholder="1500"
              class="w-full py-2 text-center font-extrabold text-black text-base focus:outline-none border-none bg-transparent appearance-none m-0 [-moz-appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            />
            <button type="button" tabindex="-1" class="px-3 py-2 text-black font-black bg-brand-primary hover:brightness-105 transition-all active:scale-95 text-base rounded-xl cursor-pointer shrink-0" onclick="const pInc = document.getElementById('renewal-price-input'); if(pInc){ pInc.value = Number(pInc.value || 0) + 50; pInc.dispatchEvent(new Event('input', { bubbles: true })); }">+</button>
          </div>
        </div>
        <div>
          <label class="block text-xs font-black text-black mb-1.5 uppercase tracking-wider text-center">Nr. ședințe</label>
          <div class="flex items-center bg-white rounded-2xl overflow-hidden shadow-sm p-1 gap-1 transition-all border border-pink-200/80">
            <button type="button" tabindex="-1" class="px-3 py-2 text-black font-black bg-brand-primary hover:brightness-105 transition-all active:scale-95 text-base rounded-xl cursor-pointer shrink-0" onclick="const sDec = document.getElementById('renewal-sessions-input'); if(sDec){ sDec.value = Math.max(1, Number(sDec.value || 0) - 1); sDec.dispatchEvent(new Event('input', { bubbles: true })); }">-</button>
            <input
              type="number"
              id="renewal-sessions-input"
              value="10"
              min="1"
              max="100"
              inputmode="numeric"
              placeholder="10"
              class="w-full py-2 text-center font-extrabold text-black text-base focus:outline-none border-none bg-transparent appearance-none m-0 [-moz-appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            />
            <button type="button" tabindex="-1" class="px-3 py-2 text-black font-black bg-brand-primary hover:brightness-105 transition-all active:scale-95 text-base rounded-xl cursor-pointer shrink-0" onclick="const sInc = document.getElementById('renewal-sessions-input'); if(sInc){ sInc.value = Number(sInc.value || 0) + 1; sInc.dispatchEvent(new Event('input', { bubbles: true })); }">+</button>
          </div>
        </div>
      </div>
    </div>

    <!-- CARD: STATUS PLATĂ (3 Opțiuni: Neachitat, Parțial, Achitat) -->
    <div class="rounded-3xl bg-black/[0.03] p-4 space-y-3 border border-black/5">
      <label class="block text-xs font-black text-black uppercase tracking-wider">Status plată</label>
      <div class="grid grid-cols-3 gap-1.5 p-1 bg-black/5 rounded-2xl" id="renewal-payment-mode-container">
        <button 
          type="button" 
          data-payment="Neachitat"
          class="renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-rose-100 text-rose-700 shadow-sm"
        >
          Neachitat
        </button>
        <button 
          type="button" 
          data-payment="Parțial"
          class="renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-center truncate text-text-muted hover:text-black"
        >
          Parțial
        </button>
        <button 
          type="button" 
          data-payment="Achitat"
          class="renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-center truncate text-text-muted hover:text-black"
        >
          Achitat
        </button>
      </div>

      <!-- Sumă plată parțială -->
      <div id="renewal-partial-box" class="hidden mt-2.5">
        <label for="renewal-partial-amount" class="block text-xs font-black text-black mb-1.5 uppercase tracking-wider">Sumă achitată acum (RON)</label>
        <input
          type="number"
          id="renewal-partial-amount"
          min="1"
          placeholder="ex: 500"
          class="w-full px-5 py-3 rounded-2xl bg-white border border-black/10 text-base font-extrabold text-black focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all shadow-sm"
        />
      </div>
    </div>
  </div>

  <!-- Sticky Bottom Actions -->
  <div class="absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-white via-white to-transparent pt-8 flex flex-col gap-2.5 pb-safe z-10">
    <button 
      type="button" 
      id="btn-confirm-renewal" 
      class="w-full py-4 px-6 rounded-full bg-brand-primary hover:brightness-105 text-black font-extrabold text-lg shadow-md shadow-amber-500/15 active:scale-[0.98] transition-all flex items-center justify-center cursor-pointer"
    >
      <span>Confirmă reînnoirea</span>
    </button>
  </div>
</div>

<script>
  import { resetPatientSubscription, getPatient, getPatientPayments } from '../../../lib/services/patientService';
  import { createAppointment } from '../../../lib/services/appointmentService';
  import { getSettings } from '../../../lib/services/settingsService';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  class RenewalSheetManager {
    private sheet: HTMLElement | null = null;
    private overlay: HTMLElement | null = null;
    private sessionsInput: HTMLInputElement | null = null;
    private priceInput: HTMLInputElement | null = null;
    private partialAmountInput: HTMLInputElement | null = null;
    private partialBox: HTMLElement | null = null;
    private calculatedDisplay: HTMLElement | null = null;
    private selectedPaymentStatus: 'Neachitat' | 'Parțial' | 'Achitat' = 'Neachitat';
    private currentPatientId: string | null = null;
    private pendingAppointment: any = null;
    private isOpen: boolean = false;

    // Touch / Swipe gesture handling
    private startY: number = 0;
    private currentY: number = 0;
    private startX: number = 0;
    private dragEngaged = false;
    private startTime = 0;
    private scrollAtTop: boolean = true;

    constructor() {
      this.reconnect();
      this.createOverlay();
      this.bindEvents();
    }

    reconnect() {
      this.sheet = document.getElementById('renewal-sheet');
      this.sessionsInput = document.getElementById('renewal-sessions-input') as HTMLInputElement;
      this.priceInput = document.getElementById('renewal-price-input') as HTMLInputElement;
      this.partialAmountInput = document.getElementById('renewal-partial-amount') as HTMLInputElement;
      this.partialBox = document.getElementById('renewal-partial-box');
      this.calculatedDisplay = document.getElementById('renewal-calculated-cost');

      if (this.sheet?.dataset.open === 'true') this.isOpen = true;
    }

    createOverlay() {
      const existingOverlays = document.querySelectorAll('.renewal-sheet-overlay');
      existingOverlays.forEach(o => o.remove());

      this.overlay = document.createElement('div');
      this.overlay.className = 'fixed inset-0 bg-black/25 z-[120] opacity-0 pointer-events-none transition-opacity duration-300 renewal-sheet-overlay';
      document.body.appendChild(this.overlay);
    }

    handleOpenEvent(e: CustomEvent) {
      this.reconnect();
      if (e.detail?.patientId) {
        this.currentPatientId = e.detail.patientId;
        const count = e.detail.currentTotal || 10;
        this.pendingAppointment = e.detail.pendingAppointment || null;
        this.loadPatientInfo(e.detail.patientName, count);
        this.open();
      }
    }

    private bindEvents() {
      // Delegated click listener on document so it survives sheet re-renders.
      if (!(window as any)._renewalDocumentClickBound) {
        (window as any)._renewalDocumentClickBound = true;
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (!target?.closest('#renewal-sheet')) return;
          const mgr = (window as any).currentRenewalSheetManager;
          if (mgr) mgr.handleClick(e);
        });
      }

      if (!this.sheet) return;

      // Backdrop click
      if (this.overlay && this.overlay.dataset.clickBound !== 'true') {
        this.overlay.dataset.clickBound = 'true';
        this.overlay.addEventListener('click', () => {
          const mgr = (window as any).currentRenewalSheetManager || this;
          mgr.close();
        });
      }

      // ── Dedicated drag handle (same pattern as AddPatientSheet) ──
      const dragHandle = document.getElementById('renewal-drag-handle');
      if (dragHandle && dragHandle.dataset.renewalDragBound !== 'true') {
        dragHandle.dataset.renewalDragBound = 'true';
        let handleStartY = 0;
        let handleCurrentY = 0;
        let handleDragging = false;
        let handleStartTime = 0;

        dragHandle.addEventListener('touchstart', (e: TouchEvent) => {
          e.stopPropagation();
          handleStartY = e.touches[0].clientY;
          handleCurrentY = handleStartY;
          handleDragging = true;
          handleStartTime = Date.now();
          if (this.sheet) this.sheet.style.transition = 'none';
        }, { passive: true });

        dragHandle.addEventListener('touchmove', (e: TouchEvent) => {
          e.stopPropagation();
          if (!handleDragging) return;
          handleCurrentY = e.touches[0].clientY;
          const deltaY = handleCurrentY - handleStartY;
          if (deltaY > 0 && this.sheet) {
            if (e.cancelable) e.preventDefault();
            this.sheet.style.transform = `translateY(${deltaY}px)`;
          }
        }, { passive: false });

        const onHandleEnd = () => {
          if (!handleDragging) return;
          handleDragging = false;
          const deltaY = handleCurrentY - handleStartY;
          const elapsed = Date.now() - handleStartTime;
          const vel = deltaY / elapsed;
          if (this.sheet) {
            this.sheet.style.transition = 'transform 350ms cubic-bezier(0.32, 0.72, 0, 1)';
            if (deltaY > 60 || (vel > 0.3 && deltaY > 15)) {
              const mgr = (window as any).currentRenewalSheetManager || this;
              mgr.close();
            } else {
              this.sheet.style.transform = 'translateY(0)';
            }
          }
        };
        dragHandle.addEventListener('touchend', onHandleEnd);
        dragHandle.addEventListener('touchcancel', onHandleEnd);
      }

      // ── Body swipe-down to dismiss ──
      if (this.sheet.dataset.renewalSwipeBound !== 'true') {
        this.sheet.dataset.renewalSwipeBound = 'true';
        this.sheet.addEventListener('touchstart', (e: any) => {
          ((window as any).currentRenewalSheetManager || this).handleTouchStart(e);
        }, { passive: true });
        this.sheet.addEventListener('touchmove', (e: any) => {
          ((window as any).currentRenewalSheetManager || this).handleTouchMove(e);
        }, { passive: false });
        this.sheet.addEventListener('touchend', (e: any) => {
          ((window as any).currentRenewalSheetManager || this).handleTouchEnd(e);
        }, { passive: true });
        this.sheet.addEventListener('touchcancel', () => {
          ((window as any).currentRenewalSheetManager || this).cancelDrag();
        }, { passive: true });
      }

      // Input calculation listeners
      if (this.sheet.dataset.inputBound !== 'true') {
        this.sheet.dataset.inputBound = 'true';
        this.sheet.addEventListener('input', (e) => {
          const target = e.target as HTMLElement;
          if (target && target.id === 'renewal-sessions-input') {
            const mgr = (window as any).currentRenewalSheetManager || this;
            const newCount = Math.max(1, parseInt((target as HTMLInputElement).value || '1', 10));
            const pInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
            if (pInput) {
              pInput.value = String(newCount * (mgr.pricePerSession || 150));
            }
            mgr.calculateTotalCost();
          } else if (target && target.id === 'renewal-price-input') {
            const mgr = (window as any).currentRenewalSheetManager || this;
            mgr.calculateTotalCost();
          }
        });
      }
    }

    private handleTouchStart(e: TouchEvent) {
      if (!e.touches || e.touches.length === 0) return;
      this.startTime = Date.now();
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;

      const target = e.target as HTMLElement;
      const isInputTarget = target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
      const isButtonTarget = target && (target.tagName === 'BUTTON' || target.closest('button') || target.closest('.renewal-payment-btn'));
      if (isButtonTarget || isInputTarget) {
        this.scrollAtTop = false;
        return;
      }

      const touchY = e.touches[0].clientY;
      const sheetRect = this.sheet?.getBoundingClientRect();
      const isInHeader = sheetRect ? (touchY - sheetRect.top) < 120 : false;
      const scrollArea = this.sheet?.querySelector('.overflow-y-auto');
      this.scrollAtTop = isInHeader || !scrollArea || scrollArea.scrollTop <= 0;
    }

    private handleTouchMove(e: TouchEvent) {
      if (!e.touches || e.touches.length === 0) return;
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        if (this.scrollAtTop && deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.sheet) this.sheet.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.sheet) {
        if (e.cancelable) e.preventDefault();
        this.sheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    private handleTouchEnd(e?: TouchEvent) {
      if (!this.sheet || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      const timeElapsed = Date.now() - this.startTime;
      const velocity = deltaY / timeElapsed;
      this.sheet.style.transition = 'transform 350ms cubic-bezier(0.32, 0.72, 0, 1)';

      if (deltaY > 60 || (velocity > 0.3 && deltaY > 15)) {
        this.close();
      } else {
        this.sheet.style.transform = 'translateY(0)';
      }
    }

    private cancelDrag() {
      this.dragEngaged = false;
      if (this.sheet) {
        this.sheet.style.transition = 'transform 350ms cubic-bezier(0.32, 0.72, 0, 1)';
        this.sheet.style.transform = 'translateY(0)';
      }
    }

    private handleClick(e: MouseEvent) {
      const target = e.target as HTMLElement;
      if (!target) return;

      // Payment mode toggle buttons
      const payBtn = target.closest('.renewal-payment-btn') as HTMLButtonElement | null;
      if (payBtn) {
        const mode = payBtn.dataset.payment as 'Neachitat' | 'Parțial' | 'Achitat';
        if (mode) this.setPaymentStatus(mode);
        return;
      }

      // Confirm button
      if (target.closest('#btn-confirm-renewal')) {
        this.handleConfirm();
        return;
      }
    }

    calculateTotalCost() {
      const pInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
      const calcEl = document.getElementById('renewal-calculated-cost');
      const price = Math.max(0, parseFloat(pInput?.value || '0'));
      if (calcEl) {
        calcEl.textContent = price.toString();
      }
    }

    setPaymentStatus(status: 'Neachitat' | 'Parțial' | 'Achitat') {
      this.selectedPaymentStatus = status;
      const buttons = document.querySelectorAll('.renewal-payment-btn');
      const partialBox = document.getElementById('renewal-partial-box');

      buttons.forEach((b) => {
        const btn = b as HTMLElement;
        const btnStatus = btn.dataset.payment;
        if (btnStatus === status) {
          if (status === 'Neachitat') {
            btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-rose-100 text-rose-700 shadow-sm';
          } else if (status === 'Parțial') {
            btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-amber-100 text-amber-900 border border-amber-200/60 shadow-sm';
          } else {
            btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-black transition-all text-center truncate bg-emerald-100 text-emerald-700 shadow-sm';
          }
        } else {
          btn.className = 'renewal-payment-btn py-2.5 px-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-center truncate text-text-muted hover:text-black';
        }
      });

      if (partialBox) {
        if (status === 'Parțial') {
          partialBox.classList.remove('hidden');
          const pInput = document.getElementById('renewal-partial-amount') as HTMLInputElement | null;
          if (pInput && !pInput.value) {
            pInput.value = '500';
          }
        } else {
          partialBox.classList.add('hidden');
        }
      }
    }

    private pricePerSession: number = 150;

    private async loadPatientInfo(providedName?: string, count: number = 10) {
      const nameEl = document.getElementById('renewal-patient-name');
      const sessionsInput = document.getElementById('renewal-sessions-input') as HTMLInputElement | null;
      const priceInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
      const debtCard = document.getElementById('renewal-debt-card');
      const debtAmountEl = document.getElementById('renewal-debt-amount');

      if (sessionsInput) sessionsInput.value = count.toString();

      // Reset debt card
      if (debtCard) debtCard.classList.add('hidden');
      if (debtAmountEl) debtAmountEl.textContent = '0 RON';

      this.pricePerSession = 150;
      try {
        const settings = await getSettings();
        if (settings?.default_price) {
          this.pricePerSession = Number(settings.default_price) || 150;
        }
      } catch (e) {}

      if (this.currentPatientId) {
        try {
          const patient = await getPatient(this.currentPatientId);
          if (patient) {
            if (nameEl) nameEl.textContent = `Pacient: ${patient.name}`;

            if (patient.cost && patient.sedinte_total && Number(patient.sedinte_total) > 0) {
              this.pricePerSession = Math.round(Number(patient.cost) / Number(patient.sedinte_total));
            }

            // Calcul restanță anterioară (dacă nu e achitat integral)
            const paymentsTotal = await getPatientPayments(this.currentPatientId);
            const unpaidDebt = Math.max(0, (patient.cost || 0) - paymentsTotal);
            if (unpaidDebt > 0 && debtCard && debtAmountEl) {
               debtAmountEl.textContent = `${unpaidDebt} RON`;
               debtCard.classList.remove('hidden');
            }
          }
        } catch (e) {
          if (providedName && nameEl) nameEl.textContent = `Pacient: ${providedName}`;
        }
      } else {
        if (providedName && nameEl) nameEl.textContent = `Pacient: ${providedName}`;
      }

      if (priceInput) {
        priceInput.value = String(count * this.pricePerSession);
      }

      this.calculateTotalCost();
    }

    private async handleConfirm() {
      if (!this.currentPatientId) {
        (window as any).showToast?.('Eroare: Pacientul nu este selectat.', 'error');
        return;
      }

      const sInput = document.getElementById('renewal-sessions-input') as HTMLInputElement | null;
      const pInput = document.getElementById('renewal-price-input') as HTMLInputElement | null;
      const partInput = document.getElementById('renewal-partial-amount') as HTMLInputElement | null;

      const count = Math.max(1, parseInt(sInput?.value || '10', 10));
      const totalCost = Math.max(0, parseFloat(pInput?.value || '0'));
      const paidAmount = this.selectedPaymentStatus === 'Parțial' ? Math.max(0, parseFloat(partInput?.value || '0')) : 0;

      let paymentOption: any = false;
      if (this.selectedPaymentStatus === 'Achitat') {
        paymentOption = true;
      } else if (this.selectedPaymentStatus === 'Parțial') {
        paymentOption = { status: 'Parțial' as const, paidAmount };
      }

      const btn = document.getElementById('btn-confirm-renewal') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="animate-pulse">Se procesează...</span>';
      }

      try {
        await resetPatientSubscription(
          this.currentPatientId,
          count,
          totalCost,
          paymentOption
        );

        if (this.pendingAppointment && this.pendingAppointment.data && this.pendingAppointment.ora) {
          try {
            await createAppointment({
              pacient_id: this.currentPatientId,
              data: this.pendingAppointment.data,
              ora: this.pendingAppointment.ora,
              locatie: this.pendingAppointment.locatie || 'Belaqva'
            });
          } catch (apptErr) {
            console.warn('Eroare creare programare la reinnoire:', apptErr);
          }
        }

        (window as any).showToast?.('Abonament reînnoit cu succes!', 'success');
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        this.close();
      } catch (err: any) {
        (window as any).showToast?.('Eroare la reînnoire: ' + (err?.message || err), 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<span>Confirmă reînnoirea</span>';
        }
      }
    }

    open() {
      if (!this.sheet || !this.overlay) return;
      this.isOpen = true;
      this.calculateTotalCost();
      this.setPaymentStatus('Neachitat');

      this.sheet.style.maxHeight = `${window.innerHeight * 0.9}px`;
      if (document.activeElement && 'blur' in document.activeElement) {
        (document.activeElement as HTMLElement).blur();
      }

      this.sheet.dataset.open = 'true';
      void this.sheet.offsetWidth;

      this.overlay.classList.remove('opacity-0', 'pointer-events-none');
      this.overlay.classList.add('pointer-events-auto');
      this.sheet.classList.remove('translate-y-full');
      lockBodyScroll();
    }

    close() {
      if (!this.sheet || !this.overlay || !this.isOpen) return;
      this.isOpen = false;
      unlockBodyScroll();

      this.sheet.style.transition = '';
      this.sheet.style.transform = '';

      this.overlay.classList.add('opacity-0', 'pointer-events-none');
      this.overlay.classList.remove('pointer-events-auto');
      this.sheet.classList.add('translate-y-full');

      setTimeout(() => {
        if (!this.isOpen && this.sheet) {
          this.sheet.dataset.open = 'false';
          this.currentPatientId = null;
        }
      }, 500);
    }
  }

  // Global selector for payment status (used by inline onclick fallback).
  (window as any).selectRenewalPayment = (status: 'Neachitat' | 'Parțial' | 'Achitat') => {
    const mgr = (window as any).currentRenewalSheetManager;
    if (mgr && typeof mgr.setPaymentStatus === 'function') {
      mgr.setPaymentStatus(status);
    }
  };

  function initRenewalSheet() {
    if (!(window as any)._renewalSheetWindowListenerBound) {
      window.addEventListener('openRenewalSheet', (e: Event) => {
        (window as any).currentRenewalSheetManager?.handleOpenEvent(e as CustomEvent);
      });
      (window as any)._renewalSheetWindowListenerBound = true;
    }

    if (document.getElementById('renewal-sheet')) {
      (window as any).currentRenewalSheetManager = new RenewalSheetManager();
    }
  }

  document.addEventListener('astro:page-load', initRenewalSheet);
  document.addEventListener('DOMContentLoaded', initRenewalSheet);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initRenewalSheet();
  }
</script>
