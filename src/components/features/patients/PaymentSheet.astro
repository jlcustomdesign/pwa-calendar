---
---
<div id="payment-sheet" data-sheet-root class="fixed inset-0 z-[120] pointer-events-none">
  <div id="payment-backdrop" class="absolute inset-0 bg-black/50 pointer-events-auto transition-opacity duration-300 opacity-0"></div>
  <div id="payment-content" class="absolute bottom-0 left-0 right-0 bg-white rounded-t-[2.5rem] p-6 pb-safe pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] max-h-[90vh] overflow-y-auto">
    <div class="w-12 h-1.5 bg-black/10 rounded-full mx-auto mb-8 cursor-grab active:cursor-grabbing" id="payment-drag-handle"></div>
    
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Status plată</h2>
        <p class="text-neutral-500 font-medium mt-1" id="payment-subtitle">Selectează modalitatea de plată</p>
      </div>
    </div>

    <!-- Patient Financial Summary Card (Clean, airy, modern design) -->
    <div id="payment-summary-box" class="mb-5 bg-neutral-50/90 rounded-3xl p-4 sm:p-5 border border-black/5 space-y-4 shadow-xs">
      
      <!-- Top Row: Patient Name & Status Badge -->
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <h3 class="font-black text-neutral-900 text-lg sm:text-xl tracking-tight truncate" id="payment-patient-name">Se încarcă…</h3>
        </div>
        <div id="payment-current-status-badge" class="shrink-0 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-neutral-200 text-neutral-800">
          -
        </div>
      </div>

      <!-- Financial Balance Card & Clean Progress Bar -->
      <div class="bg-white rounded-2xl p-4 border border-black/5 shadow-xs space-y-3">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="block text-[11px] font-bold text-neutral-400 uppercase tracking-wider">Suma Achitată</span>
            <div class="flex items-baseline gap-1 mt-0.5">
              <span class="text-2xl font-black text-neutral-900 tracking-tight" id="payment-total-paid">0 RON</span>
              <span class="text-xs font-bold text-neutral-400">/ <span id="payment-total-cost">0 RON</span></span>
            </div>
          </div>

          <div class="text-right">
            <span class="block text-[11px] font-bold text-neutral-400 uppercase tracking-wider">Rest de plată</span>
            <span class="text-base font-black text-rose-600 block mt-0.5" id="payment-remaining-due">0 RON</span>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="h-2 w-full bg-black/5 rounded-full overflow-hidden">
          <div id="payment-progress-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-500 ease-out" style="width: 0%;"></div>
        </div>
      </div>

      <!-- Payment History List -->
      <div class="space-y-2">
        <div class="flex items-center justify-between px-1">
          <label class="text-[11px] font-extrabold uppercase tracking-wider text-neutral-400">Istoric Tranzacții</label>
        </div>
        <div id="payment-history-list" class="space-y-2 max-h-36 overflow-y-auto pr-0.5">
          <div class="text-xs font-semibold text-neutral-400 py-2 text-center">Se încarcă istoricul…</div>
        </div>
      </div>
    </div>

    <!-- View 1: Initial Options -->
    <div id="payment-options-view" class="space-y-4">
      <button type="button" id="btn-partially-paid" class="w-full py-4 px-6 rounded-2xl bg-amber-100 text-amber-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Plată parțială</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>

      <button type="button" id="btn-fully-paid" class="w-full py-4 px-6 rounded-2xl bg-emerald-100 text-emerald-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Achitat integral</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>

      <button type="button" id="btn-reset-payment" class="w-full py-4 px-6 rounded-2xl bg-rose-100 text-rose-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Neachitat</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </button>
    </div>

    <!-- View 2: Custom Amount Form -->
    <div id="custom-amount-view" class="space-y-4 hidden">
      <div class="relative">
        <label for="custom-amount-input" class="block text-sm font-semibold text-neutral-700 mb-2" id="custom-amount-label">Introdu suma nouă (RON)</label>
        <div class="relative flex items-center">
          <input 
            type="number" 
            id="custom-amount-input" 
            class="w-full bg-neutral-100 border-none rounded-2xl py-4 pl-4 pr-16 text-lg font-bold text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-black transition-all"
            placeholder="0"
          >
          <span class="absolute right-4 text-neutral-500 font-bold text-lg pointer-events-none">RON</span>
        </div>
      </div>
      
      <div class="flex gap-3 pt-2">
        <button type="button" id="btn-cancel-custom" class="flex-1 py-4 px-6 rounded-2xl bg-neutral-100 text-neutral-700 font-bold text-lg active:scale-95 transition-transform">
          Înapoi
        </button>
        <button type="button" id="btn-confirm-custom" class="flex-[2] py-4 px-6 rounded-2xl bg-black text-white font-bold text-lg active:scale-95 transition-transform flex items-center justify-center shadow-lg shadow-black/20">
          <span>Confirmă plata</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { getPatient, setPaymentStatus, addPayment, getPatientPayments, resetPayments, getPatientPaymentHistoryDetails } from '../../../lib/services/patientService';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  class PaymentSheetManager {
    private sheet: HTMLElement | null;
    private backdrop: HTMLElement | null;
    private content: HTMLElement | null;
    
    private optionsView: HTMLElement | null;
    private customView: HTMLElement | null;
    private customInput: HTMLInputElement | null;
    private customLabel: HTMLElement | null;
    private subtitleText: HTMLElement | null;
    
    private currentPatientId: string | null = null;
    private previousAmount: number = 0;
    private patientCost: number = 0;
    private isOpen = false;
    private startY = 0;
    private currentY = 0;
    private startX = 0;
    private dragEngaged = false;

    constructor() {
      this.sheet = document.getElementById('payment-sheet');
      this.backdrop = document.getElementById('payment-backdrop');
      this.content = document.getElementById('payment-content');
      
      this.optionsView = document.getElementById('payment-options-view');
      this.customView = document.getElementById('custom-amount-view');
      this.customInput = document.getElementById('custom-amount-input') as HTMLInputElement;
      this.customLabel = document.getElementById('custom-amount-label');
      this.subtitleText = document.getElementById('payment-subtitle');
      
      this.bindEvents();
    }

    private reconnect() {
      this.sheet = document.getElementById('payment-sheet');
      this.backdrop = document.getElementById('payment-backdrop');
      this.content = document.getElementById('payment-content');
      this.optionsView = document.getElementById('payment-options-view');
      this.customView = document.getElementById('custom-amount-view');
      this.customInput = document.getElementById('custom-amount-input') as HTMLInputElement;
      this.customLabel = document.getElementById('custom-amount-label');
      this.subtitleText = document.getElementById('payment-subtitle');
      // Keep the open flag in sync when the persisted sheet is reused after navigation.
      if (this.sheet?.dataset.open === 'true') this.isOpen = true;
    }

    handleOpenEvent(e: CustomEvent) {
      this.reconnect();
      this.currentPatientId = e.detail.patientId;
      this.resetView();
      this.open();
    }

    private bindEvents() {
      const root = document.getElementById('payment-sheet');
      if (!root) return;

      // One delegated click listener for the whole sheet, routing to the current
      // manager so it always sees the latest currentPatientId.
      if (root.dataset.paymentEventsBound !== 'true') {
        root.dataset.paymentEventsBound = 'true';
        root.addEventListener('click', (e) => {
          const mgr = (window as any).currentPaymentSheetManager || this;
          mgr.handleClick(e);
        });
      }

      // Swipe-down to dismiss — works from anywhere on the sheet,
      // as long as the gesture is a clearly vertical downward swipe
      if (this.content && this.content.dataset.paymentSwipeBound !== 'true') {
        this.content.dataset.paymentSwipeBound = 'true';
        this.content.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
        this.content.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
        this.content.addEventListener('touchend', () => this.handleTouchEnd());
      }

      // Dedicated drag handle close
      const dragHandle = document.getElementById('payment-drag-handle');
      if (dragHandle && this.content && dragHandle.dataset.paymentDragBound !== 'true') {
        dragHandle.dataset.paymentDragBound = 'true';
        let startY = 0;
        let currentY = 0;
        let dragging = false;
        const content = this.content;
        dragHandle.addEventListener('touchstart', (e: any) => {
          startY = e.touches[0].clientY;
          currentY = startY;
          dragging = true;
          content.style.transition = 'none';
        }, { passive: true });
        dragHandle.addEventListener('touchmove', (e: any) => {
          if (!dragging) return;
          currentY = e.touches[0].clientY;
          const deltaY = currentY - startY;
          if (deltaY > 0) {
            content.style.transform = `translateY(${deltaY}px)`;
          }
        }, { passive: true });
        const onEnd = () => {
          if (!dragging) return;
          dragging = false;
          const deltaY = currentY - startY;
          content.style.transition = 'transform 400ms cubic-bezier(0.32, 0.72, 0, 1)';
          if (deltaY > 80) {
            this.close();
          } else {
            content.style.transform = 'translateY(0)';
          }
        };
        dragHandle.addEventListener('touchend', onEnd);
        dragHandle.addEventListener('touchcancel', onEnd);
      }

      // Allow pressing Enter to confirm (bound once per input element)
      if (this.customInput && this.customInput.dataset.paymentInputBound !== 'true') {
        this.customInput.dataset.paymentInputBound = 'true';
        this.customInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            this.handleCustomConfirm();
          }
        });
      }
    }

    private handleClick(e: MouseEvent) {
      const target = e.target as HTMLElement;
      if (!target) return;

      if (target.closest('#payment-backdrop')) {
        this.close();
        return;
      }
      if (target.closest('#btn-partially-paid')) {
        this.showCustomView();
        return;
      }
      if (target.closest('#btn-fully-paid')) {
        this.handleFullyPaid();
        return;
      }
      if (target.closest('#btn-reset-payment')) {
        this.handleResetPayment();
        return;
      }
      if (target.closest('#btn-cancel-custom')) {
        this.resetView();
        return;
      }
      if (target.closest('#btn-confirm-custom')) {
        this.handleCustomConfirm();
        return;
      }
    }
    
    private async showCustomView() {
      if (!this.currentPatientId || !this.optionsView || !this.customView) return;

      try {
        const patient = await getPatient(this.currentPatientId);
        this.patientCost = patient.cost || 0;
      } catch (e) {
        this.patientCost = 0;
      }

      this.previousAmount = 0;

      // Update UI text
      if (this.customLabel) {
        this.customLabel.textContent = 'Introdu suma achitată:';
      }
      if (this.subtitleText) {
        this.subtitleText.textContent = 'Suma parțială';
      }

      // Swap views
      this.optionsView.classList.add('hidden');
      this.customView.classList.remove('hidden');

      // Focus input
      if (this.customInput) {
        this.customInput.value = '';
        setTimeout(() => this.customInput?.focus(), 100);
      }
    }
    
    private async handleCustomConfirm() {
      if (!this.customInput || !this.currentPatientId) return;

      const amountStr = this.customInput.value;
      if (amountStr !== null && amountStr.trim() !== '') {
        const parsed = parseInt(amountStr, 10);
        if (!isNaN(parsed) && parsed > 0) {
          try {
            await addPayment(this.currentPatientId, parsed, false);
            window.dispatchEvent(new CustomEvent('patientsUpdated'));
            window.dispatchEvent(new CustomEvent('sessionsUpdated'));
            window.dispatchEvent(new CustomEvent('paymentsUpdated', { detail: { patientId: this.currentPatientId } }));
            this.close();
          } catch (err: any) {
            (window as any).showToast('Eroare la adăugarea plății: ' + (err.message || err), 'error');
          }
        }
      }
    }
    
    private async handleFullyPaid() {
      if (!this.currentPatientId) return;
      try {
        const patient = await getPatient(this.currentPatientId);
        const cost = patient.cost || 0;
        const totalPaid = await getPatientPayments(this.currentPatientId);
        const remaining = cost - totalPaid;
        
        if (remaining > 0) {
           await addPayment(this.currentPatientId, remaining, true);
        } else {
           await setPaymentStatus(this.currentPatientId, true);
        }
        (window as any).showToast('Plata a fost marcată ca achitată integral.', 'success');
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        window.dispatchEvent(new CustomEvent('paymentsUpdated', { detail: { patientId: this.currentPatientId } }));
        this.close();
      } catch (err: any) {
        (window as any).showToast('Eroare la actualizarea plății: ' + (err.message || err), 'error');
      }
    }

    private async handleResetPayment() {
      if (!this.currentPatientId) return;
      try {
        await resetPayments(this.currentPatientId);
        (window as any).showToast('Plățile pacientului au fost resetate.', 'info');
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        window.dispatchEvent(new CustomEvent('paymentsUpdated', { detail: { patientId: this.currentPatientId } }));
        this.close();
      } catch (err: any) {
        (window as any).showToast('Eroare la resetarea plății: ' + (err.message || err), 'error');
      }
    }
    
    private resetView() {
      if (this.optionsView && this.customView) {
        this.customView.classList.add('hidden');
        this.optionsView.classList.remove('hidden');
      }
      if (this.subtitleText) {
        this.subtitleText.textContent = 'Selectează modalitatea de plată';
      }
      if (this.customInput) {
        this.customInput.value = '';
      }
    }

    private handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;
    }

    private handleTouchMove(e: TouchEvent) {
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        // Engage only on a clearly vertical, downward swipe — taps and
        // horizontal gestures pass through untouched
        if (deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.content) this.content.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.content) {
        if (e.cancelable) e.preventDefault();
        this.content.style.transform = `translateY(${deltaY}px)`;
      }
    }

    private handleTouchEnd() {
      if (!this.content || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      this.content.style.transition = 'transform 350ms cubic-bezier(0.32, 0.72, 0, 1)';
      if (deltaY > 80) {
        this.close();
      } else {
        this.content.style.transform = 'translateY(0)';
      }
    }

    private async loadPatientFinancials() {
      if (!this.currentPatientId) return;
      try {
        const patient = await getPatient(this.currentPatientId);
        let totalPaid = await getPatientPayments(this.currentPatientId);
        const cost = Number(patient.cost || 0);
        const statusPlata = (patient as any).status_plata;
        const isFullyPaid = patient.achitat === true || statusPlata === 'Achitat integral' || statusPlata === 'Achitat' || (cost > 0 && totalPaid >= cost);
        
        if (isFullyPaid && totalPaid < cost) {
          totalPaid = cost;
        }

        const remaining = isFullyPaid ? 0 : Math.max(0, cost - totalPaid);

        let displayStatusLabel = 'Neachitat';
        let statusBadgeClass = 'bg-rose-100 text-rose-800 border border-rose-200';

        if (isFullyPaid) {
          displayStatusLabel = 'Achitat integral';
          statusBadgeClass = 'bg-emerald-100 text-emerald-800 border border-emerald-200';
        } else if (totalPaid > 0) {
          displayStatusLabel = 'Achitat parțial';
          statusBadgeClass = 'bg-amber-100 text-amber-900 border border-amber-200';
        }

        const nameEl = document.getElementById('payment-patient-name');
        const totalCostEl = document.getElementById('payment-total-cost');
        const totalPaidEl = document.getElementById('payment-total-paid');
        const remainingDueEl = document.getElementById('payment-remaining-due');
        const statusBadgeEl = document.getElementById('payment-current-status-badge');
        const historyListEl = document.getElementById('payment-history-list');

        if (nameEl) nameEl.textContent = patient.name;
        if (totalCostEl) totalCostEl.textContent = `${cost} RON`;
        if (totalPaidEl) totalPaidEl.textContent = `${totalPaid} RON`;
        if (remainingDueEl) {
          remainingDueEl.textContent = `${remaining} RON`;
          remainingDueEl.className = remaining > 0 
            ? 'font-black text-rose-600' 
            : 'font-black text-emerald-600';
        }
        if (statusBadgeEl) {
          statusBadgeEl.textContent = displayStatusLabel;
          statusBadgeEl.className = `px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider ${statusBadgeClass}`;
        }

        const percent = cost > 0 ? Math.min(100, Math.round((totalPaid / cost) * 100)) : (isFullyPaid ? 100 : 0);
        const progressBar = document.getElementById('payment-progress-bar');
        if (progressBar) {
          progressBar.style.width = `${percent}%`;
          progressBar.className = isFullyPaid 
            ? 'h-full bg-emerald-500 rounded-full transition-all duration-500 ease-out'
            : (totalPaid > 0 ? 'h-full bg-amber-400 rounded-full transition-all duration-500 ease-out' : 'h-full bg-neutral-200 rounded-full transition-all duration-500 ease-out');
        }

        // Fetch & render payment transaction history
        if (historyListEl) {
          try {
            const historyItems = await getPatientPaymentHistoryDetails(this.currentPatientId);
            if (historyItems.length === 0) {
              historyListEl.innerHTML = `
                <div class="py-3 px-4 rounded-2xl bg-white/70 border border-black/5 text-center text-xs font-semibold text-neutral-400">
                  Nicio plată înregistrată încă.
                </div>
              `;
            } else {
              historyListEl.innerHTML = historyItems.map(item => {
                const dateStr = item.data_platii || 'Dată necunoscută';
                const desc = item.descriere || 'Plată ședințe';
                return `
                  <div class="flex items-center justify-between px-4 py-3 rounded-2xl bg-white border border-black/5 text-xs shadow-2xs">
                    <div>
                      <span class="block font-black text-neutral-900 text-xs">${desc}</span>
                      <span class="block font-semibold text-neutral-400 text-[11px] mt-0.5">${dateStr}</span>
                    </div>
                    <div class="text-right">
                      <span class="block font-black text-emerald-600 text-sm">+${item.suma} RON</span>
                      <span class="block text-[10px] font-extrabold uppercase tracking-wider text-neutral-400">Înregistrat</span>
                    </div>
                  </div>
                `;
              }).join('');
            }
          } catch (e) {
            historyListEl.innerHTML = `<div class="text-xs font-bold text-rose-500 text-center py-2">Eroare la citirea istoricului.</div>`;
          }
        }
      } catch (e) {
        console.error('Eroare la citirea datelor financiare ale pacientului:', e);
      }
    }

    private open() {
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.isOpen = true;
      this.loadPatientFinancials();

      this.sheet.dataset.open = 'true';
      // Trigger reflow
      void this.sheet.offsetWidth;

      // Fade the backdrop element itself (same pattern as the other sheets) —
      // fading a parent wrapper would disable the backdrop-blur mid-animation
      this.backdrop.classList.remove('opacity-0');
      this.content.classList.remove('translate-y-full');
      lockBodyScroll();
    }

    private close() {
      if (!this.sheet || !this.content || !this.backdrop || !this.isOpen) return;
      this.isOpen = false;
      unlockBodyScroll();

      // Clear any inline drag styles so the class-based transition takes over
      this.content.style.transition = '';
      this.content.style.transform = '';

      this.backdrop.classList.add('opacity-0');
      this.content.classList.add('translate-y-full');

      // Remove focus to prevent keyboard from staying open on mobile
      if (this.customInput && document.activeElement === this.customInput) {
        this.customInput.blur();
      }

      setTimeout(() => {
        if (!this.isOpen && this.sheet) {
          this.sheet.dataset.open = 'false';
          this.currentPatientId = null;
          this.resetView(); // reset to default options when closed
        }
      }, 500);
    }
  }

  function initPaymentSheet() {
    if (!document.getElementById('payment-sheet')) return;

    // Only bind the window event listener once globally; route each open event
    // to the current manager so it survives Astro view transitions.
    if (!(window as any)._paymentSheetWindowListenerBound) {
      window.addEventListener('openPaymentSheet', (e: Event) => {
        (window as any).currentPaymentSheetManager?.handleOpenEvent(e as CustomEvent);
      });
      (window as any)._paymentSheetWindowListenerBound = true;
    }

    // Recreate the manager on every page navigation so its element references
    // and listeners are always attached to the current DOM.
    (window as any).currentPaymentSheetManager = new PaymentSheetManager();
  }

  document.addEventListener('astro:page-load', initPaymentSheet);
  document.addEventListener('DOMContentLoaded', initPaymentSheet);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initPaymentSheet();
  }
</script>
