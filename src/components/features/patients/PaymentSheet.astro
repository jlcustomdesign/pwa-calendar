---
---
<div id="payment-sheet" class="fixed inset-0 z-50 pointer-events-none hidden">
  <div id="payment-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm pointer-events-auto transition-opacity duration-500 opacity-0"></div>
  <div id="payment-content" class="absolute bottom-0 left-0 right-0 bg-white rounded-t-[2.5rem] p-6 pb-safe pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
    <div class="w-12 h-1.5 bg-black/10 rounded-full mx-auto mb-8 cursor-grab active:cursor-grabbing" id="payment-drag-handle"></div>
    
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Status Plată</h2>
        <p class="text-neutral-500 font-medium mt-1" id="payment-subtitle">Selectează modalitatea de plată</p>
      </div>
    </div>

    <!-- View 1: Initial Options -->
    <div id="payment-options-view" class="space-y-4">
      <button type="button" id="btn-partially-paid" class="w-full py-4 px-6 rounded-2xl bg-amber-100 text-amber-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Plată Parțială</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>

      <button type="button" id="btn-fully-paid" class="w-full py-4 px-6 rounded-2xl bg-emerald-100 text-emerald-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Achitat Integral</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>

      <button type="button" id="btn-reset-payment" class="w-full py-4 px-6 rounded-2xl bg-rose-100 text-rose-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Resetează Plata (Neachitat)</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </button>
    </div>

    <!-- View 2: Custom Amount Form -->
    <div id="custom-amount-view" class="space-y-4 hidden">
      <div class="relative">
        <label for="custom-amount-input" class="block text-sm font-semibold text-neutral-700 mb-2" id="custom-amount-label">Introdu suma nouă (RON)</label>
        <div class="relative flex items-center">
          <span class="absolute left-4 text-neutral-500 font-bold text-lg">RON</span>
          <input 
            type="number" 
            id="custom-amount-input" 
            class="w-full bg-neutral-100 border-none rounded-2xl py-4 pl-14 pr-4 text-lg font-bold text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-black transition-all"
            placeholder="0"
          >
        </div>
      </div>
      
      <div class="flex gap-3 pt-2">
        <button type="button" id="btn-cancel-custom" class="flex-1 py-4 px-6 rounded-2xl bg-neutral-100 text-neutral-700 font-bold text-lg active:scale-95 transition-transform">
          Înapoi
        </button>
        <button type="button" id="btn-confirm-custom" class="flex-[2] py-4 px-6 rounded-2xl bg-black text-white font-bold text-lg active:scale-95 transition-transform flex items-center justify-center gap-2 shadow-lg shadow-black/20">
          <span>Confirmă Plata</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { getPatient, setPaymentStatus, addPayment, getPatientPayments, resetPayments } from '../../../lib/services/patientService';

  class PaymentSheetManager {
    private sheet: HTMLElement | null;
    private backdrop: HTMLElement | null;
    private content: HTMLElement | null;
    
    private optionsView: HTMLElement | null;
    private customView: HTMLElement | null;
    private customInput: HTMLInputElement | null;
    private customLabel: HTMLElement | null;
    private subtitleText: HTMLElement | null;
    
    private currentPatientId: string | null = null;
    private previousAmount: number = 0;
    private patientCost: number = 0;
    private isOpen = false;
    private startY = 0;
    private currentY = 0;
    private startX = 0;
    private dragEngaged = false;

    constructor() {
      this.sheet = document.getElementById('payment-sheet');
      this.backdrop = document.getElementById('payment-backdrop');
      this.content = document.getElementById('payment-content');
      
      this.optionsView = document.getElementById('payment-options-view');
      this.customView = document.getElementById('custom-amount-view');
      this.customInput = document.getElementById('custom-amount-input') as HTMLInputElement;
      this.customLabel = document.getElementById('custom-amount-label');
      this.subtitleText = document.getElementById('payment-subtitle');
      
      this.bindEvents();
    }

    private bindEvents() {
      // Open sheet event
      window.addEventListener('openPaymentSheet', ((e: CustomEvent) => {
        this.currentPatientId = e.detail.patientId;
        this.resetView();
        this.open();
      }) as EventListener);

      // Close handlers
      this.backdrop?.addEventListener('click', () => this.close());

      // Swipe-down to dismiss — works from anywhere on the sheet,
      // as long as the gesture is a clearly vertical downward swipe
      this.content?.addEventListener('touchstart', (e: any) => this.handleTouchStart(e), { passive: true });
      this.content?.addEventListener('touchmove', (e: any) => this.handleTouchMove(e), { passive: false });
      this.content?.addEventListener('touchend', () => this.handleTouchEnd());

      // Initial Options Action handlers
      document.getElementById('btn-partially-paid')?.addEventListener('click', () => {
        this.showCustomView();
      });
      document.getElementById('btn-fully-paid')?.addEventListener('click', () => this.handleFullyPaid());
      document.getElementById('btn-reset-payment')?.addEventListener('click', () => this.handleResetPayment());

      // Custom Form Handlers
      document.getElementById('btn-cancel-custom')?.addEventListener('click', () => {
        this.resetView();
      });
      document.getElementById('btn-confirm-custom')?.addEventListener('click', () => {
        this.handleCustomConfirm();
      });
      
      // Allow pressing Enter to confirm
      this.customInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          this.handleCustomConfirm();
        }
      });
    }
    
    private async showCustomView() {
      if (!this.currentPatientId || !this.optionsView || !this.customView) return;

      try {
        const patient = await getPatient(this.currentPatientId);
        this.patientCost = patient.cost || 0;
      } catch (e) {
        this.patientCost = 0;
      }

      this.previousAmount = 0;

      // Update UI text
      if (this.customLabel) {
        this.customLabel.textContent = 'Introdu suma achitată:';
      }
      if (this.subtitleText) {
        this.subtitleText.textContent = 'Suma parțială';
      }

      // Swap views
      this.optionsView.classList.add('hidden');
      this.customView.classList.remove('hidden');

      // Focus input
      if (this.customInput) {
        this.customInput.value = '';
        setTimeout(() => this.customInput?.focus(), 100);
      }
    }
    
    private async handleCustomConfirm() {
      if (!this.customInput || !this.currentPatientId) return;

      const amountStr = this.customInput.value;
      if (amountStr !== null && amountStr.trim() !== '') {
        const parsed = parseInt(amountStr, 10);
        if (!isNaN(parsed) && parsed > 0) {
          try {
            await addPayment(this.currentPatientId, parsed, false);
            window.dispatchEvent(new CustomEvent('patientsUpdated'));
            this.close();
          } catch (err: any) {
            alert('Eroare la adăugarea plății: ' + (err.message || err));
          }
        }
      }
    }
    
    private async handleFullyPaid() {
      if (!this.currentPatientId) return;
      try {
        const patient = await getPatient(this.currentPatientId);
        const cost = patient.cost || 0;
        const totalPaid = await getPatientPayments(this.currentPatientId);
        const remaining = cost - totalPaid;
        
        if (remaining > 0) {
           await addPayment(this.currentPatientId, remaining, true);
        } else {
           await setPaymentStatus(this.currentPatientId, true);
        }
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        this.close();
      } catch (err: any) {
        alert('Eroare la actualizarea plății: ' + (err.message || err));
      }
    }

    private async handleResetPayment() {
      if (!this.currentPatientId) return;
      try {
        await resetPayments(this.currentPatientId);
        window.dispatchEvent(new CustomEvent('patientsUpdated'));
        this.close();
      } catch (err: any) {
        alert('Eroare la resetarea plății: ' + (err.message || err));
      }
    }
    
    private resetView() {
      if (this.optionsView && this.customView) {
        this.customView.classList.add('hidden');
        this.optionsView.classList.remove('hidden');
      }
      if (this.subtitleText) {
        this.subtitleText.textContent = 'Selectează modalitatea de plată';
      }
      if (this.customInput) {
        this.customInput.value = '';
      }
    }

    private handleTouchStart(e: TouchEvent) {
      this.startY = e.touches[0].clientY;
      this.currentY = this.startY;
      this.startX = e.touches[0].clientX;
      this.dragEngaged = false;
    }

    private handleTouchMove(e: TouchEvent) {
      const y = e.touches[0].clientY;
      const deltaY = y - this.startY;
      const deltaX = e.touches[0].clientX - this.startX;

      if (!this.dragEngaged) {
        // Engage only on a clearly vertical, downward swipe — taps and
        // horizontal gestures pass through untouched
        if (deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
          this.dragEngaged = true;
          if (this.content) this.content.style.transition = 'none';
        } else {
          return;
        }
      }

      this.currentY = y;
      if (deltaY > 0 && this.content) {
        if (e.cancelable) e.preventDefault();
        this.content.style.transform = `translateY(${deltaY}px)`;
      }
    }

    private handleTouchEnd() {
      if (!this.content || !this.dragEngaged) {
        this.dragEngaged = false;
        return;
      }
      this.dragEngaged = false;
      const deltaY = this.currentY - this.startY;
      this.content.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
      if (deltaY > 150) {
        this.close();
      } else {
        this.content.style.transform = 'translateY(0)';
      }
    }

    private open() {
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.isOpen = true;
      
      this.sheet.classList.remove('hidden');
      // Trigger reflow
      void this.sheet.offsetWidth;
      
      // Fade the backdrop element itself (same pattern as the other sheets) —
      // fading a parent wrapper would disable the backdrop-blur mid-animation
      this.backdrop.classList.remove('opacity-0');
      this.content.classList.remove('translate-y-full');
    }

    private close() {
      if (!this.sheet || !this.content || !this.backdrop || !this.isOpen) return;
      this.isOpen = false;
      
      // Clear any inline drag styles so the class-based transition takes over
      this.content.style.transition = '';
      this.content.style.transform = '';
      
      this.backdrop.classList.add('opacity-0');
      this.content.classList.add('translate-y-full');
      
      // Remove focus to prevent keyboard from staying open on mobile
      if (this.customInput && document.activeElement === this.customInput) {
        this.customInput.blur();
      }
      
      setTimeout(() => {
        if (!this.isOpen && this.sheet) {
          this.sheet.classList.add('hidden');
          this.currentPatientId = null;
          this.resetView(); // reset to default options when closed
        }
      }, 500);
    }
  }

  let globalPaymentSheetManager: PaymentSheetManager | null = null;
  
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('payment-sheet')) return;
    
    if (!globalPaymentSheetManager) {
      globalPaymentSheetManager = new PaymentSheetManager();
    } else {
      // Re-bind DOM elements if they changed
      globalPaymentSheetManager['sheet'] = document.getElementById('payment-sheet');
      globalPaymentSheetManager['backdrop'] = document.getElementById('payment-backdrop');
      globalPaymentSheetManager['content'] = document.getElementById('payment-content');
      globalPaymentSheetManager['optionsView'] = document.getElementById('payment-options-view');
      globalPaymentSheetManager['customView'] = document.getElementById('custom-amount-view');
      globalPaymentSheetManager['customInput'] = document.getElementById('custom-amount-input') as HTMLInputElement;
      globalPaymentSheetManager['customLabel'] = document.getElementById('custom-amount-label');
      globalPaymentSheetManager['subtitleText'] = document.getElementById('payment-subtitle');
      globalPaymentSheetManager['bindEvents']();
    }
  });
</script>
