---
---
<div id="payment-sheet" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 hidden">
  <div id="payment-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm pointer-events-auto transition-opacity duration-300"></div>
  <div id="payment-content" class="absolute bottom-0 left-0 right-0 bg-white rounded-t-[2.5rem] p-6 pb-safe pointer-events-auto transform translate-y-full transition-transform duration-400 ease-[cubic-bezier(0.32,0.72,0,1)]">
    <div class="w-12 h-1.5 bg-black/10 rounded-full mx-auto mb-8"></div>
    
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Payment Status</h2>
        <p class="text-neutral-500 font-medium mt-1">Select payment completion</p>
      </div>
      <button type="button" class="w-10 h-10 flex items-center justify-center rounded-full bg-black/5 hover:bg-black/10 active:scale-95 transition-all text-neutral-500" id="close-payment">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <div class="space-y-4">
      <button type="button" id="btn-partially-paid" class="w-full py-4 px-6 rounded-2xl bg-amber-100 text-amber-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Custom Pay</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>

      <button type="button" id="btn-fully-paid" class="w-full py-4 px-6 rounded-2xl bg-emerald-100 text-emerald-900 font-bold text-lg active:scale-95 transition-transform flex items-center justify-between">
        <span>Fully Paid (Plan)</span>
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  class PaymentSheetManager {
    private sheet: HTMLElement | null;
    private backdrop: HTMLElement | null;
    private content: HTMLElement | null;
    private currentPatientId: string | null = null;
    private isOpen = false;

    constructor() {
      this.sheet = document.getElementById('payment-sheet');
      this.backdrop = document.getElementById('payment-backdrop');
      this.content = document.getElementById('payment-content');
      
      this.bindEvents();
    }

    private bindEvents() {
      // Open sheet event
      window.addEventListener('openPaymentSheet', ((e: CustomEvent) => {
        this.currentPatientId = e.detail.patientId;
        this.open();
      }) as EventListener);

      // Close handlers
      document.getElementById('close-payment')?.addEventListener('click', () => this.close());
      this.backdrop?.addEventListener('click', () => this.close());

      // Action handlers
      document.getElementById('btn-partially-paid')?.addEventListener('click', () => {
        if (!this.currentPatientId) return;
        const patients = JSON.parse(localStorage.getItem('kineto_patients') || '[]');
        const patient = patients.find((p: any) => p.id === this.currentPatientId);
        
        let previousAmount = 0;
        if (patient && patient.paymentStatus && patient.paymentStatus.startsWith('Paid: ')) {
          const match = patient.paymentStatus.match(/\d+/);
          if (match) {
            previousAmount = parseInt(match[0], 10);
          }
        }
        
        const amountStr = window.prompt(previousAmount > 0 ? `Already paid: ${previousAmount}. Enter new amount to add:` : 'Enter amount paid:');
        if (amountStr !== null && amountStr.trim() !== '') {
          const parsed = parseInt(amountStr, 10);
          if (!isNaN(parsed)) {
            const newTotal = previousAmount + parsed;
            const patientCost = patient.cost ? Number(patient.cost) : 0;
            if (patientCost > 0 && newTotal >= patientCost) {
              this.updateStatus('Paid fully');
            } else {
              this.updateStatus(`Paid: ${newTotal}`);
            }
          }
        }
      });
      document.getElementById('btn-fully-paid')?.addEventListener('click', () => this.updateStatus('Paid fully'));
    }

    private updateStatus(status: string) {
      if (!this.currentPatientId) return;

      const patients = JSON.parse(localStorage.getItem('kineto_patients') || '[]');
      const updatedPatients = patients.map((p: any) => {
        if (p.id === this.currentPatientId) {
          return { ...p, paymentStatus: status };
        }
        return p;
      });

      localStorage.setItem('kineto_patients', JSON.stringify(updatedPatients));
      
      // Dispatch event to refresh views
      window.dispatchEvent(new CustomEvent('patientsUpdated'));
      
      this.close();
    }

    private open() {
      if (!this.sheet || !this.content || !this.backdrop) return;
      this.isOpen = true;
      
      this.sheet.classList.remove('hidden');
      // Trigger reflow
      void this.sheet.offsetWidth;
      
      this.sheet.classList.remove('opacity-0');
      this.content.classList.remove('translate-y-full');
    }

    private close() {
      if (!this.sheet || !this.content || !this.backdrop || !this.isOpen) return;
      this.isOpen = false;
      
      this.sheet.classList.add('opacity-0');
      this.content.classList.add('translate-y-full');
      
      setTimeout(() => {
        if (!this.isOpen && this.sheet) {
          this.sheet.classList.add('hidden');
          this.currentPatientId = null;
        }
      }, 400);
    }
  }

  document.addEventListener('astro:page-load', () => {
    new PaymentSheetManager();
  });
</script>
