---
// ReportsView.astro — Statistici Utile & Pragmatice
---

<div class="space-y-7">

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 1. STATISTICI ZILNICE                                    -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-3 relative">
    <div class="flex items-center justify-start px-1">
      <button type="button" id="today-date-display" class="text-xl sm:text-2xl font-black text-text-main px-4 py-1.5 rounded-2xl bg-surface-card shadow-sm border border-border-subtle/70 min-w-[10rem] text-center active:scale-95 transition-transform">
        --
      </button>
    </div>

    <div class="grid grid-cols-3 gap-3">
      <!-- Card 1: Ședințe -->
      <div class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div class="flex items-baseline gap-1">
          <span id="today-done" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</span>
          <span class="text-xl font-bold text-text-muted opacity-40">/</span>
          <span id="today-total" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</span>
        </div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Ședințe</div>
      </div>

      <!-- Card 2: Absent -->
      <div class="bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div id="today-absent" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Absent</div>
      </div>

      <!-- Card 3: Încasat azi -->
      <div class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div id="today-income" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">RON</div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 2. PLĂȚI RESTANTE (GLOBAL)                              -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-3">
    <div class="flex items-baseline justify-between px-1">
      <h2 class="text-xl sm:text-2xl font-black text-text-main">Restanțe Globale</h2>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <a
        href="/dashboard/patients"
        class="block bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40 group active:scale-[0.98]"
      >
        <div id="unpaid-count" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Neachitați</div>
      </a>
      <a
        href="/dashboard/patients"
        class="block bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40 group active:scale-[0.98]"
      >
        <div id="unpaid-total" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">RON neachitați</div>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 3. RAPOARTE COMPARATIVE (Tabs)                          -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-4">
    <!-- Tabs -->
    <div class="relative flex items-center space-x-2 bg-surface-card p-1.5 rounded-xl shadow-sm border border-border-subtle/70" id="reports-tabs-container">
      <div id="tabs-active-pill" class="absolute top-1/2 rounded-lg bg-text-main pointer-events-none z-0" style="left: 0; width: 0; height: calc(100% - 12px); opacity: 0; transform: translateY(-50%); transition: transform 450ms cubic-bezier(0.34, 1.36, 0.64, 1), width 450ms cubic-bezier(0.34, 1.36, 0.64, 1), opacity 300ms ease;"></div>
      <button class="tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-inverse" data-tab="week">Săpt</button>
      <button class="tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="month">Lun</button>
      <button class="tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="quarter">Trim</button>
      <button class="tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="year">An</button>
    </div>

    <!-- Antet perioadă + navigare -->
    <div class="flex items-center justify-between px-1">
      <div class="flex flex-col">
        <h2 id="report-title" class="text-xl sm:text-2xl font-black text-text-main">Săptămânal</h2>
        <span id="report-date-range" class="text-sm font-bold text-text-muted">--</span>
      </div>
      <div class="flex gap-2">
        <button type="button" id="prev-report-btn" class="p-2 rounded-full bg-surface-card shadow-sm border border-border-subtle/70 active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button type="button" id="next-report-btn" class="p-2 rounded-full bg-surface-card shadow-sm border border-border-subtle/70 active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <!-- Conținut Săptămânal -->
    <div id="tab-week-content" class="space-y-3">
      <!-- Card Grafic Hașurat -->
      <div class="bg-surface-card rounded-[2.2rem] p-5 shadow-sm border border-border-subtle/70 space-y-4 relative overflow-hidden">
        <div class="flex items-start justify-between">
          <div>
            <div id="chart-subtitle" class="text-xs font-extrabold uppercase tracking-wider text-text-muted">Evoluție săptămânală</div>
            <div id="chart-active-value" class="text-2xl sm:text-3xl font-black text-text-main mt-0.5 transition-all">
              0 <span class="text-sm font-sans font-black text-text-main">RON</span>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xs font-extrabold uppercase tracking-wider text-text-muted">Total perioadă</div>
            <div id="chart-period-total" class="text-lg sm:text-xl font-black text-text-main mt-0.5">0 <span class="text-xs font-sans font-black text-text-main">RON</span></div>
            <div id="chart-period-comparison" class="text-xs font-black mt-0.5 text-text-muted">--</div>
          </div>
        </div>

        <div class="relative w-full h-36" id="chart-container">
          <svg viewBox="0 0 350 120" class="w-full h-full overflow-visible" preserveAspectRatio="none" id="reports-svg">
            <defs>
              <pattern id="hatch-pattern" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="8" stroke="rgb(var(--color-text-main))" stroke-width="1.5" opacity="0.25" />
              </pattern>

              <linearGradient id="soft-bg-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgb(var(--color-brand-primary))" stop-opacity="0.2" />
                <stop offset="100%" stop-color="rgb(var(--color-surface-card))" stop-opacity="0.0" />
              </linearGradient>

              <clipPath id="hatch-clip">
                <rect id="hatch-clip-rect" x="0" y="0" width="350" height="120" style="transition: width 300ms ease;" />
              </clipPath>
            </defs>

            <path id="chart-path-gradient" fill="url(#soft-bg-gradient)" d="" />
            <path id="chart-path-hatch" fill="url(#hatch-pattern)" d="" />
            <path id="chart-path-stroke" fill="none" stroke="rgb(var(--color-text-main))" stroke-width="3" stroke-linecap="round" d="" />
          </svg>
          
          <div id="pink-dot-glow" class="absolute bg-brand-secondary rounded-full opacity-30 transition-all duration-300 transform -translate-x-1/2 -translate-y-1/2 pointer-events-none hidden" style="width: 20px; height: 20px; z-index: 20;"></div>
          <div id="pink-dot" class="absolute bg-brand-secondary rounded-full border-[2.5px] border-white shadow-md transition-all duration-300 transform -translate-x-1/2 -translate-y-1/2 pointer-events-none hidden" style="width: 14px; height: 14px; z-index: 21;"></div>
        </div>

        <div class="flex items-center justify-between px-2 text-xl sm:text-2xl font-black text-text-main" id="chart-x-labels">
          <!-- Dynamic labels generated in JS -->
        </div>
      </div>

      <!-- Card Timp Activ -->
      <div class="bg-surface-card rounded-[2.2rem] p-5 shadow-sm border border-border-subtle/70 space-y-3">
        <div class="w-full h-3.5 bg-surface-base rounded-full overflow-hidden flex items-center p-0.5 border border-border-subtle/40">
          <div id="week-progress-bar" class="h-full bg-brand-primary rounded-full transition-all duration-1000" style="width: 100%"></div>
          <div id="week-cancel-bar" class="h-full bg-brand-secondary/80 rounded-full transition-all duration-1000 ml-0.5" style="width: 0%"></div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-text-main">
            <span id="week-active-time">100%</span> <span class="text-base sm:text-lg font-black text-text-main">timp activ</span>
          </div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-text-main">
            <span id="week-cancel-time">0%</span> <span class="text-base sm:text-lg font-black text-text-main">anulări</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Conținut Generic (Lunar/Trimestrial/Anual) - Eliminat deoarece folosim graficul pentru toate! -->
  </section>

</div>

<!-- Custom Date Picker Popup (floating, smaller, no native calendar UI) -->
<div id="day-picker-sheet" class="fixed inset-0 z-[100] pointer-events-none hidden">
  <div id="day-picker-overlay" class="absolute inset-0 bg-black/20 opacity-0 pointer-events-none transition-opacity duration-200"></div>
  <div id="day-picker-content" class="fixed w-[19rem] bg-surface-card rounded-[1.75rem] p-4 shadow-2xl pointer-events-auto transform scale-95 opacity-0 transition-all duration-200 ease-out origin-top-left border border-border-subtle/70">
    <div class="flex items-center justify-between mb-3">
      <button type="button" id="day-picker-prev-month" class="p-1.5 rounded-full bg-surface-base active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <div id="day-picker-month-year" class="text-sm font-black text-text-main">--</div>
      <button type="button" id="day-picker-next-month" class="p-1.5 rounded-full bg-surface-base active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
    <div class="grid grid-cols-7 gap-1 text-center mb-2">
      <span class="text-[10px] font-bold text-text-muted">L</span>
      <span class="text-[10px] font-bold text-text-muted">M</span>
      <span class="text-[10px] font-bold text-text-muted">M</span>
      <span class="text-[10px] font-bold text-text-muted">J</span>
      <span class="text-[10px] font-bold text-text-muted">V</span>
      <span class="text-[10px] font-bold text-text-muted">S</span>
      <span class="text-[10px] font-bold text-text-muted">D</span>
    </div>
    <div id="day-picker-grid" class="grid grid-cols-7 gap-1">
      <!-- Generated by JS -->
    </div>
  </div>
</div>

<script>
  import { getTodayStats, getWeekStats, getMonthStats, getQuarterStats, getYearStats, getUnpaidPatients } from '../../../lib/services/reportsService';
  import { toLocalISOString, formatDateRO } from '../../../utils/date';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  type TabType = 'week' | 'month' | 'quarter' | 'year';
  let activeTab: TabType = 'week';
  
  let currentBaseDate = new Date();
  let currentDayDate = new Date();
  
  async function loadTodayStats() {
    try {
      const dateStr = toLocalISOString(currentDayDate);
      const today = await getTodayStats(dateStr);
      const todayDateDisplay = document.getElementById('today-date-display');
      if (todayDateDisplay) {
        const d = currentDayDate;
        const dayNameCap = d.toLocaleDateString('ro-RO', { weekday: 'long' }).charAt(0).toUpperCase() + d.toLocaleDateString('ro-RO', { weekday: 'long' }).slice(1);
        const dayNum = d.getDate().toString().padStart(2, '0');
        const monthNameCap = d.toLocaleDateString('ro-RO', { month: 'long' }).charAt(0).toUpperCase() + d.toLocaleDateString('ro-RO', { month: 'long' }).slice(1);
        todayDateDisplay.textContent = `${dayNameCap}, ${dayNum} ${monthNameCap}`;
      }

      document.getElementById('today-done')!.textContent = today.finalizate.toString();
      document.getElementById('today-total')!.textContent = today.sedinte_total.toString();
      document.getElementById('today-absent')!.textContent = today.absente.toString();
      document.getElementById('today-income')!.textContent = today.venit_azi.toString();

      const unpaid = await getUnpaidPatients();
      document.getElementById('unpaid-count')!.textContent = unpaid.count.toString();
      document.getElementById('unpaid-total')!.textContent = unpaid.totalRON.toString();
    } catch(e) {
      console.error('Error loading today stats:', e);
    }
  }

  function setupDayNavigation() {
    const displayBtn = document.getElementById('today-date-display');
    displayBtn?.addEventListener('click', () => openDayPicker());
  }

  // ── Custom day picker sheet (no native date UI) ───────────────
  let pickerViewDate = new Date();

  function openDayPicker() {
    pickerViewDate = new Date(currentDayDate.getFullYear(), currentDayDate.getMonth(), currentDayDate.getDate());
    renderDayPicker();

    const sheet = document.getElementById('day-picker-sheet');
    const overlay = document.getElementById('day-picker-overlay');
    const content = document.getElementById('day-picker-content');
    const trigger = document.getElementById('today-date-display');
    if (!sheet || !overlay || !content) return;

    const rect = trigger?.getBoundingClientRect();
    if (rect) {
      content.style.left = `${rect.left}px`;
      content.style.top = `${rect.bottom + 8}px`;
    }

    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');

    sheet.classList.remove('hidden');
    sheet.classList.add('pointer-events-auto');
    void sheet.offsetWidth;
    lockBodyScroll();
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('pointer-events-auto');

    content.classList.remove('scale-95', 'opacity-0');
    content.classList.add('scale-100', 'opacity-100');
  }

  function closeDayPicker() {
    const sheet = document.getElementById('day-picker-sheet');
    const overlay = document.getElementById('day-picker-overlay');
    const content = document.getElementById('day-picker-content');
    if (!sheet || !overlay || !content) return;

    unlockBodyScroll();
    overlay.classList.add('opacity-0', 'pointer-events-none');
    overlay.classList.remove('pointer-events-auto');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      sheet.classList.add('hidden');
      sheet.classList.remove('pointer-events-auto');
    }, 200);
  }

  function renderDayPicker() {
    const grid = document.getElementById('day-picker-grid');
    const label = document.getElementById('day-picker-month-year');
    if (!grid || !label) return;

    const year = pickerViewDate.getFullYear();
    const month = pickerViewDate.getMonth();
    label.textContent = pickerViewDate.toLocaleDateString('ro-RO', { month: 'long', year: 'numeric' })
      .replace(/\b\w/g, c => c.toUpperCase());

    grid.innerHTML = '';

    const firstDay = new Date(year, month, 1);
    const startOffset = (firstDay.getDay() + 6) % 7; // Monday = 0
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    for (let i = 0; i < startOffset; i++) {
      const empty = document.createElement('div');
      grid.appendChild(empty);
    }

    for (let d = 1; d <= daysInMonth; d++) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = d.toString();

      const isSelected =
        currentDayDate.getDate() === d &&
        currentDayDate.getMonth() === month &&
        currentDayDate.getFullYear() === year;

      const baseClass = 'aspect-square rounded-full text-sm font-black transition-all active:scale-95';
      if (isSelected) {
        btn.className = `${baseClass} bg-brand-secondary text-white`;
      } else {
        btn.className = `${baseClass} text-text-main hover:bg-surface-base`;
      }

      btn.addEventListener('click', () => {
        currentDayDate = new Date(year, month, d);
        loadTodayStats();
        closeDayPicker();
      });

      grid.appendChild(btn);
    }
  }

  function setupDayPicker() {
    const overlay = document.getElementById('day-picker-overlay');
    const content = document.getElementById('day-picker-content');

    overlay?.addEventListener('click', closeDayPicker);
    document.getElementById('day-picker-prev-month')?.addEventListener('click', () => {
      pickerViewDate.setMonth(pickerViewDate.getMonth() - 1);
      renderDayPicker();
    });
    document.getElementById('day-picker-next-month')?.addEventListener('click', () => {
      pickerViewDate.setMonth(pickerViewDate.getMonth() + 1);
      renderDayPicker();
    });

    // Swipe-down to close
    if (content) {
      let startY = 0;
      content.addEventListener('touchstart', (e: any) => {
        startY = e.touches[0].clientY;
      }, { passive: true });
      content.addEventListener('touchmove', (e: any) => {
        const deltaY = e.touches[0].clientY - startY;
        if (deltaY > 0) {
          content.style.transition = 'none';
          content.style.transform = `translateY(${deltaY}px) scale(1)`;
        }
      }, { passive: true });
      content.addEventListener('touchend', (e: any) => {
        const deltaY = (e.changedTouches[0].clientY || 0) - startY;
        content.style.transition = 'transform 200ms ease-out, opacity 200ms ease-out';
        if (deltaY > 60) {
          closeDayPicker();
        } else {
          content.style.transform = 'translateY(0) scale(1)';
        }
      });
    }
  }

  async function loadReportStats() {
    try {
      const dateStr = toLocalISOString(currentBaseDate);
      const titleEl = document.getElementById('report-title');
      const subtitleEl = document.getElementById('chart-subtitle');
      const dateRangeEl = document.getElementById('report-date-range');
      const tabWeekContent = document.getElementById('tab-week-content');

      let statData: any;

      if (activeTab === 'week') {
        if (titleEl) titleEl.textContent = 'Săptămânal';
        if (subtitleEl) subtitleEl.textContent = 'Evoluție săptămânală';
        statData = await getWeekStats(dateStr);
        if (dateRangeEl) dateRangeEl.textContent = `${formatDateRO(new Date(statData.startStr))} - ${formatDateRO(new Date(statData.endStr))}`;
      } else if (activeTab === 'month') {
        if (titleEl) titleEl.textContent = 'Lunar';
        if (subtitleEl) subtitleEl.textContent = 'Evoluție lunară';
        statData = await getMonthStats(dateStr);
        const monthName = currentBaseDate.toLocaleDateString('ro-RO', { month: 'long' });
        if (dateRangeEl) dateRangeEl.textContent = `${monthName.charAt(0).toUpperCase() + monthName.slice(1)} ${currentBaseDate.getFullYear()}`;
      } else if (activeTab === 'quarter') {
        if (titleEl) titleEl.textContent = 'Trimestrial';
        if (subtitleEl) subtitleEl.textContent = 'Evoluție trimestrială';
        statData = await getQuarterStats(dateStr);
        if (dateRangeEl) dateRangeEl.textContent = `${formatDateRO(new Date(statData.startStr), true)} - ${formatDateRO(new Date(statData.endStr), true)}`;
      } else if (activeTab === 'year') {
        if (titleEl) titleEl.textContent = 'Anual';
        if (subtitleEl) subtitleEl.textContent = 'Evoluție anuală';
        statData = await getYearStats(dateStr);
        if (dateRangeEl) dateRangeEl.textContent = `${currentBaseDate.getFullYear()}`;
      }

      if (statData) {
        // Update stats generic to the week template
        const totalPast = statData.finalizate + statData.absente;
        const prezenta = totalPast > 0 ? Math.round((statData.finalizate / totalPast) * 100) : 0;
        const anulari = totalPast > 0 ? Math.round((statData.absente / totalPast) * 100) : 0;

        document.getElementById('week-active-time')!.textContent = `${prezenta}%`;
        document.getElementById('week-cancel-time')!.textContent = `${anulari}%`;
        document.getElementById('week-progress-bar')!.style.width = `${prezenta}%`;
        document.getElementById('week-cancel-bar')!.style.width = `${anulari}%`;

        // Period comparison summary
        const periodTotalEl = document.getElementById('chart-period-total');
        const periodComparisonEl = document.getElementById('chart-period-comparison');
        if (periodTotalEl && periodComparisonEl) {
          const total = statData.venit || 0;
          const avg = statData.chartData.length > 0 ? total / statData.chartData.length : 0;
          periodTotalEl.innerHTML = `${Math.round(total)} <span class="text-xs font-sans font-black text-text-main">RON</span>`;
          periodComparisonEl.textContent = `medie ${Math.round(avg)} RON`;
        }

        // Load chart
        initInteractiveHatchChart(statData.chartData, statData.startStr, activeTab);
      }
    } catch (e) {
      console.error('Error loading report stats:', e);
    }
  }

  function initInteractiveHatchChart(chartData: { label: string, val: number, dateStr?: string }[], startStr: string, periodType: TabType) {
    const container = document.getElementById('chart-x-labels');
    if (!container) return;
    
    // Create label buttons dynamically
    container.innerHTML = '';
    chartData.forEach((item, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const textSize = chartData.length <= 7 ? 'text-xl sm:text-2xl' : 'text-sm sm:text-base';
      btn.className = `day-btn hover:text-brand-secondary transition-colors cursor-pointer py-1 px-2 text-text-muted ${textSize} font-black`;
      btn.textContent = item.label;
      btn.dataset.idx = idx.toString();
      container.appendChild(btn);
    });

    const svg = document.getElementById('reports-svg');
    const dayBtns = document.querySelectorAll('.day-btn');
    const dot = document.getElementById('pink-dot');
    const dotGlow = document.getElementById('pink-dot-glow');
    const valueDisplay = document.getElementById('chart-active-value');
    const pathGradient = document.getElementById('chart-path-gradient');
    const pathHatch = document.getElementById('chart-path-hatch');
    const pathStroke = document.getElementById('chart-path-stroke');
    
    if (!svg || !dot || !dotGlow || !valueDisplay || dayBtns.length === 0) return;

    const clipPathDef = svg.querySelector('clipPath');
    let hatchClipRectNew = svg.querySelector('rect');
    
    // Fix SVG Clip Path ID issue across navigations and tab switches
    if (clipPathDef && hatchClipRectNew) {
      if (clipPathDef.id === 'hatch-clip') {
        const uniqueSuffix = Math.random().toString(36).substr(2, 9);
        clipPathDef.id = `hatch-clip-${uniqueSuffix}`;
      }
      
      const activeClipId = clipPathDef.id;
      if (pathGradient) pathGradient.setAttribute('clip-path', `url(#${activeClipId})`);
      if (pathHatch) pathHatch.setAttribute('clip-path', `url(#${activeClipId})`);
      if (pathStroke) pathStroke.setAttribute('clip-path', `url(#${activeClipId})`);
    }

    const chartVals = chartData.map(d => d.val);
    const maxVal = Math.max(...chartVals, 100);
    const minY = 115;
    const maxY = 15;
    const pointsCount = chartVals.length;
    const step = pointsCount > 1 ? (320 / (pointsCount - 1)) : 320;
    const xCoords = Array.from({length: pointsCount}, (_, i) => 15 + i * step);

    const points = chartVals.map((val, i) => {
      const y = minY - (val / maxVal) * (minY - maxY);
      return { x: xCoords[i], y, val };
    });

    let activeBtnIdx = chartData.length - 1; // Default to last point if nothing else matches
    const todayStr = toLocalISOString(new Date());
    
    // Find the closest point that is today or past
    for (let i = chartData.length - 1; i >= 0; i--) {
      const item = chartData[i];
      if (item && item.dateStr && item.dateStr <= todayStr) {
        activeBtnIdx = i;
        break;
      }
    }

    const activePoints = points.slice(0, activeBtnIdx + 1);

    if (activePoints.length === 0) {
      // Nothing to draw
    } else if (activePoints.length === 1) {
      // Draw a horizontal flat line from left edge to the point
      const p = activePoints[0];
      const strokePath = `M 0,${p.y} L ${p.x},${p.y}`;
      const fillPath = `M 0,115 L 0,${p.y} L ${p.x},${p.y} L ${p.x},115 Z`;
      
      if (pathStroke) pathStroke.setAttribute('d', strokePath);
      if (pathGradient) pathGradient.setAttribute('d', fillPath);
      if (pathHatch) pathHatch.setAttribute('d', fillPath);
    } else {
      let strokePath = `M ${activePoints[0].x},${activePoints[0].y}`;
      for(let i=0; i<activePoints.length - 1; i++) {
        const p1 = activePoints[i];
        const p2 = activePoints[i+1];
        const cx1 = p1.x + (p2.x - p1.x) / 2;
        const cy1 = p1.y;
        const cx2 = p1.x + (p2.x - p1.x) / 2;
        const cy2 = p2.y;
        strokePath += ` C ${cx1},${cy1} ${cx2},${cy2} ${p2.x},${p2.y}`;
      }
      const fillPath = strokePath + ` L ${activePoints[activePoints.length - 1].x},115 L ${activePoints[0].x},115 Z`;
      
      if (pathStroke) pathStroke.setAttribute('d', strokePath);
      if (pathGradient) pathGradient.setAttribute('d', fillPath);
      if (pathHatch) pathHatch.setAttribute('d', fillPath);
    }

    // We will clip the chart dynamically based on the clicked point
    // The initial clipping is handled by the click event triggered at the end of this function


    const dayCoords = points.map(p => ({
      cx: p.x,
      cy: p.y,
      left: `${(p.x / 350) * 100}%`,
      top: `${(p.y / 120) * 100}%`,
      val: `${p.val} <span class="text-sm font-sans font-black text-text-main">RON</span>`,
      valNumber: p.val
    }));

    dayBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const item = chartData[idx];
        const todayStr = toLocalISOString(new Date());
        if (item?.dateStr && item.dateStr > todayStr) {
          // Do not move indicator into the future
          return;
        }

        const coord = dayCoords[idx];
        if (coord) {
          dot.style.left = coord.left;
          dot.style.top = coord.top;
          dotGlow.style.left = coord.left;
          dotGlow.style.top = coord.top;

          dot.classList.remove('hidden');
          dotGlow.classList.remove('hidden');

          valueDisplay.innerHTML = coord.val;

          const periodComparisonEl = document.getElementById('chart-period-comparison');
          if (periodComparisonEl) {
            const total = chartData.reduce((s, d) => s + d.val, 0);
            const avg = chartData.length > 0 ? total / chartData.length : 0;
            const diff = coord.valNumber - avg;
            const pct = avg > 0 ? Math.round((diff / avg) * 100) : 0;
            periodComparisonEl.textContent = `${pct >= 0 ? '+' : ''}${pct}% vs medie`;
            periodComparisonEl.className = `text-xs font-black mt-0.5 ${pct >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;
          }

          if (hatchClipRectNew) {
            hatchClipRectNew.setAttribute('width', (coord.cx + 5).toString());
          }

          document.querySelectorAll('.day-btn').forEach(b => {
            b.classList.remove('text-brand-secondary', 'font-black');
            b.classList.add('text-text-muted');
          });
          btn.classList.remove('text-text-muted');
          btn.classList.add('text-brand-secondary', 'font-black');
        }
      });
    });

    const newDayBtns = document.querySelectorAll('.day-btn');
    if (newDayBtns[activeBtnIdx]) {
      newDayBtns[activeBtnIdx].dispatchEvent(new Event('click'));
    }
  }

  function setupTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const activePill = document.getElementById('tabs-active-pill');

    function updatePill(target: HTMLElement) {
      if (!activePill) return;
      const width = target.offsetWidth;
      const left = target.offsetLeft;
      activePill.style.opacity = '1';
      activePill.style.width = `${width}px`;
      activePill.style.transform = `translate(${left}px, -50%)`;
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const newTab = target.dataset.tab as TabType;
        if (newTab !== activeTab) {
          activeTab = newTab;
          
          tabBtns.forEach(b => {
            b.classList.remove('text-text-inverse');
            b.classList.add('text-text-muted', 'hover:text-text-main');
          });
          target.classList.remove('text-text-muted', 'hover:text-text-main');
          target.classList.add('text-text-inverse');

          updatePill(target);
          loadReportStats();
        } else {
          // If the user clicks the already active tab, just load stats (forces refresh on return)
          updatePill(target);
          loadReportStats();
        }
      });
    });

    setTimeout(() => {
      const initialBtn = document.querySelector(`[data-tab="${activeTab}"]`) as HTMLElement;
      if (initialBtn) updatePill(initialBtn);
    }, 50);
  }

  function setupNavigation() {
    document.getElementById('prev-report-btn')?.addEventListener('click', () => {
      if (activeTab === 'week') currentBaseDate.setDate(currentBaseDate.getDate() - 7);
      else if (activeTab === 'month') currentBaseDate.setMonth(currentBaseDate.getMonth() - 1);
      else if (activeTab === 'quarter') currentBaseDate.setMonth(currentBaseDate.getMonth() - 3);
      else if (activeTab === 'year') currentBaseDate.setFullYear(currentBaseDate.getFullYear() - 1);
      loadReportStats();
    });
    
    document.getElementById('next-report-btn')?.addEventListener('click', () => {
      if (activeTab === 'week') currentBaseDate.setDate(currentBaseDate.getDate() + 7);
      else if (activeTab === 'month') currentBaseDate.setMonth(currentBaseDate.getMonth() + 1);
      else if (activeTab === 'quarter') currentBaseDate.setMonth(currentBaseDate.getMonth() + 3);
      else if (activeTab === 'year') currentBaseDate.setFullYear(currentBaseDate.getFullYear() + 1);
      loadReportStats();
    });
  }

  async function initReportsView() {
    const container = document.getElementById('reports-tabs-container');
    if (!container) return; // Not on this page

    setupTabs();
    setupNavigation();
    setupDayNavigation();
    setupDayPicker();
    await Promise.all([
      loadTodayStats(),
      loadReportStats()
    ]);
  }

  if (!(window as any)._reportsNavSetup) {
    document.addEventListener('astro:page-load', () => {
      const container = document.getElementById('reports-tabs-container');
      if (container) {
        currentBaseDate = new Date();
        currentDayDate = new Date();
        activeTab = 'week';
        
        // Setup initially
        const tabBtns = document.querySelectorAll('.tab-btn');
        tabBtns.forEach(b => {
          if (b.getAttribute('data-tab') === activeTab) {
            b.classList.remove('text-text-muted', 'hover:text-text-main');
            b.classList.add('text-text-inverse');
          } else {
            b.classList.remove('text-text-inverse');
            b.classList.add('text-text-muted', 'hover:text-text-main');
          }
        });

        initReportsView();
      }
    });

    // Actualizare automată statistici la orice acțiune din aplicație
    window.addEventListener('sessionsUpdated', () => {
      if (document.getElementById('reports-tabs-container')) {
        loadTodayStats();
        loadReportStats();
      }
    });
    window.addEventListener('patientsUpdated', () => {
      if (document.getElementById('reports-tabs-container')) {
        loadTodayStats();
        loadReportStats();
      }
    });
    window.addEventListener('paymentsUpdated', () => {
      if (document.getElementById('reports-tabs-container')) {
        loadTodayStats();
        loadReportStats();
      }
    });

    (window as any)._reportsNavSetup = true;
  }
</script>
