      console.error('Error loading chart stats:', e);
    }
  }


  function initInteractiveHatchChart(chartData: any[], startStr: string, periodType: TabType, statData?: any) {
    const container = document.getElementById('chart-x-labels');
    if (!container) return;
    
    // Create label buttons dynamically
    container.innerHTML = '';
    chartData.forEach((item, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const textSize = chartData.length <= 7 ? 'text-xl sm:text-2xl' : 'text-sm sm:text-base';
      btn.className = `day-btn hover:text-brand-secondary transition-colors cursor-pointer py-1 px-2 text-text-muted ${textSize} font-black`;
      btn.textContent = item.label;
      btn.dataset.idx = idx.toString();
      container.appendChild(btn);
    });

    const svg = document.getElementById('reports-svg');
    const dayBtns = document.querySelectorAll('.day-btn');
    const dot = document.getElementById('pink-dot');
    const dotGlow = document.getElementById('pink-dot-glow');
    const valueDisplay = document.getElementById('chart-active-value');
    const pathGradient = document.getElementById('chart-path-gradient');
    const pathHatch = document.getElementById('chart-path-hatch');
    const pathStroke = document.getElementById('chart-path-stroke');
    
    if (!svg || !dot || !dotGlow || !valueDisplay || dayBtns.length === 0) return;

    const chartVals = chartData.map(d => d.val);
    const rawMax = Math.max(...chartVals, 100);

    function niceAnchor(max: number) {
      if (max <= 0) return 100;
      if (max <= 10) return 10;
      if (max <= 100) return Math.ceil(max / 10) * 10;
      if (max <= 1000) return Math.ceil(max / 100) * 100;
      return Math.ceil(max / 500) * 500;
    }

    const yMax = niceAnchor(rawMax);
    const yMid = Math.round(yMax / 2);
    const yAxisMax = document.getElementById('chart-y-max');
    const yAxisMid = document.getElementById('chart-y-mid');
    if (yAxisMax) yAxisMax.textContent = `${yMax}`;
    if (yAxisMid) yAxisMid.textContent = `${yMid}`;

    const maxVal = yMax;
    const minY = 115;
    const maxY = 15;
    const pointsCount = chartVals.length;
    const step = pointsCount > 1 ? (320 / (pointsCount - 1)) : 320;
    const xCoords = Array.from({length: pointsCount}, (_, i) => 15 + i * step);

    const points = chartVals.map((val, i) => {
      const y = val === 0 ? minY : (minY - (val / maxVal) * (minY - maxY));
      return { x: xCoords[i], y, val };
    });

    if (valueDisplay) {
      valueDisplay.innerHTML = `${statData ? statData.venit || 0 : 0} <span class="text-sm font-sans font-black text-text-main">RON</span>`;
    }

    // Draw the line only up to today (or the last known day for past periods)
    const todayStr = toLocalISOString(new Date());
    let todayIdx = -1;
    for (let i = chartData.length - 1; i >= 0; i--) {
      const item = chartData[i];
      if (item && item.dateStr && item.dateStr <= todayStr) {
        todayIdx = i;
        break;
      }
    }
    if (todayIdx === -1) todayIdx = chartData.length - 1;

    const visiblePoints = points.slice(0, todayIdx + 1);
    const isAllZero = chartVals.every(v => v === 0);

    if (isAllZero || visiblePoints.length === 0) {
      if (pathStroke) pathStroke.setAttribute('d', '');
      if (pathGradient) pathGradient.setAttribute('d', '');
      if (pathHatch) pathHatch.setAttribute('d', '');
    } else if (visiblePoints.length === 1) {
      const p = visiblePoints[0];
      const strokePath = `M 0,${p.y} L ${p.x},${p.y}`;
      const fillPath = `M 0,115 L 0,${p.y} L ${p.x},${p.y} L ${p.x},115 Z`;
      
      if (pathStroke) pathStroke.setAttribute('d', strokePath);
      if (pathGradient) pathGradient.setAttribute('d', fillPath);
      if (pathHatch) pathHatch.setAttribute('d', fillPath);
    } else {
      let strokePath = `M ${visiblePoints[0].x},${visiblePoints[0].y}`;
      for(let i=0; i<visiblePoints.length - 1; i++) {
        const p1 = visiblePoints[i];
        const p2 = visiblePoints[i+1];
        const cx1 = p1.x + (p2.x - p1.x) / 2;
        const cy1 = p1.y;
        const cx2 = p1.x + (p2.x - p1.x) / 2;
        const cy2 = p2.y;
        strokePath += ` C ${cx1},${cy1} ${cx2},${cy2} ${p2.x},${p2.y}`;
      }
      const fillPath = strokePath + ` L ${visiblePoints[visiblePoints.length - 1].x},115 L ${visiblePoints[0].x},115 Z`;
      
      if (pathStroke) pathStroke.setAttribute('d', strokePath);
      if (pathGradient) pathGradient.setAttribute('d', fillPath);
      if (pathHatch) pathHatch.setAttribute('d', fillPath);
    }

    const dayCoords = points.map(p => ({
      cx: p.x,
      cy: p.y,
      left: `${(p.x / 350) * 100}%`,
      top: `${(p.y / 120) * 100}%`,
      val: `${p.val} <span class="text-sm font-sans font-black text-text-main">RON</span>`,
      valNumber: p.val
    }));

    const evolutionContainer = document.getElementById('chart-weekly-evolution');
    function renderWeeklyEvolution(highlightIdx: number = -1) {
      if (!evolutionContainer) return;
      const total = chartData.reduce((s, d) => s + d.val, 0);
      evolutionContainer.innerHTML = chartData.map((item, idx) => {
        const isActive = idx === highlightIdx;
        const pct = total > 0 ? Math.round((item.val / total) * 100) : 0;
        return `
          <button type="button" class="weekly-evolution-row w-full flex items-center justify-between py-2 px-3 rounded-2xl ${isActive ? 'bg-surface-base shadow-2xs font-bold' : 'hover:bg-surface-base/60'} transition-all cursor-pointer group text-left active:scale-[0.99]" data-idx="${idx}">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <span class="text-xs font-black uppercase tracking-wider text-text-muted w-8 shrink-0">${item.label}</span>
              <div class="w-20 sm:w-24 h-2 bg-surface-card rounded-full overflow-hidden shrink-0 border border-border-subtle/30">
                <div class="h-full rounded-full ${isActive ? 'bg-brand-secondary' : 'bg-text-main/30'}" style="width: ${Math.max(4, pct)}%"></div>
              </div>
              <span class="text-xs font-bold text-text-muted truncate hidden sm:inline-block">${item.fullTitle || ''}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 pl-2">
              <span class="text-sm font-black ${isActive ? 'text-brand-secondary' : 'text-text-main'} group-hover:text-brand-secondary transition-colors">${item.val} RON</span>
              <svg class="w-3.5 h-3.5 text-text-muted/60 group-hover:text-brand-secondary group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </div>
          </button>
        `;
      }).join('');

      // Add click handlers on evolution rows to open detailed popup
      evolutionContainer.querySelectorAll('.weekly-evolution-row').forEach(rowBtn => {
        rowBtn.addEventListener('click', () => {
          const idx = parseInt((rowBtn as HTMLElement).dataset.idx || '-1', 10);
          if (idx >= 0 && chartData[idx]) {
            const item = chartData[idx];
            // Also select on graph
            const coord = dayCoords[idx];
            if (coord) {
              dot.style.left = coord.left;
              dot.style.top = coord.top;
              dotGlow.style.left = coord.left;
              dotGlow.style.top = coord.top;
              dot.classList.remove('hidden');
              dotGlow.classList.remove('hidden');
              valueDisplay.innerHTML = coord.val;
            }

            document.querySelectorAll('.day-btn').forEach(b => {
              b.classList.remove('text-brand-secondary', 'font-black');
              b.classList.add('text-text-muted');
            });
            const correspondingBtn = document.querySelector(`.day-btn[data-idx="${idx}"]`);
            if (correspondingBtn) {
              correspondingBtn.classList.remove('text-text-muted');
              correspondingBtn.classList.add('text-brand-secondary', 'font-black');
            }

            renderWeeklyEvolution(idx);
            openIncomeDetails(item.fullTitle || `Încasări ${item.label}`, `${item.val} RON colectați`, item.startDateStr || item.dateStr, item.endDateStr || item.dateStr, item.val);
          }
        });
      });
    }
    renderWeeklyEvolution();

    dayBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const coord = dayCoords[idx];
        if (coord) {
          dot.style.left = coord.left;
          dot.style.top = coord.top;
          dotGlow.style.left = coord.left;
          dotGlow.style.top = coord.top;

          dot.classList.remove('hidden');
          dotGlow.classList.remove('hidden');

          valueDisplay.innerHTML = coord.val;

          document.querySelectorAll('.day-btn').forEach(b => {
            b.classList.remove('text-brand-secondary', 'font-black');
            b.classList.add('text-text-muted');
          });
          btn.classList.remove('text-text-muted');
          btn.classList.add('text-brand-secondary', 'font-black');

          renderWeeklyEvolution(idx);
        }
      });
    });

    const activeBtnIdx = todayIdx;
    const newDayBtns = document.querySelectorAll('.day-btn');
    if (activeBtnIdx >= 0 && newDayBtns[activeBtnIdx]) {
      (newDayBtns[activeBtnIdx] as HTMLElement).dispatchEvent(new Event('click'));
    } else {
      if (dot) dot.classList.add('hidden');
      if (dotGlow) dotGlow.classList.add('hidden');
    }
  }

  function setupTabGroup(containerId: string, pillId: string, btnClass: string, getState: () => TabType, setState: (tab: TabType) => void, onUpdate: () => void) {
    const tabsContainer = document.getElementById(containerId);
    if (!tabsContainer || tabsContainer.dataset.reportsTabsBound === 'true') return;
    tabsContainer.dataset.reportsTabsBound = 'true';

    const tabBtns = tabsContainer.querySelectorAll('.' + btnClass);
    const activePill = document.getElementById(pillId);

    function updatePill(btn: HTMLElement) {
      if (!activePill || !tabsContainer) return;
      const btnRect = btn.getBoundingClientRect();
      const containerRect = tabsContainer.getBoundingClientRect();
      const left = btnRect.left - containerRect.left;
      const width = btnRect.width;

      activePill.style.transform = `translate(${left}px, -50%)`;
      activePill.style.width = `${width}px`;
      activePill.style.opacity = '1';
    }

    function updateActivePill() {
      const activeBtn = tabsContainer?.querySelector(`.${btnClass}[data-tab="${getState()}"]`) as HTMLElement;
      if (activeBtn) updatePill(activeBtn);
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const newTab = target.getAttribute('data-tab') as TabType;
        if (newTab && newTab !== getState()) {
          setState(newTab);

          tabBtns.forEach(b => {
            b.classList.remove('text-text-inverse');
            b.classList.add('text-text-muted', 'hover:text-text-main');
          });
          target.classList.remove('text-text-muted', 'hover:text-text-main');
          target.classList.add('text-text-inverse');

          updatePill(target);
          onUpdate();
        } else {
          updatePill(target);
          onUpdate();
        }
      });
    });

    [0, 50, 150, 300, 600].forEach(delay => {
      setTimeout(updateActivePill, delay);
    });

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => updateActivePill());
      ro.observe(tabsContainer);
    }
    
    window.addEventListener('resize', updateActivePill);
  }

  function setupTabs() {
    setupTabGroup('stats-tabs-container', 'stats-tabs-active-pill', 'stats-tab-btn', () => activeStatsTab, (v) => activeStatsTab = v, loadReportStats);
    setupTabGroup('chart-tabs-container', 'chart-tabs-active-pill', 'chart-tab-btn', () => activeChartTab, (v) => activeChartTab = v, loadChartStats);
  }

  function setupNavigation() {
    const prevBtn = document.getElementById('prev-report-btn');
    const nextBtn = document.getElementById('next-report-btn');
    if (!prevBtn || prevBtn.dataset.reportsNavBound === 'true') return;
    prevBtn.dataset.reportsNavBound = 'true';
    nextBtn && (nextBtn.dataset.reportsNavBound = 'true');

    prevBtn.addEventListener('click', () => {
      if (activeStatsTab === 'day') currentBaseDate.setDate(currentBaseDate.getDate() - 1);
      else if (activeStatsTab === 'week') currentBaseDate.setDate(currentBaseDate.getDate() - 7);
      else if (activeStatsTab === 'month') currentBaseDate.setMonth(currentBaseDate.getMonth() - 1);
      else if (activeStatsTab === 'quarter') currentBaseDate.setMonth(currentBaseDate.getMonth() - 3);
      else if (activeStatsTab === 'year') currentBaseDate.setFullYear(currentBaseDate.getFullYear() - 1);
      loadReportStats();
      loadChartStats();
      loadUnpaidStats();
    });

    nextBtn?.addEventListener('click', () => {
      if (activeStatsTab === 'day') currentBaseDate.setDate(currentBaseDate.getDate() + 1);
      else if (activeStatsTab === 'week') currentBaseDate.setDate(currentBaseDate.getDate() + 7);
      else if (activeStatsTab === 'month') currentBaseDate.setMonth(currentBaseDate.getMonth() + 1);
      else if (activeStatsTab === 'quarter') currentBaseDate.setMonth(currentBaseDate.getMonth() + 3);
      else if (activeStatsTab === 'year') currentBaseDate.setFullYear(currentBaseDate.getFullYear() + 1);
      loadReportStats();
      loadChartStats();
      loadUnpaidStats();
    });
  }

  async function initReportsView() {
    const container = document.getElementById('stats-tabs-container');
    if (!container) return; // Not on this page

    const skeleton = document.getElementById('reports-skeleton');
    const data = document.getElementById('reports-data');
    if (skeleton) skeleton.classList.remove('hidden');
    if (data) data.classList.add('hidden');

    setupTabs();
    setupNavigation();
    setupDayNavigation();
    setupDayPicker();
    setupTopIncomeCard();
    setupIncomeDetailsGestures();
    
    await Promise.all([
      loadUnpaidStats(),
      loadReportStats(),
      loadChartStats()
    ]);

    if (data) data.classList.remove('hidden');
    if (skeleton) {
      skeleton.classList.add('opacity-0');
      setTimeout(() => skeleton.classList.add('hidden'), 200);
    }
  }

  function bootReports() {
    const container = document.getElementById('stats-tabs-container');
    if (!container) return;
    currentBaseDate = new Date();
    currentDayDate = new Date();
    activeStatsTab = 'day';
    activeUnpaidTab = 'all';
    activeChartTab = 'week';

    // Setup initially
    const setupVisuals = (btnClass: string, activeVal: string) => {
      const btns = document.querySelectorAll('.' + btnClass);
      btns.forEach(b => {
        if (b.getAttribute('data-tab') === activeVal) {
          b.classList.remove('text-text-muted', 'hover:text-text-main');
          b.classList.add('text-text-inverse');
        } else {
          b.classList.remove('text-text-inverse');
          b.classList.add('text-text-muted', 'hover:text-text-main');
        }
      });
    };
    
    setupVisuals('stats-tab-btn', activeStatsTab);
    setupVisuals('chart-tab-btn', activeChartTab);

    initReportsView();
  }

  if (!(window as any)._reportsNavSetup) {
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      bootReports();
    } else {
      document.addEventListener('DOMContentLoaded', bootReports);
    }
    document.addEventListener('astro:page-load', bootReports);

    // Actualizare automată statistici la orice acțiune din aplicație
    const reloadData = () => {
      if (document.getElementById('stats-tabs-container')) {
        loadUnpaidStats();
        loadReportStats();
        loadChartStats();
      }
    };
    window.addEventListener('sessionsUpdated', reloadData);
    window.addEventListener('patientsUpdated', reloadData);
    window.addEventListener('paymentsUpdated', reloadData);

    (window as any)._reportsNavSetup = true;
  }


  // ── UNPAID DETAILS POPUP SHEET ────────────────────────────────
  (window as any).openUnpaidDetails = async function() {
    const sheet = document.getElementById('unpaid-details-sheet');
    const backdrop = document.getElementById('unpaid-details-backdrop');
    const content = document.getElementById('unpaid-details-content');
    const totalEl = document.getElementById('unpaid-details-total');
    const badgeEl = document.getElementById('unpaid-details-count-badge');
    const listEl = document.getElementById('unpaid-details-list');

    if (!sheet || !backdrop || !content || !listEl) return;

    if (sheet.parentElement !== document.body) {
      document.body.appendChild(sheet);
    }

    if (badgeEl) badgeEl.textContent = 'Se încarcă...';
    listEl.innerHTML = `
      <div class="py-10 text-center space-y-2">
        <div class="w-8 h-8 border-3 border-rose-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
        <p class="text-xs font-bold text-text-muted">Se caută plățile restante...</p>
      </div>
    `;

    // Hide navigation dock to prevent overlap and rendering lag
    const dock = document.getElementById('persistent-dock');
    if (dock) {
      dock.style.transition = 'opacity 0.25s ease';
      dock.style.opacity = '0';
      dock.style.pointerEvents = 'none';
    }

    // Animate open
    isUnpaidDetailsOpen = true;
    sheet.dataset.open = 'true';
    sheet.classList.remove('pointer-events-none');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    backdrop.classList.add('opacity-100', 'pointer-events-auto');
    content.classList.remove('translate-y-full');
    content.classList.add('translate-y-0');
    lockBodyScroll();

    setupUnpaidDetailsGestures();

    // Start fetching data in parallel
    const unpaidPromise = getUnpaidPatients();
    
    // Wait for the slide-up animation (500ms) to complete before rendering DOM items to keep the animation at 60fps
    const animationDelay = new Promise(resolve => setTimeout(resolve, 350));

    try {
      const [unpaid] = await Promise.all([unpaidPromise, animationDelay]);
      
      if (totalEl) totalEl.innerHTML = `${unpaid.totalRON} <span class="text-sm font-sans font-black">RON</span>`;
      if (badgeEl) badgeEl.textContent = `${unpaid.count} pacienți`;

      if (unpaid.patients.length === 0) {
        listEl.innerHTML = `
          <div class="py-8 px-4 text-center rounded-2xl bg-surface-base/50 border border-dashed border-border-subtle/50 flex flex-col items-center justify-center space-y-2">
            <div class="w-12 h-12 rounded-2xl bg-surface-card flex items-center justify-center text-emerald-500 shadow-2xs">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-sm font-black text-text-main">Toate plățile sunt la zi</p>
            <p class="text-xs font-bold text-text-muted">Nu există niciun pacient cu sume restante.</p>
          </div>
        `;
        return;
      }

      listEl.innerHTML = unpaid.patients.map(p => {
        const nameParts = (p.name || 'Pacient').split(' ').filter(Boolean);
        const initials = nameParts.length >= 2 
          ? `${nameParts[0][0]}${nameParts[1][0]}`.toUpperCase() 
          : (nameParts[0]?.slice(0, 2).toUpperCase() || 'PA');

        return `
          <a href="/dashboard/patients/${p.id}" data-astro-history="push" class="block p-3.5 rounded-2xl bg-surface-base border border-border-subtle/30 flex items-center justify-between gap-3 shadow-2xs hover:border-rose-500/30 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-surface-card text-text-main flex items-center justify-center font-black text-sm shrink-0 shadow-sm border border-border-subtle">
                ${initials}
              </div>
              <div class="min-w-0">
                <div class="font-black text-text-main text-sm sm:text-base truncate">${p.name}</div>
                <div class="text-xs font-bold text-text-muted">Total pachet: ${p.cost || 0} RON</div>
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-base sm:text-lg font-black text-rose-600">-${p.suma_restanta} RON</div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-text-muted">Restanță</div>
            </div>
          </a>
        `;
      }).join('');

    } catch (err) {
      console.error('Eroare încărcare restanțe:', err);
      listEl.innerHTML = `
        <div class="p-4 rounded-2xl bg-rose-50 text-rose-700 text-xs font-bold text-center">
          Eroare la încărcarea listei de restanțe. Te rugăm să încerci din nou.
        </div>
      `;
    }
  }

  function closeUnpaidDetails() {
    const sheet = document.getElementById('unpaid-details-sheet');
    const backdrop = document.getElementById('unpaid-details-backdrop');
    const content = document.getElementById('unpaid-details-content');

    if (!sheet || !backdrop || !content) return;

    isUnpaidDetailsOpen = false;
    sheet.dataset.open = 'false';
    content.style.transform = ''; 
    content.classList.remove('translate-y-0');
    content.classList.add('translate-y-full');
    backdrop.classList.remove('opacity-100', 'pointer-events-auto');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    
    // Show navigation dock again
    const dock = document.getElementById('persistent-dock');
    if (dock) {
      dock.style.opacity = '1';
      dock.style.pointerEvents = 'auto';
    }

    setTimeout(() => {
      sheet.classList.add('pointer-events-none');
      unlockBodyScroll();
    }, 300);
  }

  function setupUnpaidDetailsGestures() {
    const sheet = document.getElementById('unpaid-details-sheet');
    const backdrop = document.getElementById('unpaid-details-backdrop');
    const content = document.getElementById('unpaid-details-content');

    if (!sheet || !backdrop || !content) return;

    if (sheet.dataset.gesturesBound === 'true') return;
    sheet.dataset.gesturesBound = 'true';

    backdrop.addEventListener('click', closeUnpaidDetails);

    let startY = 0;
    let currentY = 0;
    let isDragging = false;

    const resetDrag = () => {
      isDragging = false;
      content.style.transform = '';
    };

    content.addEventListener('touchstart', (e: TouchEvent) => {
      if (content.scrollTop === 0) {
        startY = e.touches[0].clientY;
        currentY = startY;
        isDragging = true;
      }
    }, { passive: true });

    content.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging) return;
      currentY = e.touches[0].clientY;
      const deltaY = currentY - startY;
      if (deltaY > 0) {
        content.style.transform = `translateY(${deltaY}px)`;
      }
    }, { passive: true });

    content.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      const deltaY = currentY - startY;
      content.style.transform = '';
      if (deltaY > 80) {
        closeUnpaidDetails();
      }
    });

    content.addEventListener('touchcancel', resetDrag);
  }

</script>
