---
// ReportsView.astro — Statistici Utile & Pragmatice
---

<div id="reports-content" class="space-y-7 relative">

  <!-- Skeleton loader: shown only while fetching from DB -->
  <div id="reports-skeleton" class="absolute inset-0 z-10 space-y-7 transition-opacity duration-200">
    <div class="grid grid-cols-3 gap-3">
      <div class="h-28 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
      <div class="h-28 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
      <div class="h-28 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div class="h-28 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
      <div class="h-28 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
    </div>
    <div class="h-80 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
    <div class="h-40 rounded-[2.2rem] bg-black/10 animate-pulse"></div>
  </div>

  <div id="reports-data" class="space-y-7 hidden">

    <!-- Antet perioadă + navigare pentru Statistici -->
    <div class="flex items-center justify-between px-1 mb-3">
      <div class="flex flex-col">
        <h2 id="report-title" class="text-xl sm:text-2xl font-black text-text-main">Azi</h2>
        <span id="report-date-range" class="text-sm font-bold text-text-muted">--</span>
      </div>
      <div class="flex gap-2">
        <button type="button" id="prev-report-btn" class="p-2 rounded-full bg-surface-card shadow-sm border border-transparent active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button type="button" id="next-report-btn" class="p-2 rounded-full bg-surface-card shadow-sm border border-transparent active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <!-- Stats Tabs Container -->
    <div class="relative flex items-center space-x-2 bg-surface-card p-1.5 rounded-xl shadow-sm border border-transparent mb-6" id="stats-tabs-container">
      <div id="stats-tabs-active-pill" class="absolute top-1/2 rounded-lg bg-text-main pointer-events-none z-0" style="left: 0; width: 0; height: calc(100% - 12px); opacity: 0; transform: translateY(-50%); transition: transform 450ms cubic-bezier(0.34, 1.36, 0.64, 1), width 450ms cubic-bezier(0.34, 1.36, 0.64, 1), opacity 300ms ease;"></div>
      <button class="stats-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-inverse" data-tab="day">Zi</button>
      <button class="stats-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="week">Săpt</button>
      <button class="stats-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="month">Lun</button>
      <button class="stats-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="quarter">Trim</button>
      <button class="stats-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="year">An</button>
    </div>



    <!-- Unified Stats Cards Row -->
    <div class="grid grid-cols-3 gap-3 mb-7">
      <!-- Card 1: Ședințe -->
      <div class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-transparent flex flex-col items-center justify-center text-center transition-all hover:border-transparent">
        <div class="flex items-baseline gap-1">
          <span id="period-done" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</span>
          <span class="text-xl font-bold text-text-muted opacity-40">/</span>
          <span id="period-total" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</span>
        </div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Ședințe</div>
      </div>
      <!-- Card 2: Absent -->
      <div class="bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-transparent flex flex-col items-center justify-center text-center transition-all hover:border-transparent">
        <div id="period-absent" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Absent</div>
      </div>
      <!-- Card 3: Încasat -->
      <button type="button" id="period-income-card" class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-transparent flex flex-col items-center justify-center text-center transition-all hover:border-transparent cursor-pointer active:scale-95 group">
        <div id="period-income" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none group-hover:text-brand-secondary transition-colors">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2 flex items-center gap-1">
          <span>RON</span>
          <svg class="w-3.5 h-3.5 text-text-muted opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </div>
      </button>
    </div>


  </section>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 2. PLĂȚI RESTANTE (GLOBAL)                              -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-3">
    <div class="flex items-baseline justify-between px-1 mb-3">
      <h2 class="text-xl sm:text-2xl font-black text-text-main">Plăți restante</h2>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <button type="button" onclick="openUnpaidDetails()"
        class="block bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-transparent flex flex-col items-center justify-center text-center transition-all hover:border-transparent group active:scale-[0.98]"
      >
        <div id="unpaid-count" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Neachitați</div>
      </button>
      <button type="button" onclick="openUnpaidDetails()"
        class="block bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-transparent flex flex-col items-center justify-center text-center transition-all hover:border-transparent group active:scale-[0.98]"
      >
        <div id="unpaid-total" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">RON neachitați</div>
      </button>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 3. EVOLUȚIE GRAFICĂ & TIMP ACTIV -->
  <section class="space-y-4">
    <!-- Chart Tabs Container -->
    <div class="relative flex items-center space-x-2 bg-surface-card p-1.5 rounded-xl shadow-sm border border-transparent mb-4" id="chart-tabs-container">
      <div id="chart-tabs-active-pill" class="absolute top-1/2 rounded-lg bg-text-main pointer-events-none z-0" style="left: 0; width: 0; height: calc(100% - 12px); opacity: 0; transform: translateY(-50%); transition: transform 450ms cubic-bezier(0.34, 1.36, 0.64, 1), width 450ms cubic-bezier(0.34, 1.36, 0.64, 1), opacity 300ms ease;"></div>
      <button class="chart-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-inverse" data-tab="week">Săpt</button>
      <button class="chart-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="month">Lun</button>
      <button class="chart-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="quarter">Trim</button>
      <button class="chart-tab-btn relative z-10 flex-1 py-1.5 rounded-lg text-sm font-black transition-all text-text-muted hover:text-text-main" data-tab="year">An</button>
    </div>
    <!-- Card Grafic Hașurat --><!-- Card Grafic Hașurat -->
      <div class="bg-surface-card rounded-[2.2rem] p-5 shadow-sm border border-transparent space-y-4 relative overflow-hidden">
        <div>
          <div id="chart-subtitle" class="text-xs font-extrabold uppercase tracking-wider text-text-muted">Evoluție săptămânală</div>
          <div id="chart-active-value" class="text-2xl sm:text-3xl font-black text-text-main mt-0.5 transition-all">
            0 <span class="text-sm font-sans font-black text-text-main">RON</span>
          </div>
        </div>

        <div class="flex items-stretch gap-1">
          <!-- Graph + X-axis labels column -->
          <div class="flex-1 flex flex-col min-w-0">
            <!-- Graph area -->
            <div class="relative flex-1 h-36" id="chart-container">
              <svg viewBox="0 0 350 120" class="w-full h-full overflow-visible" preserveAspectRatio="none" id="reports-svg">
                <defs>
                  <pattern id="hatch-pattern" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                    <line x1="0" y1="0" x2="0" y2="8" stroke="rgb(var(--color-text-main))" stroke-width="1.5" opacity="0.25" />
                  </pattern>

                  <linearGradient id="soft-bg-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="rgb(var(--color-brand-primary))" stop-opacity="0.2" />
                    <stop offset="100%" stop-color="rgb(var(--color-surface-card))" stop-opacity="0.0" />
                  </linearGradient>
                </defs>

                <path id="chart-path-gradient" fill="url(#soft-bg-gradient)" d="" />
                <path id="chart-path-hatch" fill="url(#hatch-pattern)" d="" />
                <path id="chart-path-stroke" fill="none" stroke="rgb(var(--color-text-main))" stroke-width="3" stroke-linecap="round" d="" />
              </svg>

              <div id="pink-dot-glow" class="absolute bg-brand-secondary rounded-full opacity-30 transition-all duration-300 transform -translate-x-1/2 -translate-y-1/2 pointer-events-none hidden" style="width: 20px; height: 20px; z-index: 20;"></div>
              <div id="pink-dot" class="absolute bg-brand-secondary rounded-full border-[2.5px] border-white shadow-md transition-all duration-300 transform -translate-x-1/2 -translate-y-1/2 pointer-events-none hidden" style="width: 14px; height: 14px; z-index: 21;"></div>
            </div>

            <!-- X-axis labels (aligned under SVG graph only) -->
            <div class="flex items-center justify-between px-2 pt-2 text-xl sm:text-2xl font-black text-text-main" id="chart-x-labels">
              <!-- Dynamic labels generated in JS -->
            </div>
          </div>

          <!-- Y-axis anchors (to the right of graph, matching graph height) -->
          <div class="hidden flex-col justify-between text-[10px] font-black text-text-muted text-left py-0.5 pb-8 w-auto shrink-0 pl-1" id="chart-y-labels">
            <span id="chart-y-max">--</span>
            <span id="chart-y-mid">--</span>
            <span>0</span>
          </div>
        </div>

        <!-- Total perioadă + Evoluție cap-coadă -->
        <div class="space-y-3 pt-1">
          <button type="button" id="chart-period-total-btn" class="w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-surface-base hover:bg-surface-base/80 active:scale-[0.99] transition-all cursor-pointer group text-left">
            <span class="text-sm font-black text-text-muted flex items-center gap-1.5">
              <span>Total perioadă</span>
              <svg class="w-3.5 h-3.5 text-text-muted opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </span>
            <span id="chart-period-total" class="text-lg sm:text-xl font-black text-text-main group-hover:text-brand-secondary transition-colors">0 <span class="text-xs font-sans font-black text-text-main">RON</span></span>
          </button>
          <div id="chart-weekly-evolution" class="space-y-1.5">
            <!-- Dynamic list generated in JS -->
          </div>
        </div>
      </div>

      <!-- Card Timp Activ -->
      <div class="bg-surface-card rounded-[2.2rem] p-5 shadow-sm border border-transparent space-y-3">
        <div class="w-full h-3.5 bg-surface-base rounded-full overflow-hidden flex items-center p-0.5 border border-transparent">
          <div id="week-progress-bar" class="h-full bg-brand-primary rounded-full transition-all duration-1000" style="width: 100%"></div>
          <div id="week-cancel-bar" class="h-full bg-brand-secondary/80 rounded-full transition-all duration-1000 ml-0.5" style="width: 0%"></div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-text-main">
            <span id="week-active-time">100%</span> <span class="text-base sm:text-lg font-black text-text-main">timp activ</span>
          </div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-text-main">
            <span id="week-cancel-time">0%</span> <span class="text-base sm:text-lg font-black text-text-main">anulări</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  </div>

</div>

<!-- Custom Date Picker Popup (floating, smaller, no native calendar UI) -->
<div id="day-picker-sheet" data-sheet-root class="fixed inset-0 w-screen h-screen h-[100dvh] z-[9999] pointer-events-none">
  <div id="day-picker-overlay" class="fixed inset-0 bg-black/25 opacity-0 pointer-events-none transition-opacity duration-200"></div>
  <div id="day-picker-content" class="fixed w-[19rem] bg-surface-card rounded-[1.75rem] p-4 shadow-2xl pointer-events-auto transform scale-95 opacity-0 transition-all duration-200 ease-out origin-top-left border border-transparent z-[10000]">
    <div class="flex items-center justify-between mb-3">
      <button type="button" id="day-picker-prev-month" class="p-1.5 rounded-full bg-surface-base active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <div id="day-picker-month-year" class="text-sm font-black text-text-main">--</div>
      <button type="button" id="day-picker-next-month" class="p-1.5 rounded-full bg-surface-base active:scale-95 transition-transform text-text-main hover:text-brand-secondary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
    <div class="grid grid-cols-7 gap-1 text-center mb-2">
      <span class="text-[10px] font-bold text-text-muted">L</span>
      <span class="text-[10px] font-bold text-text-muted">M</span>
      <span class="text-[10px] font-bold text-text-muted">M</span>
      <span class="text-[10px] font-bold text-text-muted">J</span>
      <span class="text-[10px] font-bold text-text-muted">V</span>
      <span class="text-[10px] font-bold text-text-muted">S</span>
      <span class="text-[10px] font-bold text-text-muted">D</span>
    </div>
    <div id="day-picker-grid" class="grid grid-cols-7 gap-1">
      <!-- Generated by JS -->
    </div>
  </div>
</div>


<!-- Unpaid Details Popup Sheet -->
<div id="unpaid-details-sheet" data-sheet-root class="fixed inset-0 z-[120] pointer-events-none">
  <div id="unpaid-details-backdrop" class="fixed inset-0 bg-black/25 opacity-0 pointer-events-none transition-opacity duration-300"></div>
  <div id="unpaid-details-content" style="will-change: transform;" class="fixed bottom-0 left-0 right-0 max-w-lg mx-auto bg-surface-card rounded-t-[2.5rem] p-6 pb-safe shadow-2xl pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] max-h-[85vh] flex flex-col border border-border-subtle/30 z-[10000]">
    <div class="w-12 h-1.5 bg-text-main/15 rounded-full mx-auto mb-4 shrink-0 cursor-grab active:cursor-grabbing"></div>
    
    <div class="flex items-start justify-between mb-4 shrink-0">
      <div class="min-w-0 pr-2">
        <h2 class="text-xl sm:text-2xl font-black text-text-main tracking-tight truncate">Plăți Restante</h2>
      </div>
    </div>

    <!-- Summary Box -->
    <div class="mb-4 bg-rose-50 rounded-2xl p-4 flex items-center justify-between shrink-0 border border-rose-100 shadow-2xs">
      <div>
        <span class="text-xs font-black uppercase tracking-wider text-rose-600">Total Datorat</span>
        <div id="unpaid-details-total" class="text-2xl sm:text-3xl font-black text-rose-600 mt-0.5">0 <span class="text-sm font-sans font-black">RON</span></div>
      </div>
      <div id="unpaid-details-count-badge" class="px-3.5 py-1.5 rounded-xl bg-white text-rose-600 text-xs sm:text-sm font-black border border-rose-200">
        0 pacienți
      </div>
    </div>

    <!-- Debtors List -->
    <div id="unpaid-details-list" class="space-y-2.5 overflow-y-auto flex-1 pr-1 overscroll-contain">
      <!-- Generated by JS -->
    </div>
  </div>
</div>

<!-- Income Details Popup Sheet (Card cu proveniența banilor) -->
<div id="income-details-sheet" data-sheet-root class="fixed inset-0 z-[120] pointer-events-none">
  <div id="income-details-backdrop" class="fixed inset-0 bg-black/25 opacity-0 pointer-events-none transition-opacity duration-300"></div>
  <div id="income-details-content" style="will-change: transform;" class="fixed bottom-0 left-0 right-0 max-w-lg mx-auto bg-surface-card rounded-t-[2.5rem] p-6 pb-safe shadow-2xl pointer-events-auto transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] max-h-[85vh] flex flex-col border border-border-subtle/30 z-[10000]">
    <div class="w-12 h-1.5 bg-text-main/15 rounded-full mx-auto mb-4 shrink-0 cursor-grab active:cursor-grabbing"></div>
    
    <div class="flex items-start justify-between mb-4 shrink-0">
      <div class="min-w-0 pr-2">
        <h2 id="income-details-title" class="text-xl sm:text-2xl font-black text-text-main tracking-tight truncate">Încasări</h2>
      </div>
    </div>

    <!-- Summary Box -->
    <div class="mb-4 bg-surface-base rounded-2xl p-4 flex items-center justify-between shrink-0 border border-border-subtle/30 shadow-2xs">
      <div>
        <span class="text-xs font-black uppercase tracking-wider text-text-main">Total</span>
        <div id="income-details-total" class="text-2xl sm:text-3xl font-black text-text-main mt-0.5">0 <span class="text-sm font-sans font-black text-text-main">RON</span></div>
      </div>
      <div id="income-details-count-badge" class="px-3.5 py-1.5 rounded-xl bg-black/5 text-text-main text-xs sm:text-sm font-black border border-black/10">
        0 plăți
      </div>
    </div>

    <!-- Payment List -->
    <div id="income-details-list" class="space-y-2.5 overflow-y-auto flex-1 pr-1 overscroll-contain">
      <!-- Generated by JS -->
    </div>
  </div>
</div>

<script>
  import { getTodayStats, getWeekStats, getMonthStats, getQuarterStats, getYearStats, getUnpaidPatients, getDetailedPayments, type DetailedPayment } from '../../../lib/services/reportsService';
  import { toLocalISOString, formatDateRO } from '../../../utils/date';
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  type TabType = 'all' | 'day' | 'week' | 'month' | 'quarter' | 'year';
  let activeStatsTab: TabType = 'day';
  let activeUnpaidTab: TabType = 'all';
  let activeChartTab: TabType = 'week';
  
  let currentBaseDate = new Date();
  let currentDayDate = new Date();
  let lastStatData: any = null;

  let isDayPickerOpen = false;
  let isIncomeDetailsOpen = false;
  let isUnpaidDetailsOpen = false;

  function removeStaleSheets(exclude?: Element) {
    document.querySelectorAll('#day-picker-sheet, #income-details-sheet, #unpaid-details-sheet').forEach(el => {
      if (el !== exclude && el.parentElement === document.body) {
        el.remove();
      }
    });
  }

  // Curăță sheet-urile supraviețuitoare înainte de swap-ul Astro
  document.addEventListener('astro:before-swap', () => {
    removeStaleSheets();
  });

  // Escape key handler, bound once globally
  function handleGlobalEscape(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      if (isUnpaidDetailsOpen) closeUnpaidDetails();
      else if (isIncomeDetailsOpen) closeIncomeDetails();
      else if (isDayPickerOpen) closeDayPicker();
    }
  }
  if (!(window as any)._reportsEscapeBound) {
    document.addEventListener('keydown', handleGlobalEscape);
    (window as any)._reportsEscapeBound = true;
  }
  
  
  async function loadUnpaidStats() {
    try {
      const unpaid = await getUnpaidPatients();
      const countEl = document.getElementById('unpaid-count');
      const totalEl = document.getElementById('unpaid-total');
      if (countEl) countEl.textContent = unpaid.count.toString();
      if (totalEl) totalEl.textContent = unpaid.totalRON.toString();
    } catch(e) {
      console.error('Eroare loading unpaid stats', e);
    }
  }


  function setupDayNavigation() {
    const displayBtn = document.getElementById('report-title');
    if (!displayBtn || displayBtn.dataset.reportsDayNavBound === 'true') return;
    displayBtn.dataset.reportsDayNavBound = 'true';
    displayBtn.addEventListener('click', () => openDayPicker());
  }

  // ── Custom day picker sheet (no native date UI) ───────────────
  let pickerViewDate = new Date();

  function openDayPicker() {
    if (isDayPickerOpen) return;

    pickerViewDate = new Date(currentDayDate.getFullYear(), currentDayDate.getMonth(), currentDayDate.getDate());
    renderDayPicker();

    const sheet = document.getElementById('day-picker-sheet');
    const overlay = document.getElementById('day-picker-overlay');
    const content = document.getElementById('day-picker-content');
    const trigger = document.getElementById('today-date-display');
    if (!sheet || !overlay || !content) return;

    if (sheet.parentElement !== document.body) {
      document.body.appendChild(sheet);
    }

    const rect = trigger?.getBoundingClientRect();
    if (rect) {
      const screenWidth = window.innerWidth;
      const contentWidth = 304; // 19rem = 304px
      let leftPos = rect.left;
      if (leftPos + contentWidth > screenWidth - 16) {
        leftPos = Math.max(16, screenWidth - contentWidth - 16);
      }
      content.style.left = `${leftPos}px`;
      content.style.top = `${rect.bottom + 8}px`;
    }

    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');

    isDayPickerOpen = true;
    sheet.dataset.open = 'true';
    sheet.classList.remove('pointer-events-none');
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('opacity-100', 'pointer-events-auto');

    requestAnimationFrame(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    });

    lockBodyScroll();
  }

  function closeDayPicker() {
    const sheet = document.getElementById('day-picker-sheet');
    const overlay = document.getElementById('day-picker-overlay');
    const content = document.getElementById('day-picker-content');
    if (!sheet || !overlay || !content) return;

    content.style.transform = ''; // reset any inline drag transform
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    overlay.classList.remove('opacity-100', 'pointer-events-auto');
    overlay.classList.add('opacity-0', 'pointer-events-none');

    setTimeout(() => {
      isDayPickerOpen = false;
      sheet.dataset.open = 'false';
      sheet.classList.add('pointer-events-none');
      unlockBodyScroll();
    }, 200);
  }

  function renderDayPicker() {
    const grid = document.getElementById('day-picker-grid');
    const monthYear = document.getElementById('day-picker-month-year');
    if (!grid || !monthYear) return;

    const year = pickerViewDate.getFullYear();
    const month = pickerViewDate.getMonth();

    const monthName = pickerViewDate.toLocaleDateString('ro-RO', { month: 'long' });
    monthYear.textContent = `${monthName.charAt(0).toUpperCase() + monthName.slice(1)} ${year}`;

    grid.innerHTML = '';

    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);

    let startDayOfWeek = firstDay.getDay() - 1;
    if (startDayOfWeek === -1) startDayOfWeek = 6;

    for (let i = 0; i < startDayOfWeek; i++) {
      const empty = document.createElement('div');
      empty.className = 'w-9 h-9';
      grid.appendChild(empty);
    }

    const todayStr = toLocalISOString(new Date());
    const selectedStr = toLocalISOString(currentDayDate);

    for (let day = 1; day <= lastDay.getDate(); day++) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = day.toString();

      const btnDate = new Date(year, month, day);
      const btnDateStr = toLocalISOString(btnDate);

      const isToday = btnDateStr === todayStr;
      const isSelected = btnDateStr === selectedStr;

      let btnClasses = 'w-9 h-9 rounded-xl text-xs font-black transition-all flex items-center justify-center ';
      if (isSelected) {
        btnClasses += 'bg-brand-primary text-text-inverse font-black shadow-sm';
      } else if (isToday) {
        btnClasses += 'border-2 border-brand-primary text-brand-primary font-black';
      } else {
        btnClasses += 'hover:bg-surface-base text-text-main';
      }

      btn.className = btnClasses;

      btn.addEventListener('click', () => {
        currentBaseDate = btnDate;
        closeDayPicker();
        loadReportStats();
        loadChartStats();
        loadUnpaidStats();
      });

      grid.appendChild(btn);
    }
  }

  function setupDayPicker() {
    const overlay = document.getElementById('day-picker-overlay');
    const prevBtn = document.getElementById('day-picker-prev-month');
    const nextBtn = document.getElementById('day-picker-next-month');
    const content = document.getElementById('day-picker-content');

    if (overlay && overlay.dataset.reportsPickerBound !== 'true') {
      overlay.dataset.reportsPickerBound = 'true';
      overlay.addEventListener('click', () => closeDayPicker());
    }

    if (prevBtn && prevBtn.dataset.reportsPickerBound !== 'true') {
      prevBtn.dataset.reportsPickerBound = 'true';
      prevBtn.addEventListener('click', () => {
        pickerViewDate.setMonth(pickerViewDate.getMonth() - 1);
        renderDayPicker();
      });
    }

    if (nextBtn && nextBtn.dataset.reportsPickerBound !== 'true') {
      nextBtn.dataset.reportsPickerBound = 'true';
      nextBtn.addEventListener('click', () => {
        pickerViewDate.setMonth(pickerViewDate.getMonth() + 1);
        renderDayPicker();
      });
    }

    if (content && content.dataset.reportsPickerBound !== 'true') {
      content.dataset.reportsPickerBound = 'true';
      let startY = 0;
      let isDragging = false;

      const resetDrag = () => {
        isDragging = false;
        content.style.transform = '';
      };

      content.addEventListener('touchstart', (e: any) => {
        startY = e.touches[0].clientY;
        isDragging = false;
      }, { passive: true });
      content.addEventListener('touchmove', (e: any) => {
        const deltaY = e.touches[0].clientY - startY;
        if (deltaY > 0) {
          isDragging = true;
          content.style.transition = 'none';
          content.style.transform = `translateY(${deltaY}px) scale(1)`;
        }
      }, { passive: true });
      content.addEventListener('touchend', (e: any) => {
        const deltaY = (e.changedTouches[0].clientY || 0) - startY;
        content.style.transition = 'transform 200ms ease-out, opacity 200ms ease-out';
        if (isDragging && deltaY > 60) {
          content.style.transform = '';
          closeDayPicker();
        } else {
          content.style.transform = 'translateY(0) scale(1)';
        }
        isDragging = false;
      });
      content.addEventListener('touchcancel', resetDrag);
    }
  }

  // ── INCOME DETAILS POPUP SHEET ────────────────────────────────
  async function openIncomeDetails(title: string, subtitle: string, startDate: string, endDate?: string, expectedTotal?: number) {
    const sheet = document.getElementById('income-details-sheet');
    const backdrop = document.getElementById('income-details-backdrop');
    const content = document.getElementById('income-details-content');
    const titleEl = document.getElementById('income-details-title');
    const subtitleEl = document.getElementById('income-details-subtitle');
    const totalEl = document.getElementById('income-details-total');
    const badgeEl = document.getElementById('income-details-count-badge');
    const listEl = document.getElementById('income-details-list');

    if (!sheet || !backdrop || !content || !listEl) return;

    if (sheet.parentElement !== document.body) {
      document.body.appendChild(sheet);
    }

    if (titleEl) titleEl.textContent = title;
    if (subtitleEl) subtitleEl.textContent = subtitle;
    if (totalEl) totalEl.innerHTML = `${expectedTotal !== undefined ? expectedTotal : '--'} <span class="text-sm font-sans font-black text-text-main">RON</span>`;
    if (badgeEl) badgeEl.textContent = 'Se încarcă...';

    listEl.innerHTML = `
      <div class="py-10 text-center space-y-2">
        <div class="w-8 h-8 border-3 border-brand-primary border-t-transparent rounded-full animate-spin mx-auto"></div>
        <p class="text-xs font-bold text-text-muted">Se caută plățile...</p>
      </div>
    `;

    // Animate open
    isIncomeDetailsOpen = true;
    sheet.dataset.open = 'true';
    sheet.classList.remove('pointer-events-none');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    backdrop.classList.add('opacity-100', 'pointer-events-auto');
    content.classList.remove('translate-y-full');
    content.classList.add('translate-y-0');
    lockBodyScroll();

    setupIncomeDetailsGestures();

    try {
      const payments = await getDetailedPayments(startDate, endDate);
      const sumTotal = payments.reduce((acc, p) => acc + p.suma, 0);
      const displayTotal = expectedTotal !== undefined && expectedTotal > 0 ? expectedTotal : sumTotal;

      if (totalEl) totalEl.innerHTML = `${displayTotal} <span class="text-sm font-sans font-black text-text-main">RON</span>`;
      if (badgeEl) badgeEl.textContent = `${payments.length} ${payments.length === 1 ? 'încasare' : 'încasări'}`;

      if (payments.length === 0) {
        listEl.innerHTML = `
          <div class="py-8 px-4 text-center rounded-2xl bg-surface-base/50 border border-dashed border-border-subtle/50 flex flex-col items-center justify-center space-y-2">
            <div class="w-12 h-12 rounded-2xl bg-surface-card flex items-center justify-center text-text-muted shadow-2xs">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-sm font-black text-text-main">Nicio încasare înregistrată</p>
            <p class="text-xs font-bold text-text-muted">Pentru această perioadă suma totală este 0 RON.</p>
          </div>
        `;
        return;
      }

      listEl.innerHTML = payments.map(p => {
        const nameParts = p.numeComplet.split(' ').filter(Boolean);
        const initials = nameParts.length >= 2 
          ? `${nameParts[0][0]}${nameParts[1][0]}`.toUpperCase() 
          : (nameParts[0]?.slice(0, 2).toUpperCase() || 'PA');

        // Belaqva = yellow (brand-primary), Ghimbav = pink (brand-secondary)
        const loc = (p.locatie || '').toLowerCase();
        const isGhimbav = loc === 'ghimbav';
        const avatarBg = isGhimbav ? 'bg-brand-secondary' : 'bg-brand-primary';
        const avatarText = isGhimbav ? 'text-white' : 'text-black';

        // Plan in Romanian
        const planRO = p.plan === 'Subscription' ? 'Abonament' : (p.plan === 'One Time' ? 'Ședință' : (p.plan || ''));

        // Metoda badge (uppercase, styled by location)
        // Date in DD.MM.YYYY Romanian format
        let dateRO = p.dataPlatii || '';
        if (dateRO && dateRO.includes('-')) {
          const parts = dateRO.split('-');
          if (parts.length === 3) dateRO = `${parts[2]}.${parts[1]}.${parts[0]}`;
        }

        return `
          <div class="p-3.5 rounded-2xl bg-surface-base border border-border-subtle/30 flex items-center justify-between gap-3 shadow-2xs hover:border-brand-primary/30 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl ${avatarBg} ${avatarText} flex items-center justify-center font-black text-sm shrink-0 shadow-sm">
                ${initials}
              </div>
              <div class="min-w-0">
                <div class="font-black text-text-main text-sm sm:text-base truncate">${p.numeComplet}</div>
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-base sm:text-lg font-black text-emerald-600">+${p.suma} RON</div>
              <div class="text-xs font-bold text-text-main">${dateRO}</div>
            </div>
          </div>
        `;
      }).join('');

    } catch (err) {
      console.error('Eroare încărcare detalii plăți:', err);
      listEl.innerHTML = `
        <div class="p-4 rounded-2xl bg-rose-50 text-rose-700 text-xs font-bold text-center">
          Eroare la încărcarea plăților. Te rugăm să încerci din nou.
        </div>
      `;
    }
  }

