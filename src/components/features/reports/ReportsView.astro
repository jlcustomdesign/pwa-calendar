---
// ReportsView.astro — Statistici Utile & Pragmatice (Azi, Săptămânal, Lunar)
---

<div class="space-y-7">

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 1. STATISTICI ZILNICE (AZI)                              -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-3">
    <div class="flex items-baseline justify-between px-1">
      <h2 class="text-xl sm:text-2xl font-black text-text-main">Azi</h2>
      <span id="today-date-display" class="text-xl sm:text-2xl font-black text-text-main">--</span>
    </div>

    <div class="grid grid-cols-3 gap-3">
      <!-- Card 1: Ședințe -->
      <div class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div class="flex items-baseline gap-1">
          <span id="today-done" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</span>
          <span class="text-xl font-bold text-text-muted opacity-40">/</span>
          <span id="today-total" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</span>
        </div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Ședințe</div>
      </div>

      <!-- Card 2: Absent -->
      <div class="bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div id="today-absent" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Absent</div>
      </div>

      <!-- Card 3: Încasat azi -->
      <div class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div id="today-income" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">RON</div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 2. STATISTICI SĂPTĂMÂNALE (cu Grafic Hașurat & Interactiv)-->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-3">
    <div class="px-1">
      <h2 class="text-xl sm:text-2xl font-black text-text-main">Săptămânal</h2>
    </div>

    <div class="space-y-3">

      <!-- Card Grafic Hașurat (Smooth Curved Line Chart cu Punct Roz Interactiv pe Zile) -->
      <div class="bg-surface-card rounded-[2.2rem] p-5 shadow-sm border border-border-subtle/70 space-y-4">
        
        <!-- Header Grafic -->
        <div>
          <div class="text-xs font-extrabold uppercase tracking-wider text-text-muted">Evoluție săptămânală</div>
          <div id="chart-active-value" class="text-2xl sm:text-3xl font-black text-text-main mt-0.5 transition-all">
            0 <span class="text-sm font-sans font-black text-text-main">RON</span>
          </div>
        </div>

        <!-- SVG Smooth Area Chart cu Hașură (Hatch Pattern) -->
        <div class="relative w-full h-36">
          <svg viewBox="0 0 350 120" class="w-full h-full overflow-visible" preserveAspectRatio="none">
            <defs>
              <!-- Hașură diagonală neagră/subtilă (Diagonal Hatch Pattern) -->
              <pattern id="hatch-pattern" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="8" stroke="rgb(var(--color-text-main))" stroke-width="1.5" opacity="0.25" />
              </pattern>

              <!-- Soft Gradient de fond -->
              <linearGradient id="soft-bg-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgb(var(--color-brand-primary))" stop-opacity="0.2" />
                <stop offset="100%" stop-color="rgb(var(--color-surface-card))" stop-opacity="0.0" />
              </linearGradient>
            </defs>

            <!-- Fundal Gradient Soft sub curbă -->
            <path
              id="chart-path-gradient"
              d="M 10,85 C 50,80 80,45 105,45 C 140,45 160,30 175,30 C 205,30 225,52 245,52 C 275,52 300,15 340,12 L 340,105 L 10,105 Z"
              fill="url(#soft-bg-gradient)"
            />

            <!-- Zone Hașurată sub curbă -->
            <path
              id="chart-path-hatch"
              d="M 10,85 C 50,80 80,45 105,45 C 140,45 160,30 175,30 C 205,30 225,52 245,52 C 275,52 300,15 340,12 L 340,105 L 10,105 Z"
              fill="url(#hatch-pattern)"
            />

            <!-- Linia curbată neagră fluidă (Curved Stroke) -->
            <path
              id="chart-path-stroke"
              d="M 10,85 C 50,80 80,45 105,45 C 140,45 160,30 175,30 C 205,30 225,52 245,52 C 275,52 300,15 340,12"
              fill="none"
              stroke="rgb(var(--color-text-main))"
              stroke-width="3"
              stroke-linecap="round"
            />

            <!-- Doar Punctul Roz Activ (Fără Linii Întrerupte) -->
            <circle id="pink-dot-glow" cx="245" cy="52" r="7" fill="rgb(var(--color-brand-secondary))" opacity="0.3" class="transition-all duration-300" />
            <circle id="pink-dot" cx="245" cy="52" r="5" fill="rgb(var(--color-brand-secondary))" stroke="#ffffff" stroke-width="2.5" class="transition-all duration-300 shadow-md" />
          </svg>
        </div>

        <!-- Etichete axa X (Zilele de lucru: L M M J V — mult mai mari și mai îngroșate) -->
        <div class="flex items-center justify-between px-2 text-xl sm:text-2xl font-black text-text-main">
          <button type="button" data-day-idx="0" data-val="0 RON" class="day-btn hover:text-brand-secondary transition-colors cursor-pointer py-1 px-2">L</button>
          <button type="button" data-day-idx="1" data-val="0 RON" class="day-btn hover:text-brand-secondary transition-colors cursor-pointer py-1 px-2">M</button>
          <button type="button" data-day-idx="2" data-val="0 RON" class="day-btn hover:text-brand-secondary transition-colors cursor-pointer py-1 px-2">M</button>
          <button type="button" data-day-idx="3" data-val="0 RON" class="day-btn text-brand-secondary font-black transition-colors cursor-pointer py-1 px-2">J</button>
          <button type="button" data-day-idx="4" data-val="0 RON" class="day-btn hover:text-brand-secondary transition-colors cursor-pointer py-1 px-2">V</button>
        </div>

      </div>

      <!-- Card 1: Timp activ vs. anulări -->
      <div class="bg-surface-card rounded-[2.2rem] p-5 shadow-sm border border-border-subtle/70 space-y-3">
        <!-- Bară de progres duală -->
        <div class="w-full h-3.5 bg-surface-base rounded-full overflow-hidden flex items-center p-0.5 border border-border-subtle/40">
          <div id="week-progress-bar" class="h-full bg-brand-primary rounded-full transition-all duration-1000" style="width: 100%"></div>
          <div id="week-cancel-bar" class="h-full bg-brand-secondary/80 rounded-full transition-all duration-1000 ml-0.5" style="width: 0%"></div>
        </div>

        <!-- Procent + "timp activ" în negru -->
        <div>
          <div class="text-2xl sm:text-3xl font-black text-text-main">
            <span id="week-active-time">100%</span> <span class="text-base sm:text-lg font-black text-text-main">timp activ</span>
          </div>
        </div>

        <!-- Dedesubt: anulări -->
        <div>
          <div class="text-2xl sm:text-3xl font-black text-text-main">
            <span id="week-cancel-time">0%</span> <span class="text-base sm:text-lg font-black text-text-main">anulări</span>
          </div>
        </div>
      </div>

      <!-- 2 Carduri Separate pentru Pacienți Neachitați -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Card 1: Număr Pacienți Neachitați -->
        <a
          href="/dashboard/patients"
          class="block bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40 group active:scale-[0.98]"
        >
          <div id="unpaid-count" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
          <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Neachitați</div>
        </a>

        <!-- Card 2: Sumă Totală Restanță -->
        <a
          href="/dashboard/patients"
          class="block bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40 group active:scale-[0.98]"
        >
          <div id="unpaid-total" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</div>
          <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">RON neachitați</div>
        </a>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- 3. STATISTICI LUNARE (Venit & Volum Ședințe)            -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section class="space-y-3">
    <div class="px-1">
      <h2 class="text-xl sm:text-2xl font-black text-text-main">Lunar</h2>
    </div>

    <!-- 2 Carduri Separate pentru Lunar -->
    <div class="grid grid-cols-2 gap-3">
      <!-- Card 1: Venit Lunar -->
      <div class="bg-surface-card rounded-tl-[2.2rem] rounded-br-[2.2rem] rounded-tr-md rounded-bl-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div id="month-income" class="text-3xl sm:text-4xl font-black text-text-main tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">RON</div>
      </div>

      <!-- Card 2: Ședințe Făcute Lunar -->
      <div class="bg-surface-card rounded-tr-[2.2rem] rounded-bl-[2.2rem] rounded-tl-md rounded-br-md p-4 shadow-sm border border-border-subtle/70 flex flex-col items-center justify-center text-center transition-all hover:border-brand-secondary/40">
        <div id="month-sessions" class="text-3xl sm:text-4xl font-black text-brand-secondary tracking-tight leading-none">0</div>
        <div class="text-sm sm:text-base font-sans font-black text-text-main leading-tight mt-2">Ședințe făcute</div>
      </div>
    </div>
  </section>

</div>

<script>
  import { getTodayStats, getWeekStats, getMonthStats, getUnpaidPatients } from '../../../lib/services/reportsService';

  async function initReportsView() {
    try {
      const today = await getTodayStats();
      const week = await getWeekStats();
      const month = await getMonthStats();
      const unpaid = await getUnpaidPatients();

      // Update Date Display
      const todayDateDisplay = document.getElementById('today-date-display');
      if (todayDateDisplay) {
        const d = new Date();
        const dayName = d.toLocaleDateString('ro-RO', { weekday: 'long' });
        const dayNameCap = dayName.charAt(0).toUpperCase() + dayName.slice(1);
        const dayNum = d.getDate().toString().padStart(2, '0');
        const monthName = d.toLocaleDateString('ro-RO', { month: 'long' });
        const monthNameCap = monthName.charAt(0).toUpperCase() + monthName.slice(1);
        todayDateDisplay.textContent = `${dayNameCap}, ${dayNum} ${monthNameCap}`;
      }

      // Update Today
      const todayDone = document.getElementById('today-done');
      const todayTotal = document.getElementById('today-total');
      const todayAbsent = document.getElementById('today-absent');
      const todayIncome = document.getElementById('today-income');

      if (todayDone) todayDone.textContent = today.finalizate.toString();
      if (todayTotal) todayTotal.textContent = today.sedinte_total.toString();
      if (todayAbsent) todayAbsent.textContent = today.absente.toString();
      if (todayIncome) todayIncome.textContent = today.venit_azi.toString();

      // Update Unpaid
      const unpaidCount = document.getElementById('unpaid-count');
      const unpaidTotal = document.getElementById('unpaid-total');
      if (unpaidCount) unpaidCount.textContent = unpaid.count.toString();
      if (unpaidTotal) unpaidTotal.textContent = unpaid.totalRON.toString();

      // Update Month
      const monthIncome = document.getElementById('month-income');
      const monthSessions = document.getElementById('month-sessions');
      if (monthIncome) monthIncome.textContent = month.venit.toString();
      if (monthSessions) monthSessions.textContent = month.finalizate.toString();

      // Update Week Time active
      const weekActiveTime = document.getElementById('week-active-time');
      const weekCancelTime = document.getElementById('week-cancel-time');
      const weekProgressBar = document.getElementById('week-progress-bar');
      const weekCancelBar = document.getElementById('week-cancel-bar');

      if (weekActiveTime) weekActiveTime.textContent = `${week.prezenta}%`;
      if (weekCancelTime) weekCancelTime.textContent = `${100 - week.prezenta}%`;
      if (weekProgressBar) weekProgressBar.style.width = `${week.prezenta}%`;
      if (weekCancelBar) weekCancelBar.style.width = `${100 - week.prezenta}%`;

      // Update Chart with Real Data
      initInteractiveHatchChart(week.byDay, week.startStr);

    } catch (e) {
      console.error('Eroare încărcare rapoarte Supabase:', e);
    }
  }

  function initInteractiveHatchChart(byDay?: Record<string, any>, startStr?: string) {
    const dayBtns = document.querySelectorAll('.day-btn');
    const dot = document.getElementById('pink-dot');
    const dotGlow = document.getElementById('pink-dot-glow');
    const valueDisplay = document.getElementById('chart-active-value');

    const pathGradient = document.getElementById('chart-path-gradient');
    const pathHatch = document.getElementById('chart-path-hatch');
    const pathStroke = document.getElementById('chart-path-stroke');

    if (!dot || !dotGlow || !valueDisplay || dayBtns.length === 0) return;

    // FĂRĂ DATE DIN BURTĂ: Dacă nu există date sau totul e 0, afișăm 0 RON
    let chartDays = [0, 0, 0, 0, 0]; 
    if (byDay && startStr) {
      const start = new Date(startStr);
      chartDays = [];
      for(let i=0; i<5; i++) {
        const d = new Date(start);
        d.setDate(d.getDate() + i);
        const dateStr = d.toISOString().split('T')[0];
        chartDays.push(byDay[dateStr]?.venit || 0);
      }
    }

    const maxVal = Math.max(...chartDays, 100);
    const minY = 105;
    const maxY = 15;
    const xCoords = [15, 95, 175, 255, 335];

    const points = chartDays.map((val, i) => {
      const y = minY - (val / maxVal) * (minY - maxY);
      return { x: xCoords[i], y, val };
    });

    // Generate Smooth SVG Path (Bezier Curves)
    let strokePath = `M ${points[0].x},${points[0].y}`;
    for(let i=0; i<points.length - 1; i++) {
      const p1 = points[i];
      const p2 = points[i+1];
      const cx1 = p1.x + (p2.x - p1.x) / 2;
      const cy1 = p1.y;
      const cx2 = p1.x + (p2.x - p1.x) / 2;
      const cy2 = p2.y;
      strokePath += ` C ${cx1},${cy1} ${cx2},${cy2} ${p2.x},${p2.y}`;
    }
    const fillPath = strokePath + ` L ${points[4].x},115 L ${points[0].x},115 Z`;

    // Apply paths to SVG elements
    if (pathStroke) pathStroke.setAttribute('d', strokePath);
    if (pathGradient) pathGradient.setAttribute('d', fillPath);
    if (pathHatch) pathHatch.setAttribute('d', fillPath);

    // Prepare day coordinates for click interaction
    const dayCoords = points.map(p => ({
      cx: p.x,
      cy: p.y,
      val: `${p.val} <span class="text-sm font-sans font-black text-text-main">RON</span>`
    }));

    // Initially select current day if weekday, else fallback to latest day
    const currentDayIdx = Math.min(Math.max(new Date().getDay() - 1, 0), 4);
    let activeBtnIdx = currentDayIdx;

    dayBtns.forEach((btn, idx) => {
      const clone = btn.cloneNode(true);
      btn.parentNode?.replaceChild(clone, btn);
      
      clone.addEventListener('click', () => {
        const coord = dayCoords[idx];
        if (coord) {
          dot.setAttribute('cx', coord.cx.toString());
          dot.setAttribute('cy', coord.cy.toString());
          dotGlow.setAttribute('cx', coord.cx.toString());
          dotGlow.setAttribute('cy', coord.cy.toString());
          valueDisplay.innerHTML = coord.val;

          document.querySelectorAll('.day-btn').forEach(b => {
            b.classList.remove('text-brand-secondary', 'font-black');
            b.classList.add('text-text-muted');
          });
          (clone as Element).classList.remove('text-text-muted');
          (clone as Element).classList.add('text-brand-secondary', 'font-black');
        }
      });
    });

    // Trigger initial selection
    const newDayBtns = document.querySelectorAll('.day-btn');
    if (newDayBtns[activeBtnIdx]) {
      newDayBtns[activeBtnIdx].dispatchEvent(new Event('click'));
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initReportsView();
  });
  document.addEventListener('astro:page-load', () => {
    initReportsView();
  });
</script>
