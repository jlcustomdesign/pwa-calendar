---
// SettingsHub.astro - Meniu principal cu carduri capsule ultra-curate (fără subtitluri)
---

<div class="space-y-4">

  <!-- 1. Card Profil Principal -->
  <a
    href="/dashboard/settings?section=profile"
    class="block bg-surface-card rounded-[2.5rem] p-6 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-brand-secondary text-white font-extrabold text-xl flex items-center justify-center shadow-md shadow-brand-secondary/30 shrink-0">
          DM
        </div>
        <div>
          <h2 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Dr. Maria</h2>
        </div>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 2. Program de lucru -->
  <a
    href="/dashboard/settings?section=schedule"
    class="block bg-surface-card rounded-[2.5rem] p-6 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Program de lucru</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-primary group-hover:text-black transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 3. Pauza de masă -->
  <a
    href="/dashboard/settings?section=break"
    class="block bg-surface-card rounded-[2.5rem] p-6 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Pauza de masă</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 4. Ședințe & pachete (Featured Galben Cald) -->
  <a
    href="/dashboard/settings?section=packages"
    class="block bg-brand-primary text-black rounded-[2.5rem] p-6 shadow-md shadow-amber-500/10 hover:brightness-105 active:scale-[0.98] transition-all relative overflow-hidden group border border-black/10"
  >
    <!-- Watermark Background Graphic -->
    <div class="absolute -right-4 -bottom-6 font-black text-[6.5rem] leading-none opacity-15 pointer-events-none tracking-tighter mix-blend-overlay select-none">
      RON
    </div>

    <div class="flex items-center justify-between relative z-10">
      <div>
        <h3 class="text-xl font-extrabold text-black">Ședințe & pachete</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-black/15 flex items-center justify-center text-black shrink-0 group-hover:bg-black group-hover:text-brand-primary transition-colors backdrop-blur-md">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 5. Categorii pacienți -->
  <a
    href="/dashboard/settings?section=categories"
    class="block bg-surface-card rounded-[2.5rem] p-6 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Categorii pacienți</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 6. Reminder-e & notificări (Featured Roz Intens) -->
  <a
    href="/dashboard/settings?section=reminders"
    class="block bg-brand-secondary text-white rounded-[2.5rem] p-6 shadow-md shadow-brand-secondary/20 hover:brightness-105 active:scale-[0.98] transition-all relative overflow-hidden group border border-white/10"
  >
    <!-- Watermark Background Graphic -->
    <div class="absolute -right-4 -bottom-6 font-black text-[6.5rem] leading-none opacity-15 pointer-events-none tracking-tighter mix-blend-overlay select-none">
      SMS
    </div>

    <div class="flex items-center justify-between relative z-10">
      <div>
        <h3 class="text-xl font-bold text-white">Reminder-e & notificări</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:bg-white group-hover:text-brand-secondary transition-colors backdrop-blur-md">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 7. Acțiune rapidă separat vizuală -->
  <div class="pt-2">
    <button
      type="button"
      id="btn-recalculate-week-hub"
      class="w-full py-4 px-6 rounded-[2.5rem] border-2 border-brand-secondary/70 hover:border-brand-secondary text-brand-secondary font-extrabold text-sm bg-transparent hover:bg-brand-secondary/10 active:scale-[0.98] transition-all flex items-center justify-center gap-2"
    >
      <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span>Recalculează săptămâna curentă</span>
    </button>
  </div>

</div>

<script>
  function initHubLogic() {
    const btn = document.getElementById('btn-recalculate-week-hub');
    btn?.addEventListener('click', () => {
      alert('Săptămâna curentă a fost recalculată cu succes!');
    });
  }

  document.addEventListener('DOMContentLoaded', initHubLogic);
  document.addEventListener('astro:page-load', initHubLogic);
</script>
