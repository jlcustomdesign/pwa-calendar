---
// SettingsHub.astro - Meniu principal cu carduri capsule ultra-curate (fără subtitluri)
---

<div class="space-y-4">

  <!-- 1. Card Profil Principal -->
  <a
    href="/dashboard/settings?section=profile"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-full bg-brand-secondary text-white font-extrabold text-base flex items-center justify-center shadow-md shadow-brand-secondary/25 shrink-0">
          RV
        </div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Profil</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 2. Program de lucru -->
  <a
    href="/dashboard/settings?section=schedule"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Program de lucru</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-primary group-hover:text-black transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 3. Pauza de masă -->
  <a
    href="/dashboard/settings?section=break"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Pauza de masă</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 4. Ședințe -->
  <a
    href="/dashboard/settings?section=packages"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Ședințe</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 5. Categorii pacienți -->
  <a
    href="/dashboard/settings?section=categories"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Categorii pacienți</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 6. Reminder și mesaj -->
  <a
    href="/dashboard/settings?section=reminders"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Reminder și mesaj</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 7. Backup -->
  <a
    href="/dashboard/settings?section=backup"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Backup</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-brand-secondary group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 8. Jurnal erori -->
  <a
    href="/dashboard/settings?section=logs"
    class="block bg-surface-card rounded-full py-3 pl-6 pr-3 shadow-sm hover:shadow-md active:scale-[0.98] transition-all group border border-border-subtle/50"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 font-extrabold text-base flex items-center justify-center shadow-sm shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-text-main group-hover:text-brand-secondary transition-colors">Jurnal erori</h3>
      </div>

      <div class="w-10 h-10 rounded-full bg-surface-base flex items-center justify-center text-text-muted group-hover:bg-rose-600 group-hover:text-white transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 9. Deconectare (Logout) -->
  <div class="pt-5 flex justify-center">
    <button
      type="button"
      id="btn-logout"
      class="inline-flex items-center gap-3 px-7 py-3.5 rounded-full text-rose-500/90 hover:text-rose-600 hover:bg-rose-500/10 font-extrabold text-lg sm:text-xl transition-all active:scale-95 cursor-pointer border border-rose-500/25"
    >
      <svg class="w-6 h-6 stroke-[2.3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span>Deconectare</span>
    </button>
  </div>

</div>
