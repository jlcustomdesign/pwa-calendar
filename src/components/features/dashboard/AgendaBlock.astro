---
import SessionCard from './SessionCard.astro';
import DailyProgress from './DailyProgress.astro';
---

<div class="bg-surface-card rounded-[2.5rem] p-6 shadow-sm">
  
  <div id="daily-progress-container" class="space-y-2 mb-6 px-2">
    <div class="flex items-center justify-between text-sm font-medium">
      <span class="text-text-main font-semibold">Progres Zilnic</span>
      <span id="daily-progress-text" class="text-text-muted">0 din 0 ședințe</span>
    </div>
    <div class="h-3 w-full bg-black/5 rounded-full overflow-hidden">
      <div id="daily-progress-bar" class="h-full bg-brand-primary rounded-full transition-all duration-500" style="width: 0%"></div>
    </div>
  </div>


  <!-- Daily Sessions List -->
  <div id="agenda-sessions-list" class="flex flex-col gap-4 pb-2">
    <!-- Populated by JS -->
  </div>

  <!-- Skeleton loader: shown only while fetching from DB -->
  <div id="agenda-skeleton" class="hidden flex flex-col gap-4 pb-2">
    <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
    <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
    <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  </div>
</div>
<script>
  import { getAppointmentsByDate } from '../../../lib/services/appointmentService';
  import { getPatientPayments, resetPatientSubscription } from '../../../lib/services/patientService';

  (window as any).renewSubscription = (window as any).renewSubscription || (async (patientId: string, totalSessions: number) => {
    try {
      await resetPatientSubscription(patientId, totalSessions);
      (window as any).showToast?.('Abonamentul a fost reînnoit! Ședințele au fost reluate de la 0.', 'success');
      window.dispatchEvent(new CustomEvent('patientsUpdated'));
      window.dispatchEvent(new CustomEvent('sessionsUpdated'));
    } catch (err: any) {
      (window as any).showToast?.('Eroare la reînnoire: ' + (err?.message || err), 'error');
    }
  });

  const _d = new Date();
  const todayStr = _d.getFullYear() + '-' + String(_d.getMonth() + 1).padStart(2, '0') + '-' + String(_d.getDate()).padStart(2, '0');
  let currentAgendaDate = todayStr;
  let lastFetchedSessions: any[] = [];
  const autoPromptedSessions = new Set<string>();

  window.addEventListener('calendarDateSelected', (e: any) => {
    const date = e.detail?.date;
    if (date) {
      currentAgendaDate = date;
      (window as any).currentCalendarDate = date;
      renderAgendaBlock();
    }
  });


  async function renderAgendaBlock() {
    const list = document.getElementById('agenda-sessions-list');
    const skeleton = document.getElementById('agenda-skeleton');
    if (!list) return;

    // Render instant cache first to prevent mobile delay
    const cacheKey = `kineto_agenda_cache_${currentAgendaDate}`;
    let usedCache = false;
    try {
      const rawCache = localStorage.getItem(cacheKey);
      if (rawCache && list.children.length === 0) {
        const cachedSessions = JSON.parse(rawCache);
        if (Array.isArray(cachedSessions) && cachedSessions.length > 0) {
          drawAgendaSessionsList(list, cachedSessions);
          usedCache = true;
        }
      }
    } catch (e) {}

    // Show skeleton only while fetching from DB (hide cached content temporarily if no cache)
    if (skeleton) {
      if (!usedCache) {
        list.classList.add('hidden');
        skeleton.classList.remove('hidden');
      } else {
        skeleton.classList.add('hidden');
      }
    }

    const now = new Date();
    const nowStr = now.toTimeString().slice(0, 5);
    const isToday = currentAgendaDate === todayStr;
    let stored: any[] = [];
    try {
      const appts = await getAppointmentsByDate(currentAgendaDate);
      stored = await Promise.all(appts.map(async (a: any) => {
        const sumaIncasata = await getPatientPayments(a.pacient_id);
        const costTotal = Number(a.pacienti?.cost || 0);
        const folosite = a.pacienti?.sedinte_folosite ?? 0;
        const totalSess = a.pacienti?.sedinte_total || 10;
        const sedinteRamase = Math.max(0, totalSess - folosite);
        const costPerSession = totalSess > 0 ? (costTotal / totalSess) : costTotal;
        const sedintePlatite = costPerSession > 0 ? Math.floor(sumaIncasata / costPerSession) : 0;

        let pStatus = 'Neachitat';
        if (a.pacienti?.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal)) {
          pStatus = 'Achitat integral';
        } else if (sumaIncasata > 0) {
          pStatus = 'Achitat parțial';
        } else if (a.pacienti?.status_plata) {
          pStatus = a.pacienti.status_plata;
        }

        return {
          id: a.id,
          patientId: a.pacient_id,
          patientName: a.pacienti ? `${a.pacienti.prenume} ${a.pacienti.nume}` : 'Pacient',
          selectedTime: a.ora,
          selectedDate: a.data,
          location: a.pacienti?.locatie || 'Belaqva',
          attendanceCount: folosite,
          totalSessions: totalSess,
          remainingSessions: sedinteRamase,
          subscriptionDone: totalSess > 0 && folosite > 0 && folosite >= totalSess,
          status: a.status || 'programat',
          paymentStatus: pStatus,
          costTotal,
          sumaIncasata
        };
      }));
    } catch (e) {
      console.error('Eroare citire agenda din DB:', e);
    }

    // Hide skeleton and reveal list after DB fetch completes
    if (skeleton) skeleton.classList.add('hidden');
    list.classList.remove('hidden');

    lastFetchedSessions = stored;
    try {
      if (stored.length > 0) {
        localStorage.setItem(cacheKey, JSON.stringify(stored));
      }
    } catch (e) {}

    // Calculate selected day's progress dynamically
    const daySessions = stored.filter((s: any) => !s.selectedDate || s.selectedDate === currentAgendaDate);
    const totalToday = daySessions.length;
    const completedToday = daySessions.filter((s: any) => {
      if (currentAgendaDate < todayStr) return true;
      if (currentAgendaDate > todayStr) return false;
      return (s.selectedTime || s.time || "00:00") <= nowStr;
    }).length;
    const todayProgressPct = totalToday > 0 ? Math.min(100, Math.round((completedToday / totalToday) * 100)) : 0;

    const progressText = document.getElementById('daily-progress-text');
    const progressBar = document.getElementById('daily-progress-bar');
    if (progressText) progressText.textContent = `${completedToday} din ${totalToday} ședințe`;
    if (progressBar) progressBar.style.width = `${todayProgressPct}%`;

    if (stored.length === 0) {
      const emptyDay = currentAgendaDate === todayStr ? 'azi' : 'această zi';
      list.innerHTML = `<p class="text-sm font-bold text-text-muted text-center py-4">Nicio ședință programată pentru ${emptyDay}.</p>`;
      return;
    }

    const getSessionCategory = (session: any) => {
      const timeStr = session.selectedTime || "08:00";
      const timeParts = timeStr.split(':');
      const hourNum = parseInt(timeParts[0] || "0", 10);
      const minute = timeParts[1] || "00";
      const endTime = `${(hourNum + 1).toString().padStart(2, '0')}:${minute}`;

      const isOngoing = isToday && nowStr >= timeStr && nowStr < endTime;
      const isPast = currentAgendaDate < todayStr || (isToday && nowStr >= endTime);

      if (isOngoing) return 0; // Ongoing comes first
      if (!isPast) return 1;   // Upcoming comes second
      return 2;                // Past comes at bottom
    };

    const sorted = [...stored].sort((a: any, b: any) => {
      const catA = getSessionCategory(a);
      const catB = getSessionCategory(b);
      if (catA !== catB) return catA - catB;
      const timeA = a.selectedTime || "08:00";
      const timeB = b.selectedTime || "08:00";
      return timeA.localeCompare(timeB);
    });

    list.innerHTML = sorted.map((session: any) => {
      const locationStr = session.location || "Belaqva";
      const isGhimbav = locationStr.toLowerCase() === "ghimbav";
      const cardClasses = isGhimbav ? "bg-brand-secondary text-white" : "bg-brand-primary text-black";
      const gradientColors = isGhimbav ? "from-white/30 to-white" : "from-black/30 to-black";
      const count = session.attendanceCount ?? 0;
      const totalSess = session.totalSessions || 10;
      const remainingSessions = session.remainingSessions ?? Math.max(0, totalSess - count);
      const isTerminat = session.subscriptionDone || (totalSess > 0 && count > 0 && count >= totalSess);
      const displayCount = isTerminat ? totalSess : count;
      const progressPercentage = isTerminat ? 100 : (totalSess > 0 ? Math.min(100, Math.round((count / totalSess) * 100)) : 0);
      const progressBarFill = isGhimbav ? "bg-brand-primary" : "bg-brand-secondary";
      const progressBarTrack = isGhimbav ? "bg-black/20" : "bg-black/15";

      const timeStr = session.selectedTime || "08:00";
      const patientNameStr = session.patientName || "Pacient";
      const cleanTimeStr = (session.selectedTime || '08:00').substring(0, 5);
      const timeParts = cleanTimeStr.split(':');
      const startH = parseInt(timeParts[0] || "8", 10);
      const startM = parseInt(timeParts[1] || "0", 10);
      const totalStartMin = startH * 60 + startM;
      const totalEndMin = totalStartMin + 50; // 50 min session duration
      const endH = Math.floor(totalEndMin / 60);
      const endM = totalEndMin % 60;
      const formattedStart = `${startH}:${startM.toString().padStart(2, '0')}`;
      const formattedEnd = `${endH}:${endM.toString().padStart(2, '0')}`;
      const timeRangeText = `${formattedStart} - ${formattedEnd}`;

      const sessionStatus = session.status || 'programat';
      const isOngoing = isToday && nowStr >= cleanTimeStr && nowStr < `${endH.toString().padStart(2, '0')}:${endM.toString().padStart(2, '0')}`;
      const isPast = currentAgendaDate < todayStr || (isToday && nowStr >= `${endH.toString().padStart(2, '0')}:${endM.toString().padStart(2, '0')}`);
      const paymentStatus = session.paymentStatus || 'Neachitat';

      // Icon-only status indicator for closed state
      // Bifa verde apare DOAR după confirmare (status = finalizat), nu doar pentru că a trecut ora.
      let statusIcon = '';
      if (sessionStatus === 'absent') {
        statusIcon = `<svg class="w-6 h-6 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
      } else if (sessionStatus === 'anulat') {
        statusIcon = `<svg class="w-6 h-6 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
      } else if (sessionStatus === 'finalizat') {
        statusIcon = `<svg class="w-6 h-6 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>`;
      } else if (isOngoing) {
        statusIcon = `<svg class="w-7 h-7 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      }

      // Subscription warning shown only in open state
      const subscriptionWarningDetails = session.subscriptionDone
        ? `<div class="pb-3"><button type="button" class="w-full py-4 px-6 rounded-2xl bg-brand-secondary text-black text-sm sm:text-base font-black uppercase tracking-wider text-center shadow-md border border-transparent hover:opacity-90 active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5" onclick="event.stopPropagation(); window.renewSubscription('${session.patientId}', ${session.totalSessions || 10})"><span>REÎNNOIEȘTE PACHETUL</span></button></div>`
        : '';

      const restDePlata = Math.max(0, (session.costTotal || 0) - (session.sumaIncasata || 0));
      const isPaid = restDePlata <= 0 || session.paymentStatus === 'Achitat integral' || session.paymentStatus === 'Achitat';

      const sumaIncasata = session.sumaIncasata || 0;
      const costTotal = session.costTotal || 0;

      let paymentBadgeClass = 'bg-white hover:bg-neutral-50 text-black border border-transparent font-extrabold shadow-sm';
      let displayPaymentLabel = 'Status plată';

      if (sumaIncasata > 0 && restDePlata > 0) {
        // Plată parțială — doar suma/total
        displayPaymentLabel = `${sumaIncasata}/${costTotal} RON`;
        paymentBadgeClass = 'bg-orange-100 hover:bg-orange-200 text-black border border-transparent font-extrabold shadow-sm';
      } else if (isPaid || paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat' || (costTotal > 0 && sumaIncasata >= costTotal)) {
        displayPaymentLabel = 'Achitat';
        paymentBadgeClass = 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-transparent font-extrabold shadow-sm';
      } else if (paymentStatus === 'Neachitat' || sumaIncasata === 0) {
        displayPaymentLabel = 'Neachitat';
        paymentBadgeClass = 'bg-white hover:bg-neutral-50 text-black border border-transparent font-extrabold shadow-sm';
      }

      const driveLink = session.driveLink || session.patientDriveLink || '';

      return `
        <session-card class="block relative rounded-[2.5rem] shadow-sm overflow-hidden mx-1 md:mx-5">
          <div class="absolute inset-0 bg-neutral-100 flex items-center justify-end px-6 z-0">
            <div class="flex items-center gap-3">
              <button 
                type="button" 
                class="w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent"
                onclick="window.editSession('${session.id}'); event.stopPropagation();"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
              </button>
              <button 
                type="button" 
                class="w-12 h-12 rounded-full bg-orange-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform"
                onclick="window.cancelSession('${session.id}'); event.stopPropagation();"
                title="Marchează ca Anulat/Absent"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
              </button>
              <button 
                type="button" 
                class="w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform"
                onclick="window.deleteSession('${session.id}'); event.stopPropagation();"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </div>

          <div class="swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}">

            <div class="card-summary relative z-20 flex flex-col justify-between cursor-pointer transition-transform active:scale-[0.98] min-h-[110px] p-6">
              
              <!-- Watermark Time Background -->
              <div class="absolute left-3 top-0 bottom-0 font-black text-[3.8rem] leading-[0.8] opacity-30 pointer-events-none tracking-tighter mix-blend-overlay flex items-center justify-start z-0 w-20">
                <div class="flex items-start">
                  ${startH.toString().padStart(2, '0')}
                  <span class="text-xl mt-1 ml-0.5">${startM.toString().padStart(2, '0')}</span>
                </div>
              </div>

              <div class="flex items-center gap-3 w-full relative z-10 pl-24 justify-between">
                <div class="flex-1 min-w-0">
                  <h4 class="text-xl font-bold tracking-tight leading-none truncate">${patientNameStr}</h4>
                </div>
                ${statusIcon}
              </div>

              <div class="flex items-center gap-4 mt-5 relative z-10 pl-24">
                <div class="h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative">
                  <div class="h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out" style="width: ${progressPercentage}%;"></div>
                </div>
                <div class="text-xs font-bold tracking-wide opacity-90 shrink-0">${displayCount}/${totalSess}</div>
              </div>
            </div>

            <div class="card-details grid transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" style="grid-template-rows: 0fr;">
              <div class="overflow-hidden relative z-20">
                ${subscriptionWarningDetails}
                
                <div class="px-6 pt-2 pb-2 space-y-3">
                  <!-- Row 1: White Pill with Black Text & Icons for Time & Location -->
                  <div class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white text-black text-sm sm:text-base font-extrabold shadow-sm border border-transparent">
                    <span class="flex items-center gap-1.5 shrink-0 text-black">
                      <svg class="w-4 h-4 text-black opacity-75 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span class="text-black font-black">${timeRangeText}</span>
                    </span>
                    <span class="flex items-center gap-1.5 shrink-0 text-black">
                      <svg class="w-4 h-4 text-black opacity-75 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <span class="text-black font-black">${locationStr}</span>
                    </span>
                  </div>

                  <!-- Row 2: Payment Badge on Left (Spacious px-6 padding) + Icon-only Call/Folder Buttons on Right -->
                  <div class="flex items-center justify-between pt-0.5 gap-4">
                    <button 
                      type="button"
                      class="h-11 flex items-center justify-center px-4 rounded-2xl ${paymentBadgeClass} hover:opacity-90 active:scale-95 transition-all text-sm sm:text-base font-black cursor-pointer shadow-sm" 
                      onclick="event.stopPropagation(); window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: '${session.patientId}' } }))"
                    >
                      <span>${displayPaymentLabel}</span>
                    </button>

                    <div class="flex items-center gap-2 shrink-0">
                      <a href="tel:${session.patientPhone || '+1234567890'}" class="w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer" title="Sună pacientul" onclick="event.stopPropagation()">
                        <svg class="w-5 h-5 text-black opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                      </a>

                      <a href="${driveLink || '#'}" target="${driveLink ? '_blank' : '_self'}" rel="noopener noreferrer" class="w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer" title="Deschide Dosar/Drive" onclick="event.stopPropagation(); if (!'${driveLink}') { event.preventDefault(); if (window.showToast) { window.showToast('Pacientul nu are un link de dosar/Drive salvat.', 'info'); } else { alert('Pacientul nu are un link de dosar/Drive salvat.'); } }">
                        <svg class="w-5 h-5 text-black opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>

                ${sessionStatus !== 'finalizat' && sessionStatus !== 'anulat' && sessionStatus !== 'absent' ? `
                  <div class="px-6 pb-5 pt-2">
                    <button type="button" class="w-full h-11 rounded-2xl ${isGhimbav ? 'bg-brand-primary hover:opacity-90' : 'bg-brand-secondary hover:opacity-90'} text-black font-black text-xs sm:text-sm tracking-wider uppercase active:scale-95 transition-transform shadow-md flex items-center justify-center cursor-pointer border border-transparent" onclick="event.stopPropagation(); window.confirmSession('${session.id}')">
                      <span>CONFIRMĂ ȘEDINȚA</span>
                    </button>
                  </div>
                ` : ''}
              </div>
            </div>
          </div>
        </session-card>
      `;
    }).join('');
  }

  function checkAutoPromptAndProgress() {
    if (currentAgendaDate !== todayStr) return;
    
    const now = new Date();
    const nowStr = now.toTimeString().slice(0, 5);
    
    // We only trigger auto-prompt if there are active sessions that just ended
    let shouldRender = false;

    lastFetchedSessions.forEach((s: any) => {
      const status = s.status || 'programat';
      if (status === 'finalizat' || status === 'anulat' || status === 'absent') return;
      
      const timeStr = s.selectedTime || "08:00";
      const cleanTimeStr = timeStr.substring(0, 5);
      const timeParts = cleanTimeStr.split(':');
      const startH = parseInt(timeParts[0] || "8", 10);
      const startM = parseInt(timeParts[1] || "0", 10);
      const totalStartMin = startH * 60 + startM;
      const totalEndMin = totalStartMin + 50; // 50 min session
      
      const nowH = parseInt(nowStr.split(':')[0], 10);
      const nowM = parseInt(nowStr.split(':')[1], 10);
      const nowTotalMin = nowH * 60 + nowM;
      
      // Auto prompt if the session ended within the last 3 minutes and wasn't prompted yet
      if (nowTotalMin >= totalEndMin && nowTotalMin - totalEndMin <= 3 && !autoPromptedSessions.has(s.id)) {
        autoPromptedSessions.add(s.id);
        if (typeof window.confirmSession === 'function') {
          window.confirmSession(s.id);
        }
      }

      // Check if we need to re-render UI because of time changes (ongoing vs past)
      // If a session just crossed the end boundary, we should re-render to update UI
      if (nowTotalMin === totalEndMin || nowTotalMin === totalStartMin) {
        shouldRender = true;
      }
    });

    if (shouldRender) {
      renderAgendaBlock();
    }
  }

  function bootAgenda() {
    renderAgendaBlock();
    setInterval(checkAutoPromptAndProgress, 60000);
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootAgenda();
  } else {
    document.addEventListener('DOMContentLoaded', bootAgenda);
  }
  
  document.addEventListener('astro:page-load', () => {
    renderAgendaBlock();
  });
  
  window.addEventListener('sessionsUpdated', renderAgendaBlock);
  window.addEventListener('patientsUpdated', renderAgendaBlock);

</script>
