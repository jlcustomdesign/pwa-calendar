<div class="bg-surface-card rounded-[2.5rem] p-6 shadow-sm">
  
  <!-- Home Page Action Notifications Banner (Renewals & Overdue Alerts) -->
  <div id="home-action-notifications" class="hidden mb-6 space-y-3">
    <!-- Injected dynamically by JS -->
  </div>

  <div id="daily-progress-container" class="space-y-2 mb-6 px-2">
    <div class="flex items-center justify-between text-sm font-medium">
      <span class="text-text-main font-semibold">Progres zilnic</span>
      <span id="daily-progress-text" class="text-text-muted">0 din 0 ședințe</span>
    </div>
    <div class="h-3 w-full bg-black/5 rounded-full overflow-hidden">
      <div id="daily-progress-bar" class="h-full bg-brand-primary rounded-full transition-all duration-500" style="width: 0%"></div>
    </div>
  </div>


  <!-- Daily Sessions List -->
  <div id="agenda-sessions-list" class="flex flex-col gap-4 pb-2">
    <!-- Populated by JS -->
  </div>

  <!-- Skeleton loader: shown only while fetching from DB -->
  <div id="agenda-skeleton" class="hidden flex flex-col gap-4 pb-2">
    <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
    <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
    <div class="h-24 rounded-[2rem] bg-black/10 animate-pulse"></div>
  </div>
</div>
<script>
  import { getAppointmentsByDate, cancelAppointment, deleteAppointment } from '../../../lib/services/appointmentService';
  import { getPatients, getPatientPayments, isRenewalDismissed } from '../../../lib/services/patientService';
  import { escapeHtml, escapeJsString } from '../../../utils/html';
  import { isPushSubscribed } from '../../../lib/services/pushService';
  import { getSettings } from '../../../lib/services/settingsService';

  const _d = new Date();
  const todayStr = _d.getFullYear() + '-' + String(_d.getMonth() + 1).padStart(2, '0') + '-' + String(_d.getDate()).padStart(2, '0');
  let currentAgendaDate = todayStr;
  let currentSessionDuration = 50;
  let lastFetchedSessions: any[] = [];
  const autoPromptedSessions = new Set<string>((() => {
    try {
      return JSON.parse(sessionStorage.getItem('kineto_auto_prompted') || '[]');
    } catch {
      return [];
    }
  })());

  const handleDateSelected = (e: any) => {
    const date = e.detail?.date;
    if (date) {
      currentAgendaDate = date;
      (window as any).currentCalendarDate = date;
      renderAgendaBlock();
    }
  };

  if ((window as any)._agendaBlockDateHandler) {
    window.removeEventListener('calendarDateSelected', (window as any)._agendaBlockDateHandler);
  }
  (window as any)._agendaBlockDateHandler = handleDateSelected;
  window.addEventListener('calendarDateSelected', handleDateSelected);


  async function checkActionNotifications() {
    const banner = document.getElementById('home-action-notifications');
    if (!banner) return;

    // Check if this device is not actually subscribed to push notifications
    const hasNotificationSupport = typeof window !== 'undefined' && 'Notification' in window && 'PushManager' in window;
    const isSubscribed = hasNotificationSupport && await isPushSubscribed();

    if (hasNotificationSupport && !isSubscribed) {
      banner.innerHTML = `
        <div class="flex items-center justify-between gap-3 p-4 rounded-2xl bg-brand-secondary/15 border border-brand-secondary/30 text-black">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🔔</span>
            <div>
              <p class="text-xs sm:text-sm font-black text-black">Activează notificările pe telefon</p>
              <p class="text-[11px] font-bold text-black/75">Vei primi alerte sonore la începutul și finalul ședințelor.</p>
            </div>
          </div>
          <button type="button" id="btn-enable-notifications-home" class="px-4 py-2.5 rounded-full bg-brand-secondary text-white text-xs font-black uppercase tracking-wider shrink-0 active:scale-95 transition-transform cursor-pointer shadow-md shadow-brand-secondary/20">
            Activează
          </button>
        </div>
      `;
      banner.classList.remove('hidden');

      const btn = document.getElementById('btn-enable-notifications-home');
      btn?.addEventListener('click', async () => {
        const originalText = btn.innerHTML;
        try {
          btn.innerHTML = '<span class="animate-pulse">Se activează...</span>';
          (btn as HTMLButtonElement).disabled = true;

          const { subscribeToPushNotifications } = await import('../../../lib/services/pushService');
          const res = await subscribeToPushNotifications();

          if (res.success) {
            banner.innerHTML = '';
            banner.classList.add('hidden');
            (window as any).showToast?.('Notificările au fost activate cu succes pe acest dispozitiv!', 'success');
          } else {
            (window as any).showToast?.(res.message || 'Eroare la activare.', 'error');
            if (res.message && res.message.includes('refuzată')) {
              alert('Pentru a primi notificări pe iPhone/Safari: Mergi în Configurări (Settings) -> Notificări -> KinetoAgenda și activează Permite Notificări.');
            }
          }
        } catch (e) {
          console.error(e);
          (window as any).showToast?.('Eroare la activarea notificărilor.', 'error');
        } finally {
          btn.innerHTML = originalText;
          (btn as HTMLButtonElement).disabled = false;
        }
      });
      return;
    }

    banner.innerHTML = '';
    banner.classList.add('hidden');
  }

  function groupAgendaSessions(sessions: any[]): any[] {
    const groups = new Map<string, any[]>();
    const singles: any[] = [];

    // 1. Group by explicit groupId first
    for (const s of sessions) {
      if (s.groupId) {
        if (!groups.has(s.groupId)) groups.set(s.groupId, []);
        groups.get(s.groupId)!.push(s);
      } else {
        singles.push(s);
      }
    }

    // 2. Also group singles that share the exact same time slot (e.g. same hour:minute)
    const byTime = new Map<string, any[]>();
    const trueSingles: any[] = [];
    for (const s of singles) {
      const timeKey = (s.selectedTime || '08:00').substring(0, 5);
      if (!byTime.has(timeKey)) byTime.set(timeKey, []);
      byTime.get(timeKey)!.push(s);
    }

    for (const [tKey, sameTimeList] of byTime) {
      if (sameTimeList.length > 1) {
        const autoGroupId = `time_group_${sameTimeList[0].selectedDate || currentAgendaDate}_${tKey}`;
        groups.set(autoGroupId, sameTimeList);
      } else {
        trueSingles.push(sameTimeList[0]);
      }
    }

    const result: any[] = [...trueSingles];
    for (const [gId, members] of groups) {
      if (members.length === 1) {
        result.push(members[0]);
      } else {
        result.push({
          isGroup: true,
          groupId: members[0].groupId || gId,
          members,
          selectedTime: members[0].selectedTime,
          selectedDate: members[0].selectedDate,
          location: members[0].location,
          status: members.some((m: any) => m.status === 'programat') ? 'programat' : members[0].status,
        });
      }
    }
    return result;
  }

  function createGroupCardHTML(group: any) {
    const count = group.members.length;
    const timeStr = (group.selectedTime || '08:00').substring(0, 5);
    const locationStr = group.location || 'Belaqva';
    const isGhimbav = locationStr.toLowerCase() === 'ghimbav';
    const cardClasses = isGhimbav ? 'bg-brand-secondary text-white' : 'bg-brand-primary text-black';
    const memberClasses = isGhimbav ? 'bg-white/95 text-black' : 'bg-white text-black';
    const progressBarFill = isGhimbav ? 'bg-brand-primary' : 'bg-brand-secondary';
    const progressBarTrack = isGhimbav ? 'bg-black/20' : 'bg-black/15';
    const memberIds = group.members.map((m: any) => m.id).join(',');

    const anyStatus = group.members.some((m: any) => m.status === 'programat') ? 'programat' : group.members[0]?.status || 'programat';
    let statusIcon = '';
    if (anyStatus === 'absent' || anyStatus === 'anulat') {
      statusIcon = `<svg class="w-6 h-6 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
    } else if (anyStatus === 'finalizat') {
      statusIcon = `<svg class="w-6 h-6 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>`;
    }

    const memberCards = group.members.map((m: any) => {
      const progress = m.totalSessions > 0 ? Math.min(100, Math.round(((m.attendanceCount || 0) / m.totalSessions) * 100)) : 0;
      const safeName = escapeHtml(m.patientName);
      const safePhone = escapeHtml(m.patientPhone || '');
      const driveLink = m.driveLink || m.patientDriveLink || '';
      const safeDriveLink = escapeHtml(driveLink || '#');
      const hasDriveLink = Boolean(driveLink);
      
      const restDePlata = Math.max(0, (m.costTotal || 0) - (m.sumaIncasata || 0));
      const isPaid = restDePlata <= 0 || m.paymentStatus === 'Achitat integral' || m.paymentStatus === 'Achitat';
      const sumaIncasata = m.sumaIncasata || 0;
      const costTotal = m.costTotal || 0;

      let paymentBadgeClass = 'bg-rose-50 hover:bg-rose-100 text-rose-700 font-extrabold';
      let displayPaymentLabel = 'Neachitat';

      if (sumaIncasata > 0 && restDePlata > 0) {
        displayPaymentLabel = `${sumaIncasata}/${costTotal} RON`;
        paymentBadgeClass = 'bg-amber-100 hover:bg-amber-200 text-amber-900 font-black';
      } else if (isPaid || m.paymentStatus === 'Achitat integral' || m.paymentStatus === 'Achitat' || (costTotal > 0 && sumaIncasata >= costTotal)) {
        displayPaymentLabel = 'Achitat';
        paymentBadgeClass = 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-extrabold';
      } else {
        displayPaymentLabel = 'Neachitat';
        paymentBadgeClass = 'bg-rose-50 hover:bg-rose-100 text-rose-700 font-extrabold';
      }

      let statusBadge = '';
      if (m.status === 'finalizat') {
        statusBadge = `<span class="inline-flex items-center gap-1 text-[11px] font-black text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg shrink-0">✓ Finalizat</span>`;
      } else if (m.status === 'absent') {
        statusBadge = `<span class="inline-flex items-center gap-1 text-[11px] font-black text-orange-700 bg-orange-50 px-2 py-0.5 rounded-lg shrink-0">✗ Absent</span>`;
      } else if (m.status === 'anulat') {
        statusBadge = `<span class="inline-flex items-center gap-1 text-[11px] font-black text-rose-700 bg-rose-50 px-2 py-0.5 rounded-lg shrink-0">Anulat</span>`;
      }

      return `
        <div class="member-card p-3.5 rounded-2xl ${memberClasses} shadow-sm space-y-2 border border-black/5" onclick="event.stopPropagation();">
          <!-- Row 1: Nume & Contor -->
          <div class="flex items-center justify-between gap-2">
            <span class="font-black text-sm text-neutral-900 truncate flex-1">${safeName}</span>
            <div class="flex items-center gap-1.5 shrink-0">
              ${statusBadge}
              <span class="text-xs font-black text-neutral-700 bg-neutral-100 px-2 py-0.5 rounded-lg font-mono">${m.attendanceCount || 0}/${m.totalSessions || 10}</span>
            </div>
          </div>

          <!-- Row 2: Progres -->
          <div class="h-1.5 w-full ${progressBarTrack} rounded-full overflow-hidden">
            <div class="h-full rounded-full ${progressBarFill}" style="width: ${progress}%;"></div>
          </div>

          <!-- Row 3: Plată pe stânga + Butoane Telefon & Dosar pe dreapta -->
          <div class="flex items-center justify-between gap-2 pt-0.5">
            <button 
              type="button" 
              class="h-9 px-3 rounded-xl ${paymentBadgeClass} text-xs font-black transition-all active:scale-95 cursor-pointer shadow-2xs flex items-center justify-center"
              onclick="event.stopPropagation(); window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: '${m.patientId}' } }))"
            >
              <span>${displayPaymentLabel}</span>
            </button>

            <div class="flex items-center gap-1.5 shrink-0">
              <a 
                href="tel:${safePhone}" 
                class="w-9 h-9 rounded-xl bg-neutral-100 hover:bg-neutral-200 text-neutral-800 flex items-center justify-center active:scale-95 transition-all cursor-pointer shadow-2xs" 
                title="Sună pacientul" 
                onclick="event.stopPropagation()"
              >
                <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </a>

              <a 
                href="${safeDriveLink}" 
                target="${hasDriveLink ? '_blank' : '_self'}" 
                rel="noopener noreferrer" 
                class="w-9 h-9 rounded-xl bg-neutral-100 hover:bg-neutral-200 text-neutral-800 flex items-center justify-center active:scale-95 transition-all cursor-pointer shadow-2xs" 
                title="Deschide Dosar/Drive" 
                onclick="event.stopPropagation(); if (!${hasDriveLink}) { event.preventDefault(); if (window.showToast) { window.showToast('Pacientul nu are dosar/Drive salvat.', 'info'); } else { alert('Pacientul nu are dosar/Drive salvat.'); } }"
              >
                <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      `;
    }).join('');

    const [startH, startM] = (timeStr || '08:00').split(':').map(Number);
    const startHStr = (isNaN(startH) ? 8 : startH).toString().padStart(2, '0');
    const startMStr = (isNaN(startM) ? 0 : startM).toString().padStart(2, '0');

    const memberNamesList = group.members.map((m: any) => m.patientName).filter(Boolean).join(', ');
    const displayNames = memberNamesList || `${count} pacienți`;

    return `
      <session-card class="group-session-card block relative rounded-[2.5rem] shadow-sm overflow-hidden mx-1 md:mx-5" data-group-id="${group.groupId}" data-group-member-ids="${memberIds}">
        <div class="absolute inset-0 bg-neutral-100 flex items-center justify-end px-6 z-0">
          <div class="flex items-center gap-3" data-action-area>
            <button
              type="button"
              data-action-btn
              class="relative z-20 w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent"
              onclick="event.stopPropagation(); event.preventDefault(); window.editGroupSession('${group.groupId}', '${memberIds}', '${timeStr}', '${group.selectedDate || currentAgendaDate}', '${escapeJsString(locationStr)}');"
            >
              <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
            </button>
            <button
              type="button"
              data-action-btn
              class="relative z-20 w-12 h-12 rounded-full bg-orange-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform"
              onclick="event.stopPropagation(); event.preventDefault(); window.cancelGroupSession('${memberIds}');"
              title="Marchează grupul ca Anulat/Absent"
            >
              <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
            </button>
            <button
              type="button"
              data-action-btn
              class="relative z-20 w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform"
              onclick="event.stopPropagation(); event.preventDefault(); window.deleteGroupSession('${memberIds}');"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        </div>
        <div class="swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}">
          <div class="card-summary relative z-20 flex flex-col justify-between cursor-pointer transition-transform active:scale-[0.98] min-h-[110px] p-6" onclick="this.closest('session-card').classList.toggle('expanded')">
            
            <!-- Watermark Time Background -->
            <div class="absolute left-3 top-0 bottom-0 font-black text-[3.8rem] leading-[0.8] opacity-50 pointer-events-none tracking-tighter flex items-center justify-start z-0 w-20">
              <div class="flex items-start">
                ${startHStr}
                <span class="text-xl mt-1 ml-0.5">${startMStr}</span>
              </div>
            </div>

            <!-- Title & Status Icon -->
            <div class="flex items-center gap-3 w-full relative z-10 pl-24 justify-between">
              <div class="flex-1 min-w-0">
                <h4 class="text-xl font-bold tracking-tight leading-none truncate">Grup</h4>
                <div class="mt-1 text-xs sm:text-sm font-bold opacity-85 truncate" title="${escapeHtml(displayNames)}">${escapeHtml(displayNames)} • ${escapeHtml(locationStr)}</div>
              </div>
              ${statusIcon}
            </div>

            <!-- Progress Bar & Count -->
            <div class="flex items-center gap-4 mt-5 relative z-10 pl-24">
              <div class="h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative">
                <div class="h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out" style="width: 100%;"></div>
              </div>
              <div class="text-xs font-bold tracking-wide opacity-90 shrink-0">${count} pacienți</div>
            </div>
          </div>

          <div class="card-details grid transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" style="grid-template-rows: 0fr;">
            <div class="overflow-hidden relative z-20">
              <div class="px-6 pb-6 pt-1">
                <div class="group-members flex flex-col gap-2.5 mb-3">
                  ${memberCards}
                </div>
                ${anyStatus !== 'finalizat' && anyStatus !== 'anulat' && anyStatus !== 'absent' && (!group.selectedDate || group.selectedDate <= todayStr) ? `
                  <div class="pt-1 pb-1">
                    <button 
                      type="button" 
                      class="w-full h-11 rounded-2xl ${isGhimbav ? 'bg-brand-primary text-black' : 'bg-brand-secondary text-white'} font-black text-xs sm:text-sm tracking-wider uppercase active:scale-95 transition-transform shadow-md flex items-center justify-center cursor-pointer border border-transparent hover:opacity-95" 
                      onclick="event.stopPropagation(); if (typeof window.confirmGroupSession === 'function') { window.confirmGroupSession('${memberIds}'); }"
                    >
                      <span>CONFIRMĂ ȘEDINȚELE DE GRUP</span>
                    </button>
                  </div>
                ` : ''}
                <div class="mt-2 text-xs font-bold text-center opacity-75 group-expanded-hint">Apasă pentru a ascunde pacienții</div>
              </div>
            </div>
          </div>
        </div>
      </session-card>
    `;
  }

  function drawAgendaSessionsList(list: HTMLElement, sessions: any[]) {
    const now = new Date();
    const nowStr = now.toTimeString().slice(0, 5);
    const isToday = currentAgendaDate === todayStr;

    if (sessions.length === 0) {
      const emptyDay = currentAgendaDate === todayStr ? 'azi' : 'această zi';
      list.innerHTML = `<p class="text-sm font-bold text-text-muted text-center py-4">Nicio ședință programată pentru ${emptyDay}.</p>`;
      return;
    }

    const getSessionCategory = (session: any) => {
      const timeStr = session.selectedTime || "08:00";
      const timeParts = timeStr.split(':');
      const hourNum = parseInt(timeParts[0] || "0", 10);
      const minute = timeParts[1] || "00";
      const endTime = `${(hourNum + 1).toString().padStart(2, '0')}:${minute}`;

      const isOngoing = isToday && nowStr >= timeStr && nowStr < endTime;
      const isPast = currentAgendaDate < todayStr || (isToday && nowStr >= endTime);

      if (isOngoing) return 0;
      if (!isPast) return 1;
      return 2;
    };

    const items = groupAgendaSessions(sessions);

    const sorted = [...items].sort((a: any, b: any) => {
      const catA = getSessionCategory(a);
      const catB = getSessionCategory(b);
      if (catA !== catB) return catA - catB;
      const timeA = a.selectedTime || "08:00";
      const timeB = b.selectedTime || "08:00";
      return timeA.localeCompare(timeB);
    });

    list.innerHTML = sorted.map((item: any) => {
      if (item.isGroup) {
        return createGroupCardHTML(item);
      }
      const session: any = item;
      const locationStr = session.location || "Belaqva";
      const isGhimbav = locationStr.toLowerCase() === "ghimbav";
      const cardClasses = isGhimbav ? "bg-brand-secondary text-white" : "bg-brand-primary text-black";
      const count = session.attendanceCount ?? 0;
      const totalSess = session.totalSessions || 10;
      const isTerminat = session.subscriptionDone || (totalSess > 0 && count >= totalSess);
      const displayCount = isTerminat ? totalSess : count;
      const progressPercentage = isTerminat ? 100 : (totalSess > 0 ? Math.min(100, Math.round((count / totalSess) * 100)) : 0);
      const progressBarFill = isGhimbav ? "bg-brand-primary" : "bg-brand-secondary";
      const progressBarTrack = isGhimbav ? "bg-black/20" : "bg-black/15";

      const timeStr = session.selectedTime || "08:00";
      const patientNameStr = session.patientName || "Pacient";
      const safePatientName = escapeHtml(patientNameStr);
      const safePatientNameJs = escapeJsString(session.patientName || '');
      const safeLocation = escapeHtml(locationStr);
      const safePhone = escapeHtml(session.patientPhone || '+1234567890');
      const cleanTimeStr = (session.selectedTime || '08:00').substring(0, 5);
      const timeParts = cleanTimeStr.split(':');
      const startH = parseInt(timeParts[0] || "8", 10);
      const startM = parseInt(timeParts[1] || "0", 10);
      const totalStartMin = startH * 60 + startM;
      const totalEndMin = totalStartMin + currentSessionDuration;
      const endH = Math.floor(totalEndMin / 60);
      const endM = totalEndMin % 60;
      const formattedStart = `${startH}:${startM.toString().padStart(2, '0')}`;
      const formattedEnd = `${endH}:${endM.toString().padStart(2, '0')}`;
      const timeRangeText = `${formattedStart} - ${formattedEnd}`;

      const sessionStatus = session.status || 'programat';
      const isOngoing = isToday && nowStr >= cleanTimeStr && nowStr < `${endH.toString().padStart(2, '0')}:${endM.toString().padStart(2, '0')}`;
      const paymentStatus = session.paymentStatus || 'Neachitat';

      let statusIcon = '';
      if (sessionStatus === 'absent') {
        statusIcon = `<svg class="w-6 h-6 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
      } else if (sessionStatus === 'anulat') {
        statusIcon = `<svg class="w-6 h-6 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
      } else if (sessionStatus === 'finalizat') {
        statusIcon = `<svg class="w-6 h-6 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>`;
      } else if (isOngoing) {
        statusIcon = `<svg class="w-7 h-7 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      }

      const subscriptionWarningDetails = isTerminat && !isRenewalDismissed(session.patientId)
        ? `<div class="px-6 pb-4">
            <div class="flex items-center gap-3 rounded-2xl bg-brand-secondary/15 border border-brand-secondary/30 p-3">
              <div class="flex-1 min-w-0">
                <p class="text-xs sm:text-sm font-black text-black truncate">Abonament terminat</p>
                <p class="text-[10px] font-bold text-black/70">${displayCount}/${totalSess} ședințe</p>
              </div>
              <button type="button" class="shrink-0 px-4 py-2.5 rounded-full bg-brand-secondary text-black text-xs font-black uppercase tracking-wide shadow-sm active:scale-95 transition-transform" onclick="event.stopPropagation(); window.renewSubscription('${session.patientId}', ${session.totalSessions || 10}, '${safePatientNameJs}')">Reînnoiește</button>
              <button type="button" class="shrink-0 w-9 h-9 rounded-full bg-surface-card text-text-muted flex items-center justify-center active:scale-95 transition-transform" onclick="event.stopPropagation(); window.dismissSubscriptionWarning('${session.patientId}')" aria-label="Nu acum">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          </div>`
        : '';

      const restDePlata = Math.max(0, (session.costTotal || 0) - (session.sumaIncasata || 0));
      const isPaid = restDePlata <= 0 || session.paymentStatus === 'Achitat integral' || session.paymentStatus === 'Achitat';

      const sumaIncasata = session.sumaIncasata || 0;
      const costTotal = session.costTotal || 0;

      let paymentBadgeClass = 'bg-rose-50 hover:bg-rose-100 text-rose-700 border border-transparent font-extrabold shadow-sm';
      let displayPaymentLabel = 'Neachitat';

      if (sumaIncasata > 0 && restDePlata > 0) {
        displayPaymentLabel = `${sumaIncasata}/${costTotal} RON`;
        paymentBadgeClass = 'bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-200/60 font-black shadow-sm';
      } else if (isPaid || paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat' || (costTotal > 0 && sumaIncasata >= costTotal)) {
        displayPaymentLabel = 'Achitat';
        paymentBadgeClass = 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-transparent font-extrabold shadow-sm';
      } else {
        displayPaymentLabel = 'Neachitat';
        paymentBadgeClass = 'bg-rose-50 hover:bg-rose-100 text-rose-700 border border-transparent font-extrabold shadow-sm';
      }

      const driveLink = session.driveLink || session.patientDriveLink || '';
      const safeDriveLink = escapeHtml(driveLink || '#');
      const hasDriveLink = Boolean(driveLink);

      return `
        <session-card class="block relative rounded-[2.5rem] shadow-sm overflow-hidden mx-1 md:mx-5" data-session-id="${session.id}">
          <div class="absolute inset-0 bg-neutral-100 flex items-center justify-end px-6 z-0">
            <div class="flex items-center gap-3" data-action-area>
              <button 
                type="button" 
                data-action-btn
                class="relative z-20 w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent"
                onclick="event.stopPropagation(); event.preventDefault(); window.editSession('${session.id}');"
              >
                <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
              </button>
              <button 
                type="button" 
                data-action-btn
                class="relative z-20 w-12 h-12 rounded-full bg-orange-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform"
                onclick="event.stopPropagation(); event.preventDefault(); window.cancelSession('${session.id}');"
                title="Marchează ca Anulat/Absent"
              >
                <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
              </button>
              <button 
                type="button" 
                data-action-btn
                class="relative z-20 w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform"
                onclick="event.stopPropagation(); event.preventDefault(); window.deleteSession('${session.id}');"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </div>

          <div class="swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}">

            <div class="card-summary relative z-20 flex flex-col justify-between cursor-pointer transition-transform active:scale-[0.98] min-h-[110px] p-6">
              
              <!-- Watermark Time Background -->
              <div class="absolute left-3 top-0 bottom-0 font-black text-[3.8rem] leading-[0.8] opacity-50 pointer-events-none tracking-tighter flex items-center justify-start z-0 w-20">
                <div class="flex items-start">
                  ${startH.toString().padStart(2, '0')}
                  <span class="text-xl mt-1 ml-0.5">${startM.toString().padStart(2, '0')}</span>
                </div>
              </div>

              <div class="flex items-center gap-3 w-full relative z-10 pl-24 justify-between">
                <div class="flex-1 min-w-0 flex items-center gap-2">
                  <h4 class="text-xl font-bold tracking-tight leading-none truncate">${safePatientName}</h4>
                </div>
                ${statusIcon}
              </div>

              <div class="flex items-center gap-4 mt-5 relative z-10 pl-24">
                <div class="h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative">
                  <div class="h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out" style="width: ${progressPercentage}%;"></div>
                </div>
                <div class="text-xs font-bold tracking-wide opacity-90 shrink-0">${displayCount}/${totalSess}</div>
              </div>
            </div>

            <div class="card-details grid transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" style="grid-template-rows: 0fr;">
              <div class="overflow-hidden relative z-20">
                <div class="px-6 pt-2 pb-6 space-y-3">
                  <!-- Row 1: White Pill with Black Text & Icons for Time & Location -->
                  <div class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white text-black text-sm sm:text-base font-extrabold shadow-sm border border-transparent">
                    <span class="flex items-center gap-1.5 shrink-0 text-black">
                      <svg class="w-4 h-4 text-black opacity-75 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span class="text-black font-black">${timeRangeText}</span>
                    </span>
                    <span class="flex items-center gap-1.5 shrink-0 text-black">
                      <svg class="w-4 h-4 text-black opacity-75 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <span class="text-black font-black">${safeLocation}</span>
                    </span>
                  </div>

                  <!-- Row 2: Payment Badge on Left + Icon-only Call/Folder Buttons on Right -->
                  <div class="flex items-center justify-between pt-0.5 gap-4">
                    <button 
                      type="button"
                      class="h-11 flex items-center justify-center px-4 rounded-2xl ${paymentBadgeClass} hover:opacity-90 active:scale-95 transition-all text-sm sm:text-base font-black cursor-pointer shadow-sm" 
                      onclick="event.stopPropagation(); window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: '${session.patientId}' } }))"
                    >
                      <span>${displayPaymentLabel}</span>
                    </button>

                    <div class="flex items-center gap-2 shrink-0">
                      <a href="tel:${safePhone}" class="w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer" title="Sună pacientul" onclick="event.stopPropagation()">
                        <svg class="w-5 h-5 text-black opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                      </a>

                      <a href="${safeDriveLink}" target="${hasDriveLink ? '_blank' : '_self'}" rel="noopener noreferrer" class="w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer" title="Deschide Dosar/Drive" onclick="event.stopPropagation(); if (!${hasDriveLink}) { event.preventDefault(); if (window.showToast) { window.showToast('Pacientul nu are un link de dosar/Drive salvat.', 'info'); } else { alert('Pacientul nu are un link de dosar/Drive salvat.'); } }">
                        <svg class="w-5 h-5 text-black opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>
                      </a>
                    </div>
                  </div>
                  
                </div>
                </div>

                ${sessionStatus !== 'finalizat' && sessionStatus !== 'anulat' && sessionStatus !== 'absent' && (!session.selectedDate || session.selectedDate <= todayStr) ? `
                  <div class="px-6 pb-6 pt-2">
                    <button type="button" class="w-full h-11 rounded-2xl ${isGhimbav ? 'bg-brand-primary text-black' : 'bg-brand-secondary text-white'} font-black text-xs sm:text-sm tracking-wider uppercase active:scale-95 transition-transform shadow-md flex items-center justify-center cursor-pointer border border-transparent hover:opacity-95" onclick="event.stopPropagation(); if (typeof window.confirmSession === 'function') { window.confirmSession('${session.id}'); }">
                      <span>CONFIRMĂ ȘEDINȚA</span>
                    </button>
                  </div>
                ` : ''}
              </div>
            </div>
          </div>
        </session-card>
      `;
    }).join('');
  }

  async function renderAgendaBlock() {
    checkActionNotifications();
    const list = document.getElementById('agenda-sessions-list');
    const skeleton = document.getElementById('agenda-skeleton');
    if (!list) return;

    try {
      const settings = await getSettings();
      currentSessionDuration = settings?.session_duration || 50;
    } catch (e) {
      currentSessionDuration = 50;
    }

    // Render instant cache first to prevent mobile delay
    const cacheKey = `kineto_agenda_cache_${currentAgendaDate}`;
    let usedCache = false;
    try {
      const rawCache = localStorage.getItem(cacheKey);
      if (rawCache && list.children.length === 0) {
        const cachedSessions = JSON.parse(rawCache);
        if (Array.isArray(cachedSessions) && cachedSessions.length > 0) {
          const groupedCache = groupAgendaSessions(cachedSessions);
          const totalToday = groupedCache.length;
          const completedToday = groupedCache.filter((s: any) => s.status === 'finalizat').length;
          const todayProgressPct = totalToday > 0 ? Math.min(100, Math.round((completedToday / totalToday) * 100)) : 0;
          const progressText = document.getElementById('daily-progress-text');
          const progressBar = document.getElementById('daily-progress-bar');
          if (progressText) progressText.textContent = `${completedToday} din ${totalToday} ședințe`;
          if (progressBar) progressBar.style.width = `${todayProgressPct}%`;

          drawAgendaSessionsList(list, cachedSessions);
          usedCache = true;
        }
      }
    } catch (e) {}

    // Show skeleton only on initial cold load when list is empty
    if (skeleton && list.children.length === 0 && !usedCache) {
      list.classList.add('hidden');
      skeleton.classList.remove('hidden');
    }

    const now = new Date();
    const nowStr = now.toTimeString().slice(0, 5);
    const isToday = currentAgendaDate === todayStr;
    let stored: any[] = [];
    try {
      const appts = await getAppointmentsByDate(currentAgendaDate);
      stored = await Promise.all(appts.map(async (a: any) => {
        const sumaIncasata = await getPatientPayments(a.pacient_id);
        const costTotal = Number(a.pacienti?.cost || 0);
        const folosite = a.pacienti?.sedinte_folosite ?? 0;
        const totalSess = a.pacienti?.sedinte_total || 10;
        const sedinteRamase = Math.max(0, totalSess - folosite);
        const costPerSession = totalSess > 0 ? (costTotal / totalSess) : costTotal;

        let pStatus = 'Neachitat';
        if (a.pacienti?.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal)) {
          pStatus = 'Achitat integral';
        } else if (sumaIncasata > 0) {
          pStatus = 'Achitat parțial';
        } else if (a.pacienti?.status_plata) {
          pStatus = a.pacienti.status_plata;
        }

        return {
          id: a.id,
          patientId: a.pacient_id,
          patientName: a.pacienti ? `${a.pacienti.prenume} ${a.pacienti.nume}` : 'Pacient',
          patientPhone: a.pacienti?.telefon || '',
          driveLink: a.pacienti?.drive_link || '',
          selectedTime: a.ora,
          selectedDate: a.data,
          location: a.locatie || a.pacienti?.locatie || 'Belaqva',
          attendanceCount: folosite,
          totalSessions: totalSess,
          remainingSessions: sedinteRamase,
          subscriptionDone: totalSess > 0 && folosite > 0 && folosite >= totalSess,
          status: a.status || 'programat',
          paymentStatus: pStatus,
          costTotal,
          sumaIncasata,
          groupId: a.group_id || null,
        };
      }));
    } catch (e) {
      console.error('Eroare citire agenda din DB:', e);
    }

    if (skeleton) skeleton.classList.add('hidden');
    list.classList.remove('hidden');

    lastFetchedSessions = stored;
    try {
      if (stored.length > 0) {
        localStorage.setItem(cacheKey, JSON.stringify(stored));
      }
    } catch (e) {}

    // Calculate selected day's progress dynamically — grupul contează ca o singură ședință
    const groupedSessions = groupAgendaSessions(stored);
    const totalToday = groupedSessions.length;
    const completedToday = groupedSessions.filter((s: any) => s.status === 'finalizat').length;
    const todayProgressPct = totalToday > 0 ? Math.min(100, Math.round((completedToday / totalToday) * 100)) : 0;

    const progressText = document.getElementById('daily-progress-text');
    const progressBar = document.getElementById('daily-progress-bar');
    if (progressText) progressText.textContent = `${completedToday} din ${totalToday} ședințe`;
    if (progressBar) progressBar.style.width = `${todayProgressPct}%`;

    drawAgendaSessionsList(list, stored);
  }

  function checkAutoPromptAndProgress() {
    if (currentAgendaDate !== todayStr) return;
    
    const now = new Date();
    const nowStr = now.toTimeString().slice(0, 5);
    
    // We only trigger auto-prompt if there are active sessions that just ended
    let shouldRender = false;

    lastFetchedSessions.forEach((s: any) => {
      const status = s.status || 'programat';
      if (status === 'finalizat' || status === 'anulat' || status === 'absent') return;
      
      const timeStr = s.selectedTime || "08:00";
      const cleanTimeStr = timeStr.substring(0, 5);
      const timeParts = cleanTimeStr.split(':');
      const startH = parseInt(timeParts[0] || "8", 10);
      const startM = parseInt(timeParts[1] || "0", 10);
      const totalStartMin = startH * 60 + startM;
      const totalEndMin = totalStartMin + currentSessionDuration; // session_duration min session
      
      const nowH = parseInt(nowStr.split(':')[0], 10);
      const nowM = parseInt(nowStr.split(':')[1], 10);
      const nowTotalMin = nowH * 60 + nowM;
      
      // Auto prompt if the session ended within the last 3 minutes and wasn't prompted yet
      if (nowTotalMin >= totalEndMin && nowTotalMin - totalEndMin <= 3 && !autoPromptedSessions.has(s.id)) {
        autoPromptedSessions.add(s.id);
        try {
          sessionStorage.setItem('kineto_auto_prompted', JSON.stringify(Array.from(autoPromptedSessions)));
        } catch {}
        if (typeof (window as any).confirmSession === 'function') {
          (window as any).confirmSession(s.id);
        }
      }

      // Check if we need to re-render UI because of time changes (ongoing vs past)
      if (nowTotalMin === totalEndMin || nowTotalMin === totalStartMin) {
        shouldRender = true;
      }
    });

    if (shouldRender) {
      renderAgendaBlock();
    }
  }

  (window as any).cancelGroupSession = async (groupId: string, memberIdsRaw: string) => {
    const ids = (memberIdsRaw || '').split(',').filter(Boolean);
    if (ids.length === 0) return;
    try {
      await Promise.all(ids.map(id => cancelAppointment(id, 'Anulat din grup')));
      (window as any).showToast?.('Ședința în grup a fost marcată ca anulată.', 'info');
      window.dispatchEvent(new CustomEvent('sessionsUpdated'));
    } catch (err: any) {
      (window as any).showToast?.('Eroare la anularea grupului: ' + (err.message || err), 'error');
    }
  };

  (window as any).deleteGroupSession = async (groupId: string, memberIdsRaw: string) => {
    const ids = (memberIdsRaw || '').split(',').filter(Boolean);
    if (ids.length === 0) return;
    if (!window.confirm('Sigur ștergi ședința în grup pentru toți pacienții?')) return;
    try {
      await Promise.all(ids.map(id => deleteAppointment(id)));
      (window as any).showToast?.('Ședința în grup a fost ștearsă.', 'info');
      window.dispatchEvent(new CustomEvent('sessionsUpdated', { detail: { source: 'dashboardDelete' } }));
    } catch (err: any) {
      (window as any).showToast?.('Eroare la ștergerea grupului: ' + (err.message || err), 'error');
    }
  };

  function bootAgenda() {
    renderAgendaBlock();
    if ((window as any).__agendaIntervalId) {
      clearInterval((window as any).__agendaIntervalId);
    }
    (window as any).__agendaIntervalId = setInterval(checkAutoPromptAndProgress, 60000);
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootAgenda();
  } else {
    document.addEventListener('DOMContentLoaded', bootAgenda);
  }
  
  document.addEventListener('astro:page-load', () => {
    renderAgendaBlock();
  });
  
  if ((window as any)._agendaBlockSessionsHandler) {
    window.removeEventListener('sessionsUpdated', (window as any)._agendaBlockSessionsHandler);
    window.removeEventListener('patientsUpdated', (window as any)._agendaBlockPatientsHandler);
  }
  (window as any)._agendaBlockSessionsHandler = (e: any) => {
    // La ștergere, cardul este eliminat optimist; nu re-fetchăm întreaga agendă.
    if (e.detail?.source === 'dashboardDelete') return;
    renderAgendaBlock();
  };
  (window as any)._agendaBlockPatientsHandler = renderAgendaBlock;

  window.addEventListener('sessionsUpdated', (window as any)._agendaBlockSessionsHandler);
  window.addEventListener('patientsUpdated', (window as any)._agendaBlockPatientsHandler);

</script>

