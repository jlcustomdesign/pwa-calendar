---
interface Props {
  patientId: string;
  patientName: string;
  startTime: string; // e.g. "07:00"
  attendanceCount: number;
  totalSessions?: number;
  location: 'Ghimbav' | 'Belaqua';
  isPast?: boolean;
  paymentStatus?: string;
}

const { 
  patientId,
  patientName, 
  startTime, 
  attendanceCount, 
  totalSessions = 10,
  location,
  isPast = false,
  paymentStatus = 'Unpaid'
} = Astro.props;

// Split startTime "07:00" into "07" and "00"
const timeParts = startTime.split(':');
const hourNum = parseInt(timeParts[0] || "0", 10);
const hour = timeParts[0] || "00";
const minute = timeParts[1] || "00";

// Calculate end time (default to 1 hour later for display)
const endHourStr = (hourNum + 1).toString().padStart(2, '0');
const endTime = `${endHourStr}:${minute}`;

let cardClasses = "";
let gradientColors = "";

if (location === 'Ghimbav') {
  // Pink
  cardClasses = "bg-brand-secondary text-white";
  gradientColors = "from-white/30 to-white"; 
} else {
  // Yellow - Belaqua
  cardClasses = "bg-brand-primary text-black";
  gradientColors = "from-black/30 to-black";
}

const remainingSessions = Math.max(0, totalSessions - attendanceCount);
const progressPercentage = Math.min(100, Math.round((attendanceCount / totalSessions) * 100));
const clipPathValue = `inset(0 ${100 - progressPercentage}% 0 0)`;
---

<session-card class={`block relative rounded-[2.5rem] shadow-sm overflow-hidden`}>
  
  <!-- Swipe Action Background -->
  <div class="absolute inset-0 bg-neutral-100 flex items-center justify-end px-6 z-0">
    <div class="flex items-center gap-3">
      <button class="w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent" onclick="window.editSession && window.editSession(this); event.stopPropagation();">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
      </button>
      <button class="w-12 h-12 rounded-full bg-orange-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" onclick="window.cancelSession && window.cancelSession(this); event.stopPropagation();" title="Marchează ca Anulat/Absent">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
      </button>
      <button class="w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" onclick="window.deleteSession && window.deleteSession(this); event.stopPropagation();">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- Draggable Foreground -->
  <div class={`swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}`}>
  <!-- Elegant Fine Hatching Overlay for Past Sessions removed to keep cards vibrant -->

  <!-- Summary Section (Always visible) -->
  <div class="card-summary relative z-20 flex flex-col justify-between cursor-pointer transition-transform active:scale-[0.98] min-h-[80px] p-6">

    <!-- Summary Content (Patient Name) -->
    <div class="flex items-center justify-between w-full relative z-10">
      <div class="flex-1 min-w-0">
        <h4 class="text-xl font-bold tracking-tight leading-none truncate pr-2">{patientName}</h4>
      </div>
      {isPast && (
        <div class="shrink-0 bg-black/10 backdrop-blur-md px-3 py-1 rounded-full flex items-center gap-1.5 border border-transparent">
          <svg class="w-3 h-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          <span class="text-[10px] font-black uppercase tracking-widest opacity-80">Efectuat</span>
        </div>
      )}
    </div>

    <!-- Progress (Restored to Summary) -->
    <div class="flex items-center gap-4 mt-5 relative z-10">
      <div class="h-1.5 flex-1 bg-black/10 rounded-full overflow-hidden relative">
        <div class={`h-full rounded-full bg-gradient-to-r ${gradientColors} transition-all duration-500 ease-out`} style={`width: ${progressPercentage}%;`}></div>
      </div>
      <div class="text-xs font-bold tracking-wide opacity-90 shrink-0">{remainingSessions}/{totalSessions}</div>
    </div>

  </div>

  <!-- Details Section (Hidden by default, expands on click) -->
  <div class="card-details grid transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" style="grid-template-rows: 0fr;">
    <div class="overflow-hidden relative z-20">
      
      <!-- Full Program Time Display -->
      <div class="px-6 pt-4 pb-2 flex justify-between items-center">
        <div class="flex items-center gap-2 text-base font-extrabold opacity-95 bg-black/5 px-4 py-2 rounded-xl backdrop-blur-sm">
          {startTime} - {endTime}
        </div>
        <div class="text-xs font-bold uppercase tracking-widest opacity-60 text-right">
          {location}
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="px-6 pb-5 pt-3 flex gap-2">
        <!-- Phone Button -->
        <a href="tel:+1234567890" class="flex-1 flex items-center justify-center gap-2 py-3 rounded-2xl bg-black/10 hover:bg-black/20 active:scale-95 transition-all text-sm font-bold" onclick="event.stopPropagation()">
          <svg class="w-4 h-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Sună
        </a>

        <!-- Drive Button -->
        <a href="#" class="flex-1 flex items-center justify-center gap-2 py-3 rounded-2xl bg-black/10 hover:bg-black/20 active:scale-95 transition-all text-sm font-bold" onclick="event.stopPropagation()">
          <svg class="w-4 h-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
          </svg>
          Dosar
        </a>

        <!-- Paid Status Toggle -->
        <button 
          class={`flex-1 flex items-center justify-center gap-2 py-3 rounded-2xl transition-all text-sm font-bold whitespace-nowrap px-2 ${
            paymentStatus === 'Paid' || paymentStatus === 'Paid fully' ? 'bg-white/40 text-black hover:bg-white/50' : 
            paymentStatus === 'Unpaid' ? 'bg-black text-white hover:bg-black/80 shadow-sm' :
            'bg-black/50 text-white hover:bg-black/60'
          }`}
          onclick={`event.stopPropagation(); if (window.handlePaymentToggle) window.handlePaymentToggle('${patientId}', '${paymentStatus}')`}
        >
          <svg class="w-4 h-4 opacity-80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {paymentStatus}
        </button>
      </div>
    </div>
  </div>
  </div>
</session-card>

<!-- SessionCard markup is kept for reference but its interactive behaviour is
     handled by the global controller in DashboardLayout.astro to avoid two
     conflicting swipe/click implementations on the same cards. -->
