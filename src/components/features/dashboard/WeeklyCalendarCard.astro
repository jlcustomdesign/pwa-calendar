---
interface Props {
  name?: string;
}

const { name = "Dr. Maria" } = Astro.props;

// Use the user's timezone (Europe/Bucharest) so weekend detection and the
// active week are correct regardless of where the server is located.
const now = new Date(
  new Date().toLocaleString("en-US", { timeZone: "Europe/Bucharest" })
);
const weekDayLabels = ["L", "M", "M", "J", "V"];
const fullDayNames = ["Luni", "Marți", "Miercuri", "Joi", "Vineri"];

const totalMonths = 60;
const startMonthOffset = -6;
const initialMonthCount = 9;
const initialStartOffset = -4;

const todayMonday = new Date(now);
const currentDay = todayMonday.getDay();
// If it's Saturday (6) or Sunday (0), jump forward to the upcoming Monday
const offsetToMonday = currentDay === 0 ? 1 : (currentDay === 6 ? 2 : 1 - currentDay);
todayMonday.setDate(todayMonday.getDate() + offsetToMonday);
todayMonday.setHours(0,0,0,0);

// Overall date range
const firstMonthDate = new Date(now.getFullYear(), now.getMonth() + startMonthOffset, 1);
const lastMonthDate = new Date(now.getFullYear(), now.getMonth() + startMonthOffset + totalMonths, 0);

// First Monday on or before the first day of the range
let firstWeekMonday = new Date(firstMonthDate);
const firstDayOfWeek = firstWeekMonday.getDay();
firstWeekMonday.setDate(firstWeekMonday.getDate() - (firstDayOfWeek === 0 ? 6 : firstDayOfWeek - 1));
firstWeekMonday.setHours(0,0,0,0);

interface DayItem {
  date: number;
  shortMonthName: string;
  monthNum: number;
  year: number;
  fullDay: string;
  dayLabel: string;
  isToday: boolean;
  active: boolean;
}

interface WeekItem {
  weekStartDate: Date;
  days: DayItem[];
  isCurrentWeek: boolean;
}

const allWeeksFlat: WeekItem[] = [];
let currentMonday = new Date(firstWeekMonday);

while (currentMonday <= lastMonthDate) {
  const weekDays: DayItem[] = [];
  const weekMon = new Date(currentMonday);
  weekMon.setHours(0,0,0,0);
  const isCurrentWeek = weekMon.getTime() === todayMonday.getTime();

  for (let d = 0; d < 5; d++) {
    const dayDate = new Date(currentMonday);
    dayDate.setDate(currentMonday.getDate() + d);
    const isToday = dayDate.toDateString() === now.toDateString();

    weekDays.push({
      date: dayDate.getDate(),
      shortMonthName: dayDate.toLocaleString('ro-RO', { month: 'short' }),
      monthNum: dayDate.getMonth(),
      year: dayDate.getFullYear(),
      fullDay: fullDayNames[d],
      dayLabel: weekDayLabels[d],
      isToday,
      active: false
    });
  }

  allWeeksFlat.push({
    weekStartDate: new Date(currentMonday),
    days: weekDays,
    isCurrentWeek
  });

  currentMonday.setDate(currentMonday.getDate() + 7);
}

// Build months that reference indices from the single flat week list
const allMonths = Array.from({ length: totalMonths }).map((_, monthIndex) => {
  const mOffset = startMonthOffset + monthIndex;
  const targetDate = new Date(now.getFullYear(), now.getMonth() + mOffset, 1);
  const year = targetDate.getFullYear();
  const monthNum = targetDate.getMonth();
  const monthName = targetDate.toLocaleString('ro-RO', { month: 'long' });
  const shortMonthName = targetDate.toLocaleString('ro-RO', { month: 'short' });
  const isCurrentMonth = mOffset === 0;

  const weekIndices: number[] = [];
  allWeeksFlat.forEach((week, idx) => {
    const hasDayInMonth = week.days.some(day => day.monthNum === monthNum && day.year === year);
    if (hasDayInMonth) weekIndices.push(idx);
  });

  return {
    monthOffset: mOffset,
    year,
    monthNum,
    monthName,
    shortMonthName,
    isCurrentMonth,
    weekIndices
  };
});

const initialMonths = allMonths.filter(m => m.monthOffset >= initialStartOffset && m.monthOffset < initialStartOffset + initialMonthCount);
const beforeMonths = allMonths.filter(m => m.monthOffset < initialStartOffset);
const afterMonths = allMonths.filter(m => m.monthOffset >= initialStartOffset + initialMonthCount);

const isWeekend = now.getDay() === 0 || now.getDay() === 6;
let foundActive = false;

if (!isWeekend) {
  allWeeksFlat.forEach(week => {
    week.days.forEach(d => {
      if (d.isToday) {
        d.active = true;
        foundActive = true;
      }
    });
  });
}

if (!foundActive) {
  allWeeksFlat.forEach(week => {
    if (week.isCurrentWeek) {
      week.days[0].active = true;
      foundActive = true;
    }
  });
}

let activeDayObj: DayItem | null = null;
for (const week of allWeeksFlat) {
  const d = week.days.find(day => day.active);
  if (d) {
    activeDayObj = d;
    break;
  }
}

const currentMonthData = allMonths.find(m => m.isCurrentMonth);

const serverDate = new Date();
let initialDate = serverDate;
if (activeDayObj) {
  const yearVal = activeDayObj.year || serverDate.getFullYear();
  const monthVal = typeof activeDayObj.monthNum === 'number' ? activeDayObj.monthNum : (currentMonthData ? currentMonthData.monthNum : serverDate.getMonth());
  const dateVal = activeDayObj.date || serverDate.getDate();
  const parsed = new Date(yearVal, monthVal, dateVal);
  if (!isNaN(parsed.getTime())) {
    initialDate = parsed;
  }
}

const rawWeekday = initialDate.toLocaleDateString('ro-RO', { weekday: 'long' });
const initialDayName = rawWeekday ? (rawWeekday.charAt(0).toUpperCase() + rawWeekday.slice(1)) : 'Luni';
const rawMonthName = initialDate.toLocaleDateString('ro-RO', { month: 'long' });
const fullMonthName = rawMonthName ? (rawMonthName.charAt(0).toUpperCase() + rawMonthName.slice(1)) : '';
const initialDateNumMonthYear = `${initialDayName}, ${initialDate.getDate()} ${fullMonthName}`;
---

<div id="calendar-card" class="bg-surface-card rounded-[2.5rem] p-6 shadow-sm overflow-hidden select-none closed-mode relative" data-expanded="false">
  <div class="flex flex-col gap-1 mb-6 relative z-10">
    <div class="flex items-center justify-between">
      <span id="header-date-suffix" class="text-2xl sm:text-3xl font-black text-black tracking-tight whitespace-nowrap">{initialDateNumMonthYear}</span>
      <button id="calendar-expand-btn" aria-label="Comută vizualizarea lunii" class="w-11 h-11 rounded-full bg-brand-primary text-black flex items-center justify-center active:scale-95 transition-transform shrink-0 shadow-sm z-30">
        <svg class="w-5 h-5 transition-transform duration-500 ease-in-out" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </button>
    </div>

    <div class="flex items-center justify-start min-h-[1.25rem]">
      <span id="calendar-month-year" class="text-sm font-black text-brand-secondary transition-opacity duration-200 opacity-0"></span>
    </div>
  </div>

  <div id="calendar-strip" data-calendar-strip class="relative w-[calc(100%+3rem)] -mx-6 px-6 transition-[opacity,transform] duration-500 ease-in-out closed-mode">

    <div
      id="calendar-active-pill"
      class="absolute bg-brand-primary pointer-events-none z-0"
      style="left: 0; top: 0; width: 0; height: 0; opacity: 0; border-radius: 2rem;"
    ></div>
    <div
      id="calendar-active-circle"
      class="absolute w-8 h-8 rounded-full bg-white shadow-md pointer-events-none z-10"
      style="left: 0; top: 0; opacity: 0;"
    ></div>

    <div id="weeks-strip">
      {allWeeksFlat.map((week, weekIndex) => (
        <div
          class={`week-section relative flex flex-col shrink-0 w-full snap-center snap-always ${week.isCurrentWeek ? 'active-week' : ''}`}
          data-is-current-week={week.isCurrentWeek ? "true" : "false"}
          data-week-index={weekIndex}
        >
          <div class="day-labels-row flex flex-row justify-between items-center px-2">
            {weekDayLabels.map((label) => (
              <span class="day-label text-center text-base font-black uppercase tracking-wider flex-1 max-w-[4.5rem] mx-auto leading-tight" style="color: #C93263 !important;">{label}</span>
            ))}
          </div>
          <div class="dates-row flex flex-row justify-between items-center px-2">
            {week.days.map((item, index) => (
              <button
                type="button"
                data-calendar-item
                data-active={item.active ? "true" : "false"}
                data-index={index}
                data-month={item.monthNum}
                data-year={item.year}
                data-date={item.date}
                data-is-current-month="true"
                data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                class={`relative z-20 flex flex-col items-center justify-center w-14 h-12 mx-auto rounded-2xl transition-colors duration-300 ${
                  item.active
                    ? "text-black font-bold"
                    : "text-text-main hover:opacity-100 opacity-100"
                }`}
              >
                <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                  {item.date}
                </span>
                {item.isToday && (
                  <span class={`today-dot absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                )}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="months-strip">
      {initialMonths.map((month) => (
        <div
          data-month-section={month.monthOffset}
          data-month-name={month.monthName}
          data-month-num={month.monthNum}
          data-year={month.year}
          id={month.isCurrentMonth ? "current-month-section" : undefined}
          class="month-section flex flex-col shrink-0 w-full snap-center snap-always gap-0 overflow-hidden"
        >
          <div class="day-labels-row flex flex-row justify-between items-center px-2">
            {weekDayLabels.map((label) => (
              <span class="day-label text-center text-base font-black uppercase tracking-wider flex-1 max-w-[4.5rem] mx-auto leading-tight" style="color: #C93263 !important;">{label}</span>
            ))}
          </div>
          {month.weekIndices.map(wi => {
            const week = allWeeksFlat[wi];
            return (
              <div
                class={`week-section relative flex flex-row justify-between items-center px-2 transition-[height,opacity] duration-500 ease-in-out snap-center snap-always ${week.isCurrentWeek ? 'active-week' : ''}`}
                data-is-current-week={week.isCurrentWeek ? "true" : "false"}
                data-week-index={wi}
              >
                {week.days.map((item, index) => {
                  const isCurrentMonth = item.monthNum === month.monthNum;
                  return (
                    <button
                      type="button"
                      data-calendar-item
                      data-active={item.active ? "true" : "false"}
                      data-index={index}
                      data-month={item.monthNum}
                      data-year={item.year}
                      data-date={item.date}
                      data-is-current-month={isCurrentMonth ? "true" : "false"}
                      data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                      class={`relative z-20 flex flex-col items-center justify-center w-14 h-[46px] mx-auto rounded-2xl transition-colors duration-300 ${
                        item.active
                          ? "text-black font-bold"
                          : isCurrentMonth
                            ? "text-text-main hover:opacity-100 opacity-70"
                            : "text-text-main hover:opacity-60 opacity-30"
                      }`}
                    >
                      <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                        {item.date}
                      </span>
                      {item.isToday && (
                        <span class={`today-dot absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                      )}
                    </button>
                  );
                })}
              </div>
            );
          })}
        </div>
      ))}
    </div>

    <template id="lazy-months-before-template">
      {beforeMonths.map((month) => (
        <div
          data-month-section={month.monthOffset}
          data-month-name={month.monthName}
          data-month-num={month.monthNum}
          data-year={month.year}
          class="month-section flex flex-col shrink-0 w-full snap-center snap-always gap-0 overflow-hidden"
        >
          <div class="day-labels-row flex flex-row justify-between items-center px-2">
            {weekDayLabels.map((label) => (
              <span class="day-label text-center text-base font-black uppercase tracking-wider flex-1 max-w-[4.5rem] mx-auto leading-tight" style="color: #C93263 !important;">{label}</span>
            ))}
          </div>
          {month.weekIndices.map(wi => {
            const week = allWeeksFlat[wi];
            return (
              <div
                class={`week-section relative flex flex-row justify-between items-center px-2 transition-[height,opacity] duration-500 ease-in-out snap-center snap-always ${week.isCurrentWeek ? 'active-week' : ''}`}
                data-is-current-week={week.isCurrentWeek ? "true" : "false"}
                data-week-index={wi}
              >
                {week.days.map((item, index) => {
                  const isCurrentMonth = item.monthNum === month.monthNum;
                  return (
                    <button
                      type="button"
                      data-calendar-item
                      data-active={item.active ? "true" : "false"}
                      data-index={index}
                      data-month={item.monthNum}
                      data-year={item.year}
                      data-date={item.date}
                      data-is-current-month={isCurrentMonth ? "true" : "false"}
                      data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                      class={`relative z-20 flex flex-col items-center justify-center w-14 h-[46px] mx-auto rounded-2xl transition-colors duration-300 ${
                        item.active
                          ? "text-black font-bold"
                          : isCurrentMonth
                            ? "text-text-main hover:opacity-100 opacity-70"
                            : "text-text-main hover:opacity-60 opacity-30"
                      }`}
                    >
                      <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                        {item.date}
                      </span>
                      {item.isToday && (
                        <span class={`today-dot absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                      )}
                    </button>
                  );
                })}
              </div>
            );
          })}
        </div>
      ))}
    </template>

    <template id="lazy-months-after-template">
      {afterMonths.map((month) => (
        <div
          data-month-section={month.monthOffset}
          data-month-name={month.monthName}
          data-month-num={month.monthNum}
          data-year={month.year}
          class="month-section flex flex-col shrink-0 w-full snap-center snap-always gap-0 overflow-hidden"
        >
          <div class="day-labels-row flex flex-row justify-between items-center px-2">
            {weekDayLabels.map((label) => (
              <span class="day-label text-center text-base font-black uppercase tracking-wider flex-1 max-w-[4.5rem] mx-auto leading-tight" style="color: #C93263 !important;">{label}</span>
            ))}
          </div>
          {month.weekIndices.map(wi => {
            const week = allWeeksFlat[wi];
            return (
              <div
                class={`week-section relative flex flex-row justify-between items-center px-2 transition-[height,opacity] duration-500 ease-in-out snap-center snap-always ${week.isCurrentWeek ? 'active-week' : ''}`}
                data-is-current-week={week.isCurrentWeek ? "true" : "false"}
                data-week-index={wi}
              >
                {week.days.map((item, index) => {
                  const isCurrentMonth = item.monthNum === month.monthNum;
                  return (
                    <button
                      type="button"
                      data-calendar-item
                      data-active={item.active ? "true" : "false"}
                      data-index={index}
                      data-month={item.monthNum}
                      data-year={item.year}
                      data-date={item.date}
                      data-is-current-month={isCurrentMonth ? "true" : "false"}
                      data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                      class={`relative z-20 flex flex-col items-center justify-center w-14 h-[46px] mx-auto rounded-2xl transition-colors duration-300 ${
                        item.active
                          ? "text-black font-bold"
                          : isCurrentMonth
                            ? "text-text-main hover:opacity-100 opacity-70"
                            : "text-text-main hover:opacity-60 opacity-30"
                      }`}
                    >
                      <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                        {item.date}
                      </span>
                      {item.isToday && (
                        <span class={`today-dot absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                      )}
                    </button>
                  );
                })}
              </div>
            );
          })}
        </div>
      ))}
    </template>

  </div>
</div>

<script>
  function initCalendarAnimation() {
    const card = document.getElementById("calendar-card") as HTMLElement;
    const strip = document.getElementById("calendar-strip") as HTMLElement;
    const weeksStrip = document.getElementById("weeks-strip") as HTMLElement;
    const monthsStrip = document.getElementById("months-strip") as HTMLElement;
    const expandBtn = document.getElementById("calendar-expand-btn") as HTMLButtonElement;
    const pill = document.getElementById("calendar-active-pill") as HTMLElement;
    const circle = document.getElementById("calendar-active-circle") as HTMLElement;
    if (!strip || !weeksStrip || !monthsStrip || !pill || !circle || !card || !expandBtn) return;
    if (strip.dataset.calendarAnimated === 'true') return;
    strip.dataset.calendarAnimated = 'true';

    const icon = expandBtn.querySelector("svg");
    if (icon) icon.style.transform = "rotate(0deg)";

    let dropTimeout: number | undefined;
    let scrollTimer: number | undefined;
    let isProgrammaticScroll = false;
    let isExpanded = false;

    function getActiveButtonIn(container: HTMLElement) {
      return container.querySelector<HTMLButtonElement>('[data-active="true"]');
    }



    function findButtonByDate(year: string, month: string, date: string, container: HTMLElement) {
      return container.querySelector<HTMLButtonElement>(`[data-calendar-item][data-year="${year}"][data-month="${month}"][data-date="${date}"]`);
    }

    function findButtonByDateInMonths(year: string, month: string, date: string) {
      // Boundary weeks appear in two month sections. Pick the instance whose
      // month section matches the date's actual month.
      const buttons = Array.from(monthsStrip.querySelectorAll<HTMLButtonElement>(
        `[data-calendar-item][data-year="${year}"][data-month="${month}"][data-date="${date}"]`
      ));
      return buttons.find(btn => {
        const section = btn.closest('[data-month-num]') as HTMLElement | null;
        return section && section.getAttribute('data-month-num') === month;
      }) || buttons[0] || null;
    }

    function scrollToActiveWeek() {
      if (isExpanded) return;
      const activeWeek = weeksStrip.querySelector('.week-section.active-week') as HTMLElement | null;
      if (!activeWeek) return;
      isProgrammaticScroll = true;
      weeksStrip.scrollLeft = activeWeek.offsetLeft;
      setTimeout(() => { isProgrammaticScroll = false; }, 300);
    }
    setTimeout(scrollToActiveWeek, 50);

    // Lazy/incremental month loading for the expanded view.
    const lazyBeforeTemplate = document.getElementById("lazy-months-before-template") as HTMLTemplateElement | null;
    const lazyAfterTemplate = document.getElementById("lazy-months-after-template") as HTMLTemplateElement | null;

    function prependLazyMonths(count: number) {
      if (!lazyBeforeTemplate || !monthsStrip) return;
      const fragment = lazyBeforeTemplate.content;
      const toMove: HTMLElement[] = [];
      for (let i = 0; i < count && fragment.firstElementChild; i++) {
        const el = fragment.firstElementChild as HTMLElement;
        toMove.push(el);
      }
      if (toMove.length === 0) return;

      const monthWidth = monthsStrip.offsetWidth;
      const addedWidth = toMove.length * monthWidth;
      const oldScrollLeft = monthsStrip.scrollLeft;

      toMove.reverse().forEach((el) => {
        monthsStrip.insertBefore(el, monthsStrip.firstChild);
      });

      isProgrammaticScroll = true;
      monthsStrip.scrollLeft = oldScrollLeft + addedWidth;
      requestAnimationFrame(() => { isProgrammaticScroll = false; });
    }

    function appendLazyMonths(count: number) {
      if (!lazyAfterTemplate || !monthsStrip) return;
      const fragment = lazyAfterTemplate.content;
      const toMove: HTMLElement[] = [];
      for (let i = 0; i < count && fragment.firstElementChild; i++) {
        const el = fragment.firstElementChild as HTMLElement;
        toMove.push(el);
      }
      if (toMove.length === 0) return;

      toMove.forEach((el) => {
        monthsStrip.appendChild(el);
      });
    }

    function handleLazyMonthsScroll() {
      if (!isExpanded || isProgrammaticScroll) return;
      const threshold = monthsStrip.offsetWidth * 0.5;
      if (monthsStrip.scrollLeft < threshold) {
        prependLazyMonths(3);
      }
      const maxScroll = monthsStrip.scrollWidth - monthsStrip.offsetWidth;
      if (maxScroll - monthsStrip.scrollLeft < threshold) {
        appendLazyMonths(3);
      }
    }

    function updatePillForButton(button: HTMLButtonElement | null, opts: { immediate?: boolean; morph?: boolean; duration?: number; previousTarget?: HTMLButtonElement | null; startRects?: any } = {}) {
      if (!button || !pill || !circle) return;
      const { immediate = false, morph = false, duration = 400 } = opts;

      const section = (button.closest('.week-section') || button.closest('.month-section')) as HTMLElement | null;
      if (!section) return;

      const numSpan = button.querySelector<HTMLElement>('.date-number');
      const left = button.offsetLeft;
      const top = button.offsetTop;
      const width = button.offsetWidth;
      const height = button.offsetHeight;
      const cLeft = left + (numSpan ? numSpan.offsetLeft : (width - 32) / 2);
      const cTop = top + (numSpan ? numSpan.offsetTop : (height - 32) / 2);

      const pillW = isExpanded ? 40 : 48;
      const pillH = isExpanded ? 40 : 92;
      const pillL = left + (width - pillW) / 2;
      const pillT = isExpanded ? (top + (height - 40) / 2) : (top - 46);
      const pillBR = isExpanded ? "50%" : "24px";

      const ensureParent = () => {
        if (pill.parentElement !== section) {
          section.insertBefore(pill, section.firstChild);
        }
        if (circle.parentElement !== section) {
          section.appendChild(circle);
        }
      };

      if (immediate) {
        ensureParent();
        pill.style.transition = "none";
        circle.style.transition = "none";
        pill.style.opacity = "1";
        circle.style.opacity = "1";
        pill.style.width = `${pillW}px`;
        pill.style.height = `${pillH}px`;
        pill.style.borderRadius = pillBR;
        pill.style.transform = `translate(${pillL}px, ${pillT}px)`;
        circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
        return;
      }

      if (morph) {
        const startPillRect = opts.startRects?.pill || pill.getBoundingClientRect();
        const startCircleRect = opts.startRects?.circle || circle.getBoundingClientRect();
        const startPillRadius = opts.startRects?.radius || parseFloat(getComputedStyle(pill).borderRadius) || Math.min(startPillRect.width, startPillRect.height) / 2;

        ensureParent();
        const sectionRect = section.getBoundingClientRect();

        const startPillLeft = startPillRect.left - sectionRect.left;
        const startPillTop = startPillRect.top - sectionRect.top;
        const startCircleLeft = startCircleRect.left - sectionRect.left;
        const startCircleTop = startCircleRect.top - sectionRect.top;

        pill.style.transition = "none";
        pill.style.opacity = "1";
        pill.style.width = `${startPillRect.width}px`;
        pill.style.height = `${startPillRect.height}px`;
        pill.style.borderRadius = `${startPillRadius}px`;
        pill.style.transform = `translate(${startPillLeft}px, ${startPillTop}px)`;

        circle.style.transition = "none";
        circle.style.opacity = "1";
        circle.style.transform = `translate(${startCircleLeft}px, ${startCircleTop}px) scale(1)`;

        void pill.offsetWidth;

        const easing = "cubic-bezier(0.4, 0, 0.2, 1)";
        pill.style.transition = `transform ${duration}ms ${easing}, width ${duration}ms ${easing}, height ${duration}ms ${easing}, border-radius ${duration}ms ease`;
        circle.style.transition = `transform ${duration}ms ${easing}`;

        pill.style.width = `${pillW}px`;
        pill.style.height = `${pillH}px`;
        pill.style.borderRadius = pillBR;
        pill.style.transform = `translate(${pillL}px, ${pillT}px)`;
        circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;

        window.setTimeout(() => {
          pill.style.transition = "";
          circle.style.transition = "";
        }, duration);
        return;
      }

      const bouncyEasing = "cubic-bezier(0.34, 1.56, 0.64, 1)";
      
      let startPillLeft = pillL;
      let startPillTop = pillT;
      let startCircleLeft = cLeft;
      let startCircleTop = cTop;
      
      if (opts.previousTarget) {
        const startPillRect = pill.getBoundingClientRect();
        const startCircleRect = circle.getBoundingClientRect();
        const sectionRect = section.getBoundingClientRect();
        
        startPillLeft = startPillRect.left - sectionRect.left;
        startPillTop = startPillRect.top - sectionRect.top;
        startCircleLeft = startCircleRect.left - sectionRect.left;
        startCircleTop = startCircleRect.top - sectionRect.top;
      }
      
      ensureParent();
      
      // Initial state: instantly at the old position
      pill.style.transition = "none";
      circle.style.transition = "none";
      pill.style.opacity = "1";
      circle.style.opacity = "1";
      pill.style.transform = `translate(${startPillLeft}px, ${startPillTop}px) scale(1)`;
      circle.style.transform = `translate(${startCircleLeft}px, ${startCircleTop}px) scale(1)`;
      
      // Force reflow
      void pill.offsetWidth;
      void circle.offsetWidth;
      
      // Final state: transition to the new position with bounce and circle delay
      pill.style.transition = `transform 400ms ${bouncyEasing}, width 400ms, height 400ms, border-radius 400ms`;
      circle.style.transition = `transform 400ms ${bouncyEasing} 150ms`; // 150ms delay
      
      pill.style.width = `${pillW}px`;
      pill.style.height = `${pillH}px`;
      pill.style.borderRadius = pillBR;
      pill.style.transform = `translate(${pillL}px, ${pillT}px) scale(1)`;
      
      circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
    }

    // --- SWIPE / DRAG LOGIC ---
    let isDragging = false;
    let startX = 0;
    let currentX = 0;
    let initialScrollLeft = 0;
    let activeStrip: HTMLElement | null = null;

    const startDrag = (e: MouseEvent | TouchEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest('button')) return;
      activeStrip = isExpanded ? monthsStrip : weeksStrip;
      isDragging = true;
      startX = e.type.includes('mouse') ? (e as MouseEvent).pageX : (e as TouchEvent).touches[0].pageX;
      initialScrollLeft = activeStrip.scrollLeft;
      activeStrip.style.scrollSnapType = 'none';
      activeStrip.style.scrollBehavior = 'auto';
    };

    const doDrag = (e: MouseEvent | TouchEvent) => {
      if (!isDragging || !activeStrip) return;
      e.preventDefault();
      currentX = e.type.includes('mouse') ? (e as MouseEvent).pageX : (e as TouchEvent).touches[0].pageX;
      const diff = startX - currentX;
      activeStrip.scrollLeft = initialScrollLeft + diff;
    };

    const endDrag = () => {
      if (!isDragging || !activeStrip) return;
      isDragging = false;
      activeStrip.style.scrollSnapType = 'x mandatory';
      activeStrip.style.scrollBehavior = 'smooth';
      const snapPoints = Array.from(activeStrip.children) as HTMLElement[];
      let closest = snapPoints[0];
      let minDiff = Infinity;
      const center = activeStrip.scrollLeft + activeStrip.clientWidth / 2;
      snapPoints.forEach(p => {
        const pCenter = p.offsetLeft + p.clientWidth / 2;
        const diff = Math.abs(pCenter - center);
        if (diff < minDiff) {
          minDiff = diff;
          closest = p;
        }
      });
      if (closest) {
        isProgrammaticScroll = true;
        activeStrip.scrollLeft = closest.offsetLeft;
        setTimeout(() => { isProgrammaticScroll = false; }, 300);
      }
      activeStrip = null;
    };

    strip.addEventListener('mousedown', startDrag);
    strip.addEventListener('mousemove', doDrag);
    window.addEventListener('mouseup', endDrag);
    strip.addEventListener('touchstart', startDrag, { passive: true });
    strip.addEventListener('touchmove', doDrag, { passive: false });
    window.addEventListener('touchend', endDrag);

    // --- EVENT LISTENERS FOR CLICKS & SCROLL ---
    function selectDay(button: HTMLButtonElement, clickOriginated = false, skipScroll = false) {
      if (dropTimeout) window.clearTimeout(dropTimeout);

      const previousTarget = document.querySelector('[data-active="true"]') as HTMLButtonElement | null;

      const allBtns = document.querySelectorAll('[data-calendar-item]');
      allBtns.forEach(btn => {
        btn.setAttribute("data-active", "false");
        btn.classList.remove("text-black", "font-bold");
        btn.classList.add("text-text-main", "opacity-100");
        const dSpan = btn.querySelector("span:last-child");
        if (dSpan) {
          dSpan.classList.remove("text-black");
          dSpan.classList.add("text-text-main");
        }
        const tDot = btn.querySelector<HTMLElement>(".today-dot");
        if (tDot) {
          tDot.classList.remove("opacity-0", "z-0", "scale-50");
          tDot.classList.add("opacity-100", "z-20", "scale-100");
        }
        const pw = btn.closest(".week-section") as HTMLElement | null;
        if (pw) pw.classList.remove("active-week");
      });

      const parentStrip = button.closest("#weeks-strip, #months-strip");
      const y = button.getAttribute("data-year");
      const m = button.getAttribute("data-month");
      const d = button.getAttribute("data-date");
      const fullDate = button.getAttribute("data-full-date");

      const headerText = document.getElementById("calendar-selected-date");
      if (headerText && fullDate) headerText.textContent = fullDate;

      if (y && m && d) {
        const weeksBtn = parentStrip === weeksStrip
          ? button
          : findButtonByDate(y, m, d, weeksStrip);
        const monthsBtn = parentStrip === monthsStrip
          ? button
          : findButtonByDateInMonths(y, m, d);

        [weeksBtn, monthsBtn].forEach(btn => {
            if (!btn) return;
            btn.setAttribute("data-active", "true");
            btn.classList.add("text-black", "font-bold");
            btn.classList.remove("opacity-100");
            const dSpan = btn.querySelector("span:last-child");
            if (dSpan) {
              dSpan.classList.add("text-black");
              dSpan.classList.remove("text-text-main");
            }
            const tDot = btn.querySelector<HTMLElement>(".today-dot");
            if (tDot) {
              tDot.classList.add("opacity-0", "z-0", "scale-50");
              tDot.classList.remove("opacity-100", "z-20", "scale-100");
            }
        });
      }

      const parentWeek = button.closest(".week-section") as HTMLElement | null;
      if (parentWeek) parentWeek.classList.add("active-week");

      if (!skipScroll) {
        if (!isExpanded && parentStrip === weeksStrip && parentWeek) {
          isProgrammaticScroll = true;
          weeksStrip.scrollLeft = parentWeek.offsetLeft;
          setTimeout(() => { isProgrammaticScroll = false; }, 300);
        }

        if (isExpanded && parentStrip === monthsStrip) {
          const activeMonthSection = button.closest('[data-month-section]') as HTMLElement | null;
          if (activeMonthSection) {
            isProgrammaticScroll = true;
            monthsStrip.scrollLeft = activeMonthSection.offsetLeft;
            setTimeout(() => { isProgrammaticScroll = false; }, 300);
          }
        }
      }

      if (y && m && d) {
        localStorage.setItem('selectedCalendarDate', `${y}-${m}-${d}`);
      }

      updatePillForButton(button, { immediate: !clickOriginated, previousTarget });
      updateMonthYearLabel();
    }

    function getVisibleActiveButton() {
      if (isExpanded) {
        let active = monthsStrip.querySelector<HTMLButtonElement>('[data-active="true"]');
        if (active) return active;
        const currentMonthSection = document.getElementById('current-month-section');
        if (currentMonthSection) {
          return currentMonthSection.querySelector<HTMLButtonElement>('[data-is-current-month="true"]');
        }
        return null;
      }
      return weeksStrip.querySelector<HTMLButtonElement>('[data-active="true"]') || weeksStrip.querySelector<HTMLButtonElement>('button');
    }

    function updateMonthYearLabel() {
      const activeBtn = getVisibleActiveButton();
      if (!activeBtn) return;
      const monthYearLabel = document.getElementById("calendar-month-year");
      if (monthYearLabel) {
        let y = activeBtn.getAttribute("data-year");
        let mNum = parseInt(activeBtn.getAttribute("data-month") || "1", 10);
        if (isExpanded) {
          const monthSection = activeBtn.closest('.month-section');
          if (monthSection) {
            const mName = monthSection.getAttribute("data-month-name") || "";
            monthYearLabel.textContent = `${mName} ${y}`;
            return;
          }
        }
        const d = new Date(parseInt(y || "2026", 10), mNum - 1, 1);
        const mName = d.toLocaleString('ro-RO', { month: 'long' });
        monthYearLabel.textContent = `${mName.charAt(0).toUpperCase() + mName.slice(1)} ${y}`;
      }
    }

    function getActiveWeekOffset(button: HTMLButtonElement | null) {
      if (!button) return 0;
      const weekSection = button.closest('.week-section') as HTMLElement | null;
      const monthSection = button.closest('.month-section') as HTMLElement | null;
      if (!weekSection || !monthSection) return 0;
      const siblings = Array.from(monthSection.children).filter(
        (el): el is HTMLElement => el.classList.contains('week-section')
      );
      const weekIndex = siblings.indexOf(weekSection);
      return Math.max(0, weekIndex) * 3.5;
    }

    expandBtn.addEventListener("click", () => {
      const startPillRect = pill.getBoundingClientRect();
      const startCircleRect = circle.getBoundingClientRect();
      const startPillRadius = parseFloat(getComputedStyle(pill).borderRadius) || Math.min(startPillRect.width, startPillRect.height) / 2;

      const activeBtn = getVisibleActiveButton();
      let targetBtn: HTMLButtonElement | null = null;
      let weekOffsetRem = 0;

      if (!isExpanded && activeBtn) {
        const y = activeBtn.getAttribute("data-year") || "";
        const m = activeBtn.getAttribute("data-month") || "";
        const d = activeBtn.getAttribute("data-date") || "";
        targetBtn = findButtonByDateInMonths(y, m, d);
        weekOffsetRem = getActiveWeekOffset(targetBtn);
      } else {
        weekOffsetRem = getActiveWeekOffset(activeBtn);
      }

      if (!isExpanded && targetBtn) {
        const activeMonthSection = targetBtn.closest('[data-month-section]') as HTMLElement | null;
        if (activeMonthSection) {
          isProgrammaticScroll = true;
          monthsStrip.scrollLeft = activeMonthSection.offsetLeft;
        }
      } else if (isExpanded && activeBtn) {
        const y = activeBtn.getAttribute("data-year");
        const m = activeBtn.getAttribute("data-month");
        const d = activeBtn.getAttribute("data-date");
        if (y && m && d) {
          const weeksBtn = findButtonByDate(y, m, d, weeksStrip);
          const activeWeek = weeksBtn ? weeksBtn.closest('.week-section') as HTMLElement | null : null;
          if (activeWeek) {
            isProgrammaticScroll = true;
            weeksStrip.scrollLeft = activeWeek.offsetLeft;
          }
        }
      }
      const countSource = targetBtn || activeBtn;
      const monthSectionForCount = countSource?.closest('.month-section') as HTMLElement | null;
      const weekCount = monthSectionForCount
        ? Array.from(monthSectionForCount.children).filter((el) => el.classList.contains('week-section')).length
        : 6;
      strip.style.setProperty('--active-week-count', `${weekCount}`);

      strip.style.setProperty('--active-week-offset', `${weekOffsetRem}rem`);

      isExpanded = !isExpanded;
      card.dataset.expanded = isExpanded ? "true" : "false";

      const icon = expandBtn.querySelector("svg");
      if (icon) {
        icon.style.transform = isExpanded ? "rotate(45deg)" : "rotate(0deg)";
      }

      const monthYearLabel = document.getElementById("calendar-month-year");

      requestAnimationFrame(() => {
        card.classList.add("is-animating");
        strip.classList.add("is-animating");

        if (isExpanded) {
          card.classList.remove("closed-mode");
          card.classList.add("expanded-mode");
          strip.classList.remove("closed-mode");
          strip.classList.add("expanded-mode");

          if (targetBtn) {
            selectDay(targetBtn, false, true);
          } else {
            const currentMonthSection = document.getElementById('current-month-section');
            if (currentMonthSection) {
              isProgrammaticScroll = true;
              monthsStrip.scrollLeft = currentMonthSection.offsetLeft;
            }
          }

          updateMonthYearLabel();
          if (monthYearLabel) monthYearLabel.classList.remove("opacity-0");
        } else {
          card.classList.remove("expanded-mode");
          card.classList.add("closed-mode");
          strip.classList.remove("expanded-mode");
          strip.classList.add("closed-mode");
          if (monthYearLabel) monthYearLabel.classList.add("opacity-0");
        }

        const targetForMorph = isExpanded ? targetBtn : activeBtn;
        if (targetForMorph) {
          updatePillForButton(targetForMorph, { 
            morph: true, 
            duration: 600,
            startRects: { pill: startPillRect, circle: startCircleRect, radius: startPillRadius }
          });
        }
      });

      window.setTimeout(() => {
        card.classList.remove("is-animating");
        strip.classList.remove("is-animating");
        isProgrammaticScroll = false;

        const steadyActiveBtn = getVisibleActiveButton();
        if (steadyActiveBtn) updatePillForButton(steadyActiveBtn, { immediate: true });
      }, 620);
    });

    const allButtons = Array.from(strip.querySelectorAll<HTMLButtonElement>('[data-calendar-item]'));
    allButtons.forEach(button => {
      if (button.dataset.clickAttached === "true") return;
      button.dataset.clickAttached = "true";
      button.addEventListener("click", (e) => {
        e.preventDefault();
        selectDay(button, true);
      });
    });

    requestAnimationFrame(() => {
      const savedDate = localStorage.getItem('selectedCalendarDate');
      const todayStr = new Date().getFullYear() + '-' + String(new Date().getMonth() + 1).padStart(2, '0') + '-' + String(new Date().getDate()).padStart(2, '0');
      let activeBtn = getVisibleActiveButton();

      if (savedDate && savedDate === todayStr) {
        const targetBtn = allButtons.find((b) => {
          const y = b.getAttribute("data-year");
          const m = b.getAttribute("data-month");
          const d = b.getAttribute("data-date");
          if (!y || !m || !d) return false;
          const dateStr = `${y}-${(parseInt(m)+1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
          return dateStr === savedDate;
        });
        if (targetBtn) {
          selectDay(targetBtn, false);
          activeBtn = getVisibleActiveButton();
        }
      } else if (savedDate) {
        localStorage.removeItem('selectedCalendarDate');
      }

      if (activeBtn) {
        const y = activeBtn.getAttribute("data-year");
        const m = activeBtn.getAttribute("data-month");
        const d = activeBtn.getAttribute("data-date");
        const initialMonthTarget = findButtonByDateInMonths(y || "", m || "", d || "");
        if (initialMonthTarget) {
          const offset = getActiveWeekOffset(initialMonthTarget);
          strip.style.setProperty('--active-week-offset', `${offset}rem`);
        }
        updatePillForButton(activeBtn, { immediate: true });
        if (y && m && d) {
          const dateStr = `${y}-${(parseInt(m)+1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
          window.dispatchEvent(new CustomEvent('calendarDateSelected', { detail: { date: dateStr } }));
        }
      }

    });

    if ((window as any)._weeklyCalendarResizeHandler) {
      window.removeEventListener("resize", (window as any)._weeklyCalendarResizeHandler);
    }
    const handleResize = () => {
      const activeBtn = getVisibleActiveButton();
      if (activeBtn) updatePillForButton(activeBtn, { immediate: true });
      if (isExpanded) requestAnimationFrame(updateMonthYearLabel);
    };
    (window as any)._weeklyCalendarResizeHandler = handleResize;
    window.addEventListener("resize", handleResize);

    function updateExpandedMonthYearLabel() {
      const monthSections = Array.from(monthsStrip.querySelectorAll<HTMLElement>(".month-section"));
      if (!monthSections.length) return;

      const center = monthsStrip.scrollLeft + monthsStrip.offsetWidth / 2;
      let nearestIdx = 0;
      let minDist = Infinity;
      monthSections.forEach((section, idx) => {
        const sectionCenter = section.offsetLeft + section.offsetWidth / 2;
        const dist = Math.abs(center - sectionCenter);
        if (dist < minDist) {
          minDist = dist;
          nearestIdx = idx;
        }
      });

      const section = monthSections[nearestIdx];
      let monthName = section.getAttribute("data-month-name") || '';
      const year = section.getAttribute("data-year");
      const monthYearLabel = document.getElementById("calendar-month-year");
      if (monthYearLabel && monthName && year) {
        monthName = monthName.charAt(0).toUpperCase() + monthName.slice(1);
        monthYearLabel.textContent = `${monthName} ${year}`;
      }
    }

    function handleWeeksScroll() {
      if (isProgrammaticScroll) return;
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const allWeeks = Array.from(weeksStrip.querySelectorAll<HTMLElement>(".week-section"));
        if (allWeeks.length === 0) return;

        const center = weeksStrip.scrollLeft + weeksStrip.offsetWidth / 2;
        let targetWeek: HTMLElement | null = null;
        for (const w of allWeeks) {
          const left = w.offsetLeft;
          const right = left + w.offsetWidth;
          if (center >= left && center < right) {
            targetWeek = w;
            break;
          }
        }
        if (!targetWeek) targetWeek = allWeeks[allWeeks.length - 1];

        const activeDay = weeksStrip.querySelector('[data-active="true"]') as HTMLButtonElement | null;
        const activeDayIndex = activeDay ? parseInt(activeDay.getAttribute('data-index') || '0', 10) : 0;
        const targetBtn = targetWeek.querySelector(`[data-calendar-item][data-index="${activeDayIndex}"]`) as HTMLButtonElement | null
          || targetWeek.querySelector('[data-calendar-item]') as HTMLButtonElement | null;
        if (targetBtn && targetBtn.getAttribute('data-active') !== 'true') {
          selectDay(targetBtn, true);
        }
      }, 150);
    }

    function handleMonthsScroll() {
      if (isProgrammaticScroll) return;
      requestAnimationFrame(updateExpandedMonthYearLabel);
    }

    weeksStrip.addEventListener("scroll", handleWeeksScroll);
    monthsStrip.addEventListener("scroll", handleMonthsScroll);
    monthsStrip.addEventListener("scroll", handleLazyMonthsScroll);

    updateMonthYearLabel();
  }

  function bootCalendar() {
    requestAnimationFrame(() => {
      initCalendarAnimation();
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootCalendar();
  } else {
    document.addEventListener("DOMContentLoaded", bootCalendar);
  }
  document.addEventListener("astro:page-load", bootCalendar);
  document.addEventListener("astro:after-swap", bootCalendar);
</script>

