---
interface Props {
  name?: string;
}

const { name = "Dr. Maria" } = Astro.props;

const now = new Date();
const weekDayLabels = ["L", "M", "M", "J", "V"];
const fullDayNames = ["Luni", "Marți", "Miercuri", "Joi", "Vineri"];

const totalMonths = 24;
const startMonthOffset = -12;

const today = new Date(now);
today.setHours(0, 0, 0, 0);
const currentDay = today.getDay();
// If it's Saturday (6) or Sunday (0), jump forward to the upcoming Monday
const offsetToMonday = currentDay === 0 ? 1 : (currentDay === 6 ? 2 : 1 - currentDay);
const todayMonday = new Date(today);
todayMonday.setDate(today.getDate() + offsetToMonday);
todayMonday.setHours(0, 0, 0, 0);

// Build a flat list of consecutive weeks spanning the whole range
const firstMonthDate = new Date(now.getFullYear(), now.getMonth() + startMonthOffset, 1);
let firstMonday = new Date(firstMonthDate);
const firstDayOfWeek = firstMonday.getDay();
firstMonday.setDate(firstMonday.getDate() - (firstDayOfWeek === 0 ? 6 : firstDayOfWeek - 1));

const lastMonthDate = new Date(now.getFullYear(), now.getMonth() + startMonthOffset + totalMonths - 1, 1);
const lastDayOfLastMonth = new Date(lastMonthDate.getFullYear(), lastMonthDate.getMonth() + 1, 0);

const allWeeksFlat: any[] = [];
let currentMonday = new Date(firstMonday);
let weekIndexGlobal = 0;
while (currentMonday <= lastDayOfLastMonth) {
  const weekDays = [];
  const weekMon = new Date(currentMonday);
  weekMon.setHours(0, 0, 0, 0);
  const isCurrentWeek = weekMon.getTime() === todayMonday.getTime();

  for (let d = 0; d < 5; d++) {
    const dayDate = new Date(currentMonday);
    dayDate.setDate(currentMonday.getDate() + d);
    const isToday = dayDate.toDateString() === now.toDateString();

    weekDays.push({
      date: dayDate.getDate(),
      shortMonthName: dayDate.toLocaleString('ro-RO', { month: 'short' }),
      monthNum: dayDate.getMonth(),
      year: dayDate.getFullYear(),
      fullDay: fullDayNames[d],
      dayLabel: weekDayLabels[d],
      isToday,
      isCurrentMonth: false,
      active: false
    });
  }

  allWeeksFlat.push({
    weekStartDate: new Date(currentMonday),
    days: weekDays,
    isCurrentWeek,
    weekIndex: weekIndexGlobal
  });

  currentMonday.setDate(currentMonday.getDate() + 7);
  weekIndexGlobal++;
}

// Build months that reference the flat weeks
const allMonths = Array.from({ length: totalMonths }).map((_, monthIndex) => {
  const mOffset = startMonthOffset + monthIndex;
  const targetDate = new Date(now.getFullYear(), now.getMonth() + mOffset, 1);
  const year = targetDate.getFullYear();
  const monthNum = targetDate.getMonth();
  const monthName = targetDate.toLocaleString('ro-RO', { month: 'long' });
  const shortMonthName = targetDate.toLocaleString('ro-RO', { month: 'short' });
  const isCurrentMonth = mOffset === 0;

  const lastDayOfMonth = new Date(year, monthNum + 1, 0);

  const weeks = allWeeksFlat.filter(w => {
    const weekEnd = new Date(w.weekStartDate);
    weekEnd.setDate(weekEnd.getDate() + 6);
    return w.weekStartDate <= lastDayOfMonth && weekEnd >= targetDate;
  });

  // Mark days that belong to this month
  weeks.forEach(w => {
    w.days.forEach((day: any) => {
      if (day.monthNum === monthNum) day.isCurrentMonth = true;
    });
  });

  return {
    monthOffset: mOffset,
    year,
    monthNum,
    monthName,
    shortMonthName,
    isCurrentMonth,
    weeks
  };
});

const isWeekend = now.getDay() === 0 || now.getDay() === 6;
let foundActive = false;

if (!isWeekend) {
  allWeeksFlat.forEach(w => {
    w.days.forEach((d: any) => {
      if (d.isToday) {
        d.active = true;
        foundActive = true;
      }
    });
  });
}

if (!foundActive) {
  const currentWeek = allWeeksFlat.find(w => w.isCurrentWeek);
  if (currentWeek) {
    currentWeek.days[0].active = true;
    foundActive = true;
  }
}

let activeDayObj: any = null;
for (const w of allWeeksFlat) {
  const d = w.days.find((day: any) => day.active);
  if (d) {
    activeDayObj = d;
    break;
  }
}

const serverDate = new Date();
let initialDate = serverDate;
if (activeDayObj) {
  const yearVal = activeDayObj.year || serverDate.getFullYear();
  const monthVal = typeof activeDayObj.monthNum === 'number' ? activeDayObj.monthNum : serverDate.getMonth();
  const dateVal = activeDayObj.date || serverDate.getDate();
  const parsed = new Date(yearVal, monthVal, dateVal);
  if (!isNaN(parsed.getTime())) {
    initialDate = parsed;
  }
}

const rawWeekday = initialDate.toLocaleDateString('ro-RO', { weekday: 'long' });
const initialDayName = rawWeekday ? (rawWeekday.charAt(0).toUpperCase() + rawWeekday.slice(1)) : 'Luni';
const rawMonthName = initialDate.toLocaleDateString('ro-RO', { month: 'long' });
const fullMonthName = rawMonthName ? (rawMonthName.charAt(0).toUpperCase() + rawMonthName.slice(1)) : '';
const initialDateNumMonthYear = `${initialDayName}, ${initialDate.getDate()} ${fullMonthName}`;
---

<div id="calendar-card" class="bg-surface-card rounded-[2.5rem] p-6 shadow-sm overflow-hidden select-none closed-mode relative" data-expanded="false">
  <div class="flex flex-col gap-1 mb-6 relative z-10">
    <div class="flex items-center justify-between">
      <span id="header-date-suffix" class="text-2xl sm:text-3xl font-black text-black tracking-tight whitespace-nowrap">{initialDateNumMonthYear}</span>
      <button id="calendar-expand-btn" aria-label="Comută vizualizarea lunii" class="w-11 h-11 rounded-full bg-brand-primary text-black flex items-center justify-center active:scale-95 transition-transform shrink-0 shadow-sm z-30">
        <svg class="w-5 h-5 transition-transform duration-500 ease-in-out" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
      </button>
    </div>

    <div class="flex items-center justify-start min-h-[1.25rem]">
      <span id="calendar-month-year" class="text-sm font-black text-brand-secondary transition-opacity duration-200 opacity-0"></span>
    </div>
  </div>

  <!-- Strip container -->
  <div id="strip-container" class="relative overflow-hidden transition-all duration-500 ease-in-out">
    <div
      id="calendar-active-pill"
      class="absolute bg-brand-primary pointer-events-none z-0"
      style="left: 0; top: 0; width: 0; height: 0; opacity: 0; border-radius: 2rem;"
    ></div>
    <div
      id="calendar-active-circle"
      class="absolute w-8 h-8 rounded-full bg-white shadow-md pointer-events-none z-10"
      style="left: 0; top: 0; opacity: 0;"
    ></div>

    <!-- Weeks strip (closed mode) -->
    <div id="weeks-strip" class="absolute inset-0 flex overflow-x-auto snap-x snap-mandatory opacity-100 z-10 transition-opacity duration-300">
      {allWeeksFlat.map((week) => (
        <div class="week-slide shrink-0 w-full snap-center snap-always px-6" data-week-slide="true" data-week-index={week.weekIndex}>
          <div class="week-section grid grid-cols-5 gap-1">
            {week.days.map((item, index) => (
              <button
                type="button"
                data-calendar-item
                data-active={item.active ? "true" : "false"}
                data-index={index}
                data-month={item.monthNum}
                data-year={item.year}
                data-date={item.date}
                data-is-current-month={item.isCurrentMonth ? "true" : "false"}
                data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                class={`relative z-20 flex flex-col items-center justify-between pt-3 pb-2 w-14 mx-auto h-20 rounded-2xl transition-colors duration-300 ${
                  item.active
                    ? "text-black font-bold"
                    : item.isCurrentMonth
                      ? "text-text-main hover:opacity-100 opacity-70"
                      : "text-text-main hover:opacity-60 opacity-30"
                }`}
              >
                <span class="day-label text-base font-black uppercase tracking-wider pointer-events-none z-20 transition-all duration-300" style="color: #C93263 !important;">{item.dayLabel}</span>
                <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                  {item.date}
                </span>
                {item.isToday && (
                  <span class={`today-dot absolute bottom-1.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                )}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Months strip (expanded mode) -->
    <div id="months-strip" class="absolute inset-0 flex overflow-x-auto snap-x snap-mandatory opacity-0 z-0 pointer-events-none transition-opacity duration-300">
      {allMonths.map((month) => (
        <div
          class="month-section shrink-0 w-full snap-center snap-always px-6 flex flex-col gap-2"
          data-month-section={month.monthOffset}
          data-month-name={month.monthName}
          data-year={month.year}
          id={month.isCurrentMonth ? "current-month-section" : undefined}
        >
          {month.weeks.map((week, weekIndex) => (
            <div class="week-section grid grid-cols-5 gap-1" data-week-index={weekIndex}>
              {week.days.map((item, index) => (
                <button
                  type="button"
                  data-calendar-item
                  data-active={item.active ? "true" : "false"}
                  data-index={index}
                  data-month={item.monthNum}
                  data-year={item.year}
                  data-date={item.date}
                  data-is-current-month={item.isCurrentMonth ? "true" : "false"}
                  data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                  class={`relative z-20 flex flex-col items-center justify-between pt-3 pb-2 w-14 mx-auto h-20 rounded-2xl transition-colors duration-300 ${
                    item.active
                      ? "text-black font-bold"
                      : item.isCurrentMonth
                        ? "text-text-main hover:opacity-100 opacity-70"
                        : "text-text-main hover:opacity-60 opacity-30"
                  }`}
                >
                  <span class="day-label text-base font-black uppercase tracking-wider pointer-events-none z-20 transition-all duration-300" style="color: #C93263 !important;">{item.dayLabel}</span>
                  <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                    {item.date}
                  </span>
                  {item.isToday && (
                    <span class={`today-dot absolute bottom-1.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                  )}
                </button>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function initCalendarAnimation() {
    const card = document.getElementById("calendar-card") as HTMLElement;
    const weeksStrip = document.getElementById("weeks-strip") as HTMLElement;
    const monthsStrip = document.getElementById("months-strip") as HTMLElement;
    const stripContainer = document.getElementById("strip-container") as HTMLElement;
    const expandBtn = document.getElementById("calendar-expand-btn") as HTMLButtonElement;
    const pill = document.getElementById("calendar-active-pill") as HTMLElement;
    const circle = document.getElementById("calendar-active-circle") as HTMLElement;
    if (!weeksStrip || !monthsStrip || !stripContainer || !pill || !circle || !card || !expandBtn) return;
    if (stripContainer.dataset.calendarAnimated === 'true') return;
    stripContainer.dataset.calendarAnimated = 'true';

    let dropTimeout: number | undefined;
    let scrollTimer: number | undefined;
    let isExpanded = false;
    let isProgrammaticScroll = false;
    let scrollStartIndex = 0;
    let scrollStartLeft = 0;

    function setScrollLeft(element: HTMLElement, value: number, instant = false) {
      if (instant) {
        element.style.scrollBehavior = 'auto';
        element.scrollLeft = value;
        element.style.scrollBehavior = '';
      } else {
        element.scrollLeft = value;
      }
    }

    function scrollToSlide(strip: HTMLElement, slide: HTMLElement, instant = false) {
      const target = slide.offsetLeft + slide.offsetWidth / 2 - strip.offsetWidth / 2;
      setScrollLeft(strip, target, instant);
    }

    function getActiveStrip(): HTMLElement {
      return isExpanded ? monthsStrip : weeksStrip;
    }

    function getSlides(strip: HTMLElement): HTMLElement[] {
      if (strip === weeksStrip) return Array.from(strip.querySelectorAll('[data-week-slide="true"]'));
      return Array.from(strip.querySelectorAll('[data-month-section]'));
    }

    function getCurrentSlideIndex(strip: HTMLElement): number {
      const slides = getSlides(strip);
      if (!slides.length) return 0;
      const center = strip.scrollLeft + strip.offsetWidth / 2;
      let nearestIdx = 0;
      let minDist = Infinity;
      slides.forEach((slide, idx) => {
        const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
        const dist = Math.abs(center - slideCenter);
        if (dist < minDist) {
          minDist = dist;
          nearestIdx = idx;
        }
      });
      return nearestIdx;
    }

    function getSlideByIndex(strip: HTMLElement, index: number): HTMLElement | null {
      return getSlides(strip)[index] || null;
    }

    // Auto-scroll weeks strip to the current week on load
    const currentWeekSlide = weeksStrip.querySelector('[data-week-slide="true"]');
    if (currentWeekSlide) {
      const activeWeekBtn = weeksStrip.querySelector('[data-active="true"]') as HTMLElement | null;
      if (activeWeekBtn) {
        const slide = activeWeekBtn.closest('[data-week-slide="true"]') as HTMLElement | null;
        if (slide) scrollToSlide(weeksStrip, slide, true);
      }
    }

    function positionPill(target: HTMLButtonElement, animate = false) {
      if (!target || !pill || !circle) return;

      const strip = getActiveStrip();
      const slide = target.closest('[data-week-slide="true"], [data-month-section]') as HTMLElement | null;
      if (!slide) return;

      const numSpan = target.querySelector<HTMLSpanElement>("span.date-number");
      if (!numSpan) return;

      const width = target.offsetWidth;
      const height = target.offsetHeight;
      const left = (slide.offsetLeft - strip.scrollLeft) + target.offsetLeft + (width - (isExpanded ? 40 : 48)) / 2;
      const top = slide.offsetTop + target.offsetTop;
      const cLeft = (slide.offsetLeft - strip.scrollLeft) + target.offsetLeft + numSpan.offsetLeft;
      const cTop = slide.offsetTop + target.offsetTop + numSpan.offsetTop;

      const targetW = isExpanded ? 40 : 48;
      const targetH = isExpanded ? 40 : height;
      const targetBR = isExpanded ? "50%" : "50px";

      if (animate) {
        pill.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), width 400ms, height 400ms";
        circle.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1)";
      } else {
        pill.style.transition = "none";
        circle.style.transition = "none";
      }

      pill.style.opacity = "1";
      pill.style.width = `${targetW}px`;
      pill.style.height = `${targetH}px`;
      pill.style.borderRadius = targetBR;
      pill.style.transform = `translate(${left}px, ${top}px)`;

      circle.style.opacity = animate ? "0" : "1";
      circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;

      if (animate) {
        void circle.offsetWidth;
        circle.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 150ms ease-out";
        dropTimeout = window.setTimeout(() => {
          circle.style.opacity = "1";
          circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
        }, 300);
      }
    }

    function clearActiveState() {
      const allActive = document.querySelectorAll('[data-active="true"]');
      allActive.forEach(el => {
        el.setAttribute("data-active", "false");
        el.classList.remove("text-black", "font-bold");
        el.classList.add("text-text-main");

        if (el.getAttribute("data-is-current-month") === "true") {
          el.classList.add("opacity-70");
        } else {
          el.classList.add("opacity-30");
        }

        const dSpan = el.querySelector("span:last-child");
        if (dSpan) {
          dSpan.classList.remove("text-black");
          dSpan.classList.add("text-text-main");
        }

        const tDot = el.querySelector<HTMLElement>(".today-dot");
        if (tDot) {
          tDot.classList.remove("opacity-0", "z-0", "scale-50");
          tDot.classList.add("opacity-100", "z-20", "scale-100");
        }
      });
    }

    function updateSelectedLabel(button: HTMLButtonElement) {
      const dateSuffixEl = document.getElementById("header-date-suffix");
      const monthYearLabel = document.getElementById("calendar-month-year");

      const y = button.getAttribute("data-year");
      const m = button.getAttribute("data-month");
      const d = button.getAttribute("data-date");

      if (y && d) {
        const yearNum = parseInt(y, 10);
        const dateNum = parseInt(d, 10);
        const monthNum = m !== null && m !== undefined ? parseInt(m, 10) : new Date().getMonth();

        const dateObj = new Date(yearNum, monthNum, dateNum);
        if (!isNaN(dateObj.getTime())) {
          const fullDay = dateObj.toLocaleDateString('ro-RO', { weekday: 'long' });
          const capitalizedDay = fullDay.charAt(0).toUpperCase() + fullDay.slice(1);
          const fullMonth = dateObj.toLocaleDateString('ro-RO', { month: 'long' });
          const fullMonthCapitalized = fullMonth ? (fullMonth.charAt(0).toUpperCase() + fullMonth.slice(1)) : '';

          if (dateSuffixEl) {
            dateSuffixEl.textContent = `${capitalizedDay}, ${dateNum} ${fullMonthCapitalized}`;
          }

          if (monthYearLabel && isExpanded) {
            const slide = button.closest('[data-month-section]') as HTMLElement | null;
            const mName = slide?.getAttribute('data-month-name') || fullMonthCapitalized;
            const mYear = slide?.getAttribute('data-year') || yearNum;
            monthYearLabel.textContent = `${mName} ${mYear}`;
          }
        }
      }
    }

    function findButtonByDate(year: string, month: string, date: string, context: HTMLElement | Document = document): HTMLButtonElement | null {
      return context.querySelector<HTMLButtonElement>(`[data-calendar-item][data-year="${year}"][data-month="${month}"][data-date="${date}"]`);
    }

    function selectDay(button: HTMLButtonElement, animate = true) {
      clearActiveState();

      const y = button.getAttribute("data-year");
      const m = button.getAttribute("data-month");
      const d = button.getAttribute("data-date");
      if (!y || !m || !d) return;

      // Activate same date in both strips
      const weeksBtn = findButtonByDate(y, m, d, weeksStrip);
      const monthsBtn = findButtonByDate(y, m, d, monthsStrip);
      const target = isExpanded ? (monthsBtn || button) : (weeksBtn || button);

      [weeksBtn, monthsBtn].forEach(btn => {
        if (!btn) return;
        btn.setAttribute("data-active", "true");
        btn.classList.add("text-black", "font-bold");
        btn.classList.remove("opacity-70", "opacity-30");
        const targetDSpan = btn.querySelector("span:last-child");
        if (targetDSpan) {
          targetDSpan.classList.add("text-black");
          targetDSpan.classList.remove("text-text-main");
        }
        const tDot = btn.querySelector<HTMLElement>(".today-dot");
        if (tDot) {
          tDot.classList.remove("opacity-100", "z-20", "scale-100");
          tDot.classList.add("opacity-0", "z-0", "scale-50");
        }
      });

      updateSelectedLabel(target);
      positionPill(target, animate);

      // Dispatch event for timeline filtering
      const dateStr = `${y}-${(parseInt(m) + 1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
      localStorage.setItem('selectedCalendarDate', dateStr);
      window.dispatchEvent(new CustomEvent('calendarDateSelected', { detail: { date: dateStr } }));
    }

    expandBtn.addEventListener("click", () => {
      isExpanded = !isExpanded;
      card.dataset.expanded = isExpanded ? "true" : "false";

      const icon = expandBtn.querySelector("svg");
      if (icon) {
        icon.style.transform = isExpanded ? "rotate(45deg)" : "rotate(0deg)";
      }

      const activeBtn = document.querySelector<HTMLButtonElement>('[data-active="true"]');
      const monthYearLabel = document.getElementById("calendar-month-year");

      if (isExpanded) {
        card.classList.remove("closed-mode");
        card.classList.add("expanded-mode");

        // Sync months strip to the active month
        if (activeBtn) {
          const activeMonthSection = activeBtn.closest('[data-month-section]') as HTMLElement | null;
          if (activeMonthSection) {
            isProgrammaticScroll = true;
            scrollToSlide(monthsStrip, activeMonthSection, true);
            setTimeout(() => { isProgrammaticScroll = false; }, 50);
          }
        }

        weeksStrip.classList.remove("opacity-100", "z-10");
        weeksStrip.classList.add("opacity-0", "z-0", "pointer-events-none");
        monthsStrip.classList.remove("opacity-0", "z-0", "pointer-events-none");
        monthsStrip.classList.add("opacity-100", "z-10");

        if (monthYearLabel) monthYearLabel.classList.remove("opacity-0");
        updateMonthYearLabel();
      } else {
        card.classList.remove("expanded-mode");
        card.classList.add("closed-mode");

        // Sync weeks strip to the active week
        if (activeBtn) {
          const activeWeekSlide = activeBtn.closest('[data-week-slide="true"]') as HTMLElement | null;
          if (activeWeekSlide) {
            isProgrammaticScroll = true;
            scrollToSlide(weeksStrip, activeWeekSlide, true);
            setTimeout(() => { isProgrammaticScroll = false; }, 50);
          }
        }

        monthsStrip.classList.remove("opacity-100", "z-10");
        monthsStrip.classList.add("opacity-0", "z-0", "pointer-events-none");
        weeksStrip.classList.remove("opacity-0", "z-0", "pointer-events-none");
        weeksStrip.classList.add("opacity-100", "z-10");

        if (monthYearLabel) monthYearLabel.classList.add("opacity-0");
      }

      // Reposition pill for the new mode
      if (activeBtn) positionPill(activeBtn, false);
    });

    function attachButtonListeners(strip: HTMLElement) {
      const allButtons = Array.from(strip.querySelectorAll<HTMLButtonElement>('[data-calendar-item]'));
      allButtons.forEach(button => {
        if (button.dataset.clickAttached === "true") return;
        button.dataset.clickAttached = "true";
        button.addEventListener("click", (e) => {
          e.preventDefault();
          selectDay(button, true);
        });
      });
    }

    attachButtonListeners(weeksStrip);
    attachButtonListeners(monthsStrip);

    requestAnimationFrame(() => {
      const savedDate = localStorage.getItem('selectedCalendarDate');
      const todayStr = new Date().getFullYear() + '-' + String(new Date().getMonth() + 1).padStart(2, '0') + '-' + String(new Date().getDate()).padStart(2, '0');
      let activeBtn = document.querySelector<HTMLButtonElement>('[data-active="true"]');

      if (savedDate && savedDate === todayStr) {
        const targetBtn = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-calendar-item]')).find((b) => {
          const y = b.getAttribute("data-year");
          const m = b.getAttribute("data-month");
          const d = b.getAttribute("data-date");
          if (!y || !m || !d) return false;
          const dateStr = `${y}-${(parseInt(m) + 1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
          return dateStr === savedDate;
        });
        if (targetBtn) {
          selectDay(targetBtn, false);
          activeBtn = targetBtn;
        }
      } else if (savedDate) {
        localStorage.removeItem('selectedCalendarDate');
      }

      if (activeBtn) {
        positionPill(activeBtn, false);
        const y = activeBtn.getAttribute("data-year");
        const m = activeBtn.getAttribute("data-month");
        const d = activeBtn.getAttribute("data-date");
        if (y && m && d) {
          const dateStr = `${y}-${(parseInt(m) + 1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
          window.dispatchEvent(new CustomEvent('calendarDateSelected', { detail: { date: dateStr } }));
        }
      }
    });

    if ((window as any)._weeklyCalendarResizeHandler) {
      window.removeEventListener("resize", (window as any)._weeklyCalendarResizeHandler);
    }
    const handleResize = () => {
      const activeBtn = document.querySelector<HTMLButtonElement>('[data-active="true"]');
      if (activeBtn) positionPill(activeBtn, false);
    };
    (window as any)._weeklyCalendarResizeHandler = handleResize;
    window.addEventListener("resize", handleResize);

    function updateMonthYearLabel() {
      if (!isExpanded) return;
      const strip = monthsStrip;
      const index = getCurrentSlideIndex(strip);
      const monthSections = Array.from(strip.querySelectorAll("[data-month-section]"));
      if (monthSections[index]) {
        const monthName = monthSections[index].getAttribute("data-month-name");
        const year = monthSections[index].getAttribute("data-year");
        const monthYearLabel = document.getElementById("calendar-month-year");
        if (monthYearLabel && monthName && year) {
          monthYearLabel.textContent = `${monthName} ${year}`;
        }
      }
    }

    function onScrollStart(strip: HTMLElement) {
      scrollStartLeft = strip.scrollLeft;
      scrollStartIndex = getCurrentSlideIndex(strip);
    }

    function onScrollEnd(strip: HTMLElement) {
      if (isProgrammaticScroll) return;

      const slides = getSlides(strip);
      if (!slides.length) return;

      const endIndex = getCurrentSlideIndex(strip);
      let targetIndex = endIndex;

      // Catch: limit swipe to one slide at a time
      const delta = endIndex - scrollStartIndex;
      if (Math.abs(delta) > 1) {
        targetIndex = scrollStartIndex + Math.sign(delta);
      }

      const targetSlide = slides[targetIndex];
      if (!targetSlide) return;

      // Snap to target slide
      if (targetIndex !== endIndex || Math.abs(strip.scrollLeft - targetSlide.offsetLeft) > 2) {
        isProgrammaticScroll = true;
        scrollToSlide(strip, targetSlide, false);
        setTimeout(() => { isProgrammaticScroll = false; }, 350);
      }

      // Update active day after snap
      const activeBtn = strip.querySelector<HTMLButtonElement>('[data-active="true"]');
      if (activeBtn) {
        const y = activeBtn.getAttribute("data-year");
        const m = activeBtn.getAttribute("data-month");
        const d = activeBtn.getAttribute("data-date");
        const idx = activeBtn.getAttribute("data-index");
        if (y && m && d && idx !== null) {
          const targetBtn = targetSlide.querySelector<HTMLButtonElement>(`[data-calendar-item][data-index="${idx}"]`);
          if (targetBtn) {
            selectDay(targetBtn, true);
          } else {
            // Fallback: keep same date if it exists in the new slide
            const sameDateBtn = targetSlide.querySelector<HTMLButtonElement>(`[data-calendar-item][data-year="${y}"][data-month="${m}"][data-date="${d}"]`);
            if (sameDateBtn) selectDay(sameDateBtn, true);
          }
        }
      }

      updateMonthYearLabel();
    }

    weeksStrip.addEventListener("scroll", () => {
      if (isProgrammaticScroll) return;
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => onScrollEnd(weeksStrip), 80);
    }, { passive: true });

    monthsStrip.addEventListener("scroll", () => {
      if (isProgrammaticScroll) return;
      if (isExpanded) updateMonthYearLabel();
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => onScrollEnd(monthsStrip), 80);
    }, { passive: true });

    weeksStrip.addEventListener("touchstart", () => onScrollStart(weeksStrip), { passive: true });
    monthsStrip.addEventListener("touchstart", () => onScrollStart(monthsStrip), { passive: true });

    updateMonthYearLabel();
  }

  function bootCalendar() {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        initCalendarAnimation();
      });
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootCalendar();
  } else {
    document.addEventListener("DOMContentLoaded", bootCalendar);
  }
  document.addEventListener("astro:page-load", bootCalendar);
  document.addEventListener("astro:after-swap", bootCalendar);
</script>

<style>
  #weeks-strip,
  #months-strip {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #weeks-strip::-webkit-scrollbar,
  #months-strip::-webkit-scrollbar {
    display: none;
  }

  .day-label {
    opacity: 0;
    font-weight: 900 !important;
    color: #C93263 !important;
    -webkit-text-stroke: 0.5px currentColor;
  }

  #weeks-strip .week-slide .day-label,
  #months-strip .month-section .week-section .day-label {
    opacity: 1 !important;
  }

  #strip-container {
    height: 7rem;
    max-height: 7rem;
  }

  .expanded-mode #strip-container {
    height: auto;
    max-height: 28rem;
  }

  #calendar-card {
    transition: max-height 0.5s ease-in-out;
    max-height: 18rem;
  }

  #calendar-card.expanded-mode {
    max-height: 38rem;
  }
</style>
