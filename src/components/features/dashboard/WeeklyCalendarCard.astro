---
interface Props {
  name?: string;
}

const { name = "Dr. Maria" } = Astro.props;

const now = new Date();
const weekDayLabels = ["L", "M", "M", "J", "V"];
const fullDayNames = ["Luni", "Marți", "Miercuri", "Joi", "Vineri"];

const totalMonths = 24;
const startMonthOffset = -12;

const todayMonday = new Date(now);
const currentDay = todayMonday.getDay();
// If it's Saturday (6) or Sunday (0), jump forward to the upcoming Monday
const offsetToMonday = currentDay === 0 ? 1 : (currentDay === 6 ? 2 : 1 - currentDay);
todayMonday.setDate(todayMonday.getDate() + offsetToMonday);
todayMonday.setHours(0,0,0,0);

const allMonths = Array.from({ length: totalMonths }).map((_, monthIndex) => {
  const mOffset = startMonthOffset + monthIndex;
  const targetDate = new Date(now.getFullYear(), now.getMonth() + mOffset, 1);
  const year = targetDate.getFullYear();
  const monthNum = targetDate.getMonth();
  const monthName = targetDate.toLocaleString('ro-RO', { month: 'long' });
  const shortMonthName = targetDate.toLocaleString('ro-RO', { month: 'short' });
  
  const isCurrentMonth = mOffset === 0;

  let startMonday = new Date(year, monthNum, 1);
  const firstDayOfWeek = startMonday.getDay();
  startMonday.setDate(startMonday.getDate() - (firstDayOfWeek === 0 ? 6 : firstDayOfWeek - 1));

  const lastDayOfMonth = new Date(year, monthNum + 1, 0);
  
  const weeks = [];
  let currentMonday = new Date(startMonday);
  
  while (currentMonday <= lastDayOfMonth) {
      const weekDays = [];
      const weekMon = new Date(currentMonday);
      weekMon.setHours(0,0,0,0);
      const isCurrentWeek = weekMon.getTime() === todayMonday.getTime();
      
      for (let d = 0; d < 5; d++) { 
          const dayDate = new Date(currentMonday);
          dayDate.setDate(currentMonday.getDate() + d);
          
          const isToday = dayDate.toDateString() === now.toDateString();
          
          weekDays.push({
              date: dayDate.getDate(),
              shortMonthName: dayDate.toLocaleString('ro-RO', { month: 'short' }),
              monthNum: dayDate.getMonth(),
              year: dayDate.getFullYear(),
              fullDay: fullDayNames[d],
              dayLabel: weekDayLabels[d],
              isToday,
              isCurrentMonth: dayDate.getMonth() === monthNum,
              active: false
          });
      }
      const hasCurrentMonthDay = weekDays.some(day => day.isCurrentMonth);
      if (hasCurrentMonthDay) {
          weeks.push({
              weekStartDate: new Date(currentMonday),
              days: weekDays,
              isCurrentWeek
          });
      }
      currentMonday.setDate(currentMonday.getDate() + 7);
  }
  
  const isWeekend = now.getDay() === 0 || now.getDay() === 6;

  if (isCurrentMonth) {
      let foundActive = false;
      if (!isWeekend) {
        weeks.forEach(w => w.days.forEach(d => {
            if (d.isToday) {
                d.active = true;
                foundActive = true;
            }
        }));
      }
      if (!foundActive) {
          weeks.forEach(w => {
              if (w.isCurrentWeek) {
                  w.days[0].active = true;
                  foundActive = true;
              }
          });
      }
  }
  
  return {
      monthOffset: mOffset,
      year,
      monthNum,
      monthName,
      shortMonthName,
      isCurrentMonth,
      weeks
  };
});

const currentMonthData = allMonths.find(m => m.isCurrentMonth);
let activeDayObj: any = null;
if (currentMonthData) {
    currentMonthData.weeks.forEach(w => {
        const d = w.days.find(day => day.active);
        if (d) activeDayObj = d;
    });
}

const serverDate = new Date();
let initialDate = serverDate;
if (activeDayObj) {
    const yearVal = activeDayObj.year || serverDate.getFullYear();
    // activeDayObj conține monthNum (0-indexed) din dayDate.getMonth()
    const monthVal = typeof activeDayObj.monthNum === 'number' ? activeDayObj.monthNum : (currentMonthData ? currentMonthData.monthNum : serverDate.getMonth());
    const dateVal = activeDayObj.date || serverDate.getDate();
    const parsed = new Date(yearVal, monthVal, dateVal);
    if (!isNaN(parsed.getTime())) {
        initialDate = parsed;
    }
}

const rawWeekday = initialDate.toLocaleDateString('ro-RO', { weekday: 'long' });
const initialDayName = rawWeekday ? (rawWeekday.charAt(0).toUpperCase() + rawWeekday.slice(1)) : 'Luni';
const rawMonthName = initialDate.toLocaleDateString('ro-RO', { month: 'long' });
const fullMonthName = rawMonthName ? (rawMonthName.charAt(0).toUpperCase() + rawMonthName.slice(1)) : '';
const initialDateNumMonthYear = `${initialDayName}, ${initialDate.getDate()} ${fullMonthName}`;
---

<div id="calendar-card" class="bg-surface-card rounded-[2.5rem] p-6 shadow-sm overflow-hidden select-none closed-mode relative" data-expanded="false">
  <div class="flex flex-col gap-1 mb-6 relative z-10">
    <div class="flex items-center justify-between">
      <span id="header-date-suffix" class="text-2xl sm:text-3xl font-black text-black tracking-tight whitespace-nowrap">{initialDateNumMonthYear}</span>
      <button id="calendar-expand-btn" aria-label="Comută vizualizarea lunii" class="w-11 h-11 rounded-full bg-brand-primary text-black flex items-center justify-center active:scale-95 transition-transform shrink-0 shadow-sm z-30">
        <svg class="w-5 h-5 transition-transform duration-500 ease-in-out" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </button>
    </div>

    <div class="flex items-center justify-start min-h-[1.25rem]">
      <span id="calendar-month-year" class="text-sm font-black text-brand-secondary transition-opacity duration-200 opacity-0"></span>
    </div>
  </div>

  <!-- Horizontal Scroll Container with Strict Snapping -->
  <div id="calendar-strip" data-calendar-strip class="relative overflow-x-auto snap-x snap-mandatory flex flex-row w-[calc(100%+3rem)] -mx-6 px-6 pt-32 -mt-32 transition-all closed-mode">
    
    <div
      id="calendar-active-pill"
      class="absolute bg-brand-primary pointer-events-none z-0"
      style="left: 0; top: 0; width: 0; height: 0; opacity: 0; border-radius: 2rem;"
    ></div>
    <div
      id="calendar-active-circle"
      class="absolute w-8 h-8 rounded-full bg-white shadow-md pointer-events-none z-10"
      style="left: 0; top: 0; opacity: 0;"
    ></div>

    {allMonths.map((month) => (
      <div 
        data-month-section={month.monthOffset}
        data-month-name={month.monthName}
        data-year={month.year}
        id={month.isCurrentMonth ? "current-month-section" : undefined}
        class="month-section flex flex-col shrink-0 w-full snap-center snap-always gap-0 overflow-hidden"
      >
        {month.weeks.map((week, weekIndex) => (
          <div 
            class={`week-section relative grid grid-cols-5 gap-1 px-2 transition-[height,opacity] duration-500 ease-in-out snap-center snap-always ${week.isCurrentWeek && month.isCurrentMonth ? 'active-week' : ''}`}
            data-is-current-week={week.isCurrentWeek ? "true" : "false"}
            data-week-index={weekIndex}
          >
            {week.days.map((item, index) => (
              <button
                type="button"
                data-calendar-item
                data-active={item.active ? "true" : "false"}
                data-index={index}
                data-month={item.monthNum}
                data-year={item.year}
                data-date={item.date}
                data-is-current-month={item.isCurrentMonth ? "true" : "false"}
                data-full-date={`${item.fullDay}, ${item.shortMonthName} ${item.date}`}
                class={`relative z-20 flex flex-col items-center justify-between pt-3 pb-2 w-14 mx-auto h-20 rounded-2xl transition-colors duration-300 ${
                  item.active
                    ? "text-black font-bold"
                    : item.isCurrentMonth
                      ? "text-text-main hover:opacity-100 opacity-70"
                      : "text-text-main hover:opacity-60 opacity-30"
                }`}
              >
                <span class="day-label text-base font-black uppercase tracking-wider pointer-events-none z-20" style="color: #C93263 !important;">{item.dayLabel}</span>
                <span class={`date-number w-8 h-8 flex items-center justify-center text-base font-black pointer-events-none relative z-20 shrink-0 ${item.active ? "text-black" : "text-text-main"}`}>
                  {item.date}
                </span>
                {item.isToday && (
                  <span class={`today-dot absolute bottom-1.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full pointer-events-none bg-amber-400 transition-all duration-200 ${item.active ? 'opacity-0 z-0 scale-50' : 'opacity-100 z-20 scale-100'}`}></span>
                )}
              </button>
            ))}
          </div>
        ))}
      </div>
    ))}

  </div>
</div>

<script>
  function initCalendarAnimation() {
    const card = document.getElementById("calendar-card") as HTMLElement;
    const strip = document.getElementById("calendar-strip") as HTMLElement;
    const expandBtn = document.getElementById("calendar-expand-btn") as HTMLButtonElement;
    const pill = document.getElementById("calendar-active-pill") as HTMLElement;
    const circle = document.getElementById("calendar-active-circle") as HTMLElement;
    if (!strip || !pill || !circle || !card || !expandBtn) return;
    if (strip.dataset.calendarAnimated === 'true') return;
    strip.dataset.calendarAnimated = 'true';

    let dropTimeout: number | undefined;
    let scrollTimer: number | undefined;
    let isProgrammaticScroll = false;
    let isExpanded = false;
    
    // Derulează la săptămâna activă la încărcare (modul închis funcționează ca un
    // carusel orizontal de săptămâni consecutive).
    function scrollToActiveWeek() {
      if (isExpanded) return;
      const activeWeek = document.querySelector('.week-section.active-week') as HTMLElement | null;
      if (!activeWeek) return;
      isProgrammaticScroll = true;
      strip.scrollLeft = activeWeek.offsetLeft;
      setTimeout(() => { isProgrammaticScroll = false; }, 300);
    }
    setTimeout(scrollToActiveWeek, 50);

    function animatePillAndCircleDrop(target: HTMLButtonElement, isInitial = false, isMorphing = false, previousTarget: HTMLButtonElement | null = null) {
      if (!target || !pill || !circle) return;
      
      const parentSection = target.closest<HTMLElement>(".week-section");
      let isDifferentRow = false;
      if (parentSection && pill.parentElement) {
        isDifferentRow = parentSection !== pill.parentElement;
      }
      
      if (parentSection && pill.parentElement !== parentSection) {
        parentSection.appendChild(pill);
        parentSection.appendChild(circle);
      }

      const width = target.offsetWidth;
      const height = target.offsetHeight; // 3.5rem (56px)
      const left = target.offsetLeft;
      const top = target.offsetTop;

      const numSpan = target.querySelector<HTMLSpanElement>("span.date-number");
      if (!numSpan) return;

      const cLeft = target.offsetLeft + numSpan.offsetLeft;
      const cTop = target.offsetTop + numSpan.offsetTop;

      if (dropTimeout) clearTimeout(dropTimeout);

      pill.style.opacity = "1";
      circle.style.opacity = "1";

      // Make the non-expanded pill a bit narrower and keep it centered on the day.
      const pillWidth = isExpanded ? 40 : 48;
      const targetW = pillWidth;
      const targetH = isExpanded ? 40 : height;
      const targetL = isExpanded ? cLeft - 4 : left + (width - pillWidth) / 2;
      const targetT = isExpanded ? cTop - 4 : top;
      const targetBR = isExpanded ? "50%" : "50px";

      if (isInitial) {
        pill.style.transition = "none";
        pill.style.width = `${targetW}px`;
        pill.style.height = `${targetH}px`;
        pill.style.borderRadius = targetBR;
        pill.style.transform = `translate(${targetL}px, ${targetT}px)`;
        circle.style.transition = "none";
        circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
      } else if (isMorphing) {
        pill.style.transition = "all 400ms cubic-bezier(0.34, 1.36, 0.64, 1)";
        circle.style.transition = "all 400ms cubic-bezier(0.34, 1.36, 0.64, 1)";
        
        pill.style.width = `${targetW}px`;
        pill.style.height = `${targetH}px`;
        pill.style.borderRadius = targetBR;
        pill.style.transform = `translate(${targetL}px, ${targetT}px)`;
        
        circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
      } else if (isDifferentRow && isExpanded) {
        pill.style.transition = "none";
        pill.style.width = `${targetW}px`;
        pill.style.height = `${targetH}px`;
        pill.style.borderRadius = targetBR;
        pill.style.opacity = "0";
        
        let isGoingUp = false;
        if (previousTarget) {
          isGoingUp = target.getBoundingClientRect().top < previousTarget.getBoundingClientRect().top;
        }
        
        const offset = isGoingUp ? 100 : -100;

        pill.style.transform = `translate(${targetL}px, ${targetT + offset}px) scale(1)`;

        circle.style.transition = "none";
        circle.style.opacity = "0";
        circle.style.transform = `translate(${cLeft}px, ${cTop + offset}px) scale(1)`;

        void pill.offsetWidth;
        void circle.offsetWidth;

        pill.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1)";
        pill.style.opacity = "1";
        pill.style.transform = `translate(${targetL}px, ${targetT}px) scale(1)`;

        // Pill finishes moving in 400ms. Wait 400ms to show the white circle.
        dropTimeout = window.setTimeout(() => {
          circle.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 150ms ease-out";
          circle.style.opacity = "1";
          circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
        }, 300);
      } else {
        pill.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), width 400ms, height 400ms";
        pill.style.width = `${targetW}px`;
        pill.style.height = `${targetH}px`;
        pill.style.borderRadius = targetBR;
        pill.style.transform = `translate(${targetL}px, ${targetT}px) scale(1)`;

        circle.style.transition = "none";
        circle.style.opacity = "0";
        circle.style.transform = `translate(${cLeft}px, ${cTop - 100}px) scale(1)`;

        void circle.offsetWidth;

        dropTimeout = window.setTimeout(() => {
          circle.style.transition = "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 150ms ease-out";
          circle.style.opacity = "1";
          circle.style.transform = `translate(${cLeft}px, ${cTop}px) scale(1)`;
        }, 300);
      }
    }

    function clearActiveState() {
      const allActive = strip.querySelectorAll('[data-active="true"]');
      allActive.forEach(el => {
        el.setAttribute("data-active", "false");
        el.classList.remove("text-black", "font-bold");
        el.classList.add("text-text-main");
        
        if (el.getAttribute("data-is-current-month") === "true") {
            el.classList.add("opacity-70");
        } else {
            el.classList.add("opacity-30");
        }
        
        const dSpan = el.querySelector("span:last-child");
        if (dSpan) {
          dSpan.classList.remove("text-black");
          dSpan.classList.add("text-text-main");
        }

        const tDot = el.querySelector<HTMLElement>(".today-dot");
        if (tDot) {
          tDot.classList.remove("opacity-0", "z-0", "scale-50");
          tDot.classList.add("opacity-100", "z-20", "scale-100");
        }
      });
    }

    function updateSelectedLabel(button: HTMLButtonElement) {
      const dateSuffixEl = document.getElementById("header-date-suffix");
      const monthYearLabel = document.getElementById("calendar-month-year");

      const y = button.getAttribute("data-year");
      const m = button.getAttribute("data-month");
      const d = button.getAttribute("data-date");

      if (y && d) {
        const yearNum = parseInt(y, 10);
        const dateNum = parseInt(d, 10);
        const monthNum = m !== null && m !== undefined ? parseInt(m, 10) : new Date().getMonth();

        const dateObj = new Date(yearNum, monthNum, dateNum);
        if (!isNaN(dateObj.getTime())) {
          const fullDay = dateObj.toLocaleDateString('ro-RO', { weekday: 'long' });
          const capitalizedDay = fullDay.charAt(0).toUpperCase() + fullDay.slice(1);
          const fullMonth = dateObj.toLocaleDateString('ro-RO', { month: 'long' });
          const fullMonthCapitalized = fullMonth ? (fullMonth.charAt(0).toUpperCase() + fullMonth.slice(1)) : '';

          if (dateSuffixEl) {
            dateSuffixEl.textContent = `${capitalizedDay}, ${dateNum} ${fullMonthCapitalized}`;
          }

          if (monthYearLabel && isExpanded) {
            monthYearLabel.textContent = `${fullMonthCapitalized} ${yearNum}`;
          }
        }
      }
    }

    function selectDay(button: HTMLButtonElement, animate = true) {
      const previousTarget = strip.querySelector<HTMLButtonElement>('[data-active="true"]');
      clearActiveState();

      button.setAttribute("data-active", "true");
      button.classList.add("text-black", "font-bold");
      button.classList.remove("opacity-70", "opacity-30");
      const targetDSpan = button.querySelector("span:last-child");
      if (targetDSpan) {
        targetDSpan.classList.add("text-black");
        targetDSpan.classList.remove("text-text-main");
      }

      const tDot = button.querySelector<HTMLElement>(".today-dot");
      if (tDot) {
        tDot.classList.remove("opacity-100", "z-20", "scale-100");
        tDot.classList.add("opacity-0", "z-0", "scale-50");
      }
      
      const allWeeks = document.querySelectorAll(".week-section");
      allWeeks.forEach(w => w.classList.remove("active-week"));
      const parentWeek = button.closest(".week-section");
      if (parentWeek) parentWeek.classList.add("active-week");

      // În modul închis, derulează strip-ul orizontal astfel încât săptămâna
      // selectată să fie vizibilă (scroll snap o va centra).
      if (!isExpanded && parentWeek) {
        isProgrammaticScroll = true;
        strip.scrollLeft = parentWeek.offsetLeft;
        setTimeout(() => { isProgrammaticScroll = false; }, 300);
      }

      updateSelectedLabel(button);

      animatePillAndCircleDrop(button, !animate, false, previousTarget);

      // Dispatch event for timeline filtering
      const y = button.getAttribute("data-year");
      const m = button.getAttribute("data-month");
      const d = button.getAttribute("data-date");
      if (y && m && d) {
        const dateStr = `${y}-${(parseInt(m)+1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
        localStorage.setItem('selectedCalendarDate', dateStr);
        window.dispatchEvent(new CustomEvent('calendarDateSelected', { detail: { date: dateStr } }));
      }
    }

    expandBtn.addEventListener("click", () => {
      isExpanded = !isExpanded;
      card.dataset.expanded = isExpanded ? "true" : "false";
      
      const icon = expandBtn.querySelector("svg");
      if (icon) {
         icon.style.transform = isExpanded ? "rotate(45deg)" : "rotate(0deg)";
      }

      const activeBtn = strip.querySelector<HTMLButtonElement>('[data-active="true"]');
      const monthYearLabel = document.getElementById("calendar-month-year");
      
      if (isExpanded) {
         card.classList.remove("closed-mode");
         card.classList.add("expanded-mode");

         strip.classList.remove("closed-mode");
         strip.classList.add("expanded-mode");

         const allWeeks = document.querySelectorAll(".week-section");
         allWeeks.forEach(w => w.classList.remove("collapsed-week"));

         if (monthYearLabel) monthYearLabel.classList.remove("opacity-0");

         if (activeBtn) {
           updateSelectedLabel(activeBtn);
           // Scroll to the active month section so we don't land on 2027
           const activeMonthSection = activeBtn.closest('[data-month-section]') as HTMLElement | null;
           if (activeMonthSection) {
             isProgrammaticScroll = true;
             strip.scrollLeft = activeMonthSection.offsetLeft;
             setTimeout(() => { isProgrammaticScroll = false; }, 300);
           }
           requestAnimationFrame(updateMonthYearLabel);
         }
      } else {
         card.classList.remove("expanded-mode");
         card.classList.add("closed-mode");

         strip.classList.remove("expanded-mode");
         strip.classList.add("closed-mode");

         const allWeeks = document.querySelectorAll(".week-section");
         allWeeks.forEach(w => w.classList.remove("collapsed-week"));

         if (monthYearLabel) monthYearLabel.classList.add("opacity-0");
         
         if (activeBtn) {
            const activeWeek = activeBtn.closest('.week-section') as HTMLElement | null;
            if (activeWeek) {
              isProgrammaticScroll = true;
              strip.scrollLeft = activeWeek.offsetLeft;
              setTimeout(() => { isProgrammaticScroll = false; }, 300);
            }
         }
      }

      if (activeBtn) animatePillAndCircleDrop(activeBtn, false, true);
    });

    const allButtons = Array.from(strip.querySelectorAll<HTMLButtonElement>('[data-calendar-item]'));
    allButtons.forEach(button => {
      if (button.dataset.clickAttached === "true") return;
      button.dataset.clickAttached = "true";
      button.addEventListener("click", (e) => {
        e.preventDefault();
        selectDay(button, true);
      });
    });

    requestAnimationFrame(() => {
      const savedDate = localStorage.getItem('selectedCalendarDate');
      const todayStr = new Date().getFullYear() + '-' + String(new Date().getMonth() + 1).padStart(2, '0') + '-' + String(new Date().getDate()).padStart(2, '0');
      let activeBtn = strip.querySelector<HTMLButtonElement>('[data-active="true"]');

      if (savedDate && savedDate === todayStr) {
        const targetBtn = allButtons.find((b) => {
          const y = b.getAttribute("data-year");
          const m = b.getAttribute("data-month");
          const d = b.getAttribute("data-date");
          if (!y || !m || !d) return false;
          const dateStr = `${y}-${(parseInt(m)+1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
          return dateStr === savedDate;
        });
        if (targetBtn) {
          selectDay(targetBtn, false);
          activeBtn = targetBtn;
        }
      } else if (savedDate) {
        // Data salvată e din altă zi — nu o mai restaurem, selectăm azi implicit
        localStorage.removeItem('selectedCalendarDate');
      }

      if (activeBtn) {
        animatePillAndCircleDrop(activeBtn, true);
        // Trigger initial selection event
        const y = activeBtn.getAttribute("data-year");
        const m = activeBtn.getAttribute("data-month");
        const d = activeBtn.getAttribute("data-date");
        if (y && m && d) {
          const dateStr = `${y}-${(parseInt(m)+1).toString().padStart(2, '0')}-${d.padStart(2, '0')}`;
          window.dispatchEvent(new CustomEvent('calendarDateSelected', { detail: { date: dateStr } }));
        }
      }
    });

    if ((window as any)._weeklyCalendarResizeHandler) {
      window.removeEventListener("resize", (window as any)._weeklyCalendarResizeHandler);
    }
    const handleResize = () => {
      const activeBtn = strip.querySelector<HTMLButtonElement>('[data-active="true"]');
      if (activeBtn) animatePillAndCircleDrop(activeBtn, true);
      updateMonthYearLabel();
    };
    (window as any)._weeklyCalendarResizeHandler = handleResize;
    window.addEventListener("resize", handleResize);

    function updateMonthYearLabel() {
      const contentWidth = strip.offsetWidth - 48; // accounting for px-6
      if (contentWidth <= 0) return;
      const index = Math.round(strip.scrollLeft / contentWidth);
      
      const monthSections = Array.from(document.querySelectorAll(".month-section"));
      if (monthSections[index]) {
        const monthName = monthSections[index].getAttribute("data-month-name");
        const year = monthSections[index].getAttribute("data-year");
        const monthYearLabel = document.getElementById("calendar-month-year");
        if (monthYearLabel && monthName && year) {
          monthYearLabel.textContent = `${monthName} ${year}`;
        }
      }
    }

    strip.addEventListener("scroll", () => {
      if (isExpanded) {
        updateMonthYearLabel();
        return;
      }
      if (isProgrammaticScroll) return;

      // În modul închis, după ce scroll-ul se oprește pe o săptămână,
      // selectează automat ziua cu același index (Luni…Vineri) din săptămâna nouă.
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const allWeeks = getAllWeekSections();
        if (allWeeks.length === 0) return;

        const center = strip.scrollLeft + strip.offsetWidth / 2;
        let targetWeek: HTMLElement | null = null;
        for (const w of allWeeks) {
          const left = w.offsetLeft;
          const right = left + w.offsetWidth;
          if (center >= left && center < right) {
            targetWeek = w;
            break;
          }
        }
        if (!targetWeek) targetWeek = allWeeks[allWeeks.length - 1];

        const activeDay = strip.querySelector('[data-active="true"]') as HTMLButtonElement | null;
        const activeDayIndex = activeDay ? parseInt(activeDay.getAttribute('data-index') || '0', 10) : 0;
        const targetBtn = targetWeek.querySelector(`[data-calendar-item][data-index="${activeDayIndex}"]`) as HTMLButtonElement | null
          || targetWeek.querySelector('[data-calendar-item]') as HTMLButtonElement | null;
        if (targetBtn && targetBtn.getAttribute('data-active') !== 'true') {
          selectDay(targetBtn, true);
        }
      }, 150);
    });
    
    // Initial label set
    updateMonthYearLabel();

    function getAllWeekSections(): HTMLElement[] {
      return Array.from(document.querySelectorAll('.week-section')) as HTMLElement[];
    }

  }

  function bootCalendar() {
    // Wait for the layout to settle before measuring/animating the calendar.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        initCalendarAnimation();
      });
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    bootCalendar();
  } else {
    document.addEventListener("DOMContentLoaded", bootCalendar);
  }
  document.addEventListener("astro:page-load", bootCalendar);
  document.addEventListener("astro:after-swap", bootCalendar);

</script>

