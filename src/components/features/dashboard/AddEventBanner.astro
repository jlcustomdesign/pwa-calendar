---
// AddEventBanner.astro
---

<button onclick="window.dispatchEvent(new CustomEvent('openAddPatient'))" class="w-full text-left rounded-3xl p-4 bg-surface-card shadow-sm active:scale-95 transition-transform flex items-center justify-between group">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-text-main flex items-center justify-center text-surface-card">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    </div>
    <span class="text-base font-semibold text-text-main group-hover:text-text-muted transition-colors">Adaugă pacient</span>
  </div>
</button>
