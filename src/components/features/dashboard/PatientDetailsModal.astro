---
// src/components/features/dashboard/PatientDetailsModal.astro
---

<div 
  id="patient-details-modal" 
  data-sheet-root
  class="fixed inset-0 z-50 flex flex-col justify-end pointer-events-none"
>
  <!-- Backdrop -->
  <div 
    class="absolute inset-0 bg-black/50 modal-backdrop opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
    aria-hidden="true"
  ></div>

  <!-- Bottom Sheet -->
  <div 
    class="relative bg-surface-card rounded-t-[2.5rem] p-8 pb-12 shadow-2xl transform translate-y-full transition-transform duration-500 ease-out modal-sheet pointer-events-auto w-full max-w-md mx-auto"
  >
    <!-- Drag Handle -->
    <div id="patient-details-drag-handle" class="w-12 h-1.5 bg-border-light rounded-full mx-auto mb-6 cursor-grab active:cursor-grabbing"></div>
    
    <div class="flex justify-between items-start mb-6">
      <div>
        <h2 class="text-2xl font-semibold text-text-main">Maria Ionescu</h2>
        <p class="text-sm text-text-muted mt-1">Kinetotherapy • Session 4/10</p>
      </div>
      <button 
        class="modal-close w-8 h-8 flex items-center justify-center rounded-full bg-surface-panel text-text-muted hover:text-text-main hover:bg-black/5 active:scale-95 transition-all"
        aria-label="Close modal"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="bg-surface-panel p-4 rounded-2xl">
        <span class="block text-xs text-text-muted mb-1">Time</span>
        <span class="block text-base font-medium text-text-main">12:00 - 13:30</span>
      </div>
      <div class="bg-surface-panel p-4 rounded-2xl">
        <span class="block text-xs text-text-muted mb-1">Status</span>
        <span class="block text-base font-medium text-brand-accent">Confirmed</span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col gap-3">
      <button class="w-full py-4 rounded-2xl bg-text-main text-surface-card font-medium active:scale-95 transition-transform">
        Start Session
      </button>
      <button class="w-full py-4 rounded-2xl bg-surface-panel text-text-main font-medium hover:bg-black/5 active:scale-95 transition-transform">
        View Full Profile
      </button>
    </div>
  </div>
</div>

<script>
  import { lockBodyScroll, unlockBodyScroll } from '../../../utils/scrollLock';

  function setupModals() {
    const triggers = document.querySelectorAll('[data-modal-trigger]');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-trigger');
        if (!modalId) return;

        const modal = document.getElementById(modalId);
        if (modal) {
          lockBodyScroll();
          const dock = document.getElementById('persistent-dock');
          if (dock) dock.style.display = 'none';

          // Show modal — fade the backdrop element itself so the blur
          // animates gradually (same pattern as the other sheets)
          const backdrop = modal.querySelector('.modal-backdrop');
          if (backdrop) {
            backdrop.classList.remove('opacity-0', 'pointer-events-none');
            backdrop.classList.add('pointer-events-auto');
          }

          const sheet = modal.querySelector('.modal-sheet');
          if (sheet) {
            sheet.classList.remove('translate-y-full');
            sheet.classList.add('translate-y-0');
          }

          modal.dataset.open = 'true';
        }
      });
    });

    const closeButtons = document.querySelectorAll('.modal-close, .modal-backdrop');
    
    closeButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        
        const modal = target.closest('.fixed.z-50');
        if (modal) {
          closeModalSheet(modal as HTMLElement);
        }
      });
    });

    // Dedicated drag handle close
    const dragHandle = document.getElementById('patient-details-drag-handle');
    if (dragHandle) {
      let startY = 0;
      let currentY = 0;
      let dragging = false;
      dragHandle.addEventListener('touchstart', (e: TouchEvent) => {
        startY = e.touches[0].clientY;
        currentY = startY;
        dragging = true;
        const sheet = dragHandle.closest('.modal-sheet') as HTMLElement | null;
        if (sheet) sheet.style.transition = 'none';
      }, { passive: true });
      dragHandle.addEventListener('touchmove', (e: TouchEvent) => {
        if (!dragging) return;
        currentY = e.touches[0].clientY;
        const sheet = dragHandle.closest('.modal-sheet') as HTMLElement | null;
        const deltaY = currentY - startY;
        if (deltaY > 0 && sheet) {
          sheet.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });
      const onEnd = () => {
        if (!dragging) return;
        dragging = false;
        const sheet = dragHandle.closest('.modal-sheet') as HTMLElement | null;
        const modal = dragHandle.closest('.fixed.z-50') as HTMLElement | null;
        if (sheet) {
          sheet.style.transition = 'transform 400ms cubic-bezier(0.32, 0.72, 0, 1)';
          const deltaY = currentY - startY;
          if (deltaY > 80 && modal) {
            closeModalSheet(modal);
          } else {
            sheet.style.transform = 'translateY(0)';
          }
        }
      };
      dragHandle.addEventListener('touchend', onEnd);
      dragHandle.addEventListener('touchcancel', onEnd);
    }

    // Swipe-down to dismiss — works from anywhere on the sheet, as long as
    // the gesture is a clearly vertical downward swipe
    const sheets = document.querySelectorAll('.modal-sheet');
    sheets.forEach(sheetEl => {
      const sheet = sheetEl as HTMLElement;
      if (sheet.dataset.swipeBound) return;
      sheet.dataset.swipeBound = 'true';

      let startY = 0;
      let currentY = 0;
      let startX = 0;
      let dragEngaged = false;

      sheet.addEventListener('touchstart', (e: TouchEvent) => {
        startY = e.touches[0].clientY;
        currentY = startY;
        startX = e.touches[0].clientX;
        dragEngaged = false;
      }, { passive: true });

      sheet.addEventListener('touchmove', (e: TouchEvent) => {
        const y = e.touches[0].clientY;
        const deltaY = y - startY;
        const deltaX = e.touches[0].clientX - startX;

        if (!dragEngaged) {
          if (deltaY > 10 && deltaY > Math.abs(deltaX) * 1.5) {
            dragEngaged = true;
            sheet.style.transition = 'none';
          } else {
            return;
          }
        }

        currentY = y;
        if (deltaY > 0) {
          if (e.cancelable) e.preventDefault();
          sheet.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: false });

      sheet.addEventListener('touchend', () => {
        if (!dragEngaged) return;
        dragEngaged = false;
        const deltaY = currentY - startY;
        sheet.style.transition = 'transform 500ms cubic-bezier(0.32, 0.72, 0, 1)';
        if (deltaY > 150) {
          const modal = sheet.closest('.fixed.z-50');
          if (modal) closeModalSheet(modal as HTMLElement);
        } else {
          sheet.style.transform = 'translateY(0)';
        }
      });
    });
  }

  function closeModalSheet(modal: HTMLElement) {
    unlockBodyScroll();
    const dock = document.getElementById('persistent-dock');
    if (dock) dock.style.display = '';

    modal.dataset.open = 'false';

    const sheet = modal.querySelector('.modal-sheet') as HTMLElement | null;
    if (sheet) {
      // Clear any inline drag styles so the class-based transition takes over
      sheet.style.transition = '';
      sheet.style.transform = '';
      sheet.classList.remove('translate-y-0');
      sheet.classList.add('translate-y-full');
    }
    const backdrop = modal.querySelector('.modal-backdrop');
    if (backdrop) {
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('pointer-events-auto');
    }
  }

  document.addEventListener('DOMContentLoaded', setupModals);
  document.addEventListener('astro:page-load', setupModals);
</script>
