---
import Skeleton from './Skeleton.astro';
---

<div class="space-y-6 w-full">
  <!-- Header skeleton -->
  <div class="px-2 pt-2 pb-1">
    <Skeleton height="h-12 sm:h-16" width="w-48" rounded="rounded-3xl" />
  </div>

  <!-- Main card skeleton -->
  <div class="rounded-[2.5rem] p-6 space-y-5">
    <div class="flex items-center justify-between">
      <Skeleton height="h-8" width="w-32" rounded="rounded-2xl" />
      <Skeleton height="h-11" width="w-11" rounded="rounded-full" />
    </div>
    <Skeleton height="h-4" width="w-56" rounded="rounded-xl" />
    <div class="flex items-center justify-between gap-3 pt-2">
      <Skeleton height="h-16" width="flex-1" rounded="rounded-full" />
      <Skeleton height="h-16" width="flex-1" rounded="rounded-full" />
      <Skeleton height="h-16" width="flex-1" rounded="rounded-full" />
      <Skeleton height="h-16" width="flex-1" rounded="rounded-full" />
      <Skeleton height="h-16" width="flex-1" rounded="rounded-full" />
    </div>
  </div>

  <!-- Secondary card skeleton -->
  <div class="rounded-[2.5rem] p-6 space-y-4">
    <div class="flex items-center justify-between">
      <Skeleton height="h-6" width="w-40" rounded="rounded-2xl" />
      <Skeleton height="h-6" width="w-20" rounded="rounded-2xl" />
    </div>
    <div class="space-y-3 pt-2">
      <Skeleton height="h-24" width="w-full" rounded="rounded-3xl" />
      <Skeleton height="h-24" width="w-full" rounded="rounded-3xl" />
      <Skeleton height="h-24" width="w-full" rounded="rounded-3xl" />
    </div>
  </div>
</div>
