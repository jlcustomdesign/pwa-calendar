---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="h-16 bg-surface-card border-b border-transparent px-4 md:px-6 pt-[env(safe-area-inset-top)] flex items-center justify-between sticky top-0 z-40">
  <div class="flex items-center gap-3">
    <h1 class="text-lg md:text-xl font-bold text-text-main">{title}</h1>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-xs px-2.5 py-1 rounded-full bg-brand-accent/10 text-brand-accent font-medium">
      Kineto Mode
    </span>
  </div>
</header>
