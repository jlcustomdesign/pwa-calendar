---
import { NAV_ITEMS } from '../../lib/constants';

const currentPath = Astro.url.pathname;
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-surface-card border-t border-transparent pb-[env(safe-area-inset-bottom)] shadow-lg">
  <div class="flex items-center justify-around h-16 px-1">
    {NAV_ITEMS.map((item) => {
      const isActive = currentPath === item.path || (item.path !== '/dashboard' && currentPath.startsWith(item.path));
      return (
        <a
          href={item.path}
          class={`flex flex-col items-center justify-center flex-1 h-full min-w-[44px] min-h-[44px] py-1 text-xs font-medium active:scale-95 transition-transform ${
            isActive ? 'text-brand-primary font-semibold' : 'text-text-muted hover:text-text-main'
          }`}
        >
          <span>{item.name}</span>
        </a>
      );
    })}
  </div>
</nav>
