---
import { NAV_ITEMS, ROUTES } from '../../lib/constants';
---

<aside class="hidden md:flex w-64 bg-surface-card border-r border-transparent p-4 flex-col justify-between shrink-0">
  <div>
    <div class="flex items-center gap-2 mb-8 px-2">
      <div class="w-10 h-10 rounded-xl bg-brand-primary flex items-center justify-center text-text-inverse font-bold text-lg shadow-sm">
        K
      </div>
      <div>
        <span class="font-bold text-base text-text-main block leading-tight">KinetoApp</span>
        <span class="text-xs text-text-muted">Practice Agenda</span>
      </div>
    </div>
    <nav class="space-y-1">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.path}
          data-astro-history="replace"
          class="flex items-center min-h-[44px] px-3.5 py-2 text-sm font-medium rounded-lg text-text-muted hover:bg-surface-panel hover:text-text-main active:scale-95 transition-all"
        >
          {item.name}
        </a>
      ))}
    </nav>
  </div>
  <div class="pt-4 border-t border-transparent px-2">
    <a href={ROUTES.LOGIN} class="flex items-center min-h-[44px] px-2 text-sm text-text-muted hover:text-state-danger active:scale-95 transition-all">
      Sign Out
    </a>
  </div>
</aside>
