---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WeeklyCalendarCard from '../../components/features/dashboard/WeeklyCalendarCard.astro';
import AddEventBanner from '../../components/features/dashboard/AddEventBanner.astro';

// Cache the shell of the dashboard page privately so switching tabs feels instant.
Astro.response.headers.set('Cache-Control', 'private, max-age=30, must-revalidate');
---

<DashboardLayout title="Calendar">
  <div class="relative min-h-[100dvh]">
    <div class="relative z-10 space-y-6 pb-24">
    
    <!-- Top Section: Expandable Weekly/Monthly Calendar -->
    <WeeklyCalendarCard name="Dr. Maria" />
    
    <!-- Add Session Banner -->
    <AddEventBanner />
    
    <!-- Timeline View -->
    <section class="mt-6">
      <h3 class="text-xl font-extrabold text-black tracking-tight mb-4 px-2">Timeline</h3>

      <div id="timeline-slots-container" class="flex flex-col gap-3">
        <!-- Rendered dynamically by JS -->
      </div>

      <!-- Skeleton loader: shown only while fetching from DB -->
      <div id="timeline-skeleton" class="hidden flex flex-col gap-3">
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
      </div>
    </section>
  </div>
  </div>

  <!-- Lunch Break Edit Modal -->
  <div id="lunch-edit-modal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200" aria-hidden="true">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="lunch-edit-backdrop"></div>
    <div id="lunch-edit-dialog" class="relative w-full max-w-sm mx-4 mb-6 sm:mb-0 bg-white rounded-[2rem] p-6 shadow-2xl transform translate-y-4 transition-transform duration-200">
      <div class="text-center mb-5">
        <h3 class="text-xl font-black text-black">Pauza de masă</h3>
        <p class="text-sm font-semibold text-text-muted mt-1">Ajustează intervalul</p>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="space-y-2">
          <label for="lunch-edit-start" class="text-xs font-black text-text-muted uppercase tracking-wider block text-center">Început</label>
          <input type="time" id="lunch-edit-start" class="w-full px-4 py-3.5 rounded-2xl bg-black/5 text-black font-extrabold text-lg text-center focus:outline-none focus:ring-2 focus:ring-brand-primary/30" />
        </div>
        <div class="space-y-2">
          <label for="lunch-edit-end" class="text-xs font-black text-text-muted uppercase tracking-wider block text-center">Sfârșit</label>
          <input type="time" id="lunch-edit-end" class="w-full px-4 py-3.5 rounded-2xl bg-black/5 text-black font-extrabold text-lg text-center focus:outline-none focus:ring-2 focus:ring-brand-primary/30" />
        </div>
      </div>
      <div class="flex gap-3">
        <button type="button" id="lunch-edit-cancel" class="flex-1 py-3.5 rounded-full bg-black/5 text-black font-extrabold text-sm active:scale-95 transition-transform">Anulează</button>
        <button type="button" id="lunch-edit-save" class="flex-1 py-3.5 rounded-full bg-brand-primary text-black font-extrabold text-sm shadow-md active:scale-95 transition-transform">Salvează</button>
      </div>
    </div>
  </div>

  <style>
    /* Long-press drag & drop: oprește callout-ul iOS și selecția textului pe carduri */
    [data-session-id] {
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }
  </style>

  <script>
    import { getAppointmentsByDate, updateAppointment, swapAppointmentPatients } from '../../lib/services/appointmentService';
    import { getSettings, saveSettings } from '../../lib/services/settingsService';
    import { getPatientPayments, isRenewalDismissed } from '../../lib/services/patientService';
    import { escapeHtml, escapeJsString } from '../../utils/html';

    function localDateStr(d = new Date()) {
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }
    const todayStr = localDateStr();
    let currentCalendarDate = todayStr;
    let currentSessionDuration = 50;
    (window as any).currentCalendarDate = currentCalendarDate;

    const handleDateSelected = (e: any) => {
      const date = e.detail?.date;
      if (date) {
        currentCalendarDate = date;
        (window as any).currentCalendarDate = date;
        renderTimeline();
      }
    };

    // Mută pauza de masă cu ±30 de minute direct din calendar.
    (window as any).shiftLunchBreak = async (minutes: number) => {
      try {
        const settings = await getSettings();
        const parseMin = (t: string) => {
          const [h, m] = (t || '00:00').substring(0, 5).split(':').map(Number);
          return (h || 0) * 60 + (m || 0);
        };
        const fmt = (total: number) => `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;

        let newStart = parseMin(settings.lunch_start || '13:00') + minutes;
        let newEnd = parseMin(settings.lunch_end || '14:00') + minutes;

        if (newStart < 0) { newEnd -= newStart; newStart = 0; }
        if (newEnd > 24 * 60) { newStart -= (newEnd - 24 * 60); newEnd = 24 * 60; }

        await saveSettings({ lunch_start: fmt(newStart), lunch_end: fmt(newEnd) });
        window.dispatchEvent(new CustomEvent('settingsUpdated'));
        (window as any).showToast?.(`Pauza de masă mutată: ${fmt(newStart)} - ${fmt(newEnd)}`, 'success');
      } catch (err: any) {
        (window as any).showToast?.('Eroare la mutarea pauzei: ' + (err.message || err), 'error');
      }
    };

    // Editează pauza de masă direct din calendar.
    const lunchEditModal = document.getElementById('lunch-edit-modal');
    const lunchEditDialog = document.getElementById('lunch-edit-dialog');
    const lunchEditBackdrop = document.getElementById('lunch-edit-backdrop');
    const lunchEditStart = document.getElementById('lunch-edit-start') as HTMLInputElement | null;
    const lunchEditEnd = document.getElementById('lunch-edit-end') as HTMLInputElement | null;
    const lunchEditSave = document.getElementById('lunch-edit-save');
    const lunchEditCancel = document.getElementById('lunch-edit-cancel');

    function openLunchEdit() {
      if (!lunchEditModal || !lunchEditDialog || !lunchEditStart || !lunchEditEnd) return;
      getSettings().then((settings) => {
        lunchEditStart.value = (settings.lunch_start || '12:00').substring(0, 5);
        lunchEditEnd.value = (settings.lunch_end || '12:30').substring(0, 5);
        lunchEditModal.classList.remove('opacity-0', 'pointer-events-none');
        lunchEditDialog.classList.remove('translate-y-4');
      });
    }

    function closeLunchEdit() {
      if (!lunchEditModal || !lunchEditDialog) return;
      lunchEditModal.classList.add('opacity-0', 'pointer-events-none');
      lunchEditDialog.classList.add('translate-y-4');
    }

    async function saveLunchEdit() {
      if (!lunchEditStart || !lunchEditEnd) return;
      const start = lunchEditStart.value;
      const end = lunchEditEnd.value;
      if (start >= end) {
        (window as any).showToast?.('Ora de început trebuie să fie înainte de ora de sfârșit.', 'error');
        return;
      }
      try {
        await saveSettings({ lunch_start: start, lunch_end: end });
        window.dispatchEvent(new CustomEvent('settingsUpdated'));
        (window as any).showToast?.(`Pauza de masă: ${start} – ${end}`, 'success');
        closeLunchEdit();
      } catch (err: any) {
        (window as any).showToast?.('Eroare la salvare: ' + (err.message || err), 'error');
      }
    }

    (window as any).openLunchEdit = openLunchEdit;

    lunchEditSave?.addEventListener('click', saveLunchEdit);
    lunchEditCancel?.addEventListener('click', closeLunchEdit);
    lunchEditBackdrop?.addEventListener('click', closeLunchEdit);

    if ((window as any)._calendarDateSelectedHandler) {
      window.removeEventListener('calendarDateSelected', (window as any)._calendarDateSelectedHandler);
    }
    (window as any)._calendarDateSelectedHandler = handleDateSelected;
    window.addEventListener('calendarDateSelected', handleDateSelected);

    function createSessionCardHTML(session: any) {
      const paymentStatus = session.paymentStatus || 'Neachitat';
      const locationStr = session.location || 'Ghimbav';
      const isGhimbav = locationStr.toLowerCase() === "ghimbav";
      const cardClasses = isGhimbav ? "bg-brand-secondary text-white" : "bg-brand-primary text-black";

      let paymentClass = '';
      if (paymentStatus === 'Neachitat') {
        paymentClass = 'bg-rose-600 text-white font-bold hover:bg-rose-700 shadow-sm';
      } else if (paymentStatus === 'Achitat parțial') {
        paymentClass = 'bg-amber-500 text-white hover:bg-amber-600 shadow-sm font-black';
      } else if (paymentStatus === 'Achitat integral' || paymentStatus === 'Achitat') {
        paymentClass = 'bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm font-black';
      }
      
      const count = session.attendanceCount ?? 0;
      const totalSess = session.totalSessions || 10;
      const isTerminat = session.subscriptionDone || (totalSess > 0 && count > 0 && count >= totalSess);
      const displayCount = isTerminat ? totalSess : count;
      const progressPercentage = isTerminat ? 100 : (totalSess > 0 ? Math.min(100, Math.round((count / totalSess) * 100)) : 0);
      const progressBarFill = isGhimbav ? "bg-brand-primary" : "bg-brand-secondary";
      const progressBarTrack = isGhimbav ? "bg-black/20" : "bg-black/15";
      
      const rawTime = session.selectedTime || session.time || "08:00";
      const cleanTimeStr = rawTime.substring(0, 5);
      const patientNameStr = session.patientName || "Pacient";
      const safePatientName = escapeHtml(patientNameStr);
      const safePatientNameJs = escapeJsString(session.patientName || '');
      const safeLocation = escapeHtml(locationStr);
      const safePhone = escapeHtml(session.patientPhone || '+1234567890');
      const timeParts = cleanTimeStr.split(':');
      const startH = parseInt(timeParts[0] || "8", 10);
      const startM = parseInt(timeParts[1] || "0", 10);
      const totalStartMin = startH * 60 + startM;
      const totalEndMin = totalStartMin + currentSessionDuration;
      const endH = Math.floor(totalEndMin / 60);
      const endM = totalEndMin % 60;
      const formattedStart = `${startH.toString().padStart(2, '0')}:${startM.toString().padStart(2, '0')}`;
      const formattedEnd = `${endH.toString().padStart(2, '0')}:${endM.toString().padStart(2, '0')}`;
      const timeRangeText = `${formattedStart} - ${formattedEnd}`;

      const now = new Date();
      const nowStr = now.toTimeString().slice(0, 5);
      const isToday = currentCalendarDate === todayStr;

      const sessionStatus = session.status || 'programat';
      const isOngoing = isToday && nowStr >= cleanTimeStr && nowStr < formattedEnd;
      const isPast = currentCalendarDate < todayStr || (isToday && nowStr >= formattedEnd);

      // Icon-only status indicator for closed state
      // Bifa verde apare DOAR după confirmare (status = finalizat), nu doar pentru că a trecut ora.
      let statusIcon = '';
      if (sessionStatus === 'absent') {
        statusIcon = `<svg class="w-6 h-6 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
      } else if (sessionStatus === 'anulat') {
        statusIcon = `<svg class="w-6 h-6 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
      } else if (sessionStatus === 'finalizat') {
        statusIcon = `<svg class="w-6 h-6 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>`;
      } else if (isOngoing) {
        statusIcon = `<svg class="w-7 h-7 ${isGhimbav ? 'text-brand-primary' : 'text-brand-secondary'} shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      }

      const subscriptionWarningDetails = session.subscriptionDone && !isRenewalDismissed(session.patientId)
        ? `<div class="px-6 pb-3">
            <div class="flex items-center gap-3 rounded-2xl bg-brand-secondary/15 border border-brand-secondary/30 p-3">
              <div class="flex-1 min-w-0">
                <p class="text-xs sm:text-sm font-black text-black truncate">Abonament terminat</p>
                <p class="text-[10px] font-bold text-black/70">0/${session.totalSessions || 10} ședințe</p>
              </div>
              <button type="button" class="shrink-0 px-4 py-2.5 rounded-full bg-brand-secondary text-black text-xs font-black uppercase tracking-wide shadow-sm active:scale-95 transition-transform" onclick="event.stopPropagation(); window.renewSubscription('${session.patientId}', ${session.totalSessions || 10}, '${safePatientNameJs}')">Reînnoiește</button>
              <button type="button" class="shrink-0 w-9 h-9 rounded-full bg-surface-card text-text-muted flex items-center justify-center active:scale-95 transition-transform" onclick="event.stopPropagation(); window.dismissSubscriptionWarning('${session.patientId}')" aria-label="Nu acum">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          </div>`
        : '';

      const sumaIncasata = session.sumaIncasata || 0;
      const costTotal = session.costTotal || 0;
      const restDePlata = Math.max(0, costTotal - sumaIncasata);
      const isPaid = restDePlata <= 0 || session.paymentStatus === 'Achitat integral' || session.paymentStatus === 'Achitat';

      let paymentBadgeClass = 'bg-rose-50 hover:bg-rose-100 text-rose-700 border border-transparent font-extrabold shadow-sm';
      let displayPaymentLabel = 'Neachitat';
      if (session.paymentStatus === 'Achitat parțial' || (sumaIncasata > 0 && restDePlata > 0)) {
        displayPaymentLabel = `${sumaIncasata}/${costTotal} RON`;
        paymentBadgeClass = 'bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-200/60 font-black shadow-sm';
      } else if (session.paymentStatus === 'Achitat integral' || session.paymentStatus === 'Achitat' || (costTotal > 0 && sumaIncasata >= costTotal && isPaid)) {
        displayPaymentLabel = 'Achitat';
        paymentBadgeClass = 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-transparent font-extrabold shadow-sm';
      } else {
        displayPaymentLabel = 'Neachitat';
        paymentBadgeClass = 'bg-rose-50 hover:bg-rose-100 text-rose-700 border border-transparent font-extrabold shadow-sm';
      }

      const driveLink = session.driveLink || '';
      const safeDriveLink = escapeHtml(driveLink || '#');
      const hasDriveLink = Boolean(driveLink);

      return `
        <session-card class="block relative rounded-[2.5rem] shadow-sm overflow-hidden" data-session-id="${session.id}" data-session-time="${cleanTimeStr}" data-session-date="${session.selectedDate || currentCalendarDate}">
          <div class="relative w-full h-full rounded-[2.5rem] overflow-hidden">
            
            <!-- Swipe Action Background -->
            <div class="absolute inset-0 bg-neutral-100 flex items-center justify-end px-6 z-0">
              <div class="flex items-center gap-3" data-action-area>
                <button 
                  type="button" 
                  data-action-btn
                  class="relative z-20 w-12 h-12 rounded-full bg-white shadow-sm text-black flex items-center justify-center active:scale-95 transition-transform border border-transparent" 
                  onclick="event.stopPropagation(); event.preventDefault(); window.editSession('${session.id}');"
                >
                  <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.843.712a.75.75 0 01-.904-.903l.71-2.842a4.5 4.5 0 011.12-1.89L16.862 4.487z"></path><path d="M19.5 7.125L16.862 4.487"></path></svg>
                </button>
                <button 
                  type="button" 
                  data-action-btn
                  class="relative z-20 w-12 h-12 rounded-full bg-orange-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" 
                  onclick="event.stopPropagation(); event.preventDefault(); window.cancelSession('${session.id}');"
                  title="Marchează ca Anulat/Absent"
                >
                  <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                </button>
                <button 
                  type="button" 
                  data-action-btn
                  class="relative z-20 w-12 h-12 rounded-full bg-red-500 shadow-sm text-white flex items-center justify-center active:scale-95 transition-transform" 
                  onclick="event.stopPropagation(); event.preventDefault(); window.deleteSession('${session.id}');"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>
            </div>

            <!-- Draggable Foreground -->
            <div class="swipe-surface relative z-10 w-full h-full rounded-[2.5rem] overflow-hidden transition-transform duration-300 will-change-transform ${cardClasses}">
              
              <div class="card-summary relative z-20 flex flex-col justify-between cursor-pointer transition-transform active:scale-[0.98] min-h-[80px] p-6">
                <div class="flex items-center gap-3 w-full relative z-10 justify-between">
                  <div class="flex-1 min-w-0">
                    <h4 class="text-xl font-bold tracking-tight leading-none truncate">${safePatientName}</h4>
                  </div>
                  ${statusIcon}
                </div>

                <div class="flex items-center gap-4 mt-5 relative z-10">
                  <div class="h-1.5 flex-1 ${progressBarTrack} rounded-full overflow-hidden relative">
                    <div class="h-full rounded-full ${progressBarFill} transition-all duration-500 ease-out" style="width: ${progressPercentage}%;"></div>
                  </div>
                  <div class="text-xs font-bold tracking-wide opacity-90 shrink-0">${displayCount}/${totalSess}</div>
                </div>
              </div>

              <div class="card-details grid transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" style="grid-template-rows: 0fr;">
                <div class="overflow-hidden relative z-20">
                  ${subscriptionWarningDetails}
                  
                  <div class="px-6 pt-2 pb-6 space-y-3">
                    <!-- Row 1: White Pill with Black Text & Icons for Time & Location -->
                    <div class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white text-black text-sm sm:text-base font-extrabold shadow-sm border border-transparent">
                      <span class="flex items-center gap-1.5 shrink-0 text-black">
                        <svg class="w-4 h-4 text-black opacity-75 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span class="text-black font-black">${timeRangeText}</span>
                      </span>
                      <span class="flex items-center gap-1.5 shrink-0 text-black">
                        <svg class="w-4 h-4 text-black opacity-75 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span class="text-black font-black">${safeLocation}</span>
                      </span>
                    </div>

                    <!-- Row 2: Payment Badge on Left (Spacious px-6 padding) + Icon-only Call/Folder Buttons on Right -->
                    <div class="flex items-center justify-between pt-0.5">
                      <button 
                        type="button"
                        class="h-11 flex items-center justify-center px-6 rounded-2xl ${paymentBadgeClass} hover:opacity-90 active:scale-95 transition-all text-sm sm:text-base font-black cursor-pointer shadow-sm whitespace-nowrap" 
                        onclick="event.stopPropagation(); window.dispatchEvent(new CustomEvent('openPaymentSheet', { detail: { patientId: '${session.patientId}' } }))"
                      >
                        <span>${displayPaymentLabel}</span>
                      </button>

                      <div class="flex items-center gap-2">
                        <a href="tel:${safePhone}" class="w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer" title="Sună pacientul" onclick="event.stopPropagation()">
                          <svg class="w-5 h-5 text-black opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                          </svg>
                        </a>

                        <a href="${safeDriveLink}" target="${hasDriveLink ? '_blank' : '_self'}" rel="noopener noreferrer" class="w-11 h-11 rounded-2xl bg-white hover:bg-neutral-50 border border-transparent shadow-sm active:scale-95 transition-all flex items-center justify-center text-black cursor-pointer" title="Deschide Dosar/Drive" onclick="event.stopPropagation(); if (!${hasDriveLink}) { event.preventDefault(); if (window.showToast) { window.showToast('Pacientul nu are un link de dosar/Drive salvat.', 'info'); } else { alert('Pacientul nu are un link de dosar/Drive salvat.'); } }">
                          <svg class="w-5 h-5 text-black opacity-85" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>

                  ${sessionStatus !== 'finalizat' && sessionStatus !== 'anulat' && sessionStatus !== 'absent' && (!session.selectedDate || session.selectedDate < todayStr || (session.selectedDate === todayStr && nowStr >= formattedEnd)) ? `
                    <div class="px-6 pb-6 pt-2">
                      <button type="button" class="w-full h-11 rounded-2xl ${isGhimbav ? 'bg-brand-primary text-black' : 'bg-brand-secondary text-white'} font-black text-xs sm:text-sm tracking-wider uppercase active:scale-95 transition-transform shadow-md flex items-center justify-center cursor-pointer border border-transparent hover:opacity-95" onclick="event.stopPropagation(); window.confirmSession('${session.id}')">
                        <span>CONFIRMĂ ȘEDINȚA</span>
                      </button>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
        </session-card>
      `;
    }

    async function renderTimeline() {
      const container = document.getElementById('timeline-slots-container');
      const skeleton = document.getElementById('timeline-skeleton');
      if (!container) return;

      if (skeleton && container.children.length === 0) {
        container.classList.add('hidden');
        skeleton.classList.remove('hidden');
      }

      let settings: any = {};
      let storedSessions: any[] = [];

      try {
        settings = await getSettings();
        currentSessionDuration = settings.session_duration || 50;
        const appts = await getAppointmentsByDate(currentCalendarDate);
        storedSessions = await Promise.all(appts.map(async (a: any) => {
          const sumaIncasata = await getPatientPayments(a.pacient_id);
          const costTotal = Number(a.pacienti?.cost || 0);
          const folosite = a.pacienti?.sedinte_folosite ?? 0;
          const totalSess = a.pacienti?.sedinte_total || 10;
          const sedinteRamase = Math.max(0, totalSess - folosite);
          const costPerSession = totalSess > 0 ? (costTotal / totalSess) : costTotal;
          const sedintePlatite = costPerSession > 0 ? Math.floor(sumaIncasata / costPerSession) : 0;

          let pStatus = 'Neachitat';
          if (a.pacienti?.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal)) {
            pStatus = 'Achitat integral';
          } else if (sumaIncasata > 0) {
            pStatus = 'Achitat parțial';
          } else if (a.pacienti?.status_plata) {
            pStatus = a.pacienti.status_plata;
          }

          return {
            id: a.id,
            patientId: a.pacient_id,
            patientName: a.pacienti ? `${a.pacienti.prenume} ${a.pacienti.nume}` : 'Pacient',
            patientPhone: a.pacienti?.telefon || '',
            driveLink: a.pacienti?.drive_link || '',
            selectedTime: a.ora,
            selectedDate: a.data,
            location: a.pacienti?.locatie || 'Belaqva',
            attendanceCount: folosite,
            totalSessions: totalSess,
            remainingSessions: sedinteRamase,
            subscriptionDone: totalSess > 0 && folosite > 0 && folosite >= totalSess,
            status: a.status || 'programat',
            costTotal,
            sumaIncasata,
            paymentStatus: pStatus,
          };
        }));
      } catch (e) {
        console.error('Eroare citire programari din DB:', e);
      }

      if (skeleton) skeleton.classList.add('hidden');
      container.classList.remove('hidden');

      const startHour = parseInt((settings.work_start || '08:00').split(':')[0], 10) || 8;
      const endHour = parseInt((settings.work_end || '20:00').split(':')[0], 10) || 20;
      const lunchStart = (settings.lunch_start || '12:00').substring(0, 5);
      const lunchEnd = (settings.lunch_end || '12:30').substring(0, 5);

      const [lsh, lsm] = lunchStart.split(':').map(Number);
      const [leh, lem] = lunchEnd.split(':').map(Number);
      const lunchStartMin = (lsh || 0) * 60 + (lsm || 0);
      const lunchEndMin = (leh || 0) * 60 + (lem || 0);

      function findSessionsForHour(slotTimeStr: string) {
        const slotHour = parseInt(slotTimeStr.split(':')[0], 10);
        return storedSessions.filter((s: any) => {
          if (!s.selectedTime) return false;
          const sessionHour = parseInt(s.selectedTime.split(':')[0], 10);
          return !isNaN(sessionHour) && sessionHour === slotHour;
        });
      }

      const timeSlots: string[] = [];
      for (let h = startHour; h <= endHour; h++) {
        timeSlots.push(`${h.toString().padStart(2, '0')}:00`);
      }

      // Group consecutive lunch slots into a single block so the lunch card spans all of them.
      type SlotItem = { type: 'slot'; time: string; sessions: any[] } | { type: 'lunch'; slots: string[] };
      const items: SlotItem[] = [];
      let i = 0;
      while (i < timeSlots.length) {
        const slotTimeStr = timeSlots[i];
        const h = parseInt(slotTimeStr.split(':')[0], 10);
        const slotHourStart = h * 60;
        const slotHourEnd = (h + 1) * 60;
        const sessions = findSessionsForHour(slotTimeStr);
        const isLunchSlot = sessions.length === 0 && (slotHourStart < lunchEndMin) && (slotHourEnd > lunchStartMin);

        if (isLunchSlot) {
          const lunchSlots: string[] = [];
          for (let j = i; j < timeSlots.length; j++) {
            const t = timeSlots[j];
            const tjHour = parseInt(t.split(':')[0], 10);
            const tjStart = tjHour * 60;
            const tjEnd = (tjHour + 1) * 60;
            const s = findSessionsForHour(t);
            if (s.length === 0 && (tjStart < lunchEndMin) && (tjEnd > lunchStartMin)) {
              lunchSlots.push(t);
            } else {
              break;
            }
          }
          items.push({ type: 'lunch', slots: lunchSlots.length > 0 ? lunchSlots : [slotTimeStr] });
          i += Math.max(1, lunchSlots.length);
        } else {
          items.push({ type: 'slot', time: slotTimeStr, sessions });
          i++;
        }
      }

      container.innerHTML = items.map((item) => {
        if (item.type === 'lunch') {
          const slotCount = item.slots.length;
          const heightClass = slotCount >= 2 ? 'h-32' : 'h-16';
          const labelHour = lunchStart.split(':')[0];
          const labelMin = lunchStart.split(':')[1] || '00';
          return `
            <div class="relative flex items-stretch gap-4 min-h-[4.5rem]">
              <div class="w-14 shrink-0 text-center flex flex-col items-center justify-center select-none relative pt-1">
                <span class="text-2xl font-black text-black leading-none tracking-tight">${labelHour}</span>
                <span class="text-xs font-extrabold text-pink-600 tracking-wider uppercase mt-0.5">${labelMin !== '00' ? ':' + labelMin : 'Pauză'}</span>
              </div>
              <div class="flex-1 min-w-0 pb-2">
                <div class="w-full ${heightClass} rounded-2xl flex items-center justify-between px-5 select-none relative cursor-pointer active:scale-[0.99] transition-transform" style="background: repeating-linear-gradient(45deg, rgba(236,72,153,0.06), rgba(236,72,153,0.06) 4px, transparent 4px, transparent 10px); border: 1.5px dashed rgba(236,72,153,0.35);" onclick="window.openLunchEdit()">
                  <span class="text-sm font-black text-pink-600/80">Pauză de masă</span>
                  <div class="flex items-center gap-2">
                    <span class="text-base font-black text-pink-700/80">${lunchStart} – ${lunchEnd}</span>
                    <svg class="w-4 h-4 text-pink-600/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                  </div>
                </div>
              </div>
            </div>
          `;
        }

        const slotTimeStr = item.time;
        const sessions = item.sessions;
        const displayTimeStr = sessions.length ? sessions[0].selectedTime : slotTimeStr;
        const [hourStr, minStr] = displayTimeStr.split(':');

        return `
          <div class="relative flex items-stretch gap-4 min-h-[4.5rem]">
            <div class="w-14 shrink-0 text-center flex flex-col items-center justify-center select-none relative pt-1">
              <span class="text-2xl font-black text-black leading-none tracking-tight">${hourStr}</span>
              <span class="text-xs font-bold text-text-muted tracking-wider uppercase mt-0.5">${minStr || '00'}</span>
            </div>

            <div class="flex-1 min-w-0 pb-2 flex flex-col gap-2" data-slot-time="${slotTimeStr}">
              ${sessions.length > 0
                ? sessions.map((s: any) => createSessionCardHTML(s)).join('')
                : `
                  <button
                    type="button"
                    class="w-full h-16 rounded-2xl border-2 border-dashed border-neutral-200 flex items-center justify-center text-neutral-400 text-sm font-bold hover:border-brand-primary hover:text-brand-primary hover:bg-brand-primary/5 transition-colors active:scale-[0.98]"
                    onclick="window.dispatchEvent(new CustomEvent('openAddSession', { detail: { time: '${slotTimeStr}', date: currentCalendarDate, showDateTime: false } }))"
                  >
                    + Adaugă ședință
                  </button>
                `}
            </div>
          </div>
        `;
      }).join('');
    }

    if ((window as any)._calendarSessionsHandler) {
      window.removeEventListener('sessionsUpdated', (window as any)._calendarSessionsHandler);
      window.removeEventListener('patientsUpdated', (window as any)._calendarPatientsHandler);
      window.removeEventListener('settingsUpdated', (window as any)._calendarSettingsHandler);
    }
    
    (window as any)._calendarSessionsHandler = (e: any) => {
      // La ștergere, cardul este eliminat optimist; nu re-fetchăm întreg calendarul.
      if (e.detail?.source === 'dashboardDelete') return;
      renderTimeline();
    };
    (window as any)._calendarPatientsHandler = renderTimeline;
    (window as any)._calendarSettingsHandler = renderTimeline;

    window.addEventListener('sessionsUpdated', (window as any)._calendarSessionsHandler);
    window.addEventListener('patientsUpdated', (window as any)._calendarPatientsHandler);
    
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      renderTimeline();
    } else {
      document.addEventListener('DOMContentLoaded', renderTimeline);
    }
    document.addEventListener('astro:page-load', renderTimeline);
    // Re-renderizează timeline când se schimbă orele de lucru sau pauza din Setări
    window.addEventListener('settingsUpdated', (window as any)._calendarSettingsHandler);

    // ── Drag & drop: mută o programare (long-press apoi drag) ──────────────
    // Drop pe un slot orar din timeline → schimbă ora.
    // Drop pe o zi din strip-ul săptămânii (WeeklyCalendarCard) → schimbă ziua.
    // Triggerul DB `valideaza_programare` respinge suprapunerile — afișăm mesajul.
    function initSessionDragDrop() {
      if ((window as any)._sessionDragDropInit) return;
      (window as any)._sessionDragDropInit = true;

      const MOVE_CANCEL_PX = 12;

      let activePointerId: number | null = null;
      let pressTimer: number | undefined;
      let startX = 0;
      let startY = 0;
      let sourceCard: HTMLElement | null = null;
      let dragging = false;
      let ghostEl: HTMLElement | null = null;
      let ghostOffsetX = 0;
      let ghostOffsetY = 0;
      let suppressClick = false;
      let dropTarget: { type: 'slot' | 'day'; el: HTMLElement; value: string; targetSessionId?: string } | null = null;

      function cancelPress() {
        clearTimeout(pressTimer);
        pressTimer = undefined;
        if (!dragging) {
          activePointerId = null;
          sourceCard = null;
        }
      }

      function clearTargetHighlight() {
        if (!dropTarget) return;
        dropTarget.el.style.outline = '';
        dropTarget.el.style.outlineOffset = '';
        dropTarget.el.style.borderRadius = '';
        dropTarget = null;
      }

      function engageDrag(x: number, y: number) {
        if (!sourceCard || dragging) return;
        dragging = true;
        (window as any)._sessionDragActive = true;

        const rect = sourceCard.getBoundingClientRect();
        ghostOffsetX = x - rect.left;
        ghostOffsetY = y - rect.top;

        ghostEl = sourceCard.cloneNode(true) as HTMLElement;
        ghostEl.style.cssText += `;position:fixed;left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;z-index:70;pointer-events:none;margin:0;opacity:0.95;box-shadow:0 24px 48px rgba(0,0,0,0.3);border-radius:2.5rem;`;
        document.body.appendChild(ghostEl);

        sourceCard.style.opacity = '0.35';
        document.body.style.overflow = 'hidden';
        moveGhost(x, y);
      }

      function moveGhost(x: number, y: number) {
        if (!ghostEl) return;
        ghostEl.style.left = `${x - ghostOffsetX}px`;
        ghostEl.style.top = `${y - ghostOffsetY}px`;
      }

      function updateDropTarget(x: number, y: number) {
        clearTargetHighlight();
        const el = document.elementFromPoint(x, y) as HTMLElement | null;
        if (!el) return;

        const dayEl = el.closest('[data-calendar-item]') as HTMLElement | null;
        if (dayEl && dayEl.closest('#calendar-strip')) {
          const yy = dayEl.getAttribute('data-year');
          const mm = dayEl.getAttribute('data-month');
          const dd = dayEl.getAttribute('data-date');
          if (yy && mm !== null && dd) {
            const dateStr = `${yy}-${(parseInt(mm) + 1).toString().padStart(2, '0')}-${dd.padStart(2, '0')}`;
            dropTarget = { type: 'day', el: dayEl, value: dateStr };
            dayEl.style.outline = '2px solid black';
            dayEl.style.outlineOffset = '2px';
            return;
          }
        }

        const slotEl = el.closest('[data-slot-time]') as HTMLElement | null;
        if (slotEl && slotEl.closest('#timeline-slots-container')) {
          const slotTime = slotEl.getAttribute('data-slot-time');
          if (slotTime) {
            const targetCard = slotEl.querySelector('[data-session-id]') as HTMLElement | null;
            const targetSessionId = targetCard?.getAttribute('data-session-id') || undefined;
            dropTarget = { type: 'slot', el: slotEl, value: slotTime, targetSessionId };
            slotEl.style.outline = '2px dashed #0a0a0a';
            slotEl.style.outlineOffset = '-2px';
            slotEl.style.borderRadius = '1rem';
          }
        }
      }

      function cleanupDrag() {
        clearTargetHighlight();
        if (ghostEl) {
          ghostEl.remove();
          ghostEl = null;
        }
        if (sourceCard) sourceCard.style.opacity = '';
        sourceCard = null;
        activePointerId = null;
        dragging = false;
        (window as any)._sessionDragActive = false;
        document.body.style.overflow = '';
      }

      async function finishDrag() {
        const target = dropTarget;
        const card = sourceCard;
        suppressClick = true;
        setTimeout(() => { suppressClick = false; }, 350);
        cleanupDrag();
        if (!target || !card) return;

        const sessionId = card.getAttribute('data-session-id');
        const origTime = card.getAttribute('data-session-time');
        const origDate = card.getAttribute('data-session-date');
        if (!sessionId) return;

        try {
          if (target.type === 'slot' && target.targetSessionId && target.targetSessionId !== sessionId) {
            // Drop pe un slot ocupat → schimbă pacienții între programări
            await swapAppointmentPatients(sessionId, target.targetSessionId);
            (window as any).showToast('Pacienții au fost schimbați între ore.', 'success');
            window.dispatchEvent(new CustomEvent('sessionsUpdated'));
            return;
          }

          const updates: { ora?: string; data?: string } = {};
          if (target.type === 'slot') {
            if (target.value === origTime) return; // aceeași oră — nimic de făcut
            updates.ora = target.value;
          } else {
            if (target.value === origDate) return; // aceeași zi — nimic de făcut
            updates.data = target.value;
          }

          await updateAppointment(sessionId, updates);
          (window as any).showToast('Programarea a fost mutată cu succes.', 'success');
          if (target.type === 'day') {
            (target.el as HTMLButtonElement).click(); // comută timeline-ul pe ziua nouă
          }
          window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        } catch (err: any) {
          (window as any).showToast('Nu am putut muta programarea: ' + (err?.message || err), 'error');
          window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        }
      }

      document.addEventListener('pointerdown', (e: PointerEvent) => {
        if (dragging) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        const target = e.target as HTMLElement;
        if (target.closest('button') || target.closest('a')) return;
        const card = target.closest('[data-session-id]') as HTMLElement | null;
        if (!card || !card.closest('#timeline-slots-container')) return;

        activePointerId = e.pointerId;
        startX = e.clientX;
        startY = e.clientY;
        sourceCard = card;

        const holdMs = e.pointerType === 'mouse' ? 250 : 500;
        clearTimeout(pressTimer);
        pressTimer = window.setTimeout(() => engageDrag(startX, startY), holdMs);
      });

      document.addEventListener('pointermove', (e: PointerEvent) => {
        if (activePointerId === null || e.pointerId !== activePointerId) return;
        if (!dragging) {
          if (Math.hypot(e.clientX - startX, e.clientY - startY) > MOVE_CANCEL_PX) cancelPress();
          return;
        }
        moveGhost(e.clientX, e.clientY);
        updateDropTarget(e.clientX, e.clientY);
      });

      document.addEventListener('pointerup', (e: PointerEvent) => {
        if (activePointerId === null || e.pointerId !== activePointerId) return;
        if (!dragging) {
          cancelPress();
          return;
        }
        finishDrag();
      });

      document.addEventListener('pointercancel', (e: PointerEvent) => {
        if (activePointerId === null || e.pointerId !== activePointerId) return;
        clearTimeout(pressTimer);
        if (dragging) cleanupDrag();
        else cancelPress();
      });

      // Blochează scroll-ul paginii cât timp e activ un potențial drag pe card.
      document.addEventListener('touchmove', (e: TouchEvent) => {
        if (activePointerId !== null && sourceCard) {
          const touch = e.touches[0];
          const dx = touch.clientX - startX;
          const dy = touch.clientY - startY;
          if (Math.hypot(dx, dy) <= MOVE_CANCEL_PX && e.cancelable) {
            e.preventDefault();
          }
        }
        if (dragging && e.cancelable) e.preventDefault();
      }, { passive: false });

      // Blochează meniul contextual pe long-press în timpul drag-ului
      document.addEventListener('contextmenu', (e: Event) => {
        if (dragging) e.preventDefault();
      });

      // Nu declanșa expandarea cardului din click-ul de la finalul drag-ului
      document.addEventListener('click', (e: Event) => {
        if (suppressClick) {
          e.stopPropagation();
          e.preventDefault();
          suppressClick = false;
        }
      }, true);
    }

    document.addEventListener('DOMContentLoaded', initSessionDragDrop);
    document.addEventListener('astro:page-load', initSessionDragDrop);
  </script>
</DashboardLayout>
