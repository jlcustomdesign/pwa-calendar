---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WeeklyCalendarCard from '../../components/features/dashboard/WeeklyCalendarCard.astro';
import AddEventBanner from '../../components/features/dashboard/AddEventBanner.astro';

// Cache the shell of the dashboard page privately so switching tabs feels instant.
Astro.response.headers.set('Cache-Control', 'private, max-age=30, must-revalidate');
---

<DashboardLayout title="Calendar">
  <div class="relative min-h-[100dvh]">
    <div class="relative z-10 space-y-6 pb-24">
    
    <!-- Top Section: Expandable Weekly/Monthly Calendar -->
    <WeeklyCalendarCard name="Dr. Maria" />
    
    <!-- Add Session Banner -->
    <AddEventBanner variant="session" />
    
    <!-- Timeline View -->
    <section class="mt-6">
      <h3 class="text-xl font-extrabold text-black tracking-tight mb-4 px-2">Timeline</h3>

      <div id="timeline-slots-container" class="flex flex-col gap-3">
        <!-- Rendered dynamically by JS -->
      </div>

      <!-- Skeleton loader: shown only while fetching from DB -->
      <div id="timeline-skeleton" class="hidden flex flex-col gap-3">
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
        <div class="flex items-stretch gap-4">
          <div class="w-14 shrink-0 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
          <div class="flex-1 h-16 rounded-2xl bg-black/10 animate-pulse"></div>
        </div>
      </div>
    </section>
  </div>
  </div>

  <!-- Lunch Break Edit Modal (native dialog for guaranteed visibility) -->
  <dialog id="lunch-edit-modal" tabindex="-1" class="fixed inset-0 m-auto p-0 bg-transparent max-w-full max-h-full w-full h-full outline-none">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="lunch-edit-backdrop"></div>
    <div id="lunch-edit-dialog" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[calc(100%-2rem)] max-w-sm max-h-[85vh] overflow-y-auto bg-white rounded-[2rem] p-6 shadow-2xl">
      <!-- Custom Time Pickers: Start & End as separate cards -->
      <div class="space-y-4 mb-6">
        <!-- Început -->
        <div class="bg-black/[0.03] rounded-3xl p-4 space-y-3" data-lunch-time-section="start">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-black uppercase tracking-wider">Început</span>
            <span class="text-2xl font-black text-black font-sans tracking-tight" data-lunch-preview="start">12:00</span>
          </div>
          <div class="space-y-2">
            <div class="text-[10px] font-extrabold text-text-muted uppercase tracking-wider">Ore</div>
            <div class="grid grid-cols-6 gap-1.5" data-lunch-hours="start">
              <!-- generated by JS -->
            </div>
          </div>
          <div class="space-y-2">
            <div class="text-[10px] font-extrabold text-text-muted uppercase tracking-wider">Minute</div>
            <div class="grid grid-cols-4 gap-1.5" data-lunch-minutes="start">
              <button type="button" data-value="00" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">00</button>
              <button type="button" data-value="15" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">15</button>
              <button type="button" data-value="30" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">30</button>
              <button type="button" data-value="45" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">45</button>
            </div>
          </div>
        </div>

        <!-- Sfârșit -->
        <div class="bg-black/[0.03] rounded-3xl p-4 space-y-3" data-lunch-time-section="end">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-black uppercase tracking-wider">Sfârșit</span>
            <span class="text-2xl font-black text-black font-sans tracking-tight" data-lunch-preview="end">12:30</span>
          </div>
          <div class="space-y-2">
            <div class="text-[10px] font-extrabold text-text-muted uppercase tracking-wider">Ore</div>
            <div class="grid grid-cols-6 gap-1.5" data-lunch-hours="end">
              <!-- generated by JS -->
            </div>
          </div>
          <div class="space-y-2">
            <div class="text-[10px] font-extrabold text-text-muted uppercase tracking-wider">Minute</div>
            <div class="grid grid-cols-4 gap-1.5" data-lunch-minutes="end">
              <button type="button" data-value="00" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">00</button>
              <button type="button" data-value="15" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">15</button>
              <button type="button" data-value="30" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">30</button>
              <button type="button" data-value="45" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all">45</button>
            </div>
          </div>
        </div>
      </div>

      <div class="flex gap-3">
        <button type="button" id="lunch-edit-cancel" class="flex-1 py-3.5 rounded-full bg-black/5 text-black font-extrabold text-sm active:scale-95 transition-transform">Anulează</button>
        <button type="button" id="lunch-edit-save" class="flex-1 py-3.5 rounded-full bg-brand-primary text-black font-extrabold text-sm shadow-md active:scale-95 transition-transform">Salvează</button>
      </div>
    </div>
  </dialog>

  <style is:global>
    /* Long-press drag & drop: oprește callout-ul iOS și selecția textului pe carduri */
    [data-session-id],
    [data-group-id] {
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }

    .group-session-card .card-details {
      grid-template-rows: 0fr;
    }
    .group-session-card.expanded .card-details {
      grid-template-rows: 1fr;
    }
    .group-session-card.expanded .group-expanded-hint {
      display: none;
    }
  </style>

  <script>
    import { getAppointmentsByDate, updateAppointment, swapAppointmentPatients } from '../../lib/services/appointmentService';
    import { getSettings, saveSettings } from '../../lib/services/settingsService';
    import { applyBeyondSupplyMarks, createGroupCardHTML, createSessionCardHTML, fetchPaymentsForPatients, groupSessions } from '../../lib/render/sessionCard';

    function localDateStr(d = new Date()) {
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }
    const todayStr = localDateStr();
    let currentCalendarDate = todayStr;
    let currentSessionDuration = (() => {
      try {
        const raw = localStorage.getItem('kineto_settings_cache');
        if (raw) {
          const cached = JSON.parse(raw);
          if (typeof cached.session_duration === 'number') return cached.session_duration;
        }
      } catch (e) {}
      return 50;
    })();
    (window as any).currentCalendarDate = currentCalendarDate;

    const handleDateSelected = (e: any) => {
      const date = e.detail?.date;
      if (date) {
        currentCalendarDate = date;
        (window as any).currentCalendarDate = date;
        renderTimeline();
      }
    };

    // Mută pauza de masă cu ±30 de minute direct din calendar.
    (window as any).shiftLunchBreak = async (minutes: number) => {
      try {
        const settings = await getSettings();
        const parseMin = (t: string) => {
          const [h, m] = (t || '00:00').substring(0, 5).split(':').map(Number);
          return (h || 0) * 60 + (m || 0);
        };
        const fmt = (total: number) => `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;

        let newStart = parseMin(settings.lunch_start || '13:00') + minutes;
        let newEnd = parseMin(settings.lunch_end || '14:00') + minutes;

        if (newStart < 0) { newEnd -= newStart; newStart = 0; }
        if (newEnd > 24 * 60) { newStart -= (newEnd - 24 * 60); newEnd = 24 * 60; }

        await saveSettings({ lunch_start: fmt(newStart), lunch_end: fmt(newEnd) });
        window.dispatchEvent(new CustomEvent('settingsUpdated'));
        (window as any).showToast?.(`Pauza de masă mutată: ${fmt(newStart)} - ${fmt(newEnd)}`, 'success');
      } catch (err: any) {
        (window as any).showToast?.('Eroare la mutarea pauzei: ' + (err.message || err), 'error');
      }
    };

    // Editează pauza de masă direct din calendar — custom time picker.
    const lunchEditState = { start: '12:00', end: '12:30' };
    let lunchWorkStartHour = 8;
    let lunchWorkEndHour = 21;

    function getLunchEditEls() {
      return {
        modal: document.getElementById('lunch-edit-modal') as HTMLDialogElement | null,
        backdrop: document.getElementById('lunch-edit-backdrop'),
        save: document.getElementById('lunch-edit-save'),
        cancel: document.getElementById('lunch-edit-cancel'),
      };
    }

    function parseHour(t: string | undefined, fallback: number) {
      const h = parseInt((t || '').split(':')[0], 10);
      return isNaN(h) ? fallback : h;
    }

    function renderLunchHourGrid(section: 'start' | 'end') {
      const container = document.querySelector(`[data-lunch-hours="${section}"]`);
      if (!container) return;
      const hours: string[] = [];
      for (let h = lunchWorkStartHour; h <= lunchWorkEndHour; h++) {
        hours.push(String(h).padStart(2, '0'));
      }
      container.innerHTML = hours.map((h) =>
        `<button type="button" data-value="${h}" class="py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all lunch-hour-btn">${h}</button>`
      ).join('');
    }

    function updateLunchPreview(section: 'start' | 'end') {
      const preview = document.querySelector(`[data-lunch-preview="${section}"]`);
      if (preview) preview.textContent = lunchEditState[section];
    }

    function setLunchTime(section: 'start' | 'end', type: 'hour' | 'minute', value: string) {
      const [h, m] = lunchEditState[section].split(':');
      const newTime = type === 'hour' ? `${value}:${m}` : `${h}:${value}`;
      lunchEditState[section] = newTime;
      updateLunchPreview(section);
      highlightLunchSelection(section);
    }

    function highlightLunchSelection(section: 'start' | 'end') {
      const [h, m] = lunchEditState[section].split(':');
      const sectionEl = document.querySelector(`[data-lunch-time-section="${section}"]`);
      if (!sectionEl) return;
      sectionEl.querySelectorAll('.lunch-hour-btn').forEach((btn) => {
        const el = btn as HTMLButtonElement;
        const active = el.dataset.value === h;
        el.className = active
          ? 'py-2 rounded-xl text-xs font-black bg-brand-secondary text-white shadow-sm scale-105 transition-all lunch-hour-btn'
          : 'py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all lunch-hour-btn';
      });
      sectionEl.querySelectorAll('[data-lunch-minutes] button').forEach((btn) => {
        const el = btn as HTMLButtonElement;
        const active = el.dataset.value === m;
        el.className = active
          ? 'py-2 rounded-xl text-xs font-black bg-brand-secondary text-white shadow-sm scale-105 transition-all'
          : 'py-2 rounded-xl text-xs font-bold bg-brand-primary text-black transition-all';
      });
    }

    function openLunchEdit() {
      const els = getLunchEditEls();
      if (!els.modal) return;
      getSettings().then((settings) => {
        lunchWorkStartHour = parseHour(settings.work_start, 8);
        lunchWorkEndHour = parseHour(settings.work_end, 21);
        lunchEditState.start = (settings.lunch_start || '12:00').substring(0, 5);
        lunchEditState.end = (settings.lunch_end || '12:30').substring(0, 5);
        renderLunchHourGrid('start');
        renderLunchHourGrid('end');
        updateLunchPreview('start');
        updateLunchPreview('end');
        highlightLunchSelection('start');
        highlightLunchSelection('end');
        if (typeof els.modal!.showModal === 'function') {
          if (!els.modal!.open) {
            els.modal!.showModal();
            // Prevent the first hour button from stealing focus/looking selected.
            els.modal!.focus();
          }
        } else {
          els.modal!.setAttribute('open', '');
        }
      });
    }

    function closeLunchEdit() {
      const els = getLunchEditEls();
      if (!els.modal) return;
      if (typeof els.modal.close === 'function') {
        els.modal.close();
      } else {
        els.modal.removeAttribute('open');
      }
    }

    async function saveLunchEdit() {
      const { start, end } = lunchEditState;
      if (start >= end) {
        (window as any).showToast?.('Ora de început trebuie să fie înainte de ora de sfârșit.', 'error');
        return;
      }
      try {
        await saveSettings({ lunch_start: start, lunch_end: end });
        window.dispatchEvent(new CustomEvent('settingsUpdated'));
        (window as any).showToast?.(`Pauza de masă: ${start} – ${end}`, 'success');
        closeLunchEdit();
      } catch (err: any) {
        (window as any).showToast?.('Eroare la salvare: ' + (err.message || err), 'error');
      }
    }

    (window as any).openLunchEdit = openLunchEdit;
    // Implementarea curentă (scriptul este re-executat la fiecare navigare SPA,
    // deci listenerele permanente trebuie să apeleze mereu ultima instanță).
    (window as any)._openLunchEditCurrent = openLunchEdit;

    function bindLunchEditEvents() {
      const els = getLunchEditEls();

      document.querySelectorAll('[data-lunch-time-section]').forEach((sectionEl) => {
        const section = sectionEl.getAttribute('data-lunch-time-section') as 'start' | 'end';
        // Fiecare element primește listener o singură dată (elementele sunt
        // recreate la swap, deci dataset-ul se resetează și se re-leagă corect).
        if ((sectionEl as HTMLElement).dataset.lunchEventsBound === 'true') return;
        (sectionEl as HTMLElement).dataset.lunchEventsBound = 'true';
        sectionEl.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const btn = target.closest('button') as HTMLButtonElement | null;
          if (!btn || !btn.dataset.value) return;
          const container = btn.parentElement;
          if (container?.hasAttribute('data-lunch-hours')) {
            setLunchTime(section, 'hour', btn.dataset.value);
          } else if (container?.hasAttribute('data-lunch-minutes')) {
            setLunchTime(section, 'minute', btn.dataset.value);
          }
        });
      });

      if (els.save && els.save.dataset.lunchSaveBound !== 'true') {
        els.save.dataset.lunchSaveBound = 'true';
        els.save.addEventListener('click', saveLunchEdit);
      }
      if (els.cancel && els.cancel.dataset.lunchCancelBound !== 'true') {
        els.cancel.dataset.lunchCancelBound = 'true';
        els.cancel.addEventListener('click', closeLunchEdit);
      }
      if (els.modal && els.modal.dataset.lunchModalBound !== 'true') {
        els.modal.dataset.lunchModalBound = 'true';
        els.modal.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target === els.modal || target === els.backdrop) closeLunchEdit();
        });
        els.modal.addEventListener('cancel', closeLunchEdit);
      }
    }
    (window as any)._bindLunchEditEventsCurrent = bindLunchEditEvents;

    // Se re-leagă la fiecare încărcare de pagină (elementele sunt recreate la
    // swap), dar listenerul de page-load este înregistrat o singură dată pe
    // sesiune — altfel s-ar acumula câte un listener permanent la fiecare vizită.
    if (!(window as any)._calendarLunchEventsBound) {
      (window as any)._calendarLunchEventsBound = true;
      document.addEventListener('astro:page-load', () => (window as any)._bindLunchEditEventsCurrent?.());
    }

    // Delegated open for lunch card (re-rendered by renderTimeline)
    if (!(window as any)._calendarLunchOpenBound) {
      (window as any)._calendarLunchOpenBound = true;
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const lunchCard = target.closest('[data-lunch-card]');
        if (lunchCard) {
          e.stopPropagation();
          (window as any)._openLunchEditCurrent?.();
        }
      });
    }

    if ((window as any)._calendarDateSelectedHandler) {
      window.removeEventListener('calendarDateSelected', (window as any)._calendarDateSelectedHandler);
    }
    (window as any)._calendarDateSelectedHandler = handleDateSelected;
    window.addEventListener('calendarDateSelected', handleDateSelected);

    async function renderTimeline() {
      const container = document.getElementById('timeline-slots-container');
      const skeleton = document.getElementById('timeline-skeleton');
      if (!container) return;

      if (skeleton && container.children.length === 0) {
        container.classList.add('hidden');
        skeleton.classList.remove('hidden');
      }

      let settings: any = {};
      let storedSessions: any[] = [];

      try {
        settings = await getSettings();
        currentSessionDuration = settings.session_duration || 50;
        const appts = await getAppointmentsByDate(currentCalendarDate);
        // O singură interogare grupată pentru plăți (în loc de câte una per ședință).
        const patientIds = [...new Set(appts.map((a: any) => a.pacient_id).filter(Boolean))] as string[];
        const paymentsByPatient = await fetchPaymentsForPatients(patientIds);
        storedSessions = appts.map((a: any) => {
          const sumaIncasata = paymentsByPatient.get(a.pacient_id) ?? 0;
          const costTotal = Number(a.pacienti?.cost || 0);
          const folosite = a.pacienti?.sedinte_folosite ?? 0;
          const totalSess = a.pacienti?.sedinte_total || 10;
          const sedinteRamase = Math.max(0, totalSess - folosite);

          let pStatus = 'Neachitat';
          if (a.pacienti?.achitat === true || (costTotal > 0 && sumaIncasata >= costTotal)) {
            pStatus = 'Achitat integral';
          } else if (sumaIncasata > 0) {
            pStatus = 'Achitat parțial';
          } else if (a.pacienti?.status_plata) {
            pStatus = a.pacienti.status_plata;
          }

          return {
            id: a.id,
            patientId: a.pacient_id,
            patientName: a.pacienti ? (a.pacienti.prenume === a.pacienti.nume || !a.pacienti.nume ? a.pacienti.prenume : `${a.pacienti.prenume} ${a.pacienti.nume}`.trim()) : 'Pacient',
            patientPhone: a.pacienti?.telefon || '',
            driveLink: a.pacienti?.drive_link || '',
            selectedTime: a.ora,
            selectedDate: a.data,
            location: a.pacienti?.locatie || 'Belaqva',
            attendanceCount: folosite,
            totalSessions: totalSess,
            remainingSessions: sedinteRamase,
            subscriptionDone: totalSess > 0 && folosite > 0 && folosite >= totalSess,
            status: a.status || 'programat',
            costTotal,
            sumaIncasata,
            paymentStatus: pStatus,
            groupId: a.group_id || null,
          };
        });

        // Marchează duplicatele (același pacient la aceeași oră) — se afișează transparent
        const dupCounts = new Map();
        for (const s of storedSessions) {
          const key = `${s.patientId}|${(s.selectedTime || '').substring(0, 5)}`;
          dupCounts.set(key, (dupCounts.get(key) || 0) + 1);
        }
        for (const s of storedSessions) {
          s.isDuplicate = (dupCounts.get(`${s.patientId}|${(s.selectedTime || '').substring(0, 5)}`) || 0) > 1;
        }

        // Marchează programările viitoare care depășesc ședințele rămase
        // (cerere vs ofertă): poziția în lista viitoare a pacientului > ședințe rămase.
        await applyBeyondSupplyMarks(storedSessions);
      } catch (e) {
        console.error('Eroare citire programari din DB:', e);
      }

      if (skeleton) skeleton.classList.add('hidden');
      container.classList.remove('hidden');

      const startHour = parseInt((settings.work_start || '08:00').split(':')[0], 10) || 8;
      const endHour = parseInt((settings.work_end || '20:00').split(':')[0], 10) || 20;

      // Determină pauza de masă pentru ziua curentă (personalizată sau implicită)
      const currentDayDate = new Date(currentCalendarDate + 'T00:00:00');
      const currentDayOfWeek = currentDayDate.getDay(); // 0=Duminică, 1=Luni...
      const dayKey = String(currentDayOfWeek);
      const lunchBreaks = (settings.lunch_breaks || {}) as Record<string, { start: string; end: string }>;
      const customLunch = lunchBreaks[dayKey];
      const lunchStart = (customLunch?.start || settings.lunch_start || '12:00').substring(0, 5);
      const lunchEnd = (customLunch?.end || settings.lunch_end || '12:30').substring(0, 5);

      const [lsh, lsm] = lunchStart.split(':').map(Number);
      const [leh, lem] = lunchEnd.split(':').map(Number);
      const lunchStartMin = (lsh || 0) * 60 + (lsm || 0);
      const lunchEndMin = (leh || 0) * 60 + (lem || 0);

      function findSessionsInRange(slotStartMin: number, slotEndMin: number) {
        return storedSessions.filter((s: any) => {
          if (!s.selectedTime) return false;
          const parts = s.selectedTime.split(':');
          const sessionStartMin = (parseInt(parts[0] || '0', 10) * 60) + parseInt(parts[1] || '0', 10);
          const sessionEndMin = sessionStartMin + currentSessionDuration;
          return sessionStartMin < slotEndMin && sessionEndMin > slotStartMin;
        });
      }

      const breakBuffer = Number(settings.break_buffer) || 0;
      const slotStep = currentSessionDuration + breakBuffer; // ex: 50 min ședință + 10 min pauză = slot la fiecare oră

      const timeSlots: string[] = [];
      let cursor = startHour * 60;
      const endMin = endHour * 60;
      while (cursor < endMin) {
        const slotEnd = cursor + currentSessionDuration;
        // Dacă slotul se suprapune cu pauza de masă și nu are nicio ședință,
        // sari la finalul pauzei și continuă de acolo (ex: 12:30, 13:30…).
        if (cursor < lunchEndMin && slotEnd > lunchStartMin) {
          if (findSessionsInRange(cursor, slotEnd).length === 0) {
            cursor = lunchEndMin;
            continue;
          }
        }
        const h = Math.floor(cursor / 60);
        const m = cursor % 60;
        timeSlots.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
        cursor += slotStep;
      }

      // Construiește lista de elemente; inserează cardul de pauză de masă
      // exact înainte de primul slot care începe după pauză.
      type SlotItem = { type: 'slot'; time: string; sessions: any[] } | { type: 'lunch'; slots: string[] };
      const items: SlotItem[] = [];
      const lunchInRange = lunchEndMin > startHour * 60 && lunchStartMin < endMin;
      let lunchInserted = false;

      // Repartizează fiecare ședință în slotul în care ÎNCEPE (o ședință de 50 min
      // de la 07:45 se afișează DOAR la 07:45, nu și ca duplicat estompat la 08:00).
      const slotBuckets = new Map<string, any[]>(timeSlots.map((t) => [t, []]));
      for (const s of storedSessions) {
        if (!s.selectedTime) continue;
        const parts = s.selectedTime.split(':');
        const startMin = (parseInt(parts[0] || '0', 10) * 60) + parseInt(parts[1] || '0', 10);
        let chosen = timeSlots[0];
        for (const t of timeSlots) {
          const [th, tm] = t.split(':').map(Number);
          if ((th || 0) * 60 + (tm || 0) <= startMin) chosen = t;
          else break;
        }
        slotBuckets.get(chosen)!.push(s);
      }

      for (let i = 0; i < timeSlots.length; i++) {
        const slotTimeStr = timeSlots[i];
        const [sh, sm] = slotTimeStr.split(':').map(Number);
        const slotStart = (sh || 0) * 60 + (sm || 0);

        if (!lunchInserted && lunchInRange && slotStart >= lunchEndMin) {
          items.push({ type: 'lunch', slots: [lunchStart] });
          lunchInserted = true;
        }
        items.push({ type: 'slot', time: slotTimeStr, sessions: slotBuckets.get(slotTimeStr) || [] });
      }

      if (!lunchInserted && lunchInRange) {
        items.push({ type: 'lunch', slots: [lunchStart] });
      }

      // Contextul comun pentru randarea cardurilor (modulul partajat sessionCard).
      const cardCtx = { currentDate: currentCalendarDate, sessionDuration: currentSessionDuration, variant: 'timeline' as const };

      container.innerHTML = items.map((item) => {
        if (item.type === 'lunch') {
          const labelHour = lunchStart.split(':')[0];
          const labelMin = lunchStart.split(':')[1] || '00';
          const firstLunchSlot = lunchEnd; // prima oră liberă de după pauză
          return `
            <div class="relative flex items-stretch gap-4 min-h-[4.5rem]">
              <div class="w-14 shrink-0 text-center flex flex-col items-center justify-center select-none relative pt-1">
                <span class="text-2xl font-black text-black leading-none tracking-tight">${labelHour}</span>
                <span class="text-xs font-extrabold text-pink-600 tracking-wider uppercase mt-0.5">${labelMin !== '00' ? ':' + labelMin : 'Pauză'}</span>
              </div>
              <div class="flex-1 min-w-0 pb-2 flex flex-col gap-2">
                <div data-lunch-card class="w-full h-16 rounded-2xl flex items-center justify-between px-5 select-none relative cursor-pointer active:scale-[0.99] transition-transform" style="background: repeating-linear-gradient(45deg, rgba(236,72,153,0.06), rgba(236,72,153,0.06) 4px, transparent 4px, transparent 10px); border: 1.5px dashed rgba(236,72,153,0.35);">
                  <span class="text-sm font-black text-pink-600/80">Pauză de masă</span>
                  <div class="flex items-center gap-2">
                    <span class="text-base font-black text-pink-700/80">${lunchStart} – ${lunchEnd}</span>
                    <svg class="w-4 h-4 text-pink-600/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                  </div>
                </div>
                <button
                  type="button"
                  class="w-full h-12 rounded-2xl border-2 border-dashed border-neutral-200 flex items-center justify-center text-neutral-400 text-sm font-bold hover:border-brand-primary hover:text-brand-primary hover:bg-brand-primary/5 transition-colors active:scale-[0.98]"
                  onclick="window.dispatchEvent(new CustomEvent('openAddSession', { detail: { time: '${firstLunchSlot}', date: currentCalendarDate, showDateTime: false } }))"
                >
                  + Adaugă ședință
                </button>
              </div>
            </div>
          `;
        }

        const slotTimeStr = item.time;
        const rawSessions = item.sessions;
        const sessions = groupSessions(rawSessions, currentCalendarDate);
        const displayTimeStr = sessions.length ? sessions[0].selectedTime : slotTimeStr;
        const [hourStr, minStr] = displayTimeStr.split(':');

        return `
          <div class="relative flex items-stretch gap-4 min-h-[4.5rem]">
            <div class="w-14 shrink-0 text-center flex flex-col items-center justify-center select-none relative pt-1">
              <span class="text-2xl font-black text-black leading-none tracking-tight">${hourStr}</span>
              <span class="text-xs font-bold text-text-muted tracking-wider uppercase mt-0.5">${minStr || '00'}</span>
            </div>

            <div class="flex-1 min-w-0 pb-2 flex flex-col gap-2" data-slot-time="${slotTimeStr}">
              ${sessions.length > 0 ? sessions.map((s: any) => {
                if (s.isGroup) return createGroupCardHTML(s, cardCtx);
                const sTime = (s.selectedTime || '08:00').substring(0, 5);
                const sHour = parseInt(sTime.split(':')[0], 10);
                const isCont = sHour !== parseInt(slotTimeStr.split(':')[0], 10);
                return createSessionCardHTML(s, isCont, cardCtx);
              }).join('') : ''}
              <button
                type="button"
                class="w-full h-12 rounded-2xl border-2 border-dashed border-neutral-200 flex items-center justify-center text-neutral-400 text-sm font-bold hover:border-brand-primary hover:text-brand-primary hover:bg-brand-primary/5 transition-colors active:scale-[0.98]"
                onclick="window.dispatchEvent(new CustomEvent('openAddSession', { detail: { time: '${slotTimeStr}', date: currentCalendarDate, showDateTime: false } }))"
              >
                + Adaugă ședință
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // Evenimentele globale re-randeză timeline-ul. Listenerelor sunt înregistrate
    // O SINGURĂ dată pe sesiune (scriptul se re-execută la fiecare navigare SPA,
    // altfel s-ar acumula listeneri permanenți); handlerii apelează mereu
    // rendererul curent, ca scope-ul să nu devină stale între navigări.
    (window as any)._calendarRenderCurrent = renderTimeline;

    if (!(window as any)._calendarEventsBound) {
      (window as any)._calendarEventsBound = true;

      window.addEventListener('sessionsUpdated', (e: any) => {
        // La ștergere, cardul este eliminat optimist; nu re-fetchăm întreg calendarul.
        if (e.detail?.source === 'dashboardDelete') return;
        (window as any)._calendarRenderCurrent?.();
      });
      window.addEventListener('patientsUpdated', () => (window as any)._calendarRenderCurrent?.());
      // Re-renderizează timeline când se schimbă orele de lucru sau pauza din Setări
      window.addEventListener('settingsUpdated', () => (window as any)._calendarRenderCurrent?.());

      // Randare inițială + la fiecare întoarcere pe pagină (astro:page-load
      // fired și la cold load, deci nu mai e nevoie de apel imediat — altfel
      // timeline-ul se randa de două ori la încărcare).
      document.addEventListener('astro:page-load', () => (window as any)._calendarRenderCurrent?.());
    }

    // ── Drag & drop: mută o programare (long-press apoi drag) ──────────────
    // Drop pe un slot orar din timeline → schimbă ora.
    // Drop pe o zi din strip-ul săptămânii (WeeklyCalendarCard) → schimbă ziua.
    // Triggerul DB `valideaza_programare` respinge suprapunerile — afișăm mesajul.
    function initSessionDragDrop() {
      if ((window as any)._sessionDragDropInit) return;
      (window as any)._sessionDragDropInit = true;

      const MOVE_CANCEL_PX = 12;

      let activePointerId: number | null = null;
      let pressTimer: number | undefined;
      let startX = 0;
      let startY = 0;
      let sourceCard: HTMLElement | null = null;
      let dragging = false;
      let ghostEl: HTMLElement | null = null;
      let ghostOffsetX = 0;
      let ghostOffsetY = 0;
      let suppressClick = false;
      let dropTarget: { type: 'slot' | 'day'; el: HTMLElement; value: string; targetSessionId?: string } | null = null;

      function cancelPress() {
        clearTimeout(pressTimer);
        pressTimer = undefined;
        if (!dragging) {
          activePointerId = null;
          sourceCard = null;
        }
      }

      function clearTargetHighlight() {
        if (!dropTarget) return;
        dropTarget.el.style.outline = '';
        dropTarget.el.style.outlineOffset = '';
        dropTarget.el.style.borderRadius = '';
        dropTarget = null;
      }

      function engageDrag(x: number, y: number) {
        if (!sourceCard || dragging) return;
        dragging = true;
        (window as any)._sessionDragActive = true;

        const rect = sourceCard.getBoundingClientRect();
        ghostOffsetX = x - rect.left;
        ghostOffsetY = y - rect.top;

        ghostEl = sourceCard.cloneNode(true) as HTMLElement;
        ghostEl.style.cssText += `;position:fixed;left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;z-index:70;pointer-events:none;margin:0;opacity:0.95;box-shadow:0 24px 48px rgba(0,0,0,0.3);border-radius:2.5rem;`;
        document.body.appendChild(ghostEl);

        sourceCard.style.opacity = '0.35';
        document.body.style.overflow = 'hidden';
        moveGhost(x, y);
      }

      function moveGhost(x: number, y: number) {
        if (!ghostEl) return;
        ghostEl.style.left = `${x - ghostOffsetX}px`;
        ghostEl.style.top = `${y - ghostOffsetY}px`;
      }

      function updateDropTarget(x: number, y: number) {
        clearTargetHighlight();
        const el = document.elementFromPoint(x, y) as HTMLElement | null;
        if (!el) return;

        const dayEl = el.closest('[data-calendar-item]') as HTMLElement | null;
        if (dayEl && dayEl.closest('#calendar-strip')) {
          const yy = dayEl.getAttribute('data-year');
          const mm = dayEl.getAttribute('data-month');
          const dd = dayEl.getAttribute('data-date');
          if (yy && mm !== null && dd) {
            const dateStr = `${yy}-${(parseInt(mm) + 1).toString().padStart(2, '0')}-${dd.padStart(2, '0')}`;
            dropTarget = { type: 'day', el: dayEl, value: dateStr };
            dayEl.style.outline = '2px solid black';
            dayEl.style.outlineOffset = '2px';
            return;
          }
        }

        const slotEl = el.closest('[data-slot-time]') as HTMLElement | null;
        if (slotEl && slotEl.closest('#timeline-slots-container')) {
          const slotTime = slotEl.getAttribute('data-slot-time');
          if (slotTime) {
            const targetCard = slotEl.querySelector('[data-session-id]') as HTMLElement | null;
            const targetSessionId = targetCard?.getAttribute('data-session-id') || undefined;
            dropTarget = { type: 'slot', el: slotEl, value: slotTime, targetSessionId };
            slotEl.style.outline = '2px dashed #0a0a0a';
            slotEl.style.outlineOffset = '-2px';
            slotEl.style.borderRadius = '1rem';
          }
        }
      }

      function cleanupDrag() {
        clearTargetHighlight();
        if (ghostEl) {
          ghostEl.remove();
          ghostEl = null;
        }
        if (sourceCard) sourceCard.style.opacity = '';
        sourceCard = null;
        activePointerId = null;
        dragging = false;
        (window as any)._sessionDragActive = false;
        document.body.style.overflow = '';
      }

      async function finishDrag() {
        const target = dropTarget;
        const card = sourceCard;
        suppressClick = true;
        setTimeout(() => { suppressClick = false; }, 350);
        cleanupDrag();
        if (!target || !card) return;

        const sessionId = card.getAttribute('data-session-id');
        const groupId = card.getAttribute('data-group-id');
        const memberIdsAttr = card.getAttribute('data-group-member-ids');
        const origTime = card.getAttribute('data-session-time');
        const origDate = card.getAttribute('data-session-date');

        try {
          // Mută întreg grupul deodată
          if (groupId && memberIdsAttr) {
            const ids = memberIdsAttr.split(',').filter(Boolean);
            if (ids.length === 0) return;

            const updates: { ora?: string; data?: string } = {};
            if (target.type === 'slot') {
              if (target.value === origTime) return;
              updates.ora = target.value;
            } else {
              if (target.value === origDate) return;
              updates.data = target.value;
            }

            await Promise.all(ids.map(id => updateAppointment(id, updates)));
            (window as any).showToast('Ședința în grup a fost mutată cu succes.', 'success');
            if (target.type === 'day') {
              (target.el as HTMLButtonElement).click();
            }
            window.dispatchEvent(new CustomEvent('sessionsUpdated'));
            return;
          }

          if (!sessionId) return;

          if (target.type === 'slot' && target.targetSessionId && target.targetSessionId !== sessionId) {
            // Drop pe un slot ocupat → schimbă pacienții între programări
            await swapAppointmentPatients(sessionId, target.targetSessionId);
            (window as any).showToast('Pacienții au fost schimbați între ore.', 'success');
            window.dispatchEvent(new CustomEvent('sessionsUpdated'));
            return;
          }

          const updates: { ora?: string; data?: string } = {};
          if (target.type === 'slot') {
            if (target.value === origTime) return; // aceeași oră — nimic de făcut
            updates.ora = target.value;
          } else {
            if (target.value === origDate) return; // aceeași zi — nimic de făcut
            updates.data = target.value;
          }

          await updateAppointment(sessionId, updates);
          (window as any).showToast('Programarea a fost mutată cu succes.', 'success');
          if (target.type === 'day') {
            (target.el as HTMLButtonElement).click(); // comută timeline-ul pe ziua nouă
          }
          window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        } catch (err: any) {
          (window as any).showToast('Nu am putut muta programarea: ' + (err?.message || err), 'error');
          window.dispatchEvent(new CustomEvent('sessionsUpdated'));
        }
      }

      document.addEventListener('pointerdown', (e: PointerEvent) => {
        if (dragging) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        const target = e.target as HTMLElement;
        if (target.closest('button') || target.closest('a')) return;
        const card = (target.closest('[data-session-id]') || target.closest('[data-group-id]')) as HTMLElement | null;
        if (!card || !card.closest('#timeline-slots-container')) return;

        activePointerId = e.pointerId;
        startX = e.clientX;
        startY = e.clientY;
        sourceCard = card;

        const holdMs = e.pointerType === 'mouse' ? 250 : 500;
        clearTimeout(pressTimer);
        pressTimer = window.setTimeout(() => engageDrag(startX, startY), holdMs);
      });

      document.addEventListener('pointermove', (e: PointerEvent) => {
        if (activePointerId === null || e.pointerId !== activePointerId) return;
        if (!dragging) {
          if (Math.hypot(e.clientX - startX, e.clientY - startY) > MOVE_CANCEL_PX) cancelPress();
          return;
        }
        moveGhost(e.clientX, e.clientY);
        updateDropTarget(e.clientX, e.clientY);
      });

      document.addEventListener('pointerup', (e: PointerEvent) => {
        if (activePointerId === null || e.pointerId !== activePointerId) return;
        if (!dragging) {
          cancelPress();
          return;
        }
        finishDrag();
      });

      document.addEventListener('pointercancel', (e: PointerEvent) => {
        if (activePointerId === null || e.pointerId !== activePointerId) return;
        clearTimeout(pressTimer);
        if (dragging) cleanupDrag();
        else cancelPress();
      });

      // Blochează scroll-ul paginii cât timp e activ un potențial drag pe card.
      document.addEventListener('touchmove', (e: TouchEvent) => {
        if (activePointerId !== null && sourceCard) {
          const touch = e.touches[0];
          const dx = touch.clientX - startX;
          const dy = touch.clientY - startY;
          if (Math.hypot(dx, dy) <= MOVE_CANCEL_PX && e.cancelable) {
            e.preventDefault();
          }
        }
        if (dragging && e.cancelable) e.preventDefault();
      }, { passive: false });

      // Blochează meniul contextual pe long-press în timpul drag-ului
      document.addEventListener('contextmenu', (e: Event) => {
        if (dragging) e.preventDefault();
      });

      // Nu declanșa expandarea cardului din click-ul de la finalul drag-ului
      document.addEventListener('click', (e: Event) => {
        if (suppressClick) {
          e.stopPropagation();
          e.preventDefault();
          suppressClick = false;
        }
      }, true);
    }

    document.addEventListener('DOMContentLoaded', initSessionDragDrop);
    document.addEventListener('astro:page-load', initSessionDragDrop);
  </script>
</DashboardLayout>
