---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PatientList from '../../components/features/patients/PatientList.astro';
import AddPatientSheet from '../../components/features/patients/AddPatientSheet.astro';
import BlobBackground from '../../components/ui/BlobBackground.astro';

// Cache the shell of the dashboard page privately so switching tabs feels instant.
Astro.response.headers.set('Cache-Control', 'private, max-age=30, must-revalidate');
---

<DashboardLayout title="Pacienți">
  <div class="relative min-h-[100dvh]">
    <BlobBackground positions={[
      { top: '-5rem', left: '-4rem' },
      { top: '50%', right: '-3.5rem' },
      { bottom: '-2rem', left: '-3.5rem' }
    ]} />
    <section class="relative z-10 space-y-6">
      <PatientList />
    </section>
    <AddPatientSheet />
  </div>
</DashboardLayout>
