---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardOverview from '../../components/features/dashboard/DashboardOverview.astro';

// Nu memora pagina: conține "azi" calculat la SSR — un max-age ar putea servi
// ziua veche timp de 30s după miezul nopții. no-cache permite 304 la revalidare.
Astro.response.headers.set('Cache-Control', 'private, no-cache');
---

<DashboardLayout title="Overview">
  <div class="relative min-h-[100dvh]">
    <section class="relative z-10 space-y-6">
      <DashboardOverview />
    </section>
  </div>
</DashboardLayout>
