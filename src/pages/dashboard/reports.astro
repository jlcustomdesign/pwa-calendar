---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ReportsView from '../../components/features/reports/ReportsView.astro';
import HeaderSkeleton from '../../components/ui/HeaderSkeleton.astro';

// Cache the shell of the dashboard page privately so switching tabs feels instant.
Astro.response.headers.set('Cache-Control', 'private, max-age=30, must-revalidate');
---

<DashboardLayout title="Statistici">
  <div class="space-y-6 pb-24 relative min-h-[100dvh]">
    <!-- Header Statistici -->
    <header class="px-2 relative z-10 pt-2">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-text-main">Statistici</h1>
    </header>
    <HeaderSkeleton />

    <div class="relative z-10">
      <ReportsView />
    </div>
  </div>
</DashboardLayout>
