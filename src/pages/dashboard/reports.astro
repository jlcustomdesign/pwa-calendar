---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ReportsView from '../../components/features/reports/ReportsView.astro';
---

<DashboardLayout title="Statistici">
  <div class="space-y-6 pb-24 relative min-h-screen">
    
    <!-- Deformed Liquid Blob SVG Bleeding From Top-Left Edge (Pink) -->
    <div class="absolute -top-24 -left-16 w-72 h-72 pointer-events-none opacity-35 text-brand-secondary z-0">
      <svg viewBox="0 0 200 200" class="w-full h-full fill-current">
        <path d="M38.1,-60.5C47.8,-53.4,53.2,-39.7,59.3,-26.4C65.4,-13.1,72.2,-0.2,71.1,12.5C70,25.2,61,37.7,50.1,47.9C39.2,58.1,26.4,66,11.8,70C-2.8,74,-19.2,74.1,-33.4,67.8C-47.6,61.5,-59.6,48.8,-66.9,34.1C-74.2,19.4,-76.8,2.7,-73.9,-12.8C-71,-28.3,-62.6,-42.6,-50.8,-50.3C-39,-58,-23.8,-59.1,-9.1,-58.5C5.6,-57.9,28.4,-67.6,38.1,-60.5Z" transform="translate(100 100)" />
      </svg>
    </div>

    <!-- Second Deformed Liquid Blob SVG (Yellow, Right Side, Lower Down, Smaller) -->
    <div class="absolute top-[38%] -right-14 w-52 h-52 pointer-events-none opacity-45 text-brand-primary z-0">
      <svg viewBox="0 0 200 200" class="w-full h-full fill-current">
        <path d="M44.7,-59.2C56.9,-51.2,65,-36.8,69.5,-21.4C74,-6,74.9,10.4,69.9,24.8C64.9,39.2,54,51.6,40.7,60.1C27.4,68.6,11.7,73.2,-3.5,77.5C-18.7,81.8,-33.4,85.8,-45.8,78.9C-58.2,72,-68.3,54.2,-74.4,36.1C-80.5,18,-82.6,-0.4,-78.3,-16.9C-74,-33.4,-63.3,-48,-49.7,-55.8C-36.1,-63.6,-19.6,-64.6,-2.4,-61.6C14.8,-58.6,32.5,-67.2,44.7,-59.2Z" transform="translate(100 100)" />
      </svg>
    </div>

    <!-- Third Deformed Liquid Blob SVG (Pink, Bottom-Left, Small, Lower Down) -->
    <div class="absolute -bottom-6 -left-14 w-48 h-48 pointer-events-none opacity-35 text-brand-secondary z-0">
      <svg viewBox="0 0 200 200" class="w-full h-full fill-current">
        <path d="M41.5,-54.6C52.6,-45.8,59.9,-32.4,63.1,-18.2C66.3,-4,65.4,11,59.8,24.4C54.2,37.8,43.9,49.6,31.2,56.7C18.5,63.8,3.4,66.2,-12.3,64.7C-28,63.2,-44.3,57.8,-54.7,46.5C-65.1,35.2,-69.6,18,-68.1,1.9C-66.6,-14.2,-59.1,-29.2,-48.5,-38.3C-37.9,-47.4,-24.2,-50.6,-10.1,-52.1C4.1,-53.6,28.4,-57.4,41.5,-54.6Z" transform="translate(100 100)" />
      </svg>
    </div>

    <!-- Header Statistici -->
    <header class="px-2 relative z-10 pt-2">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-text-main">Statistici</h1>
    </header>

    <div class="relative z-10">
      <ReportsView />
    </div>
  </div>
</DashboardLayout>
