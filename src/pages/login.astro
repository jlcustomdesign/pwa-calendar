---
import AuthForm from '../components/features/auth/AuthForm.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-surface-base">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | Kineto Agenda</title>
  </head>
  <body class="h-full flex items-center justify-center p-4 text-text-main">
    <AuthForm>
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-text-main">Welcome Back</h1>
        <p class="text-sm text-text-muted mt-1">Sign in to manage your kinetotherapy agenda</p>
      </div>
      <form class="space-y-4">
        <div>
          <label for="login-email" class="block text-xs font-medium text-text-muted mb-1">Email</label>
          <input id="login-email" name="email" type="email" class="w-full px-3 py-2 bg-surface-base border border-border-subtle rounded-lg text-sm text-text-main focus:outline-none focus:border-brand-primary" placeholder="kineto@example.com" />
        </div>
        <div>
          <label for="login-password" class="block text-xs font-medium text-text-muted mb-1">Password</label>
          <input id="login-password" name="password" type="password" class="w-full px-3 py-2 bg-surface-base border border-border-subtle rounded-lg text-sm text-text-main focus:outline-none focus:border-brand-primary" placeholder="••••••••" />
        </div>
        <button type="button" class="w-full py-2.5 px-4 bg-brand-primary text-text-inverse text-sm font-medium rounded-lg hover:bg-brand-primary/90 transition-colors">
          Sign In
        </button>
      </form>
      <div class="mt-4 text-center">
        <a href="/signup" class="text-xs text-brand-primary hover:underline">Need an account? Register</a>
      </div>
    </AuthForm>
  </body>
</html>
